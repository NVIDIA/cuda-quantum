# Install from the one native build; scikit-build writes wheel metadata/RECORD.
# Private core paths do not overlap combined-wheel paths, so uninstalling a
# combined wheel during an upgrade cannot remove core's files. A path-only .pth
# exposes the cudaq namespace to Python.
if("@CUDAQ_WHEEL_KIND@" STREQUAL "core")
  set(components Core fmt_core CUDAQCorePythonModules)
elseif("@CUDAQ_WHEEL_KIND@" STREQUAL "devel")
  # fmt_core ships with the core wheel, which cudaq-devel depends on.
  set(components Development Nvqpp BundledLLVMDevel)
else()
  set(components Runtime CUDAQuantumPythonModules)
endif()
foreach(component IN LISTS components)
  set(prefix "${CMAKE_INSTALL_PREFIX}")
  if("@CUDAQ_WHEEL_KIND@" STREQUAL "core")
    string(APPEND prefix "/cudaq_core")
    if(NOT component STREQUAL "CUDAQCorePythonModules")
      string(APPEND prefix "/cudaq/core")
    endif()
  elseif("@CUDAQ_WHEEL_KIND@" STREQUAL "devel" AND component STREQUAL "BundledLLVMDevel")
    # The bundled LLVM/MLIR toolchain and the payload-independent devel
    # helper set nest into the shared private prefix: tools under P/bin
    # resolve core-owned providers in P/lib through their $ORIGIN/../lib
    # RPATH, and P/lib/cmake/cudaq is the SDK's canonical module directory.
    # CUDA-Q's own devel files stay flat next to the frontend's payloads.
    string(APPEND prefix "/cudaq_core/cudaq/core")
  endif()
  set(strip_argument)
  if(CMAKE_INSTALL_DO_STRIP)
    set(strip_argument --strip)
  endif()
  execute_process(
    COMMAND "${CMAKE_COMMAND}" --install "@CUDAQ_WHEEL_BUILD_DIR@"
      --config "${CMAKE_INSTALL_CONFIG_NAME}" --component "${component}"
      --prefix "${prefix}" ${strip_argument}
    COMMAND_ERROR_IS_FATAL ANY)
endforeach()
if("@CUDAQ_WHEEL_KIND@" STREQUAL "devel")
  # nvqir's package files are core-owned in split wheels; devel must not
  # ship the duplicate (it would shadow core's nested NVQIRTargets).
  file(REMOVE_RECURSE "${CMAKE_INSTALL_PREFIX}/lib/cmake/nvqir")
  # The shared runtime providers are core-owned; assert none slipped into
  # the bundled LLVM tree (see BundleMLIRDevel.cmake for the filtering).
  file(GLOB _devel_providers
    "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib/libLLVM@CMAKE_SHARED_LIBRARY_SUFFIX@*"
    "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib/libLLVM-*@CMAKE_SHARED_LIBRARY_SUFFIX@*"
    "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib/libMLIR@CMAKE_SHARED_LIBRARY_SUFFIX@*"
    "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib/libMLIR-C@CMAKE_SHARED_LIBRARY_SUFFIX@*"
    "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib/libMLIRExecutionEngineShared@CMAKE_SHARED_LIBRARY_SUFFIX@*")
  if(_devel_providers)
    message(FATAL_ERROR
      "Devel wheel staging contains core-owned providers: ${_devel_providers}")
  endif()
endif()
if("@CUDAQ_WHEEL_KIND@" STREQUAL "core")
  file(WRITE "${CMAKE_INSTALL_PREFIX}/cudaq_core.pth" "cudaq_core\n")
  if(NOT APPLE)
    # Read ELF dependencies, not compiler link inputs that may be linker scripts.
    # Only bundle OpenMP; pthread and other system libraries remain external.
    file(GLOB _wheel_libraries
      "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib/*.so*")
    set(_omp_directories "@CUDAQ_WHEEL_OPENMP_DIRS@")
    file(GET_RUNTIME_DEPENDENCIES
      LIBRARIES ${_wheel_libraries}
      DIRECTORIES ${_omp_directories}
      PRE_INCLUDE_REGEXES "^lib(gomp|omp)\\.so(\\.[0-9]+)*$"
      PRE_EXCLUDE_REGEXES ".*"
      RESOLVED_DEPENDENCIES_VAR _omp_libraries)
    # Missing runtimes fail resolution above. Preserve the SONAME symlinks so
    # both wheels can exclude OpenMP from auditwheel's dependency-name rewriting.
    file(INSTALL ${_omp_libraries}
      DESTINATION "${CMAKE_INSTALL_PREFIX}/cudaq_core/cudaq/core/lib"
      TYPE SHARED_LIBRARY FOLLOW_SYMLINK_CHAIN)
  endif()
elseif(APPLE)
  # Frontend uses the OpenMP copy bundled by delocate in cudaq_core.dylibs.
  # Replace build-machine install names before packaging; excluding OpenMP
  # from frontend repair alone would leave absolute Homebrew paths intact.
  find_program(_wheel_otool otool REQUIRED)
  find_program(_wheel_install_name_tool install_name_tool REQUIRED)
  find_program(_wheel_codesign codesign REQUIRED)
  file(GLOB_RECURSE _wheel_libraries
    "${CMAKE_INSTALL_PREFIX}/*.dylib" "${CMAKE_INSTALL_PREFIX}/*.so")
  foreach(_library IN LISTS _wheel_libraries)
    # List Mach-O dependency install names to find this binary's OpenMP reference.
    execute_process(COMMAND "${_wheel_otool}" -L "${_library}"
      OUTPUT_VARIABLE _dependencies COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" _dependencies "${_dependencies}")
    set(_changed FALSE)
    foreach(_dependency IN LISTS _dependencies)
      if(_dependency MATCHES "^[ \t]+([^ \t]+/libomp\\.dylib) ")
        # Use runtime lookup instead of a build-machine path such as Homebrew's.
        execute_process(COMMAND "${_wheel_install_name_tool}"
          -change "${CMAKE_MATCH_1}" "@rpath/libomp.dylib" "${_library}"
          COMMAND_ERROR_IS_FATAL ANY)
        set(_changed TRUE)
      endif()
    endforeach()
    if(_changed)
      get_filename_component(_directory "${_library}" DIRECTORY)
      file(RELATIVE_PATH _core_dylibs "${_directory}"
        "${CMAKE_INSTALL_PREFIX}/cudaq_core.dylibs")
      # Resolve OpenMP relative to this binary in core's delocate bundle.
      execute_process(COMMAND "${_wheel_install_name_tool}"
        -add_rpath "@loader_path/${_core_dylibs}" "${_library}"
        COMMAND_ERROR_IS_FATAL ANY)
      # Restore a valid ad-hoc signature after modifying the Mach-O load commands.
      execute_process(COMMAND "${_wheel_codesign}" --force --sign - "${_library}"
        COMMAND_ERROR_IS_FATAL ANY)
    endif()
  endforeach()
endif()
