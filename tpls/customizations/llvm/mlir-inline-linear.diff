+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/Transforms/Inliner.h"
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/ControlFlow/IR/ControlFlowOps.h"
+#include "mlir/Dialect/Func/Extensions/InlinerExtension.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/Verifier.h"
+#include "mlir/Parser/Parser.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+
+namespace {
+struct CheckingInliner : InlinerInterface {
+  CheckingInliner(MLIRContext *context, Operation *suffix, Block *callerBlock,
+                  bool customClone, bool allowFastPath)
+      : InlinerInterface(context), suffix(suffix), callerBlock(callerBlock),
+        customClone(customClone), allowFastPath(allowFastPath) {}
+
+  void processInlinedBlocks(iterator_range<Region::iterator>) override {
+    // Check the structural property responsible for linear scaling: the
+    // default path must not move the caller's suffix at each call site.
+    EXPECT_EQ(suffix->getBlock() == callerBlock, !customClone);
+    processed = true;
+  }
+
+  bool allowSingleBlockOptimization(
+      iterator_range<Region::iterator>) const override {
+    return allowFastPath;
+  }
+
+  Operation *suffix;
+  Block *callerBlock;
+  bool customClone;
+  bool allowFastPath;
+  bool processed = false;
+};
+
+TEST(Inliner, SingleBlockInsertion) {
+  for (bool clone : {false, true}) {
+    for (bool customClone : {false, true}) {
+      for (bool allowFastPath : {false, true}) {
+        SCOPED_TRACE(::testing::Message()
+                     << "clone=" << clone << " custom=" << customClone
+                     << " fast=" << allowFastPath);
+        DialectRegistry registry;
+        registry.insert<arith::ArithDialect, cf::ControlFlowDialect,
+                        func::FuncDialect>();
+        func::registerInlinerExtension(registry);
+        MLIRContext context(registry);
+        auto module = parseSourceString<ModuleOp>(R"mlir(
+          module {
+            func.func private @callee(%x: i32) -> i32 {
+              %y = arith.addi %x, %x : i32
+              return %y : i32
+            }
+            func.func @caller(%x: i32) -> i32 {
+              %y = func.call @callee(%x) : (i32) -> i32
+              %z = arith.muli %y, %x : i32
+              return %z : i32
+            }
+          }
+        )mlir",
+                                                  &context);
+        ASSERT_TRUE(module);
+        auto callee = module->lookupSymbol<func::FuncOp>("callee");
+        auto caller = module->lookupSymbol<func::FuncOp>("caller");
+        auto call = cast<func::CallOp>(caller.getBody().front().front());
+        Operation *suffix = call->getNextNode();
+        CheckingInliner interface(&context, suffix, call->getBlock(),
+                                  customClone, allowFastPath);
+        InlinerConfig config;
+        if (customClone) {
+          config.setCloneCallback([&](OpBuilder &, Region *src, Block *before,
+                                      Block *after, IRMapping &mapper,
+                                      bool shouldClone) {
+            EXPECT_EQ(&before->back(), call.getOperation());
+            EXPECT_EQ(&after->front(), suffix);
+            if (shouldClone)
+              src->cloneInto(before->getParent(), after->getIterator(), mapper);
+            else
+              before->getParent()->getBlocks().splice(after->getIterator(),
+                                                      src->getBlocks());
+          });
+        }
+        ASSERT_TRUE(
+            succeeded(inlineCall(interface, config.getCloneCallback(), call,
+                                 callee, &callee.getBody(), clone)));
+        EXPECT_TRUE(interface.processed);
+        call.erase();
+        if (!clone)
+          callee.erase();
+        EXPECT_TRUE(succeeded(verify(*module)));
+        EXPECT_EQ(caller.getBody().hasOneBlock(), allowFastPath);
+      }
+    }
+  }
+}
+} // namespace
