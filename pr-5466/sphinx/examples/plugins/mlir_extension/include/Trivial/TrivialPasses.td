#ifndef TRIVIAL_PASSES
#define TRIVIAL_PASSES

include "mlir/Pass/PassBase.td"

def TrivialPass : Pass<"trivial-pass", "mlir::ModuleOp"> {
  let summary = "Insert a trivial.nop and mark the module as visited.";
  let description = [{
    Adds a `trivial.nop` to the module body and sets a `trivial.visited` unit
    attribute. Running it proves the dialect, op, and pass were generated by
    mlir-tblgen and that MLIR/LLVM symbols resolve against libcudaqMLIR.
  }];
  let dependentDialects = ["trivial::TrivialDialect"];
}

#endif // TRIVIAL_PASSES
