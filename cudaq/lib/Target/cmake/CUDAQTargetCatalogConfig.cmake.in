# Package config for the CUDAQ target-catalog component. Self-contained:
# reflect-cpp/yaml-cpp are statically embedded and no LLVM/MLIR or other
# CUDA-Q component packages are required.

@PACKAGE_INIT@

if(NOT TARGET cudaq::CUDAQTargetCatalog)
  include("${CMAKE_CURRENT_LIST_DIR}/CUDAQTargetCatalogTargets.cmake")
endif()
