# Package config for the CUDAQ target-config component: the lightweight,
# in-memory target configuration model. Self-contained: no YAML, reflect-cpp,
# LLVM/MLIR, or other CUDA-Q component packages are required.

@PACKAGE_INIT@

if(NOT TARGET cudaq::CUDAQTargetConfig)
  include("${CMAKE_CURRENT_LIST_DIR}/CUDAQTargetConfigTargets.cmake")
endif()
