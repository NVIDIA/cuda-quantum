# cudaq-target-db-gen smoke: database mode, single-target plugin mode, the
# stdout output form, and ordinary CLI error cases.

# RUN: %cudaq-target-db-gen -o %t.db.cpp lit-defaults=%S/defaults.yml lit-backend=%S/backend.yml
# RUN: FileCheck %s --input-file=%t.db.cpp --check-prefix=DB
# RUN: %cudaq-target-db-gen --plugin -o %t.plugin.cpp lit-backend=%S/backend.yml
# RUN: FileCheck %s --input-file=%t.plugin.cpp --check-prefix=PLUGIN
# RUN: %cudaq-target-db-gen -o - lit-defaults=%S/defaults.yml | FileCheck %s --check-prefix=STDOUT
# RUN: not %cudaq-target-db-gen %S/defaults.yml 2>&1 | FileCheck %s --check-prefix=ERR
# RUN: not %cudaq-target-db-gen --plugin -o %t.multi.cpp lit-a=%S/defaults.yml lit-b=%S/backend.yml 2>&1 | FileCheck %s --check-prefix=PLUGINARGS
# RUN: not %cudaq-target-db-gen --plugin -o %t.zero.cpp 2>&1 | FileCheck %s --check-prefix=PLUGINZERO
# RUN: not %cudaq-target-db-gen -o %S/no-such-dir/db.cpp lit-defaults=%S/defaults.yml 2>&1 | FileCheck %s --check-prefix=OUTERR
# RUN: %cudaq-target-db-gen --help > %t.help.txt
# RUN: FileCheck %s --input-file=%t.help.txt --check-prefix=HELP

# DB: extern "C" void cudaq_target_db_abi_v2() {}
