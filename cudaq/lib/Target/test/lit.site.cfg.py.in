# Site config: points lit at the built driver/generator and the located FileCheck (plain configure_file).

import os

config.target_catalog_driver = os.path.join(
    r"@CMAKE_CURRENT_BINARY_DIR@", "TargetCatalogTestDriver@CMAKE_EXECUTABLE_SUFFIX@")
config.target_catalog_db_gen = os.path.join(
    r"@CMAKE_BINARY_DIR@", "bin", "cudaq-target-db-gen@CMAKE_EXECUTABLE_SUFFIX@")
config.target_catalog_filecheck = r"@_target_catalog_filecheck@"
config.test_exec_root = r"@CMAKE_CURRENT_BINARY_DIR@"

lit_config.load_config(
    config, os.path.join(r"@CMAKE_CURRENT_SOURCE_DIR@", "lit.cfg.py"))
