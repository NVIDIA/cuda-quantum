// RUN: cudaq-opt --unwind-lowering --canonicalize %s | FileCheck %s

func.func @__nvqpp__mlirgen__1(%arg0: i32) {
  %c1_i32 = arith.constant 1 : i32
  %c0_i32 = arith.constant 0 : i32
  %0 = cc.alloca i32
  cc.store %arg0, %0 : !cc.ptr<i32>
  %1 = quake.alloca !quake.ref
  cc.scope {
    %2 = cc.alloca i32
    cc.store %c0_i32, %2 : !cc.ptr<i32>
    cc.loop while {
      %3 = cc.load %2 : !cc.ptr<i32>
      %4 = cc.load %0 : !cc.ptr<i32>
      %5 = arith.cmpi slt, %3, %4 : i32
      cc.condition %5
    } do {
      cc.scope {
        %3 = quake.alloca !quake.ref
        quake.x %3 : (!quake.ref) -> ()
        %4 = cc.load %2 : !cc.ptr<i32>
        %5 = arith.cmpi sgt, %4, %c0_i32 : i32
        cc.if(%5) {
          cc.unwind_break
        }
        quake.h %1 : (!quake.ref) -> ()
      }
      cc.continue
    } step {
      %3 = cc.load %2 : !cc.ptr<i32>
      %4 = arith.addi %3, %c1_i32 : i32
      cc.store %4, %2 : !cc.ptr<i32>
    }
  }
  %measOut = quake.mz %1 : (!quake.ref) -> !cc.measure_handle
  return
}

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__1(
// CHECK-SAME:      %[[ARG0:.*]]: i32) {
// CHECK-DAG:       %[[CONSTANT_0:.*]] = arith.constant 1 : i32
// CHECK-DAG:       %[[CONSTANT_1:.*]] = arith.constant 0 : i32
// CHECK-DAG:       %[[ALLOCA_0:.*]] = cc.alloca i32
// CHECK:           cc.store %[[ARG0]], %[[ALLOCA_0]] : !cc.ptr<i32>
// CHECK:           %[[ALLOCA_1:.*]] = quake.alloca !quake.ref
// CHECK:           cc.scope {
// CHECK:             %[[ALLOCA_2:.*]] = cc.alloca i32
// CHECK:             cc.store %[[CONSTANT_1]], %[[ALLOCA_2]] : !cc.ptr<i32>
// CHECK:             cc.loop while {
// CHECK:               %[[LOAD_0:.*]] = cc.load %[[ALLOCA_2]] : !cc.ptr<i32>
// CHECK:               %[[LOAD_1:.*]] = cc.load %[[ALLOCA_0]] : !cc.ptr<i32>
// CHECK:               %[[CMPI_0:.*]] = arith.cmpi slt, %[[LOAD_0]], %[[LOAD_1]] : i32
// CHECK:               cc.condition %[[CMPI_0]]
// CHECK:             } do {
// CHECK:               %[[ALLOCA_3:.*]] = quake.alloca !quake.ref
// CHECK:               quake.x %[[ALLOCA_3]] : (!quake.ref) -> ()
// CHECK:               %[[LOAD_2:.*]] = cc.load %[[ALLOCA_2]] : !cc.ptr<i32>
// CHECK:               %[[CMPI_1:.*]] = arith.cmpi sgt, %[[LOAD_2]], %[[CONSTANT_1]] : i32
// CHECK:               cf.cond_br %[[CMPI_1]], ^bb2, ^bb1
// CHECK:             ^bb1:
// CHECK:               quake.h %[[ALLOCA_1]] : (!quake.ref) -> ()
// CHECK:               quake.dealloc %[[ALLOCA_3]] : !quake.ref
// CHECK:               cc.continue
// CHECK:             ^bb2:
// CHECK:               quake.dealloc %[[ALLOCA_3]] : !quake.ref
// CHECK:               cc.break
// CHECK:             } step {
// CHECK:               %[[LOAD_3:.*]] = cc.load %[[ALLOCA_2]] : !cc.ptr<i32>
// CHECK:               %[[ADDI_0:.*]] = arith.addi %[[LOAD_3]], %[[CONSTANT_0]] : i32
// CHECK:               cc.store %[[ADDI_0]], %[[ALLOCA_2]] : !cc.ptr<i32>
// CHECK:             }
// CHECK:           }
// CHECK:           %[[MZ_0:.*]] = quake.mz %[[ALLOCA_1]] : (!quake.ref) -> !cc.measure_handle
// CHECK:           return
// CHECK:         }

