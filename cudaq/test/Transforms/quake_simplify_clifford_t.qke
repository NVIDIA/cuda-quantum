// RUN: cudaq-opt --quake-simplify %s | FileCheck %s --check-prefix=OFF
// RUN: cudaq-opt --quake-simplify='rotations-to-clifford-t=true clifford-t-epsilon=0' %s | \
// RUN:   FileCheck %s --check-prefix=EXACT
// RUN: cudaq-opt --quake-simplify='rotations-to-clifford-t=true clifford-t-epsilon=1e-3' %s | \
// RUN:   FileCheck %s --check-prefix=THRESH

// `--symbol-privatize` makes every kernel not listed in `exclude` private, so
// `--symbol-dce` can remove unrelated kernels and `CircuitCheck` compares only
// the selected test group.
// RUN: cudaq-opt \
// RUN:   --symbol-privatize='exclude=r1_residues,r1_modulo,rx_residues,rx_modulo,ry_residues,ry_modulo,rz_residues,rz_modulo' \
// RUN:   --symbol-dce %s -o %t.exact.qke
// RUN: cudaq-opt --quake-simplify='rotations-to-clifford-t=true clifford-t-epsilon=0' \
// RUN:   --symbol-privatize='exclude=r1_residues,r1_modulo,rx_residues,rx_modulo,ry_residues,ry_modulo,rz_residues,rz_modulo' \
// RUN:   --symbol-dce %s | \
// RUN:   CircuitCheck %t.exact.qke

// All eight R1 residues are strict equalities and map directly to the named
// Clifford+T gates.
func.func @r1_residues() {
  %c0 = arith.constant 0.0 : f64
  %c1 = arith.constant 0.7853981633974483 : f64
  %c2 = arith.constant 1.5707963267948966 : f64
  %c3 = arith.constant 2.356194490192345 : f64
  %c4 = arith.constant 3.141592653589793 : f64
  %c5 = arith.constant 3.9269908169872414 : f64
  %c6 = arith.constant 4.71238898038469 : f64
  %c7 = arith.constant 5.497787143782138 : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %q2 = quake.null_wire
  %q3 = quake.null_wire
  %q4 = quake.null_wire
  %q5 = quake.null_wire
  %q6 = quake.null_wire
  %q7 = quake.null_wire
  %r0 = quake.r1 (%c0) %q0 : (f64, !quake.wire) -> !quake.wire
  %r1 = quake.r1 (%c1) %q1 : (f64, !quake.wire) -> !quake.wire
  %r2 = quake.r1 (%c2) %q2 : (f64, !quake.wire) -> !quake.wire
  %r3 = quake.r1 (%c3) %q3 : (f64, !quake.wire) -> !quake.wire
  %r4 = quake.r1 (%c4) %q4 : (f64, !quake.wire) -> !quake.wire
  %r5 = quake.r1 (%c5) %q5 : (f64, !quake.wire) -> !quake.wire
  %r6 = quake.r1 (%c6) %q6 : (f64, !quake.wire) -> !quake.wire
  %r7 = quake.r1 (%c7) %q7 : (f64, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %r2 : !quake.wire
  quake.sink %r3 : !quake.wire
  quake.sink %r4 : !quake.wire
  quake.sink %r5 : !quake.wire
  quake.sink %r6 : !quake.wire
  quake.sink %r7 : !quake.wire
  return
}

