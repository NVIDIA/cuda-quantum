// EXACT: quake.s<adj>
// EXACT: quake.t<adj>

// Values outside the canonical range exercise modulo-eight reduction. In
// residue order, the quarter-turn counts are -8, 9, 130, 1027, 1028, -1027,
// -130, and -17.
func.func @r1_modulo() {
  %c0 = arith.constant -6.2831853071795862 : f64
  %c1 = arith.constant 7.0685834705770345 : f64
  %c2 = arith.constant 102.10176124166829 : f64
  %c3 = arith.constant 806.6039138091794 : f64
  %c4 = arith.constant 807.38931197257682 : f64
  %c5 = arith.constant -806.6039138091794 : f64
  %c6 = arith.constant -102.10176124166829 : f64
  %c7 = arith.constant -13.351768777756622 : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %q2 = quake.null_wire
  %q3 = quake.null_wire
  %q4 = quake.null_wire
  %q5 = quake.null_wire
  %q6 = quake.null_wire
  %q7 = quake.null_wire
  %r0 = quake.r1 (%c0) %q0 : (f64, !quake.wire) -> !quake.wire
  %r1 = quake.r1 (%c1) %q1 : (f64, !quake.wire) -> !quake.wire
  %r2 = quake.r1 (%c2) %q2 : (f64, !quake.wire) -> !quake.wire
  %r3 = quake.r1 (%c3) %q3 : (f64, !quake.wire) -> !quake.wire
  %r4 = quake.r1 (%c4) %q4 : (f64, !quake.wire) -> !quake.wire
  %r5 = quake.r1 (%c5) %q5 : (f64, !quake.wire) -> !quake.wire
  %r6 = quake.r1 (%c6) %q6 : (f64, !quake.wire) -> !quake.wire
  %r7 = quake.r1 (%c7) %q7 : (f64, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %r2 : !quake.wire
  quake.sink %r3 : !quake.wire
  quake.sink %r4 : !quake.wire
  quake.sink %r5 : !quake.wire
  quake.sink %r6 : !quake.wire
  quake.sink %r7 : !quake.wire
  return
}

