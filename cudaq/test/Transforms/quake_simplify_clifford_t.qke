// Test the accuracy of the phase correction for a rotation angle sensitive to
// one-ULP rounding.
func.func @phase_source_rounding() {
  // Eleven quarter turns (`11*pi/4`) rounded to `f64` makes the phase
  // correction sensitive to one-ULP rounding.
  %angle = arith.constant 8.639379797371932 : f64
  %q = quake.null_wire
  %r = quake.rz (%angle) %q : (f64, !quake.wire) -> !quake.wire
  quake.sink %r : !quake.wire
  return
}

// EXACT-LABEL: func.func @phase_source_rounding
// EXACT: %[[ROUNDING_PHASE_ANGLE:.*]] = arith.constant -4.319689898685966 : f64
// EXACT: %[[ROUNDING_PHASE:.*]] = quake.phase (%[[ROUNDING_PHASE_ANGLE]]) %{{.*}} : (f64, !quake.wire) -> !quake.wire
// EXACT-NOT: quake.rz

// Adjoint is folded into the sign, and a negative source literal reaches the
// same inverse residue.
func.func @adjoint_and_negative() {
  %a = arith.constant 0.7853981633974483 : f64
  %n = arith.constant -0.7853981633974483 : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %q2 = quake.null_wire
  %r0 = quake.r1<adj> (%a) %q0 : (f64, !quake.wire) -> !quake.wire
  %r1 = quake.r1 (%n) %q1 : (f64, !quake.wire) -> !quake.wire
  %r2 = quake.rz<adj> (%a) %q2 : (f64, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %r2 : !quake.wire
  return
}

// EXACT-LABEL: func.func @adjoint_and_negative
// EXACT: %[[ADJ_PHASE_ANGLE:.*]] = arith.constant 0.39269908169872414 : f64
// EXACT-COUNT-2: quake.t<adj>
// EXACT: %[[ADJ_PHASE:.*]] = quake.phase (%[[ADJ_PHASE_ANGLE]]) %{{.*}} : (f64, !quake.wire) -> !quake.wire
// EXACT-NEXT: quake.t<adj> %[[ADJ_PHASE]] : (!quake.wire) -> !quake.wire
// EXACT-NOT: quake.r

// A directly controlled rotation is never matched.
func.func @direct_control(%c: !quake.wire, %q: !quake.wire)
    -> (!quake.wire, !quake.wire) {
  %a = arith.constant 0.7853981633974483 : f64
  %r:2 = quake.rz (%a) [%c] %q : (f64, !quake.wire, !quake.wire)
      -> (!quake.wire, !quake.wire)
  return %r#0, %r#1 : !quake.wire, !quake.wire
}

// EXACT-LABEL: func.func @direct_control
// EXACT: quake.rz
// EXACT-NOT: quake.t

// Canonical matching rounds pi/4 to the source constant float semantics. The
// adjacent `f32` value is rejected in exact mode but accepted by the configured
// threshold.
func.func @source_float_semantics() {
  %exact = arith.constant 0x3F490FDB : f32
  %near = arith.constant 0x3F490FDC : f32
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %q2 = quake.null_wire
  %r0 = quake.r1 (%exact) %q0 : (f32, !quake.wire) -> !quake.wire
  %r1 = quake.r1 (%near) %q1 : (f32, !quake.wire) -> !quake.wire
  %r2 = quake.rz (%exact) %q2 : (f32, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %r2 : !quake.wire
  return
}

// EXACT-LABEL: func.func @source_float_semantics
// EXACT: %[[F32_PHASE_ANGLE:.*]] = arith.constant -0.392699093 : f32
// EXACT: quake.t
// EXACT: quake.r1
