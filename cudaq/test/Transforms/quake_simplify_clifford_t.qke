// EXACT-NEXT: quake.t %[[F32_PHASE]] : (!quake.wire) -> !quake.wire
// THRESH-LABEL: func.func @source_float_semantics
// THRESH: %[[F32_PHASE_ANGLE:.*]] = arith.constant -0.392699093 : f32
// THRESH-COUNT-2: quake.t
// THRESH: %[[F32_PHASE:.*]] = quake.phase (%[[F32_PHASE_ANGLE]]) %{{.*}} : (f32, !quake.wire) -> !quake.wire
// THRESH-NEXT: quake.t %[[F32_PHASE]] : (!quake.wire) -> !quake.wire

// Dynamic, nonfinite, and merely nearby constants are rejected in exact mode.

func.func @rejections(%a: f64) {
  %near = arith.constant 0.7853981633974484 : f64
  %inf = arith.constant 0x7FF0000000000000 : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %q2 = quake.null_wire
  %r0 = quake.r1 (%a) %q0 : (f64, !quake.wire) -> !quake.wire
  %r1 = quake.r1 (%near) %q1 : (f64, !quake.wire) -> !quake.wire
  %r2 = quake.r1 (%inf) %q2 : (f64, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %r2 : !quake.wire
  return
}

// EXACT-LABEL: func.func @rejections
// EXACT-COUNT-3: quake.r1

// phased_rx has no existing semantic lowering to the supported axis family.
// Keep it explicit as unsupported instead of pretending the Rz-only synthesis
// boundary has handled it.
func.func @unsupported_phased_rx() {
  %theta = arith.constant 0.7853981633974483 : f64
  %phase = arith.constant 0.0 : f64
  %q = quake.null_wire
  %r = quake.phased_rx (%theta, %phase) %q
      : (f64, f64, !quake.wire) -> !quake.wire
  quake.sink %r : !quake.wire
  return
}

// EXACT-LABEL: func.func @unsupported_phased_rx
// EXACT: quake.phased_rx
// Constant folding and rotation merging participate in the same greedy
// fixpoint, so both ways of producing pi/4 reach the exact family.
func.func @fold_and_merge() {
  %eighth = arith.constant 0.39269908169872414 : f64
  %sum = arith.addf %eighth, %eighth : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %r0 = quake.r1 (%sum) %q0 : (f64, !quake.wire) -> !quake.wire
  %r1 = quake.r1 (%eighth) %q1 : (f64, !quake.wire) -> !quake.wire
  %r2 = quake.r1 (%eighth) %r1 : (f64, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r2 : !quake.wire
  return
}

// EXACT-LABEL: func.func @fold_and_merge
// EXACT-COUNT-2: quake.t
// EXACT-NOT: quake.r1

// epsilon=1e-3 accepts each operation just inside its operator-norm bound and
// rejects the corresponding value just outside. R1 uses delta ~= epsilon;
// axis rotations use delta ~= 2*epsilon.
func.func @threshold_boundaries() {
  %r1in = arith.constant 0.7862981633974483 : f64
  %r1out = arith.constant 0.7864981633974483 : f64
  %axisin = arith.constant 0.7872981633974483 : f64
  %axisout = arith.constant 0.7874981633974483 : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %q2 = quake.null_wire
  %q3 = quake.null_wire
  %r0 = quake.r1 (%r1in) %q0 : (f64, !quake.wire) -> !quake.wire
  %q4 = quake.null_wire
  %q5 = quake.null_wire
  %q6 = quake.null_wire
  %q7 = quake.null_wire
  %r1 = quake.r1 (%r1out) %q1 : (f64, !quake.wire) -> !quake.wire
  %r2 = quake.rz (%axisin) %q2 : (f64, !quake.wire) -> !quake.wire
  %r3 = quake.rz (%axisout) %q3 : (f64, !quake.wire) -> !quake.wire
  %r4 = quake.rx (%axisin) %q4 : (f64, !quake.wire) -> !quake.wire
  %r5 = quake.rx (%axisout) %q5 : (f64, !quake.wire) -> !quake.wire
  %r6 = quake.ry (%axisin) %q6 : (f64, !quake.wire) -> !quake.wire
  %r7 = quake.ry (%axisout) %q7 : (f64, !quake.wire) -> !quake.wire
  quake.sink %r0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %r2 : !quake.wire
  quake.sink %r3 : !quake.wire
  quake.sink %r4 : !quake.wire
  quake.sink %r5 : !quake.wire
  quake.sink %r6 : !quake.wire
  quake.sink %r7 : !quake.wire
  return
}

