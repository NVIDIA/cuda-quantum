// RUN: cudaq-opt --factor-quantum-alloc --dqe --quake-simplify --mlir-pass-statistics %s -o /dev/null >& %t && FileCheck %s < %t && FileCheck --check-prefix=SIMPLE %s < %t

func.func @f1() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  quake.sink %1 : !quake.wire
  quake.sink %0 : !quake.wire
  return
}

func.func @f2() {
  %0 = quake.alloca !quake.veq<123>
  quake.dealloc %0 : !quake.veq<123>
  return
}

// CHECK-LABEL: DeadQuantumElimination
// CHECK:  123 refs-eliminated
// CHECK:  2 wires-eliminated

func.func @f3() {
  %0 = quake.null_wire
  %1 = quake.x %0 : (!quake.wire) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

func.func @f4() {
  %0 = quake.null_wire
  %1 = arith.constant 0.0 : f64
  %2 = quake.rx (%1) %0 : (f64, !quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

func.func @f5() {
  %0 = quake.null_wire
  %1 = arith.constant 1.0 : f64
  %2 = quake.ry (%1) %0 : (f64, !quake.wire) -> !quake.wire
  %3 = quake.ry (%1) %2 : (f64, !quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

func.func @f5b() {
  %0 = quake.null_wire
  %1 = quake.t<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.t %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

func.func @f6() {
  %0 = quake.null_wire
  %1 = quake.t<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.reset %1 : (!quake.wire) -> !quake.wire
  %3 = quake.reset %2 : (!quake.wire) -> !quake.wire
  %4 = quake.x %3 : (!quake.wire) -> !quake.wire
  quake.sink %4 : !quake.wire
  return
}

func.func @f7() {
  %0 = quake.null_wire
  %1 = quake.t<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  %3 = quake.reset %2 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

func.func @f8() {
  %0 = quake.null_wire
  %1 = quake.t %0 : (!quake.wire) -> !quake.wire
  %2 = quake.t %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

func.func @f9() {
  %0 = quake.null_wire
  %1 = quake.s %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

func.func @f10() {
  %0 = quake.null_wire
  %1 = quake.y %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s %1 : (!quake.wire) -> !quake.wire
  %3 = quake.x %2 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

// SIMPLE-LABEL: QuakeSimplify
// SIMPLE: 1 adjoint-eliminations
// SIMPLE: 1 double-s-rewrites
// SIMPLE: 1 double-t-rewrites
// SIMPLE: 1 hermitian-eliminations
// SIMPLE: 1 reduce-ysx-rewrites
// SIMPLE: 2 resets-erased
// SIMPLE: 1 rotations-combined
// SIMPLE: 1 zero-rotations-eliminated
