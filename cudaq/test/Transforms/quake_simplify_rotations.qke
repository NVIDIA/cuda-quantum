// RUN: cudaq-opt --quake-simplify %s | \
// RUN:   FileCheck %s --check-prefixes=CHECK,EXACT
// RUN: cudaq-opt --quake-simplify='threshold=1e-12' %s | \
// RUN:   FileCheck %s --check-prefixes=CHECK,APPROX

// A zero-angle rotation is erased. In memory semantics the op produces no
// result, so the body keeps only the alloca and the return.
func.func @zero_angle() {
  %q = quake.alloca !quake.ref
  %a = arith.constant 0.0 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @zero_angle
// CHECK-NOT:     quake.rz

// In value semantics the input wire is threaded straight through to the users
// of the erased op.
func.func @zero_angle_wire() {
  %0 = quake.null_wire
  %a = arith.constant 0.0 : f64
  %1 = quake.rz (%a) %0 : (f64, !quake.wire) -> !quake.wire
  quake.sink %1 : !quake.wire
  return
}

// CHECK-LABEL: func.func @zero_angle_wire
// CHECK:         %[[W:.*]] = quake.null_wire
// CHECK:         quake.sink %[[W]] : !quake.wire
// CHECK-NOT:     quake.rz

// Without controls a full turn is the identity up to a global phase, which is
// unobservable in an entry point, so it is erased just like a zero angle. This
// holds for every rotation: rz(2*pi) = -I and r1(2*pi) = I.
func.func @full_turn(%q: !quake.ref) attributes {"cudaq-entrypoint"} {
  %a = arith.constant 6.2831853071795862 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  quake.rx (%a) %q : (f64, !quake.ref) -> ()
  quake.ry (%a) %q : (f64, !quake.ref) -> ()
  quake.r1 (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @full_turn
// CHECK-NOT:     quake.r{{[xyz1]}}

// A function that is not an entry point may be specialized into a controlled
// variant, which adds a control to every gate in this body and turns that
// global phase into an observable relative one. The axis rotations therefore
// keep their exact 4*pi period here, while r1 is the identity at 2*pi either
// way.
func.func @full_turn_not_entry(%q: !quake.ref) {
  %a = arith.constant 6.2831853071795862 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  quake.rx (%a) %q : (f64, !quake.ref) -> ()
  quake.ry (%a) %q : (f64, !quake.ref) -> ()
  quake.r1 (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @full_turn_not_entry
// CHECK:         quake.rz
// CHECK:         quake.rx
// CHECK:         quake.ry
// CHECK-NOT:     quake.r1

// A zero angle is the identity in any context, entry point or not.
func.func @zero_angle_not_entry(%q: !quake.ref) {
  %a = arith.constant 0.0 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @zero_angle_not_entry
// CHECK-NOT:     quake.rz

// Two full turns are exactly the identity for every rotation, so no entry
// point is needed to erase them.
func.func @two_full_turns(%q: !quake.ref) {
  %a = arith.constant 12.566370614359172 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  quake.r1 (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @two_full_turns
// CHECK-NOT:     quake.rz
// CHECK-NOT:     quake.r1

// phased_rx(theta, phi) rotates by theta about the cos(phi)x + sin(phi)y axis,
// so a zero angle is the identity whatever the axis parameter says.
func.func @phased_rx_zero_angle(%q: !quake.ref) {
  %a = arith.constant 0.0 : f64
  %b = arith.constant 1.5707963267948966 : f64
  quake.phased_rx (%a, %b) %q : (f64, f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @phased_rx_zero_angle
// CHECK-NOT:     quake.phased_rx

// Under a control the global phase of a full turn becomes an observable
// relative phase: ctrl-rz(2*pi) = diag(1, 1, -1, -1), a phase on the control
// rather than the identity. So a controlled axis rotation needs the exact 4*pi
// period, while r1 is diag(1, exp(i*theta)) and is exactly the identity at
// 2*pi even when controlled.
func.func @controlled(%c: !quake.ref, %q: !quake.ref) {
  %a = arith.constant 6.2831853071795862 : f64
  %b = arith.constant 12.566370614359172 : f64
  quake.rz (%a) [%c] %q : (f64, !quake.ref, !quake.ref) -> ()
  quake.rz (%b) [%c] %q : (f64, !quake.ref, !quake.ref) -> ()
  quake.r1 (%a) [%c] %q : (f64, !quake.ref, !quake.ref) -> ()
  return
}

// The 2*pi rz survives; the 4*pi rz and the 2*pi r1 are erased.
// CHECK-LABEL: func.func @controlled
// CHECK:         quake.rz ({{.*}}) [
// CHECK-NOT:     quake.rz
// CHECK-NOT:     quake.r1

// A half turn folds to itself and is not the identity.
func.func @half_turn(%q: !quake.ref) {
  %a = arith.constant 3.1415926535897931 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @half_turn
// CHECK:         quake.rz

// A non-constant angle is left untouched.
func.func @dynamic(%q: !quake.ref, %a: f64) {
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @dynamic
// CHECK:         quake.rz

// A small but nonzero angle is not the identity, so by default it survives:
// erasing it approximates the circuit. It is only erased once the caller opts
// in by setting a threshold above it.
func.func @tiny(%q: !quake.ref) {
  %a = arith.constant 1.0e-15 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @tiny
// EXACT:         quake.rz
// APPROX-NOT:    quake.rz

// An angle a hair under a full turn folds to a small negative residual, and is
// erased under the same opt-in threshold. Folding against the 2*pi period is
// what makes the residual small, so this needs an entry point.
func.func @near_full_turn(%q: !quake.ref) attributes {"cudaq-entrypoint"} {
  %a = arith.constant 6.2831853071795852 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @near_full_turn
// EXACT:         quake.rz
// APPROX-NOT:    quake.rz

// An angle above the threshold is untouched even in the approximate mode.
func.func @big(%q: !quake.ref) {
  %a = arith.constant 0.5 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @big
// CHECK:         quake.rz
