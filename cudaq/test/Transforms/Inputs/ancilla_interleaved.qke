// Candidate for unitary_builder_ancilla_projection.qke. The ancilla sits
// between two of the kernel's own qubits, so it is neither the first nor the
// last index: %c0 -> 0, %anc -> 1, %c1 -> 2, %c2 -> 3, %t -> 4. It is computed
// and then uncomputed, so it is returned clean.
func.func @ccc_x() {
  %c0 = quake.alloca !quake.ref
  %anc = quake.alloca !quake.ref {quake.ancilla}
  %c1 = quake.alloca !quake.ref
  %c2 = quake.alloca !quake.ref
  %t = quake.alloca !quake.ref
  quake.x [%c0, %c1] %anc : (!quake.ref, !quake.ref, !quake.ref) -> ()
  quake.x [%c2, %anc] %t : (!quake.ref, !quake.ref, !quake.ref) -> ()
  quake.x [%c0, %c1] %anc : (!quake.ref, !quake.ref, !quake.ref) -> ()
  return
}
