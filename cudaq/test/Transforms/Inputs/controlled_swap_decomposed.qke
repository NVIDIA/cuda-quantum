// Baseline for unitary_builder_controlled_swap.qke: the same three kernels,
// written with single-target gates only. Those take the single-qubit and
// controlled paths through the unitary builder rather than the multi-target
// one, so agreement between the two files pins the multi-target path down.

func.func @swap_no_controls(%a: !quake.ref, %b: !quake.ref) {
  quake.x [%a] %b : (!quake.ref, !quake.ref) -> ()
  quake.x [%b] %a : (!quake.ref, !quake.ref) -> ()
  quake.x [%a] %b : (!quake.ref, !quake.ref) -> ()
  return
}

func.func @swap_one_control(%c: !quake.ref, %a: !quake.ref, %b: !quake.ref) {
  quake.x [%b] %a : (!quake.ref, !quake.ref) -> ()
  quake.x [%c, %a] %b : (!quake.ref, !quake.ref, !quake.ref) -> ()
  quake.x [%b] %a : (!quake.ref, !quake.ref) -> ()
  return
}

func.func @swap_two_controls(%c0: !quake.ref, %c1: !quake.ref, %a: !quake.ref,
                             %b: !quake.ref) {
  quake.x [%b] %a : (!quake.ref, !quake.ref) -> ()
  quake.x [%c0, %c1, %a] %b : (!quake.ref, !quake.ref, !quake.ref, !quake.ref) -> ()
  quake.x [%b] %a : (!quake.ref, !quake.ref) -> ()
  return
}
