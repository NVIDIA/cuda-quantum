// Candidate for unitary_builder_ancilla_projection.qke, identical to
// Inputs/ancilla_interleaved.qke except that the ancilla is never uncomputed.
// The operator is then not block diagonal in the ancilla index, so the ancilla
// cannot be projected out at all.
func.func @ccc_x() {
  %c0 = quake.alloca !quake.ref
  %anc = quake.alloca !quake.ref {quake.ancilla}
  %c1 = quake.alloca !quake.ref
  %c2 = quake.alloca !quake.ref
  %t = quake.alloca !quake.ref
  quake.x [%c0, %c1] %anc : (!quake.ref, !quake.ref, !quake.ref) -> ()
  quake.x [%c2, %anc] %t : (!quake.ref, !quake.ref, !quake.ref) -> ()
  return
}
