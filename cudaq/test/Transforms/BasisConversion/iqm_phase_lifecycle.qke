// The first IQM mapping may leave phase bookkeeping. Lower it before the final
// mapping so that LowerPhase's R1/Rz output is converted to IQM native gates.
// RUN: cudaq-opt -pass-pipeline='builtin.module(jit-deploy-pipeline,iqm-gate-set-mapping,func.func(cse,normalize-phase-placement,lower-phase,canonicalize),iqm-gate-set-mapping,verify-no-phase)' %s | FileCheck %s --implicit-check-not='quake.phase (' --implicit-check-not='quake.r1 (' --implicit-check-not='quake.rz ('

module {
  func.func @u3_iqm() attributes {"cudaq-entrypoint"} {
    %theta = arith.constant 0.000000e+00 : f64
    %phi = arith.constant 1.5707963267948966 : f64
    %lambda = arith.constant 3.1415926535897931 : f64
    %q = quake.alloca !quake.ref
    quake.u3 (%theta, %phi, %lambda) %q
        : (f64, f64, f64, !quake.ref) -> ()
    return
  }
}

// CHECK-LABEL: func.func @u3_iqm()
// CHECK: quake.phased_rx
// CHECK: return
