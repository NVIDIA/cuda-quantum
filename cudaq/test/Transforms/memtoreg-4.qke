// CHECK:               %[[VAL_18:.*]] = quake.discriminate %[[VAL_118]] :
// CHECK:               %[[VAL_20:.*]] = cc.undef i1
// CHECK:               cf.br ^bb1(%[[VAL_11]] : i64)
