// CHECK-SAME:                  %[[VAL_0:.*]]: !quake.veq<?>) {
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : i64
// CHECK:           %[[VAL_2:.*]] = arith.constant 10 : i64
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = cc.undef i64
// CHECK:           cc.scope {
