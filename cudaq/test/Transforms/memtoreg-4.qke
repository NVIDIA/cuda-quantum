// CHECK:               %[[VAL_25:.*]] = arith.addi %[[VAL_23]], %[[VAL_3]] : i64
// CHECK:               cc.continue %[[VAL_25]] : i64
// CHECK:             }
// CHECK:           }
// CHECK:           return
