// Regression for a crash where a memAnalysis-eliminated (non-escaping)
// alloca (%3, destined to become a null wire) was passed as a control
// operand of a gate inside a dynamically-aliased loop. The pass must not
// keep a permanent, literal dereference of such an alloca alive (it is
// erased at the end of the pass), nor must it lose track of the alloca's
// binding across an op that gets rebuilt (with extra results) to carry a
// live-out value past a nested op-with-regions' own aliasing summary.
func.func @control_operand_alias(%arg0: i64) {
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %0 = quake.alloca !quake.ref
  %1 = quake.alloca !quake.ref
  %2 = quake.concat %0, %1 : (!quake.ref, !quake.ref) -> !quake.veq<2>
  %3 = quake.alloca !quake.ref
  %4 = cc.loop while ((%arg1 = %c0_i64) -> (i64)) {
    %5 = arith.cmpi slt, %arg1, %arg0 : i64
    cc.condition %5(%arg1 : i64)
  } do {
  ^bb0(%arg1: i64):
    %5 = quake.extract_ref %2[%arg1] : (!quake.veq<2>, i64) -> !quake.ref
    quake.x [%3] %5 : (!quake.ref, !quake.ref) -> ()
    cc.continue %arg1 : i64
  } step {
  ^bb0(%arg1: i64):
    %5 = arith.addi %arg1, %c1_i64 : i64
    cc.continue %5 : i64
  } {normalized}
  quake.log_output %2 : (!quake.veq<2>) -> () {compilerGenerated}
  quake.log_output %3 : (!quake.ref) -> () {compilerGenerated}
  quake.dealloc %3 : !quake.ref
  quake.dealloc %0 : !quake.ref
  quake.dealloc %1 : !quake.ref
  return
}

