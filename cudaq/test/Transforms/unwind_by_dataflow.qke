// RUN: cudaq-opt --unwind-by-dataflow --canonicalize %s | \
// RUN:   FileCheck --implicit-check-not=cc.unwind %s

func.func @__nvqpp__mlirgen__function_1(%arg0: i1) {
  %c4_i64 = arith.constant 4 : i64
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %0 = cc.alloca i1
  cc.store %arg0, %0 : !cc.ptr<i1>
  %1 = quake.alloca !quake.veq<4>
  %2 = cc.load %0 : !cc.ptr<i1>
  cc.if(%2) {
    cc.unwind_return
  }
  quake.x %1 : (!quake.veq<4>) -> ()
  return
}

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__function_1(
// CHECK-DAG:       %[[CONSTANT_1:.*]] = arith.constant 4 : i8
// CHECK-DAG:       %[[CONSTANT_0:.*]] = arith.constant 0 : i8
// CHECK-DAG:       %[[ALLOCA_0:.*]] = cc.alloca i8
// CHECK:           cc.if(%{{.*}}) {
// CHECK:             cc.store %[[CONSTANT_1]], %[[ALLOCA_0]] : !cc.ptr<i8>
// CHECK:           }
// CHECK:           %[[LOAD_1:.*]] = cc.load %[[ALLOCA_0]] : !cc.ptr<i8>
// CHECK:           %[[CMPI_0:.*]] = arith.cmpi eq, %[[LOAD_1]], %[[CONSTANT_0]] : i8
// CHECK:           cc.if(%[[CMPI_0]]) {
// CHECK:             quake.x %{{.*}} : (!quake.veq<4>) -> ()
// CHECK:           }
// CHECK:           return

func.func @__nvqpp__mlirgen__function_2(%arg0: i1, %arg1: i32, %arg2: i32) {
  %c1_i32 = arith.constant 1 : i32
  %c0_i32 = arith.constant 0 : i32
  %c4_i32 = arith.constant 4 : i32
  %0 = cc.alloca i1
  cc.store %arg0, %0 : !cc.ptr<i1>
  %1 = cc.alloca i32
  cc.store %arg1, %1 : !cc.ptr<i32>
  %2 = cc.alloca i32
  cc.store %arg2, %2 : !cc.ptr<i32>
  %3 = quake.alloca !quake.veq<4>
  cc.scope {
    %4 = cc.load %1 : !cc.ptr<i32>
    %5 = cc.alloca i32
    cc.store %4, %5 : !cc.ptr<i32>
    cc.loop while {
      %6 = cc.load %5 : !cc.ptr<i32>
      %7 = cc.load %2 : !cc.ptr<i32>
      %8 = arith.cmpi ne, %6, %7 : i32
      cc.condition %8
    } do {
      %6 = cc.load %5 : !cc.ptr<i32>
      %7 = arith.cmpi slt, %6, %c0_i32 : i32
      cc.if(%7) {
        cc.unwind_continue
      }
      %8 = cc.load %5 : !cc.ptr<i32>
      %9 = arith.cmpi sge, %8, %c4_i32 : i32
      cc.if(%9) {
        cc.unwind_break
      }
      %10 = cc.load %5 : !cc.ptr<i32>
      %11 = cc.cast signed %10 : (i32) -> i64
      %12 = quake.extract_ref %3[%11] : (!quake.veq<4>, i64) -> !quake.ref
      quake.x %12 : (!quake.ref) -> ()
      cc.continue
    } step {
      %6 = cc.load %5 : !cc.ptr<i32>
      %7 = arith.addi %6, %c1_i32 : i32
      cc.store %7, %5 : !cc.ptr<i32>
    }
  }
  return
}

