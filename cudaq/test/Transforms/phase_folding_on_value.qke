// RUN: cudaq-opt --phase-folding="use-wire-semantics min-length=0 min-rz-weight=0" %s | FileCheck %s

// Two rotations that share the same phase term across a pair of CNOTs are
// merged into a single rotation whose angle is the sum of the two.

func.func @merge_across_cnots(%angle: f64) {
  %w0 = quake.null_wire
  %w1 = quake.null_wire
  %0 = quake.rz (%angle) %w1 : (f64, !quake.wire) -> !quake.wire
  %1:2 = quake.x [%w0] %0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %2 = quake.rz (%angle) %1#1 : (f64, !quake.wire) -> !quake.wire
  %3:2 = quake.x [%1#0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4 = quake.rz (%angle) %3#0 : (f64, !quake.wire) -> !quake.wire
  %5 = quake.rz (%angle) %3#1 : (f64, !quake.wire) -> !quake.wire
  %6:2 = quake.x [%5] %4 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  return
}

// CHECK-LABEL:   func.func @merge_across_cnots(
// CHECK-SAME:                                  %[[VAL_0:.*]]: f64) {
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]] = quake.null_wire
// CHECK:           %[[VAL_3:.*]]:2 = quake.x {{\[}}%[[VAL_1]]] %[[VAL_2]] :
// CHECK:           %[[VAL_4:.*]] = quake.rz (%[[VAL_0]]) %[[VAL_3]]#1 :
// CHECK:           %[[VAL_5:.*]]:2 = quake.x {{\[}}%[[VAL_3]]#0] %[[VAL_4]] :
// CHECK:           %[[VAL_6:.*]] = quake.rz (%[[VAL_0]]) %[[VAL_5]]#0 :
// CHECK:           %[[VAL_7:.*]] = arith.addf %[[VAL_0]], %[[VAL_0]] : f64
// CHECK:           %[[VAL_8:.*]] = quake.rz (%[[VAL_7]]) %[[VAL_5]]#1 :
// CHECK:           %[[VAL_9:.*]]:2 = quake.x {{\[}}%[[VAL_8]]] %[[VAL_6]] :
// CHECK:           return
// CHECK:         }

// A swap exchanges the phases carried by the two wires, so rotations on either
// side of it are still recognized as sharing a phase term and merged.

func.func @swap_case(%a: f64, %b: f64) {
  %w0 = quake.null_wire
  %w1 = quake.null_wire
  %w2 = quake.null_wire
  %0 = quake.rz (%a) %w2 : (f64, !quake.wire) -> !quake.wire
  %1:2 = quake.x [%w0] %0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %2:2 = quake.swap %1#0, %w1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.x [%2#1] %1#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4 = quake.rz (%b) %3#1 : (f64, !quake.wire) -> !quake.wire
  return
}

// CHECK-LABEL:   func.func @swap_case(
// CHECK-SAME:                         %[[VAL_0:.*]]: f64,
// CHECK-SAME:                         %[[VAL_1:.*]]: f64) {
// CHECK:           %[[VAL_2:.*]] = quake.null_wire
// CHECK:           %[[VAL_3:.*]] = quake.null_wire
// CHECK:           %[[VAL_4:.*]] = quake.null_wire
// CHECK:           %[[VAL_5:.*]]:2 = quake.x {{\[}}%[[VAL_2]]] %[[VAL_4]] :
// CHECK:           %[[VAL_6:.*]]:2 = quake.swap %[[VAL_5]]#0, %[[VAL_3]] :
// CHECK:           %[[VAL_7:.*]]:2 = quake.x {{\[}}%[[VAL_6]]#1] %[[VAL_5]]#1 :
// CHECK:           %[[VAL_8:.*]] = arith.addf %[[VAL_0]], %[[VAL_1]] : f64
// CHECK:           %[[VAL_9:.*]] = quake.rz (%[[VAL_8]]) %[[VAL_7]]#1 :
// CHECK:           return
// CHECK:         }

// A `ry` is a circuit breaker: it ends the subcircuit, so the CNOT whose control
// wire originates past it lies outside the subcircuit and the lone `rz` has
// nothing to merge with. The IR is left unchanged.

func.func @ry_breaker(%a: f64) {
  %w0 = quake.null_wire
  %w1 = quake.null_wire
  %0:2 = quake.x [%w0] %w1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %1 = quake.ry (%a) %0#0 : (f64, !quake.wire) -> !quake.wire
  %2 = quake.rz (%a) %0#1 : (f64, !quake.wire) -> !quake.wire
  %3:2 = quake.x [%1] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  return
}

// CHECK-LABEL:   func.func @ry_breaker(
// CHECK-SAME:                          %[[VAL_0:.*]]: f64) {
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]] = quake.null_wire
// CHECK:           %[[VAL_3:.*]]:2 = quake.x {{\[}}%[[VAL_1]]] %[[VAL_2]] :
// CHECK:           %[[VAL_4:.*]] = quake.ry (%[[VAL_0]]) %[[VAL_3]]#0 :
// CHECK:           %[[VAL_5:.*]] = quake.rz (%[[VAL_0]]) %[[VAL_3]]#1 :
// CHECK:           %[[VAL_6:.*]]:2 = quake.x {{\[}}%[[VAL_4]]] %[[VAL_5]] :
// CHECK:           return
// CHECK:         }
