// RUN: cudaq-opt --add-wireset --assign-wire-indices %s | FileCheck %s

// A bodyless callee threads its wires straight back out, so the pass runs.

func.func private @__qm__wait_function(!quake.ref, f64)
func.func private @some_classical(f64)

func.func @external_callee(%arg0: f64) attributes {"cudaq-entrypoint"} {
  %0 = quake.null_wire
  func.call @some_classical(%arg0) : (f64) -> ()
  %1 = quake.call_by_ref @__qm__wait_function(%0, %arg0) : (!quake.wire, f64) -> !quake.wire
  quake.sink %1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @external_callee(
// CHECK:           %[[VAL_1:.*]] = quake.borrow_wire @wires[0] : !quake.wire
// CHECK:           %[[VAL_2:.*]] = quake.call_by_ref @__qm__wait_function(%[[VAL_1]], %{{.*}}) : (!quake.wire, f64) -> !quake.wire
// CHECK:           quake.return_wire %[[VAL_2]] : !quake.wire

// A callee with a body threads wires across a function boundary, so the pass
// declines.

func.func @defined_callee(%q: !quake.ref, %d: f64) attributes {"cudaq-kernel"} {
  return
}

func.func @calls_defined_kernel(%arg0: f64) attributes {"cudaq-entrypoint"} {
  %0 = quake.null_wire
  func.call @some_classical(%arg0) : (f64) -> ()
  %1 = quake.call_by_ref @defined_callee(%0, %arg0) : (!quake.wire, f64) -> !quake.wire
  quake.sink %1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @calls_defined_kernel(
// CHECK:           %[[VAL_3:.*]] = quake.null_wire
// CHECK:           quake.sink
