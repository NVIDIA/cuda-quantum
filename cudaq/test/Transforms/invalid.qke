// quake.apply verification errors

func.func private @takes_one(i32)

%1 = arith.constant 4 : i32
%2 = arith.constant 5 : i32
// expected-error@+1 {{hidden argument must be callable}}
quake.apply @takes_one %1, %2 : (i32, i32) -> ()

