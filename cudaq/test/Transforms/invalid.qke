// expected-error@+1 {{callee must be declared}}
quake.apply @error : () -> ()

// -----

%1 = arith.constant 0 : i32
%2 = arith.constant 1 : i32
// expected-error@+1 {{expected ':'}}
quake.apply %1, %2 : (i32, i32) -> ()

// -----

func.func private @wonk(i32, i32)

%1 = arith.constant 4 : i32
// expected-error@+1 {{number of arguments must be consistent}}
quake.apply @wonk %1 : (i32) -> ()

// -----

func.func private @wonk(i32, i32)

%1 = arith.constant 4 : i32
%2 = quake.alloca !quake.veq<18>
// expected-error@+1 {{number of arguments must be consistent}}
quake.apply @wonk [%2] %1 : (!quake.veq<18>, i32) -> ()

// -----

func.func private @wonk(!quake.veq<2>, i32)

%1 = arith.constant 4 : i32
%2 = quake.alloca !quake.veq<18>
// expected-error@+1 {{argument types must match}}
quake.apply @wonk %2, %1 : (!quake.veq<18>, i32) -> ()

// -----

func.func private @wonk(!quake.veq<18>, i32) -> f64

%1 = arith.constant 4 : i32
%2 = quake.alloca !quake.veq<18>
// expected-error@+1 {{result types must match}}
%3 = quake.apply @wonk %2, %1 : (!quake.veq<18>, i32) -> i8

// -----

// expected-error@+1 {{cannot classically allocate quake abstract type}}
%0 = cc.alloca !quake.measure

// -----

func.func @mz_handle_register_scalar_result(%v: !quake.veq<?>) {
  // expected-error@+1 {{must return `!cc.sequence<!quake.measure>` or `!cc.sequence<!cc.measure_handle>`}}
  %m = quake.mz %v : (!quake.veq<?>) -> !cc.measure_handle
  return
}

