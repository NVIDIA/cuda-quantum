func.func @test_extract_ref_out_of_bounds(%v: !quake.veq<2>) {
  // expected-error@+1 {{invalid index [4] because >= size [2]}}
  %0 = quake.extract_ref %v[4] : (!quake.veq<2>) -> !quake.ref
  return
