func.func @test_exp_pauli_two_parameters(%theta: f64) {
  %q = quake.alloca !quake.veq<2>
  // expected-error@+1 {{can only have 0 or 1 parameter}}
  quake.exp_pauli (%theta, %theta) %q to "XY" : (f64, f64, !quake.veq<2>) -> ()
