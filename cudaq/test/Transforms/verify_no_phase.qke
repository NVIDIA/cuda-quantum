// RUN: cudaq-opt --verify-no-phase %s -verify-diagnostics

func.func @phase_reached_codegen(%theta: f64, %anchor: !quake.ref) {
  // expected-error @+1 {{phase bookkeeping must be lowered before code generation}}
  quake.phase (%theta) %anchor : (f64, !quake.ref) -> ()
  return
}