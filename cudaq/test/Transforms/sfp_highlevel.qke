// RUN: cudaq-opt --stack-frame-prealloc %s | FileCheck %s

// stack-frame-prealloc must be able to run over IR that still has high-level
// control flow (cc.scope, cc.if, cc.loop) present, rather than requiring it
// to have already been lowered to a plain CFG. cc.scope/cc.if act as region
// fences (an alternative, structural form of the stacksave/stackrestore-pair
// fencing this pass recognizes for lowered CFG form -- see sfp.qke);
// cc.loop is a loop boundary in its own right, exactly like a strongly
// connected component of a lowered CFG.

// A cc.alloca directly inside a cc.scope that is itself directly inside a
// cc.loop's `do` region is properly fenced: the scope resets per iteration,
// so it is safe to preallocate the alloca once, at the function's entry.
func.func @loop_scope_fenced(%n: i32) {
  %c1 = arith.constant 1 : i32
  %c0 = arith.constant 0 : i32
  %i = cc.alloca i32
  cc.store %c0, %i : !cc.ptr<i32>
  cc.loop while {
    %iv = cc.load %i : !cc.ptr<i32>
    %cond = arith.cmpi ult, %iv, %n : i32
    cc.condition %cond
  } do {
    cc.scope {
      %x = cc.alloca i32
      cc.store %c1, %x : !cc.ptr<i32>
    }
    cc.continue
  } step {
    %iv = cc.load %i : !cc.ptr<i32>
    %inc = arith.addi %iv, %c1 : i32
    cc.store %inc, %i : !cc.ptr<i32>
  }
  return
}

// CHECK-LABEL:   func.func @loop_scope_fenced(
// CHECK:           %[[I:.*]] = cc.alloca i32
// CHECK:           %[[X:.*]] = cc.alloca i32
// CHECK:           cc.loop while {
// CHECK:           } do {
// CHECK:             cc.scope {
// CHECK-NOT:           cc.alloca
// CHECK:               cc.store %{{.*}}, %[[X]] : !cc.ptr<i32>
// CHECK:             }
// CHECK:           } step {

// A cc.alloca directly inside a cc.scope that is itself directly inside a
// cc.if's then-region is properly fenced the same way (cc.if is also
// single-entry/single-exit: its region runs at most once).
func.func @if_scope_fenced(%b: i1) {
  %c1 = arith.constant 1 : i32
  cc.if(%b) {
    cc.scope {
      %x = cc.alloca i32
      cc.store %c1, %x : !cc.ptr<i32>
    }
    cc.continue
  }
  return
}

// CHECK-LABEL:   func.func @if_scope_fenced(
// CHECK:           %[[X:.*]] = cc.alloca i32
// CHECK:           cc.if(%{{.*}}) {
// CHECK:             cc.scope {
// CHECK-NOT:           cc.alloca
// CHECK:               cc.store %{{.*}}, %[[X]] : !cc.ptr<i32>
// CHECK:             }

// The fencing cc.scope need not be the *direct* child of the enclosing
// cc.loop: it is reached here through an intervening cc.if. Fencing is
// determined by structural containment (the scope is nested somewhere
// inside the loop's repeating `do` region and itself contains the alloca),
// not by requiring the scope to be the loop's immediate child.
func.func @loop_if_scope_fenced(%n: i32, %b: i1) {
  %c1 = arith.constant 1 : i32
  %c0 = arith.constant 0 : i32
  %i = cc.alloca i32
  cc.store %c0, %i : !cc.ptr<i32>
  cc.loop while {
    %iv = cc.load %i : !cc.ptr<i32>
    %cond = arith.cmpi ult, %iv, %n : i32
    cc.condition %cond
  } do {
    cc.if(%b) {
      cc.scope {
        %x = cc.alloca i32
        cc.store %c1, %x : !cc.ptr<i32>
      }
      cc.continue
    }
    cc.continue
  } step {
    %iv = cc.load %i : !cc.ptr<i32>
    %inc = arith.addi %iv, %c1 : i32
    cc.store %inc, %i : !cc.ptr<i32>
  }
  return
}

// CHECK-LABEL:   func.func @loop_if_scope_fenced(
// CHECK:           %[[I:.*]] = cc.alloca i32
// CHECK:           %[[X:.*]] = cc.alloca i32
// CHECK:           cc.loop while {
// CHECK:           } do {
// CHECK:             cc.if(%{{.*}}) {
// CHECK:               cc.scope {
// CHECK-NOT:             cc.alloca
// CHECK:                 cc.store %{{.*}}, %[[X]] : !cc.ptr<i32>
// CHECK:               }
// CHECK:             }
// CHECK:           } step {

// A cc.create_lambda's body is an entirely separate allocation scope: it may
// be invoked any number of times, on its own schedule, independent of the
// enclosing function. Its cc.alloca ops are hoisted (if safe) to the
// lambda's *own* entry, never into the enclosing func.func.
func.func @lambda_selfcontained(%b: i1) {
  %c1 = arith.constant 1 : i32
  %lam = cc.create_lambda {
    cc.scope {
      %x = cc.alloca i32
      cc.store %c1, %x : !cc.ptr<i32>
    }
    cc.return
  } : !cc.callable<() -> ()>
  return
}

// CHECK-LABEL:   func.func @lambda_selfcontained(
// CHECK:           %[[LAM:.*]] = cc.create_lambda {
// CHECK:             %[[X:.*]] = cc.alloca i32
// CHECK:             cc.scope {
// CHECK-NOT:           cc.alloca
// CHECK:               cc.store %{{.*}}, %[[X]] : !cc.ptr<i32>
// CHECK:             }
// CHECK:             cc.return
// CHECK:           }
