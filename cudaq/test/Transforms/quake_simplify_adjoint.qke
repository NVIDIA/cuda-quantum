// CHECK-LABEL:   func.func @combine_sdg_sdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.z %[[VAL_0]] : (!quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @track_controlled_ysx() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.y [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.x [%3#0] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %4#0 : !quake.wire
  quake.sink %4#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @track_controlled_ysx() {
// CHECK:           %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]]:2 = quake.s {{\[}}%[[VAL_0]]] %[[VAL_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK-NEXT:      %[[PHASE:.*]]:2 = quake.phase (%[[PI]]) {{\[}}%[[S]]#0] %[[S]]#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK-NEXT:      quake.sink %[[PHASE]]#0 : !quake.wire
// CHECK-NEXT:      quake.sink %[[PHASE]]#1 : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// LOWER-LABEL:   func.func @track_controlled_ysx() {
// LOWER:           quake.s
// LOWER:           quake.r1

// The required pi correction adds -1 only when the control is |1>.
// Without it, the result differs by Z on the control wire. The surrounding
// H gates transform that difference into X (H Z H = X), which CircuitCheck
// can observe.
func.func @controlled_ysx_interference() {
  %control = quake.null_wire
  %target = quake.null_wire
  %h0 = quake.h %control : (!quake.wire) -> !quake.wire
  %y:2 = quake.y [%h0] %target
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %s:2 = quake.s [%y#0] %y#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x:2 = quake.x [%s#0] %s#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %h1 = quake.h %x#0 : (!quake.wire) -> !quake.wire
  quake.sink %h1 : !quake.wire
  quake.sink %x#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @controlled_ysx_interference() {
// CHECK:           quake.h
// CHECK:           quake.s
// CHECK:           quake.phase
// CHECK:           quake.h
// CHECK-NEXT:      quake.sink

func.func @cancel_controlled_t_tdg() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.t [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.t<adj> [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %3#0 : !quake.wire
  quake.sink %3#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_controlled_t_tdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @cancel_controlled_s_sdg() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.s [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s<adj> [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %3#0 : !quake.wire
  quake.sink %3#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_controlled_s_sdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// X S^dagger Y is exactly S^dagger and needs no correction.
func.func @reduce_ysdgx_exact() {
  %0 = quake.null_wire
  %1 = quake.y %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s<adj> %1 : (!quake.wire) -> !quake.wire
  %3 = quake.x %2 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @reduce_ysdgx_exact() {
// CHECK:           %[[Q:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]] = quake.s<adj> %[[Q]] : (!quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[S]] : !quake.wire
// CHECK-NOT:       quake.phase
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// A negative source predicate must be copied to both the replacement and the
// phase correction.
func.func @track_negative_controlled_ysx() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.y [%0 neg [true]] %1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s [%2#0 neg [true]] %2#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.x [%3#0 neg [true]] %3#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %4#0 : !quake.wire
  quake.sink %4#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @track_negative_controlled_ysx() {
// CHECK:           %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK:           %[[CONTROL:.*]] = quake.null_wire
// CHECK-NEXT:      %[[TARGET:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]]:2 = quake.s {{\[}}%[[CONTROL]] neg [true]{{\]}} %[[TARGET]]
// CHECK-NEXT:      %[[PHASE:.*]]:2 = quake.phase (%[[PI]]) {{\[}}%[[S]]#0 neg [true]{{\]}} %[[S]]#1
// CHECK-NEXT:      quake.sink %[[PHASE]]#0 : !quake.wire
// CHECK-NEXT:      quake.sink %[[PHASE]]#1 : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @erase_zero_phased_rx() {
  %theta = arith.constant 0.0 : f64
  %phi = arith.constant 0.25 : f64
  %0 = quake.null_wire
  %1 = quake.phased_rx (%theta, %phi) %0 : (f64, f64, !quake.wire) -> !quake.wire
  %2 = quake.null_wire
  %3 = quake.phased_rx<adj> (%theta, %phi) %2 : (f64, f64, !quake.wire) -> !quake.wire
  %4 = quake.null_wire
  %5 = quake.null_wire
  %6:2 = quake.phased_rx (%theta, %phi) [%4 neg [true]] %5 : (f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %1 : !quake.wire
  quake.sink %3 : !quake.wire
  quake.sink %6#0 : !quake.wire
  quake.sink %6#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @erase_zero_phased_rx() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_2:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_3:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_2]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_3]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @combine_phased_rx_same_axis() {
  %theta0 = arith.constant 1.0 : f64
  %theta1 = arith.constant 0.25 : f64
  %phi0 = arith.constant 0.5 : f64
  %phi1 = arith.constant 0.5 : f64
  %0 = quake.null_wire
  %1 = quake.phased_rx (%theta0, %phi0) %0 : (f64, f64, !quake.wire) -> !quake.wire
  %2 = quake.phased_rx<adj> (%theta1, %phi1) %1 : (f64, f64, !quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @combine_phased_rx_same_axis() {
// CHECK:           %[[THETA:.*]] = arith.constant 7.500000e-01 : f64
// CHECK:           %[[PHI:.*]] = arith.constant 5.000000e-01 : f64
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.phased_rx (%[[THETA]], %[[PHI]]) %[[VAL_0]] : (f64, f64, !quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @preserve_phased_rx_different_axes() {
  %theta0 = arith.constant 1.0 : f64
  %theta1 = arith.constant 0.25 : f64
  %phi0 = arith.constant 0.5 : f64
  %phi1 = arith.constant 0.75 : f64
  %0 = quake.null_wire
  %1 = quake.phased_rx (%theta0, %phi0) %0 : (f64, f64, !quake.wire) -> !quake.wire
  %2 = quake.phased_rx (%theta1, %phi1) %1 : (f64, f64, !quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @preserve_phased_rx_different_axes() {
// CHECK:           %[[THETA0:.*]] = arith.constant 1.000000e+00 : f64
// CHECK:           %[[THETA1:.*]] = arith.constant 2.500000e-01 : f64
// CHECK:           %[[PHI0:.*]] = arith.constant 5.000000e-01 : f64
// CHECK:           %[[PHI1:.*]] = arith.constant 7.500000e-01 : f64
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.phased_rx (%[[THETA0]], %[[PHI0]]) %[[VAL_0]] : (f64, f64, !quake.wire) -> !quake.wire
// CHECK-NEXT:      %[[VAL_2:.*]] = quake.phased_rx (%[[THETA1]], %[[PHI1]]) %[[VAL_1]] : (f64, f64, !quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_2]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }
