func.func @combine_sdg_sdg() {
  %0 = quake.null_wire
  %1 = quake.s<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s<adj> %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
