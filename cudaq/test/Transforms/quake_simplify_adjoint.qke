// RUN: cudaq-opt --quake-simplify %s | FileCheck %s
// RUN: cudaq-opt --quake-simplify %s | CircuitCheck %s
// RUN: cudaq-opt -pass-pipeline='builtin.module(func.func(quake-simplify,normalize-phase-placement,lower-phase,canonicalize))' %s | FileCheck %s --check-prefix=LOWER --implicit-check-not='quake.phase ('
// RUN: cudaq-opt -pass-pipeline='builtin.module(func.func(quake-simplify,normalize-phase-placement,lower-phase,canonicalize))' %s | CircuitCheck %s

// CircuitCheck uses strict unitary equivalence in this file to detect both
// global and relative phase changes.

func.func @cancel_t_tdg() {
  %0 = quake.null_wire
  %1 = quake.t %0 : (!quake.wire) -> !quake.wire
  %2 = quake.t<adj> %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_t_tdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @cancel_tdg_t() {
  %0 = quake.null_wire
  %1 = quake.t<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.t %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_tdg_t() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @combine_tdg_tdg() {
  %0 = quake.null_wire
  %1 = quake.t<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.t<adj> %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @combine_tdg_tdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.s<adj> %[[VAL_0]] : (!quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @cancel_s_sdg() {
  %0 = quake.null_wire
  %1 = quake.s %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s<adj> %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_s_sdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @cancel_sdg_s() {
  %0 = quake.null_wire
  %1 = quake.s<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_sdg_s() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @combine_sdg_sdg() {
  %0 = quake.null_wire
  %1 = quake.s<adj> %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s<adj> %1 : (!quake.wire) -> !quake.wire
  quake.sink %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @combine_sdg_sdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.z %[[VAL_0]] : (!quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @track_controlled_ysx() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.y [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.x [%3#0] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %4#0 : !quake.wire
  quake.sink %4#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @track_controlled_ysx() {
// CHECK:           %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]]:2 = quake.s {{\[}}%[[VAL_0]]] %[[VAL_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK-NEXT:      %[[PHASE:.*]]:2 = quake.phase (%[[PI]]) {{\[}}%[[S]]#0] %[[S]]#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK-NEXT:      quake.sink %[[PHASE]]#0 : !quake.wire
// CHECK-NEXT:      quake.sink %[[PHASE]]#1 : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// LOWER-LABEL:   func.func @track_controlled_ysx() {
// LOWER:           quake.s
// LOWER:           quake.r1

// The required pi correction adds -1 only when the control is |1>.
// Without it, the result differs by Z on the control wire. The surrounding
// H gates transform that difference into X (H Z H = X), which CircuitCheck
// can observe.
func.func @controlled_ysx_interference() {
  %control = quake.null_wire
  %target = quake.null_wire
  %h0 = quake.h %control : (!quake.wire) -> !quake.wire
  %y:2 = quake.y [%h0] %target
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %s:2 = quake.s [%y#0] %y#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x:2 = quake.x [%s#0] %s#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %h1 = quake.h %x#0 : (!quake.wire) -> !quake.wire
  quake.sink %h1 : !quake.wire
  quake.sink %x#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @controlled_ysx_interference() {
// CHECK:           quake.h
// CHECK:           quake.s
// CHECK:           quake.phase
// CHECK:           quake.h
// CHECK-NEXT:      quake.sink

// Reference-form rotations on the threaded qubits block both intervals in the
// Y/S/X fold.
func.func @preserve_ysx_across_reference_aliases() {
  %angle = arith.constant 3.750000e-01 : f64
  %reference0 = quake.alloca !quake.ref
  %reference1 = quake.alloca !quake.ref
  %wire0 = quake.unwrap %reference0 : (!quake.ref) -> !quake.wire
  %wire1 = quake.unwrap %reference1 : (!quake.ref) -> !quake.wire
  %y0 = quake.y %wire0 : (!quake.wire) -> !quake.wire
  quake.rx (%angle) %reference0 : (f64, !quake.ref) -> ()
  %s0 = quake.s %y0 : (!quake.wire) -> !quake.wire
  %x0 = quake.x %s0 : (!quake.wire) -> !quake.wire
  %y1 = quake.y %wire1 : (!quake.wire) -> !quake.wire
  %s1 = quake.s %y1 : (!quake.wire) -> !quake.wire
  quake.rx (%angle) %reference1 : (f64, !quake.ref) -> ()
  %x1 = quake.x %s1 : (!quake.wire) -> !quake.wire
  quake.wrap %x0 to %reference0 : !quake.wire, !quake.ref
  quake.wrap %x1 to %reference1 : !quake.wire, !quake.ref
  return
}

// CHECK-LABEL:   func.func @preserve_ysx_across_reference_aliases() {
// CHECK:           %[[ANGLE:.*]] = arith.constant 3.750000e-01 : f64
// CHECK-NEXT:      %[[REFERENCE0:.*]] = quake.alloca !quake.ref
// CHECK-NEXT:      %[[REFERENCE1:.*]] = quake.alloca !quake.ref
// CHECK-NEXT:      %[[WIRE0:.*]] = quake.unwrap %[[REFERENCE0]]
// CHECK-NEXT:      %[[WIRE1:.*]] = quake.unwrap %[[REFERENCE1]]
// CHECK-NEXT:      %[[Y0:.*]] = quake.y %[[WIRE0]]
// CHECK-NEXT:      quake.rx (%[[ANGLE]]) %[[REFERENCE0]]
// CHECK-NEXT:      %[[S0:.*]] = quake.s %[[Y0]]
// CHECK-NEXT:      %[[X0:.*]] = quake.x %[[S0]]
// CHECK-NEXT:      %[[Y1:.*]] = quake.y %[[WIRE1]]
// CHECK-NEXT:      %[[S1:.*]] = quake.s %[[Y1]]
// CHECK-NEXT:      quake.rx (%[[ANGLE]]) %[[REFERENCE1]]
// CHECK-NEXT:      %[[X1:.*]] = quake.x %[[S1]]
// CHECK-NEXT:      quake.wrap %[[X0]] to %[[REFERENCE0]]
// CHECK-NEXT:      quake.wrap %[[X1]] to %[[REFERENCE1]]
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @cancel_controlled_t_tdg() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.t [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.t<adj> [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %3#0 : !quake.wire
  quake.sink %3#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_controlled_t_tdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @cancel_controlled_s_sdg() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.s [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s<adj> [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %3#0 : !quake.wire
  quake.sink %3#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @cancel_controlled_s_sdg() {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.null_wire
// CHECK-NEXT:      quake.sink %[[VAL_0]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[VAL_1]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// X S^dagger Y is exactly S^dagger and needs no correction.
func.func @reduce_ysdgx_exact() {
  %0 = quake.null_wire
  %1 = quake.y %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s<adj> %1 : (!quake.wire) -> !quake.wire
  %3 = quake.x %2 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @reduce_ysdgx_exact() {
// CHECK:           %[[Q:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]] = quake.s<adj> %[[Q]] : (!quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[S]] : !quake.wire
// CHECK-NOT:       quake.phase
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// Reusable controls have no wire result. They may be mixed with linear controls
// without changing the ordered predicate or target threading.
func.func @reduce_ysdgx_mixed_controls() {
  %reusableWire = quake.null_wire
  %reusable = quake.to_ctrl %reusableWire : (!quake.wire) -> !quake.control
  %linearControl = quake.null_wire
  %target = quake.null_wire
  %y:2 = quake.y [%reusable, %linearControl] %target
      : (!quake.control, !quake.wire, !quake.wire)
        -> (!quake.wire, !quake.wire)
  %s:2 = quake.s<adj> [%reusable, %y#0] %y#1
      : (!quake.control, !quake.wire, !quake.wire)
        -> (!quake.wire, !quake.wire)
  %x:2 = quake.x [%reusable, %s#0] %s#1
      : (!quake.control, !quake.wire, !quake.wire)
        -> (!quake.wire, !quake.wire)
  %returned = quake.from_ctrl %reusable : (!quake.control) -> !quake.wire
  quake.sink %returned : !quake.wire
  quake.sink %x#0 : !quake.wire
  quake.sink %x#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @reduce_ysdgx_mixed_controls() {
// CHECK:           %[[REUSABLE_WIRE:.*]] = quake.null_wire
// CHECK-NEXT:      %[[REUSABLE:.*]] = quake.to_ctrl %[[REUSABLE_WIRE]]
// CHECK-NEXT:      %[[LINEAR_CONTROL:.*]] = quake.null_wire
// CHECK-NEXT:      %[[TARGET:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]]:2 = quake.s<adj> {{\[}}%[[REUSABLE]], %[[LINEAR_CONTROL]]] %[[TARGET]]
// CHECK-NEXT:      %[[RETURNED:.*]] = quake.from_ctrl %[[REUSABLE]]
// CHECK-NEXT:      quake.sink %[[RETURNED]] : !quake.wire
// CHECK-NEXT:      quake.sink %[[S]]#0 : !quake.wire
// CHECK-NEXT:      quake.sink %[[S]]#1 : !quake.wire
// CHECK-NOT:       quake.phase
// CHECK-NEXT:      return
// CHECK-NEXT:    }

// A negative source predicate must be copied to both the replacement and the
// phase correction.
func.func @track_negative_controlled_ysx() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.y [%0 neg [true]] %1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s [%2#0 neg [true]] %2#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.x [%3#0 neg [true]] %3#1
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %4#0 : !quake.wire
  quake.sink %4#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @track_negative_controlled_ysx() {
// CHECK:           %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK:           %[[CONTROL:.*]] = quake.null_wire
// CHECK-NEXT:      %[[TARGET:.*]] = quake.null_wire
// CHECK-NEXT:      %[[S:.*]]:2 = quake.s {{\[}}%[[CONTROL]] neg [true]{{\]}} %[[TARGET]]
// CHECK-NEXT:      %[[PHASE:.*]]:2 = quake.phase (%[[PI]]) {{\[}}%[[S]]#0 neg [true]{{\]}} %[[S]]#1
// CHECK-NEXT:      quake.sink %[[PHASE]]#0 : !quake.wire
// CHECK-NEXT:      quake.sink %[[PHASE]]#1 : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }
