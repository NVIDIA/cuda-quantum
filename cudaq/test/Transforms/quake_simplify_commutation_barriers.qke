// RUN: cudaq-opt --quake-simplify %s | FileCheck %s

// Every function here holds a pair that looks cancellable but must survive, for
// one of two reasons: something between the two endpoints cannot be proven safe
// to cross, or the two endpoints are not inverses of each other after all.

func.func private @opaque_wire(!quake.wire) -> !quake.wire
quake.wire_set @frontier_alignment_wires[2]

// Measurement instruments and reset channels propagate scalar wire identity,
// but the analysis still requires a supported commutation proof before the
// matcher may cross them.
func.func @non_unitary_relation_barriers() {
  %measured_qubit = quake.null_wire
  %reset_qubit = quake.null_wire
  %h0 = quake.h %measured_qubit : (!quake.wire) -> !quake.wire
  %bit, %measured = quake.mz %h0 : (!quake.wire) -> (!quake.measure, !quake.wire)  // barrier
  %h1 = quake.h %measured : (!quake.wire) -> !quake.wire
  %x0 = quake.x %reset_qubit : (!quake.wire) -> !quake.wire
  %reset = quake.reset %x0 : (!quake.wire) -> !quake.wire  // barrier
  %x1 = quake.x %reset : (!quake.wire) -> !quake.wire
  quake.sink %h1 : !quake.wire
  quake.sink %x1 : !quake.wire
  return
}

// Both pairs survive, each still straddling the operation that stopped it.
// CHECK-LABEL: func.func @non_unitary_relation_barriers() {
// CHECK:         %[[H0:.*]] = quake.h
// CHECK:         %[[BIT:.*]], %[[MEASURED:.*]] = quake.mz %[[H0]]
// CHECK:         %[[H1:.*]] = quake.h %[[MEASURED]]
// CHECK:         %[[X0:.*]] = quake.x
// CHECK:         %[[RESET:.*]] = quake.reset %[[X0]]
// CHECK:         %[[X1:.*]] = quake.x %[[RESET]]
// CHECK:         quake.sink %[[H1]]
// CHECK:         quake.sink %[[X1]]

// A computational-basis measurement instrument commutes with Z. The matcher
// may cross it without disturbing the classical result or the returned wire.
func.func @measurement_instrument_commuting_path() {
  %q = quake.null_wire
  %z0 = quake.z %q : (!quake.wire) -> !quake.wire
  %bit, %measured = quake.mz %z0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %z1 = quake.z %measured : (!quake.wire) -> !quake.wire
  quake.sink %z1 : !quake.wire
  return
}

// Both Z gates disappear. The measurement instrument still consumes the
// original wire and threads its quantum result to the sink.
// CHECK-LABEL: func.func @measurement_instrument_commuting_path() {
// CHECK:         %[[Q:.*]] = quake.null_wire
// CHECK-NOT:     quake.z
// CHECK:         %[[BIT:.*]], %[[MEASURED:.*]] = quake.mz %[[Q]]
// CHECK-NOT:     quake.z
// CHECK:         quake.sink %[[MEASURED]]
// CHECK:         return

// A call may do anything to a wire it takes, so the search ends there instead
// of treating the two H gates as a pair on an untouched qubit.
func.func @call_barrier() {
  %q = quake.null_wire
  %h0 = quake.h %q : (!quake.wire) -> !quake.wire
  %called = func.call @opaque_wire(%h0) : (!quake.wire) -> !quake.wire  // barrier
  %h1 = quake.h %called : (!quake.wire) -> !quake.wire
  quake.sink %h1 : !quake.wire
  return
}

// Both H gates survive with the call still between them.
// CHECK-LABEL: func.func @call_barrier() {
// CHECK:         %[[H0:.*]] = quake.h
// CHECK:         %[[CALLED:.*]] = call @opaque_wire(%[[H0]])
// CHECK:         %[[H1:.*]] = quake.h %[[CALLED]]
// CHECK:         quake.sink %[[H1]]

// An operation owning a region can act on the qubit inside code the search does
// not read, so reaching one ends the search.
func.func @region_barrier() {
  %condition = cc.undef i1
  %q = quake.null_wire
  %h0 = quake.h %q : (!quake.wire) -> !quake.wire
  // barrier: the region could act on %h0 in code the search does not read
  %region:1 = cc.if (%condition) ((%arg = %h0)) -> (!quake.wire) {
    cc.continue %arg : !quake.wire
  } else {
    cc.continue %arg : !quake.wire
  }
  %h1 = quake.h %region#0 : (!quake.wire) -> !quake.wire
  quake.sink %h1 : !quake.wire
  return
}

// Both H gates survive with the region still between them.
// CHECK-LABEL: func.func @region_barrier() {
// CHECK:         %[[H0:.*]] = quake.h
// CHECK:         %[[REGION:.*]] = cc.if
// CHECK:         %[[H1:.*]] = quake.h %[[REGION]]
// CHECK:         quake.sink %[[H1]]

// A terminator may forward one wire to distinct successor blocks. The search
// cannot choose one path as the next operation, so the H remains unchanged.
func.func @control_flow_fanout(%condition: i1) {
  %q = quake.null_wire
  %h = quake.h %q : (!quake.wire) -> !quake.wire
  cf.cond_br %condition, ^left(%h : !quake.wire), ^right(%h : !quake.wire)
^left(%left_wire: !quake.wire):
  quake.sink %left_wire : !quake.wire
  return
^right(%right_wire: !quake.wire):
  quake.sink %right_wire : !quake.wire
  return
}

// CHECK-LABEL: func.func @control_flow_fanout
// CHECK:         %[[H:.*]] = quake.h
// CHECK:         cf.cond_br {{.*}}, ^bb1(%[[H]] : !quake.wire), ^bb2(%[[H]] : !quake.wire)

// The two X gates would otherwise be a valid pair, but X and Z anticommute, so
// the Z is a barrier rather than an operation the pair may cross.
func.func @does_not_commute_barrier() {
  %q = quake.null_wire
  %x0 = quake.x %q : (!quake.wire) -> !quake.wire
  %z = quake.z %x0 : (!quake.wire) -> !quake.wire  // barrier, X and Z anticommute
  %x1 = quake.x %z : (!quake.wire) -> !quake.wire
  quake.sink %x1 : !quake.wire
  return
}

// All three operations survive in their original order.
// CHECK-LABEL: func.func @does_not_commute_barrier() {
// CHECK:         %[[X0:.*]] = quake.x
// CHECK:         %[[Z:.*]] = quake.z %[[X0]]
// CHECK:         %[[X1:.*]] = quake.x %[[Z]]
// CHECK:         quake.sink %[[X1]]

// The counterpart to @does_not_commute_barrier: there the relation is proven
// false, here it is merely unproven. U3 takes its parameters at runtime, so the
// analysis cannot evaluate its matrix and answers Indeterminate. An unproven
// relation has to stop the search exactly as a disproven one does.
func.func @unproved_relation_barrier(%theta: f64, %phi: f64, %lambda: f64) {
  %q = quake.null_wire
  %h0 = quake.h %q : (!quake.wire) -> !quake.wire
  %u3 = quake.u3 (%theta, %phi, %lambda) %h0 : (f64, f64, f64, !quake.wire) -> !quake.wire  // barrier, relation unproved
  %h1 = quake.h %u3 : (!quake.wire) -> !quake.wire
  quake.sink %h1 : !quake.wire
  return
}

// Both H gates survive with the U3 still between them.
// CHECK-LABEL: func.func @unproved_relation_barrier
// CHECK:         %[[H0:.*]] = quake.h
// CHECK:         %[[U3:.*]] = quake.u3 {{.*}} %[[H0]]
// CHECK:         %[[H1:.*]] = quake.h %[[U3]]
// CHECK:         quake.sink %[[H1]]

// The two X gates control on the same qubit but with opposite polarity, so they
// are not inverses of each other and must not cancel.
func.func @mismatched_polarity(%angle: f64) {
  %control = quake.null_wire
  %target = quake.null_wire
  %x0:2 = quake.x [%control] %target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %rx = quake.rx (%angle) %x0#1 : (f64, !quake.wire) -> !quake.wire
  %x1:2 = quake.x [%x0#0 neg [true]] %rx : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)  // not an inverse of %x0
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  return
}

// Neither X is removed and the negated control is preserved as written.
// CHECK-LABEL: func.func @mismatched_polarity
// CHECK:         %[[X0:.*]]:2 = quake.x
// CHECK:         %[[RX:.*]] = quake.rx {{.*}} %[[X0]]#1
// CHECK:         %[[X1:.*]]:2 = quake.x {{\[}}%[[X0]]#0 neg [true]] %[[RX]]
// CHECK:         quake.sink %[[X1]]#0
// CHECK:         quake.sink %[[X1]]#1

// Identity equality alone cannot make an endpoint reachable. The second X
// names the same control identity through another borrow, while the anchor's
// actual control result reaches H instead. The two frontier paths are therefore
// not aligned at the candidate.
func.func @incompletely_aligned_endpoint() {
  %control = quake.borrow_wire @frontier_alignment_wires[0] : !quake.wire
  %target = quake.borrow_wire @frontier_alignment_wires[1] : !quake.wire
  %x0:2 = quake.x [%control] %target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %same_control = quake.borrow_wire @frontier_alignment_wires[0] : !quake.wire
  %x1:2 = quake.x [%same_control] %x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %h = quake.h %x0#0 : (!quake.wire) -> !quake.wire
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  quake.sink %h : !quake.wire
  return
}

// Both X gates survive because their required paths do not meet at %x1.
// CHECK-LABEL: func.func @incompletely_aligned_endpoint() {
// CHECK:         %[[CONTROL:.*]] = quake.borrow_wire @frontier_alignment_wires[0]
// CHECK:         %[[TARGET:.*]] = quake.borrow_wire @frontier_alignment_wires[1]
// CHECK:         %[[X0:.*]]:2 = quake.x {{\[}}%[[CONTROL]]] %[[TARGET]]
// CHECK:         %[[SAME_CONTROL:.*]] = quake.borrow_wire @frontier_alignment_wires[0]
// CHECK:         %[[X1:.*]]:2 = quake.x {{\[}}%[[SAME_CONTROL]]] %[[X0]]#1
// CHECK:         %[[H:.*]] = quake.h %[[X0]]#0
// CHECK:         quake.sink %[[X1]]#0
// CHECK:         quake.sink %[[X1]]#1
// CHECK:         quake.sink %[[H]]
