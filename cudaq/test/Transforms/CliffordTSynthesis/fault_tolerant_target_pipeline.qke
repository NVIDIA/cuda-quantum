// RUN: cudaq-opt --cudaq-fault-tolerant-target='epsilon=1e-3' %s | \
// RUN:   FileCheck %s --implicit-check-not='quake.r{{[xyz1]}}' \
// RUN:     --implicit-check-not='quake.phase'

// End-to-end test of the registered `cudaq-fault-tolerant-target` pipeline
// (UnitarySynthesis -> ApplyOpSpecialization -> ConstantPropagation ->
// exact-angle simplification -> CliffordTSynthesis -> Decomposition to
// {h,s,t,x,z,cnot}). After the whole pipeline runs, no rotation ops survive
// anywhere and the body is expressed in the fault-tolerant basis.

func.func @kernel() {
  %q = quake.alloca !quake.ref
  %a = arith.constant 0.7853981633974483 : f64
  quake.rz (%a) %q : (f64, !quake.ref) -> ()
  quake.h %q : (!quake.ref) -> ()
  return
}

// The exact rotation is simplified directly to a named gate before gridsynth.
// CHECK-LABEL: func.func @kernel
// CHECK:         quake.alloca
// CHECK-NEXT:    quake.t
// CHECK-NEXT:    quake.h
// CHECK-NOT:     call @__cliffordt_rz_

// Rx and Ry exact rotations are also simplified directly to named gates.
func.func @kernel_rx_ry() attributes {"cudaq-entrypoint"} {
  %q = quake.alloca !quake.ref
  %a = arith.constant 0.7853981633974483 : f64
  quake.rx (%a) %q : (f64, !quake.ref) -> ()
  quake.ry (%a) %q : (f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @kernel_rx_ry
// CHECK:         quake.alloca
// CHECK-NEXT:    quake.h
// CHECK-NEXT:    quake.t
// CHECK-NEXT:    quake.h
// CHECK-NEXT:    quake.s<adj>
// CHECK-NEXT:    quake.h
// CHECK-NEXT:    quake.t
// CHECK-NEXT:    quake.h
// CHECK-NEXT:    quake.s
// CHECK-NOT:     call @__cliffordt_rz_

// `exp_pauli(theta, Z)` lowers through `Rz(-2*theta)`. Constant folding must
// expose `-pi/4` to exact-angle simplification before `gridsynth` runs.
func.func @kernel_exp_pauli() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %q = quake.alloca !quake.veq<1>
  %angle = arith.constant 0.39269908169872414 : f64
  quake.exp_pauli (%angle) %q to "Z" : (f64, !quake.veq<1>) -> ()
  return
}

// CHECK-LABEL: func.func @kernel_exp_pauli
// CHECK:         %[[QUBIT:.*]] = quake.alloca !quake.ref
// CHECK-NEXT:    quake.t<adj> %[[QUBIT]]
// CHECK-NEXT:    quake.dealloc %[[QUBIT]]
// CHECK-NEXT:    return
// CHECK-NOT:     quake.exp_pauli
// CHECK-NOT:     call @__cliffordt_rz_
