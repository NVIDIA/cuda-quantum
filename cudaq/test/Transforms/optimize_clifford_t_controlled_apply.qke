// RUN: cudaq-opt --optimize-clifford-t %s | FileCheck %s

// `S X S` differs from `X` by global phase. That phase becomes observable when
// this function is controlled, so the pass must preserve the original chain.
func.func @phase_sensitive(%arg0: !quake.ref) {
  %0 = quake.unwrap %arg0 : (!quake.ref) -> !quake.wire
  %1 = quake.s %0 : (!quake.wire) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  %3 = quake.s %2 : (!quake.wire) -> !quake.wire
  quake.wrap %3 to %arg0 : !quake.wire, !quake.ref
  return
}

func.func @caller(%control: !quake.ref, %target: !quake.ref) {
  quake.apply @phase_sensitive [%control] %target
      : (!quake.ref, !quake.ref) -> ()
  return
}

// CHECK-LABEL: func.func @phase_sensitive
// CHECK:         quake.s
// CHECK-NEXT:    quake.x
// CHECK-NEXT:    quake.s
// CHECK:         quake.wrap

// CHECK-LABEL: func.func @caller
// CHECK:         quake.apply @phase_sensitive [
