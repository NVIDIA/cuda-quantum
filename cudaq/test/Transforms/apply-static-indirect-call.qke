// RUN: cudaq-opt --aggressive-inlining --apply-op-specialization %s | FileCheck %s

// A static callable reached through func.call_indirect must be made direct
// before inlining, so control specialization sees the callable's quantum work.

module {
  func.func private @callable_thunk(
      %closure: !cc.callable<(!quake.ref) -> ()>, %q: !quake.ref)
      attributes {"cudaq-kernel"} {
    quake.x %q : (!quake.ref) -> ()
    return
  }

  func.func private @wrapper(
      %closure: !cc.callable<(!quake.ref) -> ()>, %q: !quake.ref)
      attributes {"cudaq-kernel"} {
    %fn = func.constant @callable_thunk : (!cc.callable<(!quake.ref) -> ()>, !quake.ref) -> ()
    func.call_indirect %fn(%closure, %q) : (!cc.callable<(!quake.ref) -> ()>, !quake.ref) -> ()
    return
  }

  func.func @main() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %closure = cc.instantiate_callable @callable_thunk() : () -> !cc.callable<(!quake.ref) -> ()>
    %control = quake.alloca !quake.ref
    %target = quake.alloca !quake.ref
    quake.apply @wrapper [%control] %closure, %target : (!quake.ref, !cc.callable<(!quake.ref) -> ()>, !quake.ref) -> ()
    return
  }
}

// CHECK-LABEL: func.func private @wrapper.ctrl(
// CHECK-SAME:  %[[CTRL:.*]]: !quake.veq<?>
// CHECK-NOT:   call @callable_thunk
// CHECK-NOT:   call_indirect
// CHECK:       quake.x [%[[CTRL]]] %{{.*}} : (!quake.veq<?>, !quake.ref) -> ()
// CHECK-NOT:   call @callable_thunk
// CHECK-NOT:   call_indirect
