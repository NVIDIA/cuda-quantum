// RUN: cudaq-opt --cable-rough-in %s -split-input-file -verify-diagnostics

// A veq of unknown size cannot be given a cable arity, so the call cannot be
// put in wire form. Reported rather than left in reference form, which would
// reach the backend with the qubits never threaded through the call.

func.func private @callee(!quake.veq<?>, f64)

func.func @dynamic_size(%n: i64, %d: f64) {
  %0 = quake.alloca !quake.veq<?>[%n : i64]
  // expected-error @+1 {{cannot be put in wire form}}
  call @callee(%0, %d) : (!quake.veq<?>, f64) -> ()
  return
}

// -----

// A veq argument this pass cannot resolve to references is reported too, and
// the earlier argument must not have been half-rewritten before that happened.

func.func private @two_vecs(!quake.veq<?>, !quake.veq<?>)

func.func @static_then_dynamic(%n: i64) {
  %0 = quake.alloca !quake.veq<2>
  %1 = quake.relax_size %0 : (!quake.veq<2>) -> !quake.veq<?>
  %2 = quake.alloca !quake.veq<?>[%n : i64]
  // expected-error @+1 {{cannot be put in wire form}}
  call @two_vecs(%1, %2) : (!quake.veq<?>, !quake.veq<?>) -> ()
  return
}
