// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=R1ToRz})' %s | CircuitCheck %s
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=R1ToRz},func.func(cse,normalize-phase-placement,lower-phase,canonicalize),verify-no-phase)' %s | CircuitCheck %s --up-to-global-phase
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{basis=rz,x(1)},func.func(cse,normalize-phase-placement,lower-phase,canonicalize),verify-no-phase)' %s | FileCheck %s --check-prefix=BASIS --implicit-check-not=quake.phase --implicit-check-not=quake.r1

func.func @forward(%target: !quake.ref) {
  %theta = arith.constant 1.234000e+00 : f64
  quake.r1 (%theta) %target : (f64, !quake.ref) -> ()
  return
}

func.func @adjoint(%target: !quake.ref) {
  %theta = arith.constant 7.890000e-01 : f64
  quake.r1<adj> (%theta) %target : (f64, !quake.ref) -> ()
  return
}

func.func @controlled(%control: !quake.ref, %target: !quake.ref) {
  %theta = arith.constant 4.560000e-01 : f64
  quake.r1 (%theta) [%control neg [true]] %target
      : (f64, !quake.ref, !quake.ref) -> ()
  return
}

// BASIS-LABEL: func.func @controlled(
// BASIS: quake.rz
// BASIS: quake.x
// BASIS: quake.rz
// BASIS: quake.x
// BASIS: quake.rz
// BASIS: return
