// Decompose H before apply specialization, then compare the original and
// phase-tracked controlled forms both before and after LowerPhase.
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --symbol-dce --expand-control-veqs --cse %s > %t.source
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=HToPhasedRx})' %s > %t.decomposed
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --symbol-dce --expand-control-veqs --cse %t.decomposed > %t.actual
// RUN: FileCheck %s --check-prefix=PHASE < %t.actual
// RUN: CircuitCheck --input=%t.actual %t.source
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --symbol-dce --expand-control-veqs --cse --normalize-phase-placement --lower-phase --canonicalize %s > %t.lower.source
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --symbol-dce --expand-control-veqs --cse --normalize-phase-placement --lower-phase --canonicalize %t.decomposed > %t.lower.actual
// RUN: FileCheck %s --check-prefix=LOWER --implicit-check-not='quake.phase (' < %t.lower.actual
// RUN: CircuitCheck --input=%t.lower.actual %t.lower.source

func.func private @h_exact(%target: !quake.ref) {
  quake.h %target : (!quake.ref) -> ()
  return
}

func.func @controlled_h(%control: !quake.ref, %target: !quake.ref) {
  quake.apply @h_exact [%control] (%target)
      : (!quake.ref, !quake.ref) -> ()
  return
}

// PHASE-LABEL: func.func @controlled_h
// PHASE: quake.phased_rx
// PHASE: quake.phase {{.*}}[%{{.*}}]
// LOWER-LABEL: func.func @controlled_h
// LOWER: quake.r1
