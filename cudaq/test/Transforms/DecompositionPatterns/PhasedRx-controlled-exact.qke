// Compare the exact H-to-PhasedRx representation with a controlled H after
// apply specialization, both before and after lowering its conditional phase.
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --expand-control-veqs --cse \
// RUN:   %S/Inputs/PhasedRx-controlled-source.qke > %t.source
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --expand-control-veqs --cse %s > %t.actual
// RUN: FileCheck %s --check-prefix=PHASE < %t.actual
// RUN: CircuitCheck --input=%t.actual %t.source
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --symbol-dce \
// RUN:   --expand-control-veqs --cse --normalize-phase-placement --lower-phase --canonicalize \
// RUN:   %S/Inputs/PhasedRx-controlled-source.qke > %t.lower.source
// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --symbol-dce \
// RUN:   --expand-control-veqs --cse --normalize-phase-placement --lower-phase --canonicalize \
// RUN:   %s > %t.lower.actual
// RUN: FileCheck %s --check-prefix=LOWER --implicit-check-not='quake.phase (' \
// RUN:   < %t.lower.actual
// RUN: CircuitCheck --input=%t.lower.actual %t.lower.source

func.func private @h_exact(%target: !quake.ref) {
  %zero = arith.constant 0.000000e+00 : f64
  %pi = arith.constant 3.1415926535897931 : f64
  %pi_2 = arith.constant 1.5707963267948966 : f64
  quake.phased_rx (%pi_2, %pi_2) %target : (f64, f64, !quake.ref) -> ()
  quake.phased_rx (%pi, %zero) %target : (f64, f64, !quake.ref) -> ()
  quake.phase (%pi_2) %target : (f64, !quake.ref) -> ()
  return
}

func.func @controlled_h(%control: !quake.ref, %target: !quake.ref) {
  quake.apply @h_exact [%control] %target
      : (!quake.ref, !quake.ref) -> ()
  return
}

// PHASE-LABEL: func.func @controlled_h
// PHASE: quake.phase {{.*}}[%{{.*}}]
// LOWER-LABEL: func.func @controlled_h
// LOWER: quake.r1
