// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=ExpPauliDecomposition})' %s | FileCheck %s

module attributes {quake.mangled_name_map = {__nvqpp__mlirgen__Z4mainE3$_0 = "_ZZ4mainENK3$_0clEd"}} {

  func.func @__nvqpp__mlirgen__Z4mainE3$_0(%arg0: f64) attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = cc.alloca f64
    cc.store %arg0, %0 : !cc.ptr<f64>
    %1 = quake.alloca !quake.veq<4>
    %2 = quake.extract_ref %1[0] : (!quake.veq<4>) -> !quake.ref
    quake.x %2 : (!quake.ref) -> ()
    %3 = quake.extract_ref %1[1] : (!quake.veq<4>) -> !quake.ref
    quake.x %3 : (!quake.ref) -> ()
    %4 = cc.load %0 : !cc.ptr<f64>
    %5 = cc.string_literal "XXXY" : !cc.ptr<!cc.array<i8 x 5>>
    quake.exp_pauli (%4) %1 to %5 : (f64, !quake.veq<4>, !cc.ptr<!cc.array<i8 x 5>>) -> ()
    return
  }

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__Z4mainE3$_0(
// CHECK-SAME:                                             %[[ARG:.*]]: f64) attributes {"cudaq-entrypoint", "cudaq-kernel"} {
// CHECK-DAG:       %[[PLUS_HALF_PI:.*]] = arith.constant 1.5707963267948966 : f64
// CHECK-DAG:       %[[NEG_TWO:.*]] = arith.constant -2.000000e+00 : f64
// CHECK-DAG:       %[[NEG_HALF_PI:.*]] = arith.constant -1.5707963267948966 : f64
// CHECK:           %[[ANGLE_SLOT:.*]] = cc.alloca f64
// CHECK:           cc.store %[[ARG]], %[[ANGLE_SLOT]] : !cc.ptr<f64>
// CHECK:           %[[VEC:.*]] = quake.alloca !quake.veq<4>
// CHECK:           %[[SOURCE_Q0:.*]] = quake.extract_ref %[[VEC]][0] : (!quake.veq<4>) -> !quake.ref
// CHECK:           quake.x %[[SOURCE_Q0]] : (!quake.ref) -> ()
// CHECK:           %[[SOURCE_Q1:.*]] = quake.extract_ref %[[VEC]][1] : (!quake.veq<4>) -> !quake.ref
// CHECK:           quake.x %[[SOURCE_Q1]] : (!quake.ref) -> ()
// CHECK:           %[[THETA:.*]] = cc.load %[[ANGLE_SLOT]] : !cc.ptr<f64>
// CHECK:           %[[Q0:.*]] = quake.extract_ref %[[VEC]][0] : (!quake.veq<4>) -> !quake.ref
// CHECK:           %[[Q1:.*]] = quake.extract_ref %[[VEC]][1] : (!quake.veq<4>) -> !quake.ref
// CHECK:           %[[Q2:.*]] = quake.extract_ref %[[VEC]][2] : (!quake.veq<4>) -> !quake.ref
// CHECK:           %[[Q3:.*]] = quake.extract_ref %[[VEC]][3] : (!quake.veq<4>) -> !quake.ref
// CHECK:           quake.h %[[Q0]] : (!quake.ref) -> ()
// CHECK:           quake.h %[[Q1]] : (!quake.ref) -> ()
// CHECK:           quake.h %[[Q2]] : (!quake.ref) -> ()
// CHECK:           quake.rx (%[[PLUS_HALF_PI]]) %[[Q3]] : (f64, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q0]]] %[[Q1]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q1]]] %[[Q2]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q2]]] %[[Q3]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           %[[ROTATION:.*]] = arith.mulf %[[THETA]], %[[NEG_TWO]] : f64
// CHECK:           quake.rz (%[[ROTATION]]) %[[Q3]] : (f64, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q2]]] %[[Q3]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q1]]] %[[Q2]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q0]]] %[[Q1]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.rx (%[[NEG_HALF_PI]]) %[[Q3]] : (f64, !quake.ref) -> ()
// CHECK:           quake.h %[[Q2]] : (!quake.ref) -> ()
// CHECK:           quake.h %[[Q1]] : (!quake.ref) -> ()
// CHECK:           quake.h %[[Q0]] : (!quake.ref) -> ()
// CHECK:           return
// CHECK:         }

  func.func @__nvqpp__mlirgen__function_test_param._Z10test_paramN5cudaq10pauli_wordE() attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
    %cst = arith.constant 1.000000e+00 : f64
    %c2_i64 = arith.constant 2 : i64
    %0 = cc.address_of @cstr.585900 : !cc.ptr<!llvm.array<3 x i8>>
    %1 = cc.cast %0 : (!cc.ptr<!llvm.array<3 x i8>>) -> !cc.ptr<i8>
    %2 = cc.stdvec_init %1, %c2_i64 : (!cc.ptr<i8>, i64) -> !cc.charspan
    %3 = quake.alloca !quake.veq<2>
    quake.exp_pauli (%cst) %3 to %2 : (f64, !quake.veq<2>, !cc.charspan) -> ()
    return
  }

  llvm.mlir.global private constant @cstr.585900("XY\00") {addr_space = 0 : i32}

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__function_test_param._Z10test_paramN5cudaq10pauli_wordE() attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
// CHECK-DAG:       %[[PLUS_HALF_PI_2:.*]] = arith.constant 1.5707963267948966 : f64
// CHECK-DAG:       %[[NEG_TWO_2:.*]] = arith.constant -2.000000e+00 : f64
// CHECK-DAG:       %[[NEG_HALF_PI_2:.*]] = arith.constant -1.5707963267948966 : f64
// CHECK-DAG:       %[[VEC_2:.*]] = quake.alloca !quake.veq<2>
// CHECK:           %[[Q0_2:.*]] = quake.extract_ref %[[VEC_2]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK:           %[[Q1_2:.*]] = quake.extract_ref %[[VEC_2]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK:           quake.h %[[Q0_2]] : (!quake.ref) -> ()
// CHECK:           quake.rx (%[[PLUS_HALF_PI_2]]) %[[Q1_2]] : (f64, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q0_2]]] %[[Q1_2]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.rz (%[[NEG_TWO_2]]) %[[Q1_2]] : (f64, !quake.ref) -> ()
// CHECK:           quake.x {{\[}}%[[Q0_2]]] %[[Q1_2]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           quake.rx (%[[NEG_HALF_PI_2]]) %[[Q1_2]] : (f64, !quake.ref) -> ()
// CHECK:           quake.h %[[Q0_2]] : (!quake.ref) -> ()
// CHECK:           return
// CHECK:         }
}
