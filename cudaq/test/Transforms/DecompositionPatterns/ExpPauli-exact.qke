// REFERENCE:   %theta = arith.constant 6.600000e-01 : f64
// REFERENCE:   %x = quake.extract_ref %rest[0] : (!quake.veq<2>) -> !quake.ref
// REFERENCE:   %y = quake.extract_ref %rest[1] : (!quake.veq<2>) -> !quake.ref
// REFERENCE:   %neg_theta = arith.negf %theta : f64
// REFERENCE:   %neg_two = arith.constant -2.000000e+00 : f64
// REFERENCE:   %rotation = arith.mulf %neg_theta, %neg_two : f64
// REFERENCE:   %plus_half_pi = arith.constant 1.5707963267948966 : f64
// REFERENCE:   %neg_half_pi = arith.constant -1.5707963267948966 : f64
// REFERENCE:   quake.h %x : (!quake.ref) -> ()
// REFERENCE:   quake.rx (%plus_half_pi) %y : (f64, !quake.ref) -> ()
// REFERENCE:   quake.x [%x] %y : (!quake.ref, !quake.ref) -> ()
// REFERENCE:   quake.rz (%rotation) %y : (f64, !quake.ref) -> ()
// REFERENCE:   quake.x [%x] %y : (!quake.ref, !quake.ref) -> ()
// REFERENCE:   quake.rx (%neg_half_pi) %y : (f64, !quake.ref) -> ()
