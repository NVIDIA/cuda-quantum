// REFERENCE:   %theta = arith.constant 2.200000e-01 : f64
// REFERENCE:   %neg_two = arith.constant -2.000000e+00 : f64
// REFERENCE:   %rotation = arith.mulf %theta, %neg_two : f64
// REFERENCE:   quake.h %target : (!quake.ref) -> ()
// REFERENCE:   quake.rz (%rotation) %target : (f64, !quake.ref) -> ()
