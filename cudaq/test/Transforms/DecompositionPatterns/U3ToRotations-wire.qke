// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=U3ToRotations})' %s | FileCheck %s

func.func @wire(%control: !quake.wire, %target: !quake.wire)
    -> (!quake.wire, !quake.wire) attributes {"cudaq-entrypoint"} {
  %theta = arith.constant 3.330000e-01 : f64
  %phi = arith.constant 4.440000e-01 : f64
  %lambda = arith.constant 5.550000e-01 : f64
  %next:2 = quake.u3 (%theta, %phi, %lambda) [%control] %target
      : (f64, f64, f64, !quake.wire, !quake.wire)
        -> (!quake.wire, !quake.wire)
  return %next#0, %next#1 : !quake.wire, !quake.wire
}

// CHECK-LABEL: func.func @wire
// CHECK: %[[RZ0:.*]]:2 = quake.rz
// CHECK: %[[RX0:.*]]:2 = quake.rx
// CHECK: %[[RZ1:.*]]:2 = quake.rz
// CHECK: %[[RX1:.*]]:2 = quake.rx
// CHECK: %[[RZ2:.*]]:2 = quake.rz
// CHECK: %[[PHASE:.*]]:2 = quake.phase
// CHECK: return %[[PHASE]]#0, %[[PHASE]]#1
