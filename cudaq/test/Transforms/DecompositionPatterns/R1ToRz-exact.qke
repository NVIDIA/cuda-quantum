// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=R1ToRz})' %s | CircuitCheck %s

func.func @forward(%target: !quake.ref) {
  %theta = arith.constant 1.234000e+00 : f64
  quake.r1 (%theta) %target : (f64, !quake.ref) -> ()
  return
}

func.func @adjoint(%target: !quake.ref) {
  %theta = arith.constant 7.890000e-01 : f64
  quake.r1<adj> (%theta) %target : (f64, !quake.ref) -> ()
  return
}

func.func @controlled(%control: !quake.ref, %target: !quake.ref) {
  %theta = arith.constant 4.560000e-01 : f64
  quake.r1 (%theta) [%control neg [true]] %target
      : (f64, !quake.ref, !quake.ref) -> ()
  return
}
