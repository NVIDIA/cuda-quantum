func.func private @h_exact(%target: !quake.ref) {
  quake.h %target : (!quake.ref) -> ()
  return
}

func.func @controlled_h(%control: !quake.ref, %target: !quake.ref) {
  quake.apply @h_exact [%control] %target : (!quake.ref, !quake.ref) -> ()
  return
}
