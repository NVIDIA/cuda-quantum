// RUN: cudaq-opt --qubit-mapping='device=path(3) raise-fatal-errors=1' %s -split-input-file -verify-diagnostics
// RUN: cudaq-opt --qubit-mapping='device=path(3) raise-fatal-errors=1' --mlir-print-ir-after-failure %s -split-input-file -verify-diagnostics 2>&1 | FileCheck --check-prefix=UNCHANGED %s

// expected-error@+1 {{no borrow_wire ops found in test_00}}
func.func @test_00() {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2 = quake.null_wire
  %3:2 = quake.x [%1] %0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.x [%3#0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %5:2 = quake.x [%4#1] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %4#0 : !quake.wire
  quake.sink %5#0 : !quake.wire
  quake.sink %5#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires_01[10]

func.func @test_01() {
  %0 = quake.borrow_wire @wires_01[0] : !quake.wire
  // expected-error @+1 {{the mapper requires borrow operations and prohibits null wires}}
  %1 = quake.null_wire
  %2 = quake.null_wire
  %3:2 = quake.x [%1] %0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.x [%3#0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %5:2 = quake.x [%4#1] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %4#0 : !quake.wire
  quake.sink %5#0 : !quake.wire
  quake.return_wire %5#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02[10]

func.func @test_02() {
  %0 = quake.borrow_wire @wires_02[0] : !quake.wire
  // expected-error @+1 {{the mapper requires borrow operations and prohibits reference semantics}}
  %1 = quake.alloca !quake.ref
  %2 = quake.alloca !quake.ref
  %3 = quake.alloca !quake.ref
  quake.return_wire %0 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02_scope_alloc[10]

func.func @test_02_scope_alloc() {
  %0 = quake.borrow_wire @wires_02_scope_alloc[0] : !quake.wire
  // expected-error @+1 {{mapper cannot handle quantum allocations or borrows inside a scope}}
  cc.scope {
    %1 = quake.alloca !quake.ref
    cc.continue
  }
  quake.return_wire %0 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02_scope_borrow[10]

func.func @test_02_scope_borrow() {
  %0 = quake.borrow_wire @wires_02_scope_borrow[0] : !quake.wire
  // expected-error @+1 {{mapper cannot handle quantum allocations or borrows inside a scope}}
  cc.scope {
    %1 = quake.borrow_wire @wires_02_scope_borrow[1] : !quake.wire
    quake.sink %1 : !quake.wire
    cc.continue
  }
  quake.return_wire %0 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02_scope_exit[10]

func.func @test_02_scope_return() {
  %0 = quake.borrow_wire @wires_02_scope_exit[0] : !quake.wire
  cc.scope {
    // expected-error @+1 {{mapper cannot handle terminal wire operations inside a scope}}
    cc.scope {
      quake.return_wire %0 : !quake.wire
      cc.continue
    }
    cc.continue
  }
  return
}

// -----

quake.wire_set @wires_02_scope_drop[10]

// UNCHANGED-LABEL: func.func @test_02_scope_drop
// UNCHANGED:       quake.borrow_wire @wires_02_scope_drop[0]
// UNCHANGED:       cc.scope -> (!quake.wire)
// UNCHANGED:       quake.return_wire
func.func @test_02_scope_drop() {
  %0 = quake.borrow_wire @wires_02_scope_drop[0] : !quake.wire
  %1 = quake.borrow_wire @wires_02_scope_drop[1] : !quake.wire
  // expected-error @+1 {{mapper requires a scope result for every wire consumed in the scope}}
  %2 = cc.scope -> !quake.wire {
    %3:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
    cc.continue %3#0 : !quake.wire
  }
  quake.return_wire %2 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02_scope_cfg[10]

func.func @test_02_scope_cfg() {
  %0 = quake.borrow_wire @wires_02_scope_cfg[0] : !quake.wire
  // expected-error @+1 {{mapper can only handle single-block scopes}}
  cc.scope {
    cf.br ^bb1
  ^bb1:
    cc.continue
  }
  quake.return_wire %0 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02_scope_loop_step[10]

func.func @test_02_scope_loop_step() {
  %cond = cc.undef i1
  %0 = quake.borrow_wire @wires_02_scope_loop_step[0] : !quake.wire
  cc.loop while {
    cc.condition %cond
  } do {
    cc.continue
  } step {
    // expected-error @+1 {{mapper cannot handle scopes nested inside structured control flow}}
    cc.scope {
      cc.continue
    }
    cc.continue
  }
  quake.return_wire %0 : !quake.wire
  return
}

// -----

quake.wire_set @wires_02_scope_contains_control_flow[10]

func.func @test_02_scope_contains_control_flow() {
  %cond = cc.undef i1
  %0 = quake.borrow_wire @wires_02_scope_contains_control_flow[0] : !quake.wire
  cc.scope {
    // expected-error @+1 {{mapper cannot handle structured control flow inside a scope}}
    cc.if (%cond) {
      cc.continue
    }
    cc.continue
  }
  quake.return_wire %0 : !quake.wire
  return
}

// -----

quake.wire_set @wires_03[10]

// expected-error@+1 {{no borrow_wire ops found in test_03}}
func.func @test_03() {
  return
}

// -----

quake.wire_set @wires_04[10]

// A measured wire reused by a later quantum op is a mid-circuit measurement the
// mapper cannot preserve while it defers measurements to the end.
func.func @test_04() {
  %0 = quake.borrow_wire @wires_04[0] : !quake.wire
  %1 = quake.borrow_wire @wires_04[1] : !quake.wire
  %2:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  // expected-error @+1 {{unsupported mid-circuit measurement}}
  %meas, %wire = quake.mz %2#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %3 = quake.h %wire : (!quake.wire) -> !quake.wire
  quake.return_wire %3 : !quake.wire
  quake.return_wire %2#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires_05[10]

// A measurement result feeding control flow through a store/load is the
// adaptive/feed-forward shape CUDA-Q lowering produces, and is unsupported. The
// feedback diagnostic is reported on the function, not the measurement op.
// expected-error @+1 {{unsupported measurement-dependent behavior}}
func.func @test_05() {
  %0 = quake.borrow_wire @wires_05[0] : !quake.wire
  %1 = quake.borrow_wire @wires_05[1] : !quake.wire
  %2:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %meas, %wire = quake.mz %2#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %b = quake.discriminate %meas : (!quake.measure) -> i1
  %slot = cc.alloca i1
  cc.store %b, %slot : !cc.ptr<i1>
  %cond = cc.load %slot : !cc.ptr<i1>
  cc.if(%cond) {
    %tmp = cc.alloca i1
  }
  quake.return_wire %wire : !quake.wire
  quake.return_wire %2#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires_06[10]

// A gate in the for-loop step region is loop control machinery, not routable
// quantum work, so it is rejected rather than routed.
func.func @test_06() {
  %cond = cc.undef i1
  %0 = quake.borrow_wire @wires_06[0] : !quake.wire
  // expected-error @+1 {{mapper cannot handle quantum operations in a loop condition or step region}}
  %loop = cc.loop while ((%w = %0) -> !quake.wire) {
    cc.condition %cond (%w : !quake.wire)
  } do {
  ^bb0(%bw : !quake.wire):
    cc.continue %bw : !quake.wire
  } step {
  ^bb0(%sw : !quake.wire):
    %s = quake.t %sw : (!quake.wire) -> !quake.wire
    cc.continue %s : !quake.wire
  }
  quake.return_wire %loop : !quake.wire
  return
}

// -----

quake.wire_set @wires_07[10]

// A gate in the loop condition region is likewise rejected: a condition can
// only depend on quantum state through a measurement, which is unsupported.
func.func @test_07() {
  %cond = cc.undef i1
  %0 = quake.borrow_wire @wires_07[0] : !quake.wire
  %1 = quake.borrow_wire @wires_07[1] : !quake.wire
  // expected-error @+1 {{mapper cannot handle quantum operations in a loop condition or step region}}
  %loop:2 = cc.loop while ((%w0 = %0, %w1 = %1) -> (!quake.wire, !quake.wire)) {
    %g:2 = quake.x [%w0] %w1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
    cc.condition %cond (%g#0, %g#1 : !quake.wire, !quake.wire)
  } do {
  ^bb0(%bw0 : !quake.wire, %bw1 : !quake.wire):
    cc.continue %bw0, %bw1 : !quake.wire, !quake.wire
  }
  quake.return_wire %loop#0 : !quake.wire
  quake.return_wire %loop#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires_08[10]

// The mapper cannot choose one body when borrowed wires span the run entry and
// its wrapper scope.
// expected-error@+1 {{mapper requires all borrow_wire operations in a run entry to be in its selected body block}}
func.func @test_08.run() attributes {quake.cudaq_run = [i1]} {
  %0 = quake.borrow_wire @wires_08[0] : !quake.wire
  cc.scope {
    %1 = quake.borrow_wire @wires_08[1] : !quake.wire
    quake.return_wire %1 : !quake.wire
    cc.continue
  }
  quake.return_wire %0 : !quake.wire
  return
}
