// RUN: cudaq-translate --convert-to=qir --emit-llvm=false %s | FileCheck %s

// The phase begins uncontrolled inside the helper. Apply specialization adds
// the outer control, after which the late phase lifecycle must lower it to R1.
func.func private @phase_helper(%theta: f64, %anchor: !quake.ref) {
  quake.phase (%theta) %anchor : (f64, !quake.ref) -> ()
  return
}

func.func @phase_lifecycle(%theta: f64, %outer: !quake.ref,
                           %anchor: !quake.ref) {
  quake.apply @phase_helper [%outer] (%theta, %anchor)
      : (!quake.ref, f64, !quake.ref) -> ()
  return
}

// CHECK-LABEL: llvm.func @phase_lifecycle(
// CHECK-SAME: %[[THETA:[a-zA-Z0-9_.$-]+]]: f64
// CHECK-SAME: %[[OUTER:[a-zA-Z0-9_.$-]+]]: !llvm.ptr
// CHECK: llvm.call @__quantum__qis__r1(%[[THETA]], %[[OUTER]])
// CHECK-NOT: quake.phase

// Apply specialization prepends the outer control and preserves the inner
// negation. LowerPhase selects the outer control as the R1 target, leaving
// the inner negation as its control predicate.
func.func private @negative_phase_helper(
    %theta: f64, %inner: !quake.ref, %anchor: !quake.ref) {
  quake.phase (%theta) [%inner neg [true]] %anchor
      : (f64, !quake.ref, !quake.ref) -> ()
  return
}

func.func @negative_phase_lifecycle(
    %theta: f64, %outer: !quake.ref, %inner: !quake.ref,
    %anchor: !quake.ref) {
  quake.apply @negative_phase_helper [%outer] (%theta, %inner, %anchor)
      : (!quake.ref, f64, !quake.ref, !quake.ref) -> ()
  return
}

// CHECK-LABEL: llvm.func @negative_phase_lifecycle(
// CHECK-SAME: %[[NEG_THETA:[a-zA-Z0-9_.$-]+]]: f64
// CHECK-SAME: %[[NEG_OUTER:[a-zA-Z0-9_.$-]+]]: !llvm.ptr
// CHECK-SAME: %[[NEG_INNER:[a-zA-Z0-9_.$-]+]]: !llvm.ptr
// CHECK:           %[[ZERO:.*]] = llvm.mlir.constant(0 : i32) : i32
// CHECK:           %[[R1_CTL:.*]] = llvm.mlir.addressof @__nvqir__qis__r1__ctl_values : !llvm.ptr
// CHECK:           %[[ONE:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK:           %[[R1_CALLEE:.*]] = llvm.bitcast %[[R1_CTL]] : !llvm.ptr to !llvm.ptr
// CHECK:           %[[INNER:.*]] = llvm.bitcast %[[NEG_INNER]] : !llvm.ptr to !llvm.ptr
// CHECK:           %[[OUTER:.*]] = llvm.bitcast %[[NEG_OUTER]] : !llvm.ptr to !llvm.ptr
// CHECK:           llvm.call @generalizedInvokeWithControlValues(%[[ONE]], %[[ONE]], %[[ONE]], %[[R1_CALLEE]], %[[NEG_THETA]], %[[ZERO]], %[[ZERO]], %[[INNER]], %[[OUTER]]) vararg(!llvm.func<void (i64, i64, i64, ptr, ...)>) : (i64, i64, i64, !llvm.ptr, f64, i32, i32, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           llvm.return
// CHECK-NOT: quake.phase
