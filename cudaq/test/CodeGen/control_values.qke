// CHECK:           llvm.store %[[MLIR_7]], %[[GETELEMENTPTR_0]] : i64, !llvm.ptr
// CHECK:           %[[CALL_10:.*]] = llvm.call @llvm.stacksave.p0() : () -> !llvm.ptr
// CHECK:           llvm.br ^bb3
