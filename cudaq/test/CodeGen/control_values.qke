// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr) -> !llvm.struct<(ptr, ptr)> attributes {"qir-api"} {
// CHECK-NEXT:           %[[MLIR_0:.*]] = llvm.mlir.poison : !llvm.struct<(ptr, ptr)>
// CHECK-NEXT:           %[[MLIR_1:.*]] = llvm.mlir.addressof @cstr.5800 : !llvm.ptr
// CHECK-NEXT:           %[[MLIR_2:.*]] = llvm.mlir.addressof @phase_matrix : !llvm.ptr
// CHECK-NEXT:           %[[MLIR_3:.*]] = llvm.mlir.addressof @cstr.00 : !llvm.ptr
// CHECK-NEXT:           %[[MLIR_4:.*]] = llvm.mlir.constant(8 : i32) : i32
// CHECK-NEXT:           %[[MLIR_5:.*]] = llvm.mlir.addressof @__nvqir__qis__custom_unitary__adj__ctl_values : !llvm.ptr
// CHECK-NEXT:           %[[MLIR_6:.*]] = llvm.mlir.constant(0 : i64) : i64
// CHECK-NEXT:           %[[MLIR_7:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK-NEXT:           %[[MLIR_8:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK-NEXT:           %[[ALLOCA_0:.*]] = llvm.alloca %[[MLIR_8]] x !llvm.array<1 x struct<(ptr, i64)>> : (i32) -> !llvm.ptr
// CHECK-NEXT:           %[[CALL_0:.*]] = llvm.call @__quantum__rt__array_create_1d(%[[MLIR_4]], %[[MLIR_7]]) : (i32, i64) -> !llvm.ptr
// CHECK-NEXT:           %[[CALL_1:.*]] = llvm.call @__quantum__rt__array_get_element_ptr_1d(%[[CALL_0]], %[[MLIR_6]]) : (!llvm.ptr, i64) -> !llvm.ptr
// CHECK-NEXT:           llvm.store %[[ARG2]], %[[CALL_1]] : !llvm.ptr, !llvm.ptr
// CHECK-NEXT:           llvm.call @invokeCustomUnitaryWithControlValues(%[[MLIR_7]], %[[MLIR_2]], %[[CALL_0]], %[[MLIR_3]], %[[MLIR_5]], %[[MLIR_6]], %[[ARG1]], %[[MLIR_6]]) vararg(!llvm.func<void (i64, ptr, ptr, ptr, ptr, ...)>) : (i64, !llvm.ptr, !llvm.ptr, !llvm.ptr, !llvm.ptr, i64, !llvm.ptr, i64) -> ()
// CHECK-NEXT:           %[[CALL_2:.*]] = llvm.call @__quantum__rt__array_create_1d(%[[MLIR_4]], %[[MLIR_7]]) : (i32, i64) -> !llvm.ptr
// CHECK-NEXT:           %[[CALL_3:.*]] = llvm.call @__quantum__rt__array_get_element_ptr_1d(%[[CALL_2]], %[[MLIR_6]]) : (!llvm.ptr, i64) -> !llvm.ptr
// CHECK-NEXT:           llvm.store %[[ARG2]], %[[CALL_3]] : !llvm.ptr, !llvm.ptr
// CHECK-NEXT:           llvm.store %[[MLIR_1]], %[[ALLOCA_0]] : !llvm.ptr, !llvm.ptr
// CHECK-NEXT:           %[[GETELEMENTPTR_0:.*]] = llvm.getelementptr %[[ALLOCA_0]][0, 0, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.array<1 x struct<(ptr, i64)>>
// CHECK-NEXT:           llvm.store %[[MLIR_7]], %[[GETELEMENTPTR_0]] : i64, !llvm.ptr
// CHECK-NEXT:           llvm.call @invokeExpPauliWithControlValues(%[[MLIR_7]], %[[ARG0]], %[[CALL_2]], %[[ALLOCA_0]], %[[MLIR_6]], %[[ARG1]], %[[MLIR_6]]) vararg(!llvm.func<void (i64, f64, ptr, ptr, ...)>) : (i64, f64, !llvm.ptr, !llvm.ptr, i64, !llvm.ptr, i64) -> ()
// CHECK-NEXT:           %[[INSERTVALUE_0:.*]] = llvm.insertvalue %[[ARG1]], %[[MLIR_0]][0] : !llvm.struct<(ptr, ptr)>
// CHECK-NEXT:           %[[INSERTVALUE_1:.*]] = llvm.insertvalue %[[ARG2]], %[[INSERTVALUE_0]][1] : !llvm.struct<(ptr, ptr)>
// CHECK-NEXT:           llvm.return %[[INSERTVALUE_1]] : !llvm.struct<(ptr, ptr)>
// CHECK-NEXT:         }

// Reusable controls do not produce results, with either ref or wire targets.
func.func @reusable_control(%control: !quake.control, %reference: !quake.ref,
                           %wire: !quake.wire) -> !quake.wire {
  quake.x [%control neg [true]] %reference
      : (!quake.control, !quake.ref) -> ()
  %next = quake.x [%control neg [true]] %wire
      : (!quake.control, !quake.wire) -> !quake.wire
  return %next : !quake.wire
}

