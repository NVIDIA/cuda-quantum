// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr) -> !llvm.ptr attributes {"qir-api"} {
// CHECK:           %[[MLIR_0:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK:           %[[MLIR_1:.*]] = llvm.mlir.addressof @__nvqir__qis__x__ctl_values : !llvm.ptr
// CHECK:           %[[MLIR_2:.*]] = llvm.mlir.constant(0 : i64) : i64
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlValuesTargets(%[[MLIR_2]], %[[MLIR_2]], %[[MLIR_0]], %[[MLIR_0]], %[[MLIR_1]], %[[ARG0]], %[[MLIR_2]], %[[ARG1]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, !llvm.ptr, i64, !llvm.ptr) -> ()
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlValuesTargets(%[[MLIR_2]], %[[MLIR_2]], %[[MLIR_0]], %[[MLIR_0]], %[[MLIR_1]], %[[ARG0]], %[[MLIR_2]], %[[ARG2]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, !llvm.ptr, i64, !llvm.ptr) -> ()
// CHECK:           llvm.return %[[ARG2]] : !llvm.ptr
// CHECK:         }
