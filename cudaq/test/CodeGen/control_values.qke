// RUN: cudaq-opt %s --convert-to-qir-api --lower-to-cfg --cc-to-llvm \
// RUN:   --canonicalize | FileCheck %s
// RUN: cudaq-opt %s "--convert-to-qir-api=opaque-pointer=true" \
// RUN:   --lower-to-cfg --cc-to-llvm --canonicalize | FileCheck %s

func.func @ordered_controls(%theta: f64, %closed: !quake.ref,
                            %open_register: !quake.veq<?>, %open: !quake.ref,
                            %target: !quake.ref) {
  quake.rx<adj> (%theta) [%closed, %open_register, %open neg [false, true, true]] %target
      : (f64, !quake.ref, !quake.veq<?>, !quake.ref, !quake.ref) -> ()
  return
}

// CHECK-LABEL:   llvm.func @ordered_controls(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG4:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr) attributes {"qir-api"} {
// CHECK:           %[[MLIR_0:.*]] = llvm.mlir.constant(5 : i64) : i64
// CHECK:           %[[MLIR_1:.*]] = llvm.mlir.constant(2 : i64) : i64
// CHECK:           %[[MLIR_2:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK:           %[[MLIR_3:.*]] = llvm.mlir.addressof @__nvqir__qis__rx__ctl_values : !llvm.ptr
// CHECK:           %[[FNEG_0:.*]] = llvm.fneg %[[ARG0]] : f64
// CHECK:           %[[CALL_0:.*]] = llvm.call @__quantum__rt__array_get_size_1d(%[[ARG2]]) : (!llvm.ptr) -> i64
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlsTargets_v2(%[[MLIR_2]], %[[MLIR_2]], %[[MLIR_1]], %[[MLIR_2]], %[[MLIR_3]], %[[MLIR_0]], %[[FNEG_0]], %[[CALL_0]], %[[ARG2]], %[[ARG1]], %[[ARG3]], %[[ARG4]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, i64, f64, i64, !llvm.ptr, !llvm.ptr, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           llvm.return
// CHECK:         }

// Mixed register and qubit controls keep the same grouping with and without
// control values. The mask bits follow that grouping.
func.func @grouped_controls(%control: !quake.ref, %register: !quake.veq<?>,
                            %first: !quake.ref, %second: !quake.ref) {
  quake.x [%control, %register] %first
      : (!quake.ref, !quake.veq<?>, !quake.ref) -> ()
  quake.swap [%control, %register neg [true, false]] %first, %second
      : (!quake.ref, !quake.veq<?>, !quake.ref, !quake.ref) -> ()
  return
}

// CHECK-LABEL:   llvm.func @grouped_controls(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr) attributes {"qir-api"} {
// CHECK:           %[[MLIR_0:.*]] = llvm.mlir.constant(2 : i64) : i64
// CHECK:           %[[MLIR_1:.*]] = llvm.mlir.addressof @__nvqir__qis__swap__ctl_values : !llvm.ptr
// CHECK:           %[[MLIR_2:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK:           %[[MLIR_3:.*]] = llvm.mlir.constant(0 : i64) : i64
// CHECK:           %[[MLIR_4:.*]] = llvm.mlir.addressof @__quantum__qis__x__ctl : !llvm.ptr
// CHECK:           %[[CALL_0:.*]] = llvm.call @__quantum__rt__array_get_size_1d(%[[ARG1]]) : (!llvm.ptr) -> i64
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlsTargets(%[[MLIR_3]], %[[MLIR_2]], %[[MLIR_2]], %[[MLIR_2]], %[[MLIR_4]], %[[CALL_0]], %[[ARG1]], %[[ARG0]], %[[ARG2]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, i64, !llvm.ptr, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           %[[CALL_1:.*]] = llvm.call @__quantum__rt__array_get_size_1d(%[[ARG1]]) : (!llvm.ptr) -> i64
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlsTargets_v2(%[[MLIR_3]], %[[MLIR_2]], %[[MLIR_2]], %[[MLIR_0]], %[[MLIR_1]], %[[MLIR_0]], %[[CALL_1]], %[[ARG1]], %[[ARG0]], %[[ARG2]], %[[ARG3]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, i64, i64, !llvm.ptr, !llvm.ptr, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           llvm.return
// CHECK:         }

// Adjoint S and T call their sdg and tdg callbacks.
func.func @adjoint_phase_gates(%control: !quake.ref, %target: !quake.ref) {
  quake.s<adj> [%control neg [true]] %target : (!quake.ref, !quake.ref) -> ()
  quake.t<adj> [%control neg [true]] %target : (!quake.ref, !quake.ref) -> ()
  return
}

