// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr) -> !llvm.struct<(ptr, ptr)> attributes {"qir-api"} {
// CHECK:           %[[MLIR_0:.*]] = llvm.mlir.poison : !llvm.struct<(ptr, ptr)>
// CHECK:           %[[MLIR_1:.*]] = llvm.mlir.addressof @cstr.5800 : !llvm.ptr
// CHECK:           %[[MLIR_2:.*]] = llvm.mlir.addressof @phase_matrix : !llvm.ptr
// CHECK:           %[[MLIR_3:.*]] = llvm.mlir.addressof @cstr.00 : !llvm.ptr
