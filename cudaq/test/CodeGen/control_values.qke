// CHECK:           %[[ALLOCA_0:.*]] = llvm.alloca %[[MLIR_8]] x !llvm.array<1 x struct<(ptr, i64)>> : (i32) -> !llvm.ptr
// CHECK:           %[[CALL_0:.*]] = llvm.call @__quantum__rt__array_create_1d(%[[MLIR_4]], %[[MLIR_7]]) : (i32, i64) -> !llvm.ptr
// CHECK:           %[[CALL_1:.*]] = llvm.call @__quantum__rt__array_get_element_ptr_1d(%[[CALL_0]], %[[MLIR_6]]) : (!llvm.ptr, i64) -> !llvm.ptr
// CHECK:           llvm.store %[[ARG2]], %[[CALL_1]] : !llvm.ptr, !llvm.ptr
// CHECK:           %[[CALL_2:.*]] = llvm.call @__quantum__rt__array_create_1d(%[[MLIR_4]], %[[MLIR_7]]) : (i32, i64) -> !llvm.ptr
// CHECK:           %[[CALL_3:.*]] = llvm.call @__quantum__rt__array_get_element_ptr_1d(%[[CALL_2]], %[[MLIR_6]]) : (!llvm.ptr, i64) -> !llvm.ptr
// CHECK:           llvm.store %[[ARG1]], %[[CALL_3]] : !llvm.ptr, !llvm.ptr
// CHECK:           %[[CALL_4:.*]] = llvm.call @llvm.stacksave.p0() : () -> !llvm.ptr
// CHECK:           llvm.br ^bb1
// CHECK:         ^bb1:
// CHECK:           %[[CALL_5:.*]] = llvm.call @__quantum__rt__array_get_size_1d(%[[CALL_2]]) : (!llvm.ptr) -> i64
// CHECK:           %[[ALLOCA_1:.*]] = llvm.alloca %[[CALL_5]] x i32 : (i64) -> !llvm.ptr
// CHECK:           llvm.store %[[MLIR_5]], %[[ALLOCA_1]] : i32, !llvm.ptr
// CHECK:           llvm.call @__nvqir__qis__custom_unitary__adj__ctl_values(%[[MLIR_2]], %[[CALL_2]], %[[ALLOCA_1]], %[[CALL_5]], %[[CALL_0]], %[[MLIR_3]]) : (!llvm.ptr, !llvm.ptr, !llvm.ptr, i64, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           llvm.br ^bb2
// CHECK:         ^bb2:
// CHECK:           llvm.call @llvm.stackrestore.p0(%[[CALL_4]]) : (!llvm.ptr) -> ()
// CHECK:           %[[CALL_6:.*]] = llvm.call @__quantum__rt__array_create_1d(%[[MLIR_4]], %[[MLIR_7]]) : (i32, i64) -> !llvm.ptr
// CHECK:           %[[CALL_7:.*]] = llvm.call @__quantum__rt__array_get_element_ptr_1d(%[[CALL_6]], %[[MLIR_6]]) : (!llvm.ptr, i64) -> !llvm.ptr
// CHECK:           llvm.store %[[ARG1]], %[[CALL_7]] : !llvm.ptr, !llvm.ptr
// CHECK:           %[[CALL_8:.*]] = llvm.call @__quantum__rt__array_create_1d(%[[MLIR_4]], %[[MLIR_7]]) : (i32, i64) -> !llvm.ptr
// CHECK:           %[[CALL_9:.*]] = llvm.call @__quantum__rt__array_get_element_ptr_1d(%[[CALL_8]], %[[MLIR_6]]) : (!llvm.ptr, i64) -> !llvm.ptr
// CHECK:           llvm.store %[[ARG2]], %[[CALL_9]] : !llvm.ptr, !llvm.ptr
// CHECK:           llvm.store %[[MLIR_1]], %[[ALLOCA_0]] : !llvm.ptr, !llvm.ptr
