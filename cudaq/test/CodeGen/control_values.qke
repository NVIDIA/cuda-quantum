// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !llvm.ptr) attributes {"qir-api"} {
// CHECK:           %[[MLIR_0:.*]] = llvm.mlir.addressof @__nvqir__qis__tdg__ctl_values : !llvm.ptr
// CHECK:           %[[MLIR_1:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK:           %[[MLIR_2:.*]] = llvm.mlir.constant(0 : i64) : i64
// CHECK:           %[[MLIR_3:.*]] = llvm.mlir.addressof @__nvqir__qis__sdg__ctl_values : !llvm.ptr
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlsTargets_v2(%[[MLIR_2]], %[[MLIR_2]], %[[MLIR_1]], %[[MLIR_1]], %[[MLIR_3]], %[[MLIR_1]], %[[ARG0]], %[[ARG1]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, i64, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           llvm.call @generalizedInvokeWithRotationsControlsTargets_v2(%[[MLIR_2]], %[[MLIR_2]], %[[MLIR_1]], %[[MLIR_1]], %[[MLIR_0]], %[[MLIR_1]], %[[ARG0]], %[[ARG1]]) vararg(!llvm.func<void (i64, i64, i64, i64, ptr, ...)>) : (i64, i64, i64, i64, !llvm.ptr, i64, !llvm.ptr, !llvm.ptr) -> ()
// CHECK:           llvm.return
// CHECK:         }

// U2 and controlled PhasedRx use the control-value ABI even with closed controls.
func.func @two_parameter_gates(%theta: f64, %phi: f64,
                               %control: !quake.ref, %target: !quake.ref) {
  quake.u2 (%theta, %phi) %target : (f64, f64, !quake.ref) -> ()
  quake.u2<adj> (%theta, %phi) [%control neg [true]] %target
      : (f64, f64, !quake.ref, !quake.ref) -> ()
  quake.phased_rx (%theta, %phi) [%control neg [false]] %target
      : (f64, f64, !quake.ref, !quake.ref) -> ()
  quake.phased_rx<adj> (%theta, %phi) [%control neg [true]] %target
      : (f64, f64, !quake.ref, !quake.ref) -> ()
  return
}

