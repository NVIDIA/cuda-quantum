// CHECK-NEXT:           %[[MLIR_1:.*]] = llvm.mlir.constant(1 : i64) : i64
// CHECK-NEXT:           %[[MLIR_2:.*]] = llvm.mlir.constant(1 : i32) : i32
// CHECK-NEXT:           %[[ALLOCA_0:.*]] = llvm.alloca %[[MLIR_2]] x !llvm.array<1 x struct<(ptr, i64)>> : (i32) -> !llvm.ptr
// CHECK-NEXT:           %[[FNEG_0:.*]] = llvm.fneg %[[ARG0]] : f64
// CHECK-NEXT:           llvm.store %[[MLIR_0]], %[[ALLOCA_0]] : !llvm.ptr, !llvm.ptr
// CHECK-NEXT:           %[[GETELEMENTPTR_0:.*]] = llvm.getelementptr %[[ALLOCA_0]][0, 0, 1] : (!llvm.ptr) -> !llvm.ptr, !llvm.array<1 x struct<(ptr, i64)>>
// CHECK-NEXT:           llvm.store %[[MLIR_1]], %[[GETELEMENTPTR_0]] : i64, !llvm.ptr
// CHECK-NEXT:           %[[CALL_0:.*]] = llvm.call @__quantum__rt__array_get_size_1d(%[[ARG1]]) : (!llvm.ptr) -> i64
// CHECK-NEXT:           llvm.call @invokeExpPauliWithControlValues(%[[MLIR_1]], %[[MLIR_1]], %[[FNEG_0]], %[[ARG3]], %[[ALLOCA_0]], %[[MLIR_1]], %[[CALL_0]], %[[ARG1]], %[[ARG2]]) vararg(!llvm.func<void (i64, i64, f64, ptr, ptr, ...)>) : (i64, i64, f64, !llvm.ptr, !llvm.ptr, i64, i64, !llvm.ptr, !llvm.ptr) -> ()
// CHECK-NEXT:           llvm.return
// CHECK-NEXT:         }

func.func @wire_results(%theta: f64, %control: !quake.wire,
                        %target: !quake.wire) -> (!quake.wire, !quake.wire) {
  %custom_control, %custom_target = quake.custom_unitary_constant @phase_matrix<adj>
      [%control neg [true]] %target
      : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %pauli_control, %pauli_target = quake.exp_pauli (%theta)
      [%custom_control neg [true]] %custom_target to "X"
      : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  return %pauli_control, %pauli_target : !quake.wire, !quake.wire
}

