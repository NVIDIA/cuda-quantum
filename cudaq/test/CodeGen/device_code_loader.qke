// RUN: cudaq-opt %s --device-code-loader | FileCheck %s

// Preserve dependency order and deduplication for repeated calls, transitive
// calls, recursive calls, and instantiated callables. The second kernel is
// processed after registration symbols for the first kernel have been added.

func.func private @external(!cc.ptr<i8>)

func.func private @leaf() {
  func.call @direct() : () -> ()
  return
}

func.func private @direct() {
  func.call @leaf() : () -> ()
  return
}

func.func private @closure(%self: !cc.callable<() -> ()>) {
  func.call @leaf() : () -> ()
  return
}

func.func private @unrelated() {
  return
}

func.func private @values(%angle: f64, %q: !quake.ref) {
  %sum = arith.addf %angle, %angle : f64
  quake.rx (%sum) %q : (f64, !quake.ref) -> ()
  return
}

func.func @__nvqpp__mlirgen__first() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  func.call @direct() : () -> ()
  func.call @direct() : () -> ()
  %closure = cc.instantiate_callable @closure() : () -> !cc.callable<() -> ()>
  return
}

func.func @__nvqpp__mlirgen__second() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  func.call @direct() : () -> ()
  %q = quake.alloca !quake.ref
  %angle = arith.constant 0.5 : f64
  func.call @values(%angle, %q) : (f64, !quake.ref) -> ()
  quake.dealloc %q : !quake.ref
  return
}

// CHECK-LABEL: llvm.mlir.global private constant @firstCodeHolder.extract_device_code
// CHECK-SAME: func.func @__nvqpp__mlirgen__first
// CHECK-SAME: func.func private @direct
// CHECK-NOT: func.func private @direct
// CHECK-SAME: func.func private @leaf
// CHECK-NOT: func.func private @leaf
// CHECK-SAME: func.func private @closure
// CHECK-NOT: func.func private @unrelated
// CHECK-SAME: func.func private @external
// CHECK-LABEL: llvm.mlir.global private constant @secondCodeHolder.extract_device_code
// CHECK-SAME: func.func @__nvqpp__mlirgen__second
// CHECK-SAME: func.func private @direct
// CHECK-NOT: func.func private @direct
// CHECK-SAME: func.func private @leaf
// CHECK-NOT: func.func private @closure
// CHECK-NOT: func.func private @unrelated
// CHECK-SAME: func.func private @values(%arg0: f64
// CHECK-SAME: %arg1: !quake.ref
// CHECK-SAME: %0 = arith.addf %arg0, %arg0 : f64
// CHECK-SAME: quake.rx (%0) %arg1 : (f64, !quake.ref) -> ()
// CHECK-SAME: func.func private @external
