// CHECK-DAG:     tail call void @__quantum__rt__qubit_release(ptr %[[VAL_5]])
// CHECK-DAG:     tail call void @__quantum__rt__qubit_release(ptr %[[VAL_6]])
// CHECK:         ret void
// CHECK:       }
