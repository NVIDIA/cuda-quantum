// RUN: cudaq-opt --apply-op-specialization --aggressive-inlining --split-input-file --verify-diagnostics %s

func.func private @allocating_helper(%q: !quake.ref) {
  // expected-error@+1 {{qubit allocations are not supported inside an atomic quantum region; allocate in the caller and pass the qubits as arguments}}
  %ancilla = quake.alloca !quake.ref
  quake.x [%ancilla] %q : (!quake.ref, !quake.ref) -> ()
  return
}

func.func @marked_apply(%q: !quake.ref) attributes {atomic_quantum_region} {
  quake.apply @allocating_helper (%q) : (!quake.ref) -> ()
  return
}

// -----

func.func private @allocating_adjoint_helper(%q: !quake.ref) {
  // expected-error@+1 {{qubit allocations are not supported inside an atomic quantum region; allocate in the caller and pass the qubits as arguments}}
  %ancilla = quake.alloca !quake.ref
  quake.x [%ancilla] %q : (!quake.ref, !quake.ref) -> ()
  return
}

func.func @marked_adjoint_apply(%q: !quake.ref) attributes {atomic_quantum_region} {
  quake.apply<adj> @allocating_adjoint_helper (%q) : (!quake.ref) -> ()
  return
}
