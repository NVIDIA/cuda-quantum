// Store/load forwarding across region operations (cc.if, cc.loop, cc.scope) and
// across the edges of a CFG (cf.br, cf.cond_br). A fact must hold on every path
// that reaches a point. Block arguments of a block with several predecessors
// and the induction variables of a loop merge distinct values, so facts are
// never carried across those. See also dsr_forwarding.qke.

// RUN: cudaq-opt --dead-store-removal %s | FileCheck %s

func.func private @use(i32)
func.func private @opaque()

//===----------------------------------------------------------------------===//
// cc.if
//===----------------------------------------------------------------------===//

// What is known in front of a cc.if is known inside both of its branches.
func.func @if_forward_into_branch(%c: i1, %p: !cc.ptr<i32>, %v: i32) {
  cc.store %v, %p : !cc.ptr<i32>
  cc.if(%c) {
    %r = cc.load %p : !cc.ptr<i32>
    func.call @use(%r) : (i32) -> ()
  }
  return
}

// CHECK-LABEL: func.func @if_forward_into_branch(
// CHECK-SAME:      %[[C:.*]]: i1, %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32) {
// CHECK:         cc.store %[[V]], %[[P]]
// CHECK:         cc.if
// CHECK-NOT:       cc.load
// CHECK:           call @use(%[[V]])

// ... and after it, provided that nothing in the branches may have changed it.
func.func @if_forward_past_disjoint_store(%c: i1, %a: !cc.ptr<!cc.array<i32 x 4>>,
                                          %v: i32, %w: i32) -> i32 {
  %p0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p1 = cc.compute_ptr %a[1] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  cc.store %v, %p0 : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %w, %p1 : !cc.ptr<i32>
  }
  %r = cc.load %p0 : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_forward_past_disjoint_store(
// CHECK-SAME:      %[[C:.*]]: i1, %[[A:.*]]: !cc.ptr<!cc.array<i32 x 4>>, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK:         cc.if
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// A store in a branch to a location that may be the same one kills the fact.
func.func @if_killed_by_may_alias_store(%c: i1, %p: !cc.ptr<i32>,
                                        %q: !cc.ptr<i32>, %v: i32,
                                        %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %w, %q : !cc.ptr<i32>
  }
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_killed_by_may_alias_store(
// CHECK:         cc.if
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// A call in a branch clobbers memory that others can see, but not a stack slot
// whose address is not available to the callee.
func.func @if_call_clobbers_pointer(%c: i1, %p: !cc.ptr<i32>, %v: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cc.if(%c) {
    func.call @opaque() : () -> ()
  }
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_call_clobbers_pointer(
// CHECK:         cc.if
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

func.func @if_call_spares_private_slot(%c: i1, %v: i32) -> i32 {
  %s = cc.alloca i32
  cc.store %v, %s : !cc.ptr<i32>
  cc.if(%c) {
    func.call @opaque() : () -> ()
  }
  %r = cc.load %s : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_call_spares_private_slot(
// CHECK-SAME:      %[[C:.*]]: i1, %[[V:.*]]: i32) -> i32 {
// CHECK:         cc.if
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// What is learned inside a branch is not known after the cc.if.
func.func @if_inner_fact_not_known_after(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                         %w: i32) -> i32 {
  cc.if(%c) {
    cc.store %w, %p : !cc.ptr<i32>
  } else {
    cc.store %v, %p : !cc.ptr<i32>
  }
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_inner_fact_not_known_after(
// CHECK:         cc.if
// CHECK:         cc.store
// CHECK:         } else {
// CHECK:           cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// A store in front of a cc.if is not removed by a store after it, even if the
// cc.if does not touch the location: control may leave the function early.
func.func @store_not_erased_across_if(%c: i1, %a: !cc.ptr<!cc.array<i32 x 4>>,
                                      %v: i32, %w: i32, %x: i32) {
  %p0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p1 = cc.compute_ptr %a[1] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  cc.store %v, %p0 : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %x, %p1 : !cc.ptr<i32>
  }
  cc.store %w, %p0 : !cc.ptr<i32>
  return
}

// CHECK-LABEL: func.func @store_not_erased_across_if(
// CHECK-SAME:      %[[C:.*]]: i1, %[[A:.*]]: !cc.ptr<!cc.array<i32 x 4>>, %[[V:.*]]: i32, %[[W:.*]]: i32, %[[X:.*]]: i32) {
// CHECK:         cc.store %[[V]]
// CHECK:         cc.if
// CHECK:         cc.store %[[W]]

// A store in a branch does not remove the store in front of the cc.if: it is
// not overwritten when the branch is not taken.
func.func @store_not_erased_by_branch(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                      %w: i32) {
  cc.store %v, %p : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %w, %p : !cc.ptr<i32>
  }
  return
}

// CHECK-LABEL: func.func @store_not_erased_by_branch(
// CHECK-SAME:      %[[C:.*]]: i1, %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) {
// CHECK:         cc.store %[[V]], %[[P]]
// CHECK:         cc.if
// CHECK:           cc.store %[[W]], %[[P]]

//===----------------------------------------------------------------------===//
// cc.scope
//===----------------------------------------------------------------------===//

func.func @scope_forward_in_not_out(%p: !cc.ptr<i32>, %q: !cc.ptr<i32>,
                                    %v: i32, %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cc.scope {
    %r = cc.load %p : !cc.ptr<i32>
    func.call @use(%r) : (i32) -> ()
    cc.store %w, %q : !cc.ptr<i32>
  }
  %s = cc.load %q : !cc.ptr<i32>
  return %s : i32
}

// CHECK-LABEL: func.func @scope_forward_in_not_out(
// CHECK-SAME:      %[[P:.*]]: !cc.ptr<i32>, %[[Q:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK:         cc.scope {
// CHECK-NOT:       cc.load
// CHECK:           call @use(%[[V]])
// CHECK:         %[[S:.*]] = cc.load %[[Q]]
// CHECK:         return %[[S]]

//===----------------------------------------------------------------------===//
// cc.loop
//===----------------------------------------------------------------------===//

// A location that no iteration may write is the same on every iteration.
func.func @loop_invariant_forwarded(%a: !cc.ptr<!cc.array<i32 x 4>>, %n: i64,
                                    %v: i32, %w: i32) -> i32 {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %p0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p1 = cc.compute_ptr %a[1] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p2 = cc.compute_ptr %a[2] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  cc.store %v, %p0 : !cc.ptr<i32>
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      %r = cc.load %p0 : !cc.ptr<i32>
      cc.store %r, %p2 : !cc.ptr<i32>
      cc.store %w, %p1 : !cc.ptr<i32>
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  %after = cc.load %p0 : !cc.ptr<i32>
  return %after : i32
}

// CHECK-LABEL: func.func @loop_invariant_forwarded(
// CHECK-SAME:      %[[A:.*]]: !cc.ptr<!cc.array<i32 x 4>>, %[[N:.*]]: i64, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK:         cc.loop
// CHECK-NOT:       cc.load
// CHECK:           cc.store %[[V]], %{{.*}} : !cc.ptr<i32>
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// A store that may hit the location, on any iteration, keeps it out of the
// loop and out of what is known afterwards.
func.func @loop_dynamic_store_kills(%a: !cc.ptr<!cc.array<i32 x ?>>, %n: i64,
                                    %v: i32, %w: i32) -> i32 {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %p0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x ?>>) -> !cc.ptr<i32>
  cc.store %v, %p0 : !cc.ptr<i32>
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      %r = cc.load %p0 : !cc.ptr<i32>
      func.call @use(%r) : (i32) -> ()
      %pi = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
      cc.store %w, %pi : !cc.ptr<i32>
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  %after = cc.load %p0 : !cc.ptr<i32>
  return %after : i32
}

// CHECK-LABEL: func.func @loop_dynamic_store_kills(
// CHECK:         cc.loop
// CHECK:           %[[R:.*]] = cc.load
// CHECK:           call @use(%[[R]])
// CHECK:         %[[AFTER:.*]] = cc.load
// CHECK:         return %[[AFTER]]

// A call in the loop kills what others can see, but not a private stack slot.
func.func @loop_call(%p: !cc.ptr<i32>, %n: i64, %v: i32) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %s = cc.alloca i32
  cc.store %v, %p : !cc.ptr<i32>
  cc.store %v, %s : !cc.ptr<i32>
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      func.call @opaque() : () -> ()
      %rp = cc.load %p : !cc.ptr<i32>
      %rs = cc.load %s : !cc.ptr<i32>
      func.call @use(%rp) : (i32) -> ()
      func.call @use(%rs) : (i32) -> ()
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  return
}

// CHECK-LABEL: func.func @loop_call(
// CHECK-SAME:      %[[P:.*]]: !cc.ptr<i32>, %[[N:.*]]: i64, %[[V:.*]]: i32) {
// CHECK:         cc.loop
// CHECK:           call @opaque
// CHECK:           %[[RP:.*]] = cc.load %[[P]]
// CHECK-NOT:       cc.load
// CHECK:           call @use(%[[RP]])
// CHECK:           call @use(%[[V]])

// A fact established in the loop body holds in nested regions of that body.
func.func @loop_nested_if(%c: i1, %p: !cc.ptr<i32>, %n: i64, %v: i32) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      cc.store %v, %p : !cc.ptr<i32>
      cc.if(%c) {
        %r = cc.load %p : !cc.ptr<i32>
        func.call @use(%r) : (i32) -> ()
      }
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  return
}

// CHECK-LABEL: func.func @loop_nested_if(
// CHECK-SAME:      %[[C:.*]]: i1, %[[P:.*]]: !cc.ptr<i32>, %[[N:.*]]: i64, %[[V:.*]]: i32) {
// CHECK:         cc.store %[[V]], %[[P]]
// CHECK:         cc.if
// CHECK-NOT:       cc.load
// CHECK:           call @use(%[[V]])

//===----------------------------------------------------------------------===//
// CFG form
//===----------------------------------------------------------------------===//

// A block with a single predecessor sees what was known at the end of it, and
// so does the join of a diamond when both arms leave the location alone.
func.func @cfg_diamond_untouched(%c: i1, %a: !cc.ptr<!cc.array<i32 x 4>>,
                                 %v: i32, %w: i32) -> i32 {
  %p0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p1 = cc.compute_ptr %a[1] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p2 = cc.compute_ptr %a[2] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  cc.store %v, %p0 : !cc.ptr<i32>
  cf.cond_br %c, ^then, ^else
^then:
  %t = cc.load %p0 : !cc.ptr<i32>
  cc.store %t, %p2 : !cc.ptr<i32>
  cc.store %w, %p1 : !cc.ptr<i32>
  cf.br ^join
^else:
  cf.br ^join
^join:
  %r = cc.load %p0 : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @cfg_diamond_untouched(
// CHECK-SAME:      %[[C:.*]]: i1, %[[A:.*]]: !cc.ptr<!cc.array<i32 x 4>>, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK-NOT:     cc.load
// CHECK:         cc.store %[[V]], %{{.*}} : !cc.ptr<i32>
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// Both arms store the same value: that is known at the join.
func.func @cfg_diamond_same_value(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                  %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cf.cond_br %c, ^then, ^else
^then:
  cc.store %w, %p : !cc.ptr<i32>
  cf.br ^join
^else:
  cc.store %w, %p : !cc.ptr<i32>
  cf.br ^join
^join:
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @cfg_diamond_same_value(
// CHECK-SAME:      %[[C:.*]]: i1, %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK-NOT:     cc.load
// CHECK:         return %[[W]]

// The arms store different values: the join is a merge, nothing is known.
func.func @cfg_diamond_different_values(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                        %w: i32, %x: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cf.cond_br %c, ^then, ^else
^then:
  cc.store %w, %p : !cc.ptr<i32>
  cf.br ^join
^else:
  cc.store %x, %p : !cc.ptr<i32>
  cf.br ^join
^join:
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @cfg_diamond_different_values(
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// Only one arm stores: the stale value from before the branch is not known at
// the join.
func.func @cfg_diamond_one_arm_stores(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                      %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cf.cond_br %c, ^then, ^else
^then:
  cc.store %w, %p : !cc.ptr<i32>
  cf.br ^join
^else:
  cf.br ^join
^join:
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @cfg_diamond_one_arm_stores(
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// A store before a cf.cond_br is not overwritten on all paths.
func.func @cfg_store_not_erased_across_cond_br(%c: i1, %p: !cc.ptr<i32>,
                                               %v: i32, %w: i32) {
  cc.store %v, %p : !cc.ptr<i32>
  cf.cond_br %c, ^then, ^else
^then:
  cc.store %w, %p : !cc.ptr<i32>
  return
^else:
  return
}

// CHECK-LABEL: func.func @cfg_store_not_erased_across_cond_br(
// CHECK-SAME:      %[[C:.*]]: i1, %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) {
// CHECK:         cc.store %[[V]], %[[P]]
// CHECK:         cf.cond_br
// CHECK:         cc.store %[[W]], %[[P]]

// ... but a store before a cf.br to a block with no other predecessor is.
func.func @cfg_store_erased_across_br(%p: !cc.ptr<i32>, %v: i32, %w: i32) {
  cc.store %v, %p : !cc.ptr<i32>
  cf.br ^next
^next:
  cc.store %w, %p : !cc.ptr<i32>
  return
}

// CHECK-LABEL: func.func @cfg_store_erased_across_br(
// CHECK-SAME:      %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) {
// CHECK-NOT:     cc.store %[[V]]
// CHECK:         cc.store %[[W]], %[[P]]

// The loop calls a function, which may write anything that is not a private
// stack slot, so what was stored before the loop is not known in the header.
// (See dsr_cfg_loops.qke for what is known there otherwise.)
func.func @cfg_loop_header_call_kills_fact(%c: i1, %p: !cc.ptr<i32>, %v: i32) {
  cc.store %v, %p : !cc.ptr<i32>
  cf.br ^header(%v : i32)
^header(%x: i32):
  %r = cc.load %p : !cc.ptr<i32>
  func.call @use(%r) : (i32) -> ()
  cf.cond_br %c, ^header(%x : i32), ^exit
^exit:
  return
}

// CHECK-LABEL: func.func @cfg_loop_header_call_kills_fact(
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         call @use(%[[R]])

// A loop with more stores than are listed in a summary. It must still be
// assumed to write what the last of them writes.
func.func @loop_many_stores(%a: !cc.ptr<!cc.array<i32 x 128>>, %p: !cc.ptr<i32>,
                            %n: i64, %v: i32) -> i32 {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  cc.store %v, %p : !cc.ptr<i32>
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      %e0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e0 : !cc.ptr<i32>
      %e1 = cc.compute_ptr %a[1] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e1 : !cc.ptr<i32>
      %e2 = cc.compute_ptr %a[2] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e2 : !cc.ptr<i32>
      %e3 = cc.compute_ptr %a[3] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e3 : !cc.ptr<i32>
      %e4 = cc.compute_ptr %a[4] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e4 : !cc.ptr<i32>
      %e5 = cc.compute_ptr %a[5] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e5 : !cc.ptr<i32>
      %e6 = cc.compute_ptr %a[6] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e6 : !cc.ptr<i32>
      %e7 = cc.compute_ptr %a[7] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e7 : !cc.ptr<i32>
      %e8 = cc.compute_ptr %a[8] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e8 : !cc.ptr<i32>
      %e9 = cc.compute_ptr %a[9] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e9 : !cc.ptr<i32>
      %e10 = cc.compute_ptr %a[10] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e10 : !cc.ptr<i32>
      %e11 = cc.compute_ptr %a[11] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
      cc.store %v, %e11 : !cc.ptr<i32>
      %e12 = cc.compute_ptr %a[12] : (!cc.ptr<!cc.array<i32 x 128>>) -> !cc.ptr<i32>
