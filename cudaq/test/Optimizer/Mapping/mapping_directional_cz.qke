// RUN: cudaq-opt '--qubit-mapping=device=file(%S/mapping_directional.txt) placement=identity search=none' %s | FileCheck --implicit-check-not=quake.h --implicit-check-not=quake.swap %s
// RUN: cudaq-opt '--qubit-mapping=device=file(%S/mapping_directional.txt) placement=identity search=none' %s | CircuitCheck --up-to-mapping %s

quake.wire_set @wires[2147483647]

func.func @forward_controlled_z() {
  %q0 = quake.borrow_wire @wires[0] : !quake.wire
  %q1 = quake.borrow_wire @wires[1] : !quake.wire
  %z:2 = quake.z [%q0] %q1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.return_wire %z#0 : !quake.wire
  quake.return_wire %z#1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @forward_controlled_z
// CHECK:           %[[FQ0:.*]] = quake.borrow_wire @mapped_wireset[0]
// CHECK:           %[[FQ1:.*]] = quake.borrow_wire @mapped_wireset[1]
// CHECK:           %[[FZ:.*]]:2 = quake.z {{\[}}%[[FQ0]]] %[[FQ1]]
// CHECK-NOT:       quake.z

func.func @reverse_controlled_z() {
  %q0 = quake.borrow_wire @wires[0] : !quake.wire
  %q1 = quake.borrow_wire @wires[1] : !quake.wire
  %z:2 = quake.z [%q1] %q0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.return_wire %z#0 : !quake.wire
  quake.return_wire %z#1 : !quake.wire
  return
}

// CZ is symmetric, so exchanging its physical operand roles implements the
// same unitary without the Hadamards required by a reverse CX.

// CHECK-LABEL:   func.func @reverse_controlled_z
// CHECK:           %[[RQ0:.*]] = quake.borrow_wire @mapped_wireset[0]
// CHECK:           %[[RQ1:.*]] = quake.borrow_wire @mapped_wireset[1]
// CHECK:           %[[RZ:.*]]:2 = quake.z {{\[}}%[[RQ0]]] %[[RQ1]]
// CHECK-NOT:       quake.z
