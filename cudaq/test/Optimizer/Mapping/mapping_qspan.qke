// CHECK-LABEL:   quake.wire_set @mapped_wireset[5] adjacency sparse<{{\[\[}}0, 1], [1, 2], [1, 0], [2, 3], [2, 1], [3, 4], [3, 2], [4, 3]], true> : tensor<5x5xi1> attributes {sym_visibility = "private"}
// CHECK:         quake.wire_set @wires[2147483647]
// CHECK-LABEL:   func.func @__nvqpp__mlirgen__function_foo._Z3foov() attributes {"cudaq-entrypoint", "cudaq-kernel", mapping_v2p = [2, 1, 0, 3, 4], no_this} {
// CHECK:           %[[BORROW_WIRE_0:.*]] = quake.borrow_wire @mapped_wireset[0] : !quake.wire
// CHECK:           %[[BORROW_WIRE_1:.*]] = quake.borrow_wire @mapped_wireset[1] : !quake.wire
// CHECK:           %[[BORROW_WIRE_2:.*]] = quake.borrow_wire @mapped_wireset[2] : !quake.wire
// CHECK:           %[[BORROW_WIRE_3:.*]] = quake.borrow_wire @mapped_wireset[3] : !quake.wire
// CHECK:           %[[BORROW_WIRE_4:.*]] = quake.borrow_wire @mapped_wireset[4] : !quake.wire
// CHECK:           %[[X_0:.*]] = quake.x %[[BORROW_WIRE_1]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_1:.*]] = quake.x %[[BORROW_WIRE_2]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_2:.*]] = quake.x %[[BORROW_WIRE_3]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_3:.*]] = quake.x %[[BORROW_WIRE_4]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[H_0:.*]] = quake.h %[[BORROW_WIRE_0]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[H_1:.*]] = quake.h %[[X_3]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[SWAP_0:.*]]:2 = quake.swap %[[H_0]], %[[X_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[SWAP_1:.*]]:2 = quake.swap %[[H_1]], %[[X_2]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[X_4:.*]]:2 = quake.x {{\[}}%[[X_1]]] %[[SWAP_0]]#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_0:.*]] = quake.t<adj> %[[X_4]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_5:.*]]:2 = quake.x {{\[}}%[[SWAP_0]]#0] %[[T_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_1:.*]] = quake.t %[[X_5]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_6:.*]]:2 = quake.x {{\[}}%[[X_4]]#0] %[[T_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_2:.*]] = quake.t<adj> %[[X_6]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_7:.*]]:2 = quake.x {{\[}}%[[X_5]]#0] %[[T_2]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_3:.*]] = quake.t %[[X_7]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[H_2:.*]] = quake.h %[[T_3]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[SWAP_2:.*]]:2 = quake.swap %[[X_6]]#0, %[[H_2]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[X_8:.*]]:2 = quake.x {{\[}}%[[X_7]]#0] %[[SWAP_2]]#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_4:.*]] = quake.t<adj> %[[X_8]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_9:.*]]:2 = quake.x {{\[}}%[[X_8]]#0] %[[T_4]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_5:.*]] = quake.t %[[X_9]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[T_6:.*]] = quake.t %[[X_9]]#0 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_10:.*]]:2 = quake.x {{\[}}%[[SWAP_2]]#0] %[[SWAP_1]]#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_7:.*]] = quake.t<adj> %[[X_10]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_11:.*]]:2 = quake.x {{\[}}%[[SWAP_1]]#0] %[[T_7]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_8:.*]] = quake.t %[[X_11]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_12:.*]]:2 = quake.x {{\[}}%[[X_10]]#0] %[[T_8]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_9:.*]] = quake.t<adj> %[[X_12]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_13:.*]]:2 = quake.x {{\[}}%[[X_11]]#0] %[[T_9]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_10:.*]] = quake.t %[[X_13]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[H_3:.*]] = quake.h %[[T_10]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[SWAP_3:.*]]:2 = quake.swap %[[X_13]]#0, %[[H_3]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[X_14:.*]]:2 = quake.x {{\[}}%[[SWAP_3]]#1] %[[X_12]]#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_11:.*]] = quake.t<adj> %[[X_14]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_15:.*]]:2 = quake.x {{\[}}%[[X_14]]#0] %[[T_11]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_12:.*]] = quake.t %[[X_15]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[T_13:.*]] = quake.t %[[X_15]]#0 : (!quake.wire) -> !quake.wire
// CHECK:           %[[H_4:.*]] = quake.h %[[T_12]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_16:.*]]:2 = quake.x {{\[}}%[[T_5]]] %[[H_4]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_14:.*]] = quake.t<adj> %[[X_16]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[SWAP_4:.*]]:2 = quake.swap %[[T_6]], %[[X_16]]#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[X_17:.*]]:2 = quake.x {{\[}}%[[SWAP_4]]#1] %[[T_14]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_15:.*]] = quake.t %[[X_17]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[SWAP_5:.*]]:2 = quake.swap %[[SWAP_4]]#0, %[[X_17]]#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[X_18:.*]]:2 = quake.x {{\[}}%[[SWAP_5]]#1] %[[T_15]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_16:.*]] = quake.t<adj> %[[X_18]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[SWAP_6:.*]]:2 = quake.swap %[[SWAP_5]]#0, %[[X_18]]#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[X_19:.*]]:2 = quake.x {{\[}}%[[SWAP_6]]#1] %[[T_16]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_17:.*]] = quake.t %[[X_19]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_20:.*]]:2 = quake.x {{\[}}%[[X_19]]#0] %[[SWAP_6]]#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_18:.*]] = quake.t<adj> %[[X_20]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[X_21:.*]]:2 = quake.x {{\[}}%[[X_20]]#0] %[[T_18]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[T_19:.*]] = quake.t %[[X_21]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[T_20:.*]] = quake.t %[[X_21]]#0 : (!quake.wire) -> !quake.wire
// CHECK:           %[[H_5:.*]] = quake.h %[[T_17]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[EVINCE_0:.*]]:4 = quake.evince %[[T_20]], %[[T_19]], %[[T_13]], %[[SWAP_3]]#0 : (!quake.wire, !quake.wire, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire, !quake.wire, !quake.wire)
// CHECK:           quake.return_wire %[[EVINCE_0]]#1 : !quake.wire
// CHECK:           quake.return_wire %[[EVINCE_0]]#0 : !quake.wire
// CHECK:           quake.return_wire %[[H_5]] : !quake.wire
// CHECK:           quake.return_wire %[[EVINCE_0]]#2 : !quake.wire
// CHECK:           quake.return_wire %[[EVINCE_0]]#3 : !quake.wire
// CHECK:           return
// CHECK:         }

