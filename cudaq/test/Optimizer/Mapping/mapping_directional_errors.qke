// RUN: cudaq-opt '--qubit-mapping=device=file(%S/mapping_directional.txt) placement=identity search=none raise-fatal-errors=true' %s -split-input-file -verify-diagnostics
// RUN: cudaq-opt '--qubit-mapping=device=file(%S/mapping_directional.txt) placement=identity search=none' %s -split-input-file | FileCheck --check-prefix=COMPOSABLE %s

quake.wire_set @wires[2147483647]

// COMPOSABLE-LABEL: func.func @controlled_rx
// COMPOSABLE: quake.rx
func.func @controlled_rx() {
  %angle = arith.constant 5.000000e-01 : f64
  %q0 = quake.borrow_wire @wires[0] : !quake.wire
  %q1 = quake.borrow_wire @wires[1] : !quake.wire
  // expected-error @+1 {{is not supported by directional qubit mapping; only CX and CZ are supported as multi-qubit gates; run the decomposition pass before qubit mapping}}
  %rx:2 = quake.rx (%angle) [%q0] %q1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.return_wire %rx#0 : !quake.wire
  quake.return_wire %rx#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires[2147483647]

// COMPOSABLE-LABEL: func.func @controlled_r1
// COMPOSABLE: quake.r1
func.func @controlled_r1() {
  %angle = arith.constant 5.000000e-01 : f64
  %q0 = quake.borrow_wire @wires[0] : !quake.wire
  %q1 = quake.borrow_wire @wires[1] : !quake.wire
  // expected-error @+1 {{is not supported by directional qubit mapping; only CX and CZ are supported as multi-qubit gates; run the decomposition pass before qubit mapping}}
  %r1:2 = quake.r1 (%angle) [%q0] %q1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.return_wire %r1#0 : !quake.wire
  quake.return_wire %r1#1 : !quake.wire
  return
}

// -----

quake.wire_set @wires[2147483647]

// COMPOSABLE-LABEL: func.func @source_swap
// COMPOSABLE: quake.swap
func.func @source_swap() {
  %q0 = quake.borrow_wire @wires[0] : !quake.wire
  %q1 = quake.borrow_wire @wires[1] : !quake.wire
  // expected-error @+1 {{is not supported by directional qubit mapping; only CX and CZ are supported as multi-qubit gates; run the decomposition pass before qubit mapping}}
  %swap:2 = quake.swap %q0, %q1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.return_wire %swap#0 : !quake.wire
  quake.return_wire %swap#1 : !quake.wire
  return
}
