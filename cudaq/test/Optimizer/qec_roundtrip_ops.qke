// RUN: cudaq-opt %s | cudaq-opt | FileCheck %s

func.func @det_obs_roundtrip(%h0 : !quake.measure,
                              %h1 : !quake.measure,
                              %v : !cc.sequence<!quake.measure>) {
  qec.detector %h0 : !quake.measure {flag = "Hi"}
  qec.detector %h0, %h1 : !quake.measure, !quake.measure
  qec.detector %v : !cc.sequence<!quake.measure>
  qec.detector %h0, %v : !quake.measure, !cc.sequence<!quake.measure>
  qec.observable %h0 : !quake.measure
  qec.observable %h0 index 0 : !quake.measure
  qec.observable %h0 index 1 : !quake.measure
  qec.observable %v index 2 : !cc.sequence<!quake.measure>
  qec.pair_detectors %v, %v : !cc.sequence<!quake.measure>, !cc.sequence<!quake.measure>
  return
}

// CHECK-LABEL:   func.func @det_obs_roundtrip(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.measure, %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.measure, %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !cc.sequence<!quake.measure>) {
// CHECK:           qec.detector %[[ARG0]] : !quake.measure {flag = "Hi"}
// CHECK:           qec.detector %[[ARG0]], %[[ARG1]] : !quake.measure, !quake.measure
// CHECK:           qec.detector %[[ARG2]] : !cc.sequence<!quake.measure>
// CHECK:           qec.detector %[[ARG0]], %[[ARG2]] : !quake.measure, !cc.sequence<!quake.measure>
// CHECK:           qec.observable %[[ARG0]] : !quake.measure
// CHECK:           qec.observable %[[ARG0]] : !quake.measure
// CHECK:           qec.observable %[[ARG0]] index 1 : !quake.measure
// CHECK:           qec.observable %[[ARG2]] index 2 : !cc.sequence<!quake.measure>
// CHECK:           qec.pair_detectors %[[ARG2]], %[[ARG2]] : <!quake.measure>, <!quake.measure>
// CHECK:           return
// CHECK:         }
