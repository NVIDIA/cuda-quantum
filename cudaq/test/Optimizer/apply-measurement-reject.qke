// RUN: cudaq-opt --apply-op-specialization --split-input-file \
// RUN:   --verify-diagnostics %s

// A control variant of a kernel that measures cannot be built gate by gate:
// the basis change feeding the measurement and the outcome-conditioned reset
// would acquire the control, making the measurement outcome distribution
// depend on the control.

// expected-error@+1 {{contains measurements}}
func.func @erase(%arg0: !quake.veq<?>) {
  %0 = quake.extract_ref %arg0[2] : (!quake.veq<?>) -> !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %1 = quake.extract_ref %arg0[2] : (!quake.veq<?>) -> !quake.ref
  %measOut = quake.mz %1 name "fired" : (!quake.ref) -> !quake.measure
  %2 = quake.discriminate %measOut : (!quake.measure) -> i1
  cc.if(%2) {
    %3 = quake.extract_ref %arg0[0] : (!quake.veq<?>) -> !quake.ref
    %4 = quake.extract_ref %arg0[1] : (!quake.veq<?>) -> !quake.ref
    quake.z [%3] %4 : (!quake.ref, !quake.ref) -> ()
    %5 = quake.extract_ref %arg0[2] : (!quake.veq<?>) -> !quake.ref
    quake.x %5 : (!quake.ref) -> ()
  }
  return
}

func.func @caller() {
  %c = quake.alloca !quake.ref
  %q = quake.alloca !quake.veq<3>
  %qv = quake.relax_size %q : (!quake.veq<3>) -> !quake.veq<?>
  quake.apply @erase [%c] (%qv) : (!quake.ref, !quake.veq<?>) -> ()
  return
}

// -----

// The adjoint-controlled variant is refused for the same reason.

// expected-error@+1 {{contains measurements}}
func.func @measure_only(%arg0: !quake.veq<?>) {
  %0 = quake.extract_ref %arg0[0] : (!quake.veq<?>) -> !quake.ref
  quake.x %0 : (!quake.ref) -> ()
  %measOut = quake.mz %0 : (!quake.ref) -> !quake.measure
  return
}

func.func @caller_adj() {
  %c = quake.alloca !quake.ref
  %q = quake.alloca !quake.veq<2>
  %qv = quake.relax_size %q : (!quake.veq<2>) -> !quake.veq<?>
  quake.apply<adj> @measure_only [%c] (%qv) : (!quake.ref, !quake.veq<?>) -> ()
  return
}
