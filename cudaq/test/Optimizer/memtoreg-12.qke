// RUN: cudaq-opt --convert-to-linear-values %s | FileCheck %s

// factor-quantum-alloc splits %q into two !quake.ref allocations and rebuilds
// it with quake.concat for the run-time-indexed extract_ref. The quake.x
// through the concat may act on %a, so %a is not promoted to a wire. It stays
// in memory form, and neither the quake.h, the quake.mz nor the dealloc of %a
// gets an unwrap, wrap or sink.
func.func @concat_operands_stay_in_memory(%i: i64) {
  %q = quake.alloca !quake.veq<2>
  %a = quake.extract_ref %q[0] : (!quake.veq<2>) -> !quake.ref
  quake.h %a : (!quake.ref) -> ()
  %qi = quake.extract_ref %q[%i] : (!quake.veq<2>, i64) -> !quake.ref
  quake.x %qi : (!quake.ref) -> ()
  %m = quake.mz %a : (!quake.ref) -> !quake.measure
  quake.dealloc %q : !quake.veq<2>
  return
}

// CHECK-LABEL:   func.func @concat_operands_stay_in_memory(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_2:.*]] = quake.concat %[[VAL_0]], %[[VAL_1]] : (!quake.ref, !quake.ref) -> !quake.veq<2>
// CHECK:           quake.h %[[VAL_0]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_3:.*]] = quake.extract_ref %[[VAL_2]][%[[ARG0]]] : (!quake.veq<2>, i64) -> !quake.ref
// CHECK:           quake.x %[[VAL_3]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_4:.*]] = quake.mz %[[VAL_0]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.dealloc %[[VAL_0]] : !quake.ref
// CHECK:           quake.dealloc %[[VAL_1]] : !quake.ref
// CHECK:           return
// CHECK:         }
