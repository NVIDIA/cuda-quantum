// Level 1 runs the shared cleanup, and level 2 adds phase folding.

// RUN: cudaq-opt --dump-pass-pipeline \
// RUN:   "--two-qubit-gate-count-optimization-pipeline=level=1" %s \
// RUN:   -o /dev/null 2>&1 | FileCheck --check-prefix=LEVEL1 %s
// RUN: cudaq-opt --dump-pass-pipeline \
// RUN:   "--two-qubit-gate-count-optimization-pipeline=level=2" %s \
// RUN:   -o /dev/null 2>&1 | FileCheck --check-prefix=LEVEL2 %s

// LEVEL1:     dqe
// LEVEL1-NOT: phase-folding

// LEVEL2:     dqe
// LEVEL2:     phase-folding
