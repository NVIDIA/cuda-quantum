// RUN: cudaq-opt --pass-pipeline="builtin.module(hw-jit-prep-pipeline)" %s | FileCheck --check-prefix=LOWER %s
// RUN: cudaq-opt --pass-pipeline="builtin.module(hw-jit-prep-pipeline{lower-gates=false})" %s | FileCheck --check-prefix=KEEP %s

// A target that needs no gate lowering applies a negated control itself, so
// prep expands it into an `x` pair only when it lowers gates.
func.func @__nvqpp__mlirgen__function_negated_control() attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %q = quake.alloca !quake.veq<2>
  %0 = quake.extract_ref %q[0] : (!quake.veq<2>) -> !quake.ref
  %1 = quake.extract_ref %q[1] : (!quake.veq<2>) -> !quake.ref
  quake.x [%0 neg [true]] %1 : (!quake.ref, !quake.ref) -> ()
  return
}

// LOWER:      quake.x %[[C:.*]] : (!quake.ref) -> ()
// LOWER-NEXT: quake.x [%[[C]]] %{{.*}} : (!quake.ref, !quake.ref) -> ()
// LOWER-NEXT: quake.x %[[C]] : (!quake.ref) -> ()

// KEEP-NOT: quake.x %
// KEEP:     quake.x [%{{.*}} neg [true]] %{{.*}} : (!quake.ref, !quake.ref) -> ()
