// RUN: cudaq-opt -inject-implicit-output -add-measurements=use-evince=1 %s | FileCheck %s
// RUN: cudaq-opt -inject-implicit-output -memtoreg -add-measurements=use-evince=1 %s | FileCheck --check-prefix=VALUE %s
// RUN: cudaq-opt -add-dealloc -add-measurements %s | FileCheck --check-prefix=DEALLOC %s

module {
  func.func @reference() attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.alloca !quake.ref
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.h %2 : (!quake.ref) -> ()
    quake.x %1 : (!quake.ref) -> ()
    return
  }
}

// inject-implicit-output emits the evince ops in allocation order, so the
// measurements follow that order as well.

// CHECK-LABEL:   func.func @reference()
// CHECK:           %[[VEQ:.*]] = quake.alloca !quake.veq<2>
// CHECK:           %[[REF:.*]] = quake.alloca !quake.ref
// CHECK:           quake.x %[[REF]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[VEQ]] : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
// CHECK:           quake.evince %[[VEQ]] : (!quake.veq<2>) -> ()
// CHECK:           quake.mz %[[REF]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[REF]] : (!quake.ref) -> ()
// CHECK:           return

// The same in value semantics: the measured wire is threaded into the evince.

// VALUE-LABEL:   func.func @reference()
// VALUE:           %[[V_VEQ:.*]] = quake.alloca !quake.veq<2>
// VALUE:           %[[V_NULL:.*]] = quake.null_wire
// VALUE:           quake.mz %[[V_VEQ]] : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
// VALUE:           quake.evince %[[V_VEQ]] : (!quake.veq<2>) -> ()
// VALUE:           %[[V_MEAS:.*]], %[[V_WIRE:.*]] = quake.mz %{{.*}} : (!quake.wire) -> (!quake.measure, !quake.wire)
// VALUE:           quake.evince %[[V_WIRE]] : (!quake.wire) -> !quake.wire
// VALUE:           return

// add-dealloc generates the deallocations from a DenseSet, so their order is
// not stable. Match them in any order.

// DEALLOC-LABEL:   func.func @reference()
// DEALLOC:           %[[D_VEQ:.*]] = quake.alloca !quake.veq<2>
// DEALLOC:           %[[D_REF:.*]] = quake.alloca !quake.ref
// DEALLOC-DAG:       quake.mz %[[D_VEQ]] : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
// DEALLOC-DAG:       quake.mz %[[D_REF]] : (!quake.ref) -> !quake.measure
// DEALLOC-DAG:       quake.dealloc %[[D_VEQ]] : !quake.veq<2>
// DEALLOC-DAG:       quake.dealloc %[[D_REF]] : !quake.ref
// DEALLOC:           return
