// RUN: cudaq-opt -add-dealloc -add-measurements %s | FileCheck %s
// RUN: cudaq-opt -add-dealloc -memtoreg -add-measurements %s | FileCheck --check-prefix=VALUE %s

module {
  func.func @reference() attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.alloca !quake.ref
    %2 = quake.alloca !quake.ref
    %3 = quake.alloca !quake.veq<3>
    %4 = quake.alloca !quake.ref
    %5 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.h %5 : (!quake.ref) -> ()
    quake.x %1 : (!quake.ref) -> ()
    quake.x %2 : (!quake.ref) -> ()
    quake.x %4 : (!quake.ref) -> ()
    return
  }
}

// add-dealloc emits the deallocations in allocation order, so the measurements
// in front of them follow that order too. The CHECK lines below are
// deliberately ordered: an unordered container here would interleave them
// differently on every run.

// CHECK-LABEL:   func.func @reference()
// CHECK:           %[[VEQ2:.*]] = quake.alloca !quake.veq<2>
// CHECK:           %[[REF1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[REF2:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VEQ3:.*]] = quake.alloca !quake.veq<3>
// CHECK:           %[[REF3:.*]] = quake.alloca !quake.ref
// CHECK:           quake.mz %[[VEQ2]] : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
// CHECK:           quake.dealloc %[[VEQ2]] : !quake.veq<2>
// CHECK:           quake.mz %[[REF1]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.dealloc %[[REF1]] : !quake.ref
// CHECK:           quake.mz %[[REF2]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.dealloc %[[REF2]] : !quake.ref
// CHECK:           quake.mz %[[VEQ3]] : (!quake.veq<3>) -> !cc.sequence<!quake.measure>
// CHECK:           quake.dealloc %[[VEQ3]] : !quake.veq<3>
// CHECK:           quake.mz %[[REF3]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.dealloc %[[REF3]] : !quake.ref
// CHECK:           return

// The same order in value semantics, where the measured wire is threaded into
// the sink that replaced the deallocation.

// VALUE-LABEL:   func.func @reference()
// VALUE:           %[[V_VEQ2:.*]] = quake.alloca !quake.veq<2>
// VALUE:           %[[V_VEQ3:.*]] = quake.alloca !quake.veq<3>
// VALUE:         ^bb1(%[[W1:.*]]: !quake.wire, %[[W2:.*]]: !quake.wire, %[[W3:.*]]: !quake.wire):
// VALUE:           quake.mz %[[V_VEQ2]] : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
// VALUE:           quake.dealloc %[[V_VEQ2]] : !quake.veq<2>
// VALUE:           %{{.*}}, %[[S1:.*]] = quake.mz %[[W1]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// VALUE:           quake.sink %[[S1]] : !quake.wire
// VALUE:           %{{.*}}, %[[S2:.*]] = quake.mz %[[W2]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// VALUE:           quake.sink %[[S2]] : !quake.wire
// VALUE:           quake.mz %[[V_VEQ3]] : (!quake.veq<3>) -> !cc.sequence<!quake.measure>
// VALUE:           quake.dealloc %[[V_VEQ3]] : !quake.veq<3>
// VALUE:           %{{.*}}, %[[S3:.*]] = quake.mz %[[W3]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// VALUE:           quake.sink %[[S3]] : !quake.wire
// VALUE:           return
