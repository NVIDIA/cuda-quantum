// Read-only reset-after-measure checking of the physical-quake profile. A
// proven missing reset is a `profile violation`; a case that cannot be
// proven (unresolved aliasing, unsupported control flow, unclassified
// operations) is `cannot verify`. Both fail the pass. Checking is
// intra-function and uses the entry block's operation order; it never relies
// on a linear walk order across regions: any function touching quantum
// references without a single-block straight-line body is unverifiable.

// RUN: cudaq-opt --verify-profile-physical-quake='reset-after-measure=true' --split-input-file %s 2>/dev/null | FileCheck --check-prefix=OK %s
// RUN: not cudaq-opt --verify-profile-physical-quake='reset-after-measure=true' --split-input-file %s 2>&1 1>/dev/null | FileCheck --check-prefix=ERR %s
// RUN: cudaq-opt --verify-profile-physical-quake --split-input-file %s 2>/dev/null | FileCheck --check-prefix=OFF %s

// A measured reference may be measured again, must be reset before a gate
// reuses it, and may be measured terminally afterwards.

// OK-LABEL: func.func @reset_then_gate(
func.func @reset_then_gate(%q: !quake.ref) {
  %m0 = quake.mz %q : (!quake.ref) -> !quake.measure
  %m1 = quake.mz %q : (!quake.ref) -> !quake.measure
  quake.reset %q : (!quake.ref) -> ()
  quake.x %q : (!quake.ref) -> ()
  %m2 = quake.mz %q : (!quake.ref) -> !quake.measure
  return
}

// -----

// Deallocating a measured register ends its lifetime: no reset needed.

// OK-LABEL: func.func @measure_then_dealloc(
func.func @measure_then_dealloc(%v: !quake.veq<2>) {
  %m = quake.mz %v : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
  quake.dealloc %v : !quake.veq<2>
  return
}

// -----

// A reset measured reference may serve as a control.

// OK-LABEL: func.func @control_after_reset(
func.func @control_after_reset(%q: !quake.ref, %t: !quake.ref) {
  %m = quake.mz %q : (!quake.ref) -> !quake.measure
  quake.reset %q : (!quake.ref) -> ()
  quake.x [%q] %t : (!quake.ref, !quake.ref) -> ()
  return
}

// -----

// A compiler-generated evince is bookkeeping, not quantum reuse.

// OK-LABEL: func.func @evince_is_bookkeeping(
func.func @evince_is_bookkeeping(%v: !quake.veq<1>) {
  %m = quake.mz %v : (!quake.veq<1>) -> !cc.sequence<!quake.measure>
  quake.evince %v : (!quake.veq<1>) -> () {compilerGenerated}
  return
}

// -----

// Extracting a reference is bookkeeping; using it before any measurement is
// unconstrained, and a terminal measurement creates no further obligation.

// OK-LABEL: func.func @extract_then_measure(
func.func @extract_then_measure(%v: !quake.veq<2>) {
  %e = quake.extract_ref %v[0] : (!quake.veq<2>) -> !quake.ref
  quake.x %e : (!quake.ref) -> ()
  %m = quake.mz %e : (!quake.ref) -> !quake.measure
  return
}

// -----

// A gate on a measured reference without an intervening reset is a proven
// violation.

// ERR: error: 'quake.x' op profile violation: measured qubit is reused without a required reset
// OFF-LABEL: func.func @violation_gate_use(
func.func @violation_gate_use(%q: !quake.ref) {
  %m = quake.mz %q : (!quake.ref) -> !quake.measure
  quake.x %q : (!quake.ref) -> ()
  return
}

// -----

// Repeated measurement is exempt but does not clear the obligation.

// ERR: error: 'quake.h' op profile violation: measured qubit is reused without a required reset
// OFF-LABEL: func.func @violation_remeasure_use(
func.func @violation_remeasure_use(%q: !quake.ref) {
  %m0 = quake.mz %q : (!quake.ref) -> !quake.measure
  %m1 = quake.mz %q : (!quake.ref) -> !quake.measure
  quake.h %q : (!quake.ref) -> ()
  return
}

// -----

// The obligation is created by any measurement axis (mz, mx, my).

// ERR: error: 'quake.x' op profile violation: measured qubit is reused without a required reset
func.func @violation_mx_axis(%q: !quake.ref) {
  %m = quake.mx %q : (!quake.ref) -> !quake.measure
  quake.x %q : (!quake.ref) -> ()
  return
}

// -----

// A control is a use: a measured control needs a reset first.

// ERR: error: 'quake.x' op profile violation: measured qubit is reused without a required reset
func.func @violation_control_use(%c: !quake.ref, %t: !quake.ref) {
  %m = quake.mz %c : (!quake.ref) -> !quake.measure
  quake.x [%c] %t : (!quake.ref, !quake.ref) -> ()
  return
}

// -----

// A register measured as a whole is reused by a vector gate on it.

// ERR: error: 'quake.x' op profile violation: measured qubit is reused without a required reset
func.func @violation_veq_use(%v: !quake.veq<2>) {
  %m = quake.mz %v : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
  quake.x %v : (!quake.veq<2>) -> ()
  return
}

// -----

// A reset of one reference cannot be proven to reset another that may alias
// it: conservatively unverifiable. (Resolution of allocation/extract aliases
// is a follow-up.)

// ERR: error: 'quake.reset' op cannot verify reset-after-measure: reference may alias a measured qubit
func.func @reset_may_alias(%q0: !quake.ref, %q1: !quake.ref) {
  %m0 = quake.mz %q0 : (!quake.ref) -> !quake.measure
  %m1 = quake.mz %q1 : (!quake.ref) -> !quake.measure
  quake.reset %q0 : (!quake.ref) -> ()
  quake.reset %q1 : (!quake.ref) -> ()
  quake.x %q0 : (!quake.ref) -> ()
  quake.x %q1 : (!quake.ref) -> ()
  return
}

// -----

// Distinct references are never assumed to be distinct qubits: a use of one
// while another holds an obligation cannot be proven conformant.

// ERR: error: 'quake.x' op cannot verify reset-after-measure: reference may alias a measured qubit
func.func @distinct_refs_may_alias(%q0: !quake.ref, %q1: !quake.ref) {
  %m = quake.mz %q0 : (!quake.ref) -> !quake.measure
  quake.x %q1 : (!quake.ref) -> ()
  return
}

// -----

// A reference extracted from a measured register may alias a measured qubit:
// the extract itself is bookkeeping, the use is unverifiable.

// ERR: error: 'quake.x' op cannot verify reset-after-measure: reference may alias a measured qubit
func.func @extract_may_alias(%v: !quake.veq<2>) {
  %m = quake.mz %v : (!quake.veq<2>) -> !cc.sequence<!quake.measure>
  %e = quake.extract_ref %v[0] : (!quake.veq<2>) -> !quake.ref
  quake.x %e : (!quake.ref) -> ()
  return
}

// -----

// Control flow has no linear order to check against: a function that touches
// quantum references outside a single straight-line block is unverifiable.

// ERR: error: 'quake.mz' op cannot verify reset-after-measure: unsupported control flow
// OFF-LABEL: func.func @control_flow_unsupported(
func.func @control_flow_unsupported(%q: !quake.ref, %b: i1) {
  %m = quake.mz %q : (!quake.ref) -> !quake.measure
  cc.if(%b) {
    quake.x %q : (!quake.ref) -> ()
  } else {
  }
  return
}

// -----

// A call with quantum references cannot be classified from the caller alone:
// conservatively unverifiable whether or not an obligation is outstanding.

// ERR: error: 'func.call' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func private @ext_kernel(!quake.ref)
func.func @call_with_ref(%q: !quake.ref) {
  quake.x %q : (!quake.ref) -> ()
  func.call @ext_kernel(%q) : (!quake.ref) -> ()
  return
}

// -----

// An application is not traversed interprocedurally: same conservative
// failure.

// ERR: error: 'quake.apply' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func @apply_helper(%q: !quake.ref) {
  quake.x %q : (!quake.ref) -> ()
  return
}
func.func @apply_with_ref(%q: !quake.ref) {
  quake.x %q : (!quake.ref) -> ()
  quake.apply @apply_helper (%q) : (!quake.ref) -> ()
  return
}

// -----

// A callable's body is opaque: while any obligation is outstanding it may
// touch the measured qubits invisibly.

// ERR: error: 'quake.compute_action' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func @compute_action_with_obligation(%q: !quake.ref,
                                          %c1: !cc.callable<() -> ()>,
                                          %c2: !cc.callable<() -> ()>) {
  %m = quake.mz %q : (!quake.ref) -> !quake.measure
  quake.compute_action %c1, %c2 : !cc.callable<() -> ()>, !cc.callable<() -> ()>
  return
}

// -----

// A callable invocation is opaque even with no obligation outstanding: the
// callable body may measure and reuse invisibly.

// ERR: error: 'cc.call_callable' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func @callable_no_obligation(%c: !cc.callable<() -> ()>) {
  cc.call_callable %c : (!cc.callable<() -> ()>) -> ()
  return
}

// -----

// A call producing a quantum reference has invisible provenance: the
// returned qubit may already be measured.

// ERR: error: 'func.call' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func private @get_ref() -> !quake.ref
func.func @call_produces_ref() {
  %q = func.call @get_ref() : () -> !quake.ref
  quake.x %q : (!quake.ref) -> ()
  return
}

// -----

// An external declared a quantum kernel is not trusted classical, even with
// no quantum references crossing the boundary.

// ERR: error: 'func.call' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func private @external_marked_kernel() attributes {"cudaq-kernel"}
func.func @call_marked_kernel() {
  func.call @external_marked_kernel() : () -> ()
  return
}

// -----

// A dynamic call target may be a quantum kernel: unresolvable, untrusted.

// ERR: error: 'func.call_indirect' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func @call_indirect_target(%fn: () -> ()) {
  func.call_indirect %fn() : () -> ()
  return
}

// -----

// compute_action is opaque with or without outstanding obligations.

// ERR: error: 'quake.compute_action' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func @compute_action_no_obligation(%c1: !cc.callable<() -> ()>,
                                         %c2: !cc.callable<() -> ()>) {
  quake.compute_action %c1, %c2 : !cc.callable<() -> ()>, !cc.callable<() -> ()>
  return
}


// -----

// An application is a quantum invocation even with no operands: the
// trusted-classical convention never extends to it.

// ERR: error: 'quake.apply' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func private @ext_unmarked_helper()
func.func @apply_no_args() {
  quake.apply @ext_unmarked_helper () : () -> ()
  return
}

// -----

// An unmarked external with a classical signature is trusted classical by
// convention, as in the basis and measurement-form checks.

// OK-LABEL: func.func @trusted_classical_external(
func.func private @log_classical(i64)
func.func @trusted_classical_external() {
  %c = arith.constant 1 : i64
  func.call @log_classical(%c) : (i64) -> ()
  return
}

// -----

// A call into an available in-module body with a classical signature is
// checked in the callee; the caller side is transparent.

// OK-LABEL: func.func @calls_local_classical(
func.func @local_classical(%n: i64) -> i64 {
  %r = arith.addi %n, %n : i64
  return %r : i64
}
func.func @calls_local_classical() {
  %c = arith.constant 1 : i64
  %r = func.call @local_classical(%c) : (i64) -> i64
  return
}

// -----

// A retained (deprecated) call_by_ref is likewise a quantum invocation:
// no classical-call exemption for an unavailable body.

// ERR: error: 'quake.call_by_ref' op cannot verify reset-after-measure: operation cannot be proven not to reuse a measured qubit
func.func private @cbr_ext_helper()
func.func @call_by_ref_no_args() {
  quake.call_by_ref @cbr_ext_helper() : () -> ()
  return
}

// -----

// An application with an available in-module body and nothing quantum
// crossing is checked in the callee.

// OK-LABEL: func.func @apply_available(
func.func @avail_helper() {
  %q = quake.alloca !quake.ref
  quake.x %q : (!quake.ref) -> ()
  return
}
func.func @apply_available() {
  quake.apply @avail_helper () : () -> ()
  return
}
