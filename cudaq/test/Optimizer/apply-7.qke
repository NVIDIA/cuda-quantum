// CPROP:           return
// CPROP:         }

// Self-referential closure data (the angle) is not a flat argument, so its
// constant is baked directly into a specialized clone of @thunk_cp.ctrl —
// not into @lifted_cp.ctrl — which the wrapper below then targets instead.
// CPROP-LABEL:   func.func private @thunk_cp.ctrl.0(
// CPROP-SAME:      %[[ARG0:.*]]: !quake.veq<?>,
// CPROP-SAME:      %[[ARG1:.*]]: !cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG2:.*]]: !quake.veq<?>) {
// CPROP:           %[[CONSTANT_0:.*]] = arith.constant 1.500000e+00 : f64
// CPROP:           %[[INSTANTIATE_CALLABLE_0:.*]] = cc.instantiate_callable @lifted_cp.ctrl_closurev(%[[ARG0]]) : (!quake.veq<?>) -> !cc.callable<(f64, !quake.veq<?>) -> ()>
// CPROP:           call @lifted_cp.ctrl_closurev(%[[INSTANTIATE_CALLABLE_0]], %[[CONSTANT_0]], %[[ARG2]]) : (!cc.callable<(f64, !quake.veq<?>) -> ()>, f64, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

// CPROP-LABEL:   func.func private @thunk_cp.ctrl_closurer(
// CPROP-SAME:      %[[ARG0:.*]]: !cc.callable<(!quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG1:.*]]: !quake.veq<?>) {
// CPROP:           %[[UNPACK:.*]]:2 = cc.callable_closure %[[ARG0]] : (!cc.callable<(!quake.veq<?>) -> ()>) -> (f64, !quake.ref)
// CPROP:           %[[CONCAT_0:.*]] = quake.concat %[[UNPACK]]#1 : (!quake.ref) -> !quake.veq<?>
// CPROP:           %[[INNER_SELF:.*]] = cc.instantiate_callable @thunk_cp.ctrl.0(%[[UNPACK]]#0) : (f64) -> !cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>
// CPROP:           call @thunk_cp.ctrl.0(%[[CONCAT_0]], %[[INNER_SELF]], %[[ARG1]]) : (!quake.veq<?>, !cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

// CPROP-LABEL:   func.func private @kernel.ctrl_closurer(
// CPROP-SAME:      %[[ARG0:.*]]: !cc.callable<(!quake.veq<?>, f64) -> ()>,
// CPROP-SAME:      %[[ARG1:.*]]: !quake.veq<?>,
// CPROP-SAME:      %[[ARG2:.*]]: f64) {
// CPROP:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG0]] : (!cc.callable<(!quake.veq<?>, f64) -> ()>) -> !quake.ref
// CPROP:           %[[CONCAT_0:.*]] = quake.concat %[[CALLABLE_CLOSURE_0]] : (!quake.ref) -> !quake.veq<?>
// CPROP:           call @kernel.ctrl(%[[CONCAT_0]], %[[ARG1]], %[[ARG2]]) : (!quake.veq<?>, !quake.veq<?>, f64) -> ()

// CPROP-LABEL:   func.func private @thunk.ctrl_closurer(
// CPROP-SAME:      %[[ARG0:.*]]: !cc.callable<(!quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG1:.*]]: !quake.veq<?>) {
// CPROP:           %[[UNPACK:.*]]:2 = cc.callable_closure %[[ARG0]] : (!cc.callable<(!quake.veq<?>) -> ()>) -> (f64, !quake.ref)
// CPROP:           %[[CONCAT_0:.*]] = quake.concat %[[UNPACK]]#1 : (!quake.ref) -> !quake.veq<?>
// CPROP:           %[[INNER_SELF:.*]] = cc.instantiate_callable @thunk.ctrl(%[[UNPACK]]#0) : (f64) -> !cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>
// CPROP:           call @thunk.ctrl(%[[CONCAT_0]], %[[INNER_SELF]], %[[ARG1]]) : (!quake.veq<?>, !cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

// CPROP-LABEL:   func.func private @lifted.ctrl_closurev(
// CPROP-SAME:      %[[ARG0:.*]]: !cc.callable<(f64, !quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG1:.*]]: f64,
// CPROP-SAME:      %[[ARG2:.*]]: !quake.veq<?>) {
// CPROP:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG0]] : (!cc.callable<(f64, !quake.veq<?>) -> ()>) -> !quake.veq<?>
// CPROP:           %[[CONCAT_0:.*]] = quake.concat %[[CALLABLE_CLOSURE_0]] : (!quake.veq<?>) -> !quake.veq<?>
// CPROP:           call @lifted.ctrl(%[[CONCAT_0]], %[[ARG1]], %[[ARG2]]) : (!quake.veq<?>, f64, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

// CPROP-LABEL:   func.func private @lifted_cp.ctrl_closurev(
// CPROP-SAME:      %[[ARG0:.*]]: !cc.callable<(f64, !quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG1:.*]]: f64,
// CPROP-SAME:      %[[ARG2:.*]]: !quake.veq<?>) {
// CPROP:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG0]] : (!cc.callable<(f64, !quake.veq<?>) -> ()>) -> !quake.veq<?>
// CPROP:           %[[CONCAT_0:.*]] = quake.concat %[[CALLABLE_CLOSURE_0]] : (!quake.veq<?>) -> !quake.veq<?>
// CPROP:           call @lifted_cp.ctrl(%[[CONCAT_0]], %[[ARG1]], %[[ARG2]]) : (!quake.veq<?>, f64, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

