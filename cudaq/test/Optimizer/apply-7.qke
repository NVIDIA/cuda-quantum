// CPROP:           call @thunk.ctrl_closurer(%[[INSTANTIATE_CALLABLE_0]], %[[ARG1]]) : (!cc.callable<(!quake.veq<?>) -> ()>, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

