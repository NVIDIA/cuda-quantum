// CPROP:           %[[INSTANTIATE_CALLABLE_0:.*]] = cc.instantiate_callable @thunk_cp.ctrl_closurer(%[[CONSTANT_0]], %[[ARG0]]) : (f64, !quake.ref) -> !cc.callable<(!quake.veq<?>) -> ()>
