// CPROP-SAME:      %[[ARG0:.*]]: !quake.veq<?>,
// CPROP-SAME:      %[[ARG1:.*]]: !cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG2:.*]]: !quake.veq<?>) {
// CPROP:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG1]] : (!cc.callable<(!quake.veq<?>, !quake.veq<?>) -> ()>) -> f64
// CPROP:           %[[INSTANTIATE_CALLABLE_0:.*]] = cc.instantiate_callable @lifted.ctrl_closurev(%[[ARG0]]) : (!quake.veq<?>) -> !cc.callable<(f64, !quake.veq<?>) -> ()>
// CPROP:           call @lifted.ctrl_closurev(%[[INSTANTIATE_CALLABLE_0]], %[[CALLABLE_CLOSURE_0]], %[[ARG2]]) : (!cc.callable<(f64, !quake.veq<?>) -> ()>, f64, !quake.veq<?>) -> ()
// CPROP:           return
// CPROP:         }

// CPROP-LABEL:   func.func private @lifted(
// CPROP:           quake.ry (%

// CPROP-LABEL:   func.func private @thunk(
// CPROP-SAME:      %[[ARG0:.*]]: !cc.callable<(!quake.veq<?>) -> ()>,
// CPROP-SAME:      %[[ARG1:.*]]: !quake.veq<?>) {
// CPROP:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG0]] : (!cc.callable<(!quake.veq<?>) -> ()>) -> f64
// CPROP:           call @lifted(%[[CALLABLE_CLOSURE_0]], %[[ARG1]]) : (f64, !quake.veq<?>) -> ()
