// CHECK:           quake.t<adj> %[[ARG0]] : (!quake.ref) -> ()

// CHECK-LABEL:   func.func private @marked.ctrl(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.veq<?>, %[[ARG1:.*]]: !quake.ref) attributes {atomic_quantum_region} {
// CHECK:           quake.t {{\[}}%[[ARG0]]] %[[ARG1]] : (!quake.veq<?>, !quake.ref) -> ()

// CHECK-LABEL:   func.func private @marked(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.ref) attributes {atomic_quantum_region} {
// CHECK:           quake.t %[[ARG0]] : (!quake.ref) -> ()

// CHECK-LABEL:   func.func private @ordinary(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.ref) {
// CHECK:           quake.t %[[ARG0]] : (!quake.ref) -> ()

// CHECK-LABEL:   func.func @caller(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.ref, %[[ARG1:.*]]: !quake.ref) {
// CHECK:           call @marked.adj(%[[ARG1]]) : (!quake.ref) -> ()
// CHECK:           %[[INSTANTIATE_CALLABLE_0:.*]] = cc.instantiate_callable @marked.ctrl_closurer(%[[ARG0]]) : (!quake.ref) -> !cc.callable<(!quake.ref) -> ()>
// CHECK:           call @marked.ctrl_closurer(%[[INSTANTIATE_CALLABLE_0]], %[[ARG1]]) : (!cc.callable<(!quake.ref) -> ()>, !quake.ref) -> ()
// CHECK:           %[[INSTANTIATE_CALLABLE_1:.*]] = cc.instantiate_callable @marked.adj_ctrl_closurer(%[[ARG0]]) : (!quake.ref) -> !cc.callable<(!quake.ref) -> ()>
// CHECK:           call @marked.adj_ctrl_closurer(%[[INSTANTIATE_CALLABLE_1]], %[[ARG1]]) : (!cc.callable<(!quake.ref) -> ()>, !quake.ref) -> ()
// CHECK:           call @ordinary.adj(%[[ARG1]]) : (!quake.ref) -> ()

// CHECK-LABEL:   func.func private @marked.adj_ctrl_closurer(
// CHECK-SAME:      %[[ARG0:.*]]: !cc.callable<(!quake.ref) -> ()>, %[[ARG1:.*]]: !quake.ref) {
// CHECK:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG0]] : (!cc.callable<(!quake.ref) -> ()>) -> !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[CALLABLE_CLOSURE_0]] : (!quake.ref) -> !quake.veq<?>
// CHECK:           call @marked.adj.ctrl(%[[CONCAT_0]], %[[ARG1]]) : (!quake.veq<?>, !quake.ref) -> ()

// CHECK-LABEL:   func.func private @marked.ctrl_closurer(
// CHECK-SAME:      %[[ARG0:.*]]: !cc.callable<(!quake.ref) -> ()>, %[[ARG1:.*]]: !quake.ref) {
// CHECK:           %[[CALLABLE_CLOSURE_0:.*]] = cc.callable_closure %[[ARG0]] : (!cc.callable<(!quake.ref) -> ()>) -> !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[CALLABLE_CLOSURE_0]] : (!quake.ref) -> !quake.veq<?>
// CHECK:           call @marked.ctrl(%[[CONCAT_0]], %[[ARG1]]) : (!quake.veq<?>, !quake.ref) -> ()


