// RUN: cudaq-opt --wireset-to-null-wires %s | FileCheck %s

// The entry-block borrows of `@phys[2]` and `@phys[0]` become null wires at
// the start of the block in identity order, and the borrow inside `cc.if`
// stays where it is.

quake.wire_set @phys[3]

func.func @__nvqpp__mlirgen__kernel() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %0 = quake.borrow_wire @phys[2] : !quake.wire
  %1 = quake.h %0 : (!quake.wire) -> !quake.wire
  %2 = quake.borrow_wire @phys[0] : !quake.wire
  %3:2 = quake.x [%1] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %measOut, %wires = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %4 = quake.discriminate %measOut : (!quake.measure) -> i1
  cc.if(%4) {
    %5 = quake.borrow_wire @phys[1] : !quake.wire
    %6 = quake.h %5 : (!quake.wire) -> !quake.wire
    quake.return_wire %6 : !quake.wire
  } else {
  }
  quake.return_wire %3#0 : !quake.wire
  quake.return_wire %wires : !quake.wire
  return
}

// CHECK-NOT:     quake.wire_set
// CHECK-LABEL:   func.func @__nvqpp__mlirgen__kernel()
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]] = quake.h %[[VAL_1]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[VAL_3:.*]]:2 = quake.x [%[[VAL_2]]] %[[VAL_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           cc.if(
// CHECK:             %[[VAL_4:.*]] = quake.null_wire
// CHECK:             %[[VAL_5:.*]] = quake.h %[[VAL_4]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.sink %[[VAL_5]] : !quake.wire
// CHECK:           }
// CHECK:           quake.sink %[[VAL_3]]#0 : !quake.wire
// CHECK:           quake.sink
// CHECK-NOT:       quake.borrow_wire
// CHECK-NOT:       quake.return_wire
// CHECK:           return
