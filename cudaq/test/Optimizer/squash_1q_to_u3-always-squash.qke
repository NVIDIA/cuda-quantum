// RUN: cudaq-opt --convert-to-linear-values --squash-1q-to-u3=always-squash --canonicalize %s | \
// RUN:   FileCheck %s

// `always-squash` rewrites even a single gate. A Hadamard becomes
// U3(pi/2, 0, pi), with every angle exact.

// CHECK-LABEL: func.func @single(
// CHECK-DAG:     %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK-DAG:     %[[HALF_PI:.*]] = arith.constant 1.5707963267948966 : f64
// CHECK-DAG:     %[[ZERO:.*]] = arith.constant 0.000000e+00 : f64
// CHECK:         quake.unwrap
// CHECK-NEXT:    quake.u3 (%[[HALF_PI]], %[[ZERO]], %[[PI]])
// CHECK-NEXT:    quake.wrap
func.func @single(%q: !quake.ref) {
  quake.h %q : (!quake.ref) -> ()
  return
}
