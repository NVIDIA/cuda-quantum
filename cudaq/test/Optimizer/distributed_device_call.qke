  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbInt on %dev (%arg0) : (i64, i32) -> i32
  return
}
