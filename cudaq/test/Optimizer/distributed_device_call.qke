// A static struct result that is too large for registers is returned through a
// hidden sret pointer, and static structs that are too large for registers are
// passed `byval`, on x86_64. The 16-byte struct is passed in two registers. Both attributes
// must be on the callee's declaration and on the call itself, and each
// argument's position must account for the sret pointer in front of it and the two-register struct.
module attributes {llvm.triple = "x86_64-unknown-linux-gnu"} {
func.func @__nvqpp__mlirgen__call_big_x86_64(%arg0 : i32, %arg1 : !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>, %arg2 : !cc.struct<"Two" {i64, i64} [128,8]>, %arg3 : !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>) attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbBig_x86_64 on %dev (%arg0, %arg1, %arg2, %arg3) : (i64, i32, !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>, !cc.struct<"Two" {i64, i64} [128,8]>, !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>) -> !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>
  return
}
func.func private @cbBig_x86_64(i32, !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>, !cc.struct<"Two" {i64, i64} [128,8]>, !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>) -> !cc.struct<"Big" {i64, i64, i64, i64} [256,8]> attributes {"cudaq-devicecall"}
}

