// A result with dynamic parts is returned from the marshal function in heap
// memory, which the caller takes over. The caller moves it to its own stack and
// frees the heap storage. For a nested result that is done one element at a
// time. The unmarshal side makes the result a copy of its own, in heap memory,
// before it destroys the host value that the callback returned.
func.func @__nvqpp__mlirgen__call_own_vec(%arg0 : i32) -> !cc.sequence<i32> attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbOwnVec on %dev (%arg0) : (i64, i32) -> !cc.sequence<i32>
  return %1 : !cc.sequence<i32>
}
