// RUN: cudaq-opt -canonicalize -distributed-device-call -cse -split-input-file %s | FileCheck %s

// Regression coverage for the generalized, distributed-memory reference
// `device_call` lowering: marshal/unmarshal generation for a variety of
// argument and result types passed through the pointer-free communication
// buffer. `i32`/`i64` stand in for `int`/`long`/`long long` (which all share
// the same bit width on this target); `i8`/`i16` stand in for `char`/`short`.
// Each case is its own module (-split-input-file) so the generated
// marshal/unmarshal functions for one case can't be confused with another's;
// the greedy pattern rewriter does not otherwise guarantee output order
// matches source declaration order.
//
// Note: std::vector<std::vector<T>> (recursively dynamic) and a struct
// containing a vector are both covered, as arguments (call_vecvec_arg,
// call_structvec_arg) and as return types (call_vecvec_ret,
// call_structvec_ret) -- return types recurse arbitrarily deep, which
// call_vecvecvec_ret (below) confirms one level further with a triple-nested
// vector.

// clang-format off

func.func @__nvqpp__mlirgen__call_bool(%arg0 : i1) attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbBool on %dev (%arg0) : (i64, i1) -> i1
  return
}
func.func private @cbBool(i1) -> i1 attributes {"cudaq-devicecall"}

// CHECK-LABEL:   func.func @marshal.cbBool(
// CHECK-SAME:      %{{.*}}: i1) -> i1 {
// CHECK:           %{{.*}} = call @__nvqpp__device_callback_run
// CHECK:           %{{.*}} = cc.compute_ptr %{{.*}}[1]
// CHECK:           %[[LD:.*]] = cc.load %{{.*}} : !cc.ptr<i1>
// CHECK:           return %[[LD]] : i1
// CHECK-LABEL:   func.func @unmarshal.cbBool(
// CHECK:           %[[CALL:.*]] = call @cbBool(%{{.*}}) : (i1) -> i1
// CHECK:           cc.store %[[CALL]], %{{.*}} : !cc.ptr<i1>

// -----

func.func @__nvqpp__mlirgen__call_char(%arg0 : i8) attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbChar on %dev (%arg0) : (i64, i8) -> i8
  return
}
func.func private @cbChar(i8) -> i8 attributes {"cudaq-devicecall"}

// CHECK-LABEL:   func.func @marshal.cbChar(
// CHECK-SAME:      %{{.*}}: i8) -> i8 {
// CHECK-LABEL:   func.func @unmarshal.cbChar(
// CHECK:           %{{.*}} = call @cbChar(%{{.*}}) : (i8) -> i8

// -----

func.func @__nvqpp__mlirgen__call_short(%arg0 : i16) attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbShort on %dev (%arg0) : (i64, i16) -> i16
