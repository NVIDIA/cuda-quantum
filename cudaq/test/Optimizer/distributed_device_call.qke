  %dev = arith.constant 0 : i64
  %1 = cc.device_call @cbChar on %dev (%arg0) : (i64, i8) -> i8
  return
}
func.func private @cbChar(i8) -> i8 attributes {"cudaq-devicecall"}

// CHECK-LABEL:   func.func @marshal.cbChar(
