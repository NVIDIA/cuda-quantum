func.func @__nvqpp__mlirgen__call_double(%arg0 : f64) attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %dev = arith.constant 0 : i64
