// X86-SAME:      !cc.ptr<!cc.struct<"Big" {i64, i64, i64, i64} [256,8]>> {llvm.sret = !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>}, i32,
// X86-SAME:      !cc.ptr<!cc.struct<"Big" {i64, i64, i64, i64} [256,8]>> {llvm.byval = !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>}, i64, i64,
// X86-SAME:      !cc.ptr<!cc.struct<"Big" {i64, i64, i64, i64} [256,8]>> {llvm.byval = !cc.struct<"Big" {i64, i64, i64, i64} [256,8]>})
