// RUN: cudaq-opt --apply-op-specialization --split-input-file %s | FileCheck %s

// Measured uncomputation under control. The scratch qubit is allocated by the
// kernel and measured in the X basis: the compute Toffoli and the payload
// receive the control, the measurement does not, and inside the
// outcome-conditioned block the feedforward CZ receives the control
// (outcome AND control) while the reset of the measured qubit does not.

func.func @mbu(%arg0: !quake.veq<?>) {
  %anc = quake.alloca !quake.ref
  %0 = quake.extract_ref %arg0[0] : (!quake.veq<?>) -> !quake.ref
  %1 = quake.extract_ref %arg0[1] : (!quake.veq<?>) -> !quake.ref
  quake.x [%0, %1] %anc : (!quake.ref, !quake.ref, !quake.ref) -> ()
  quake.z %anc : (!quake.ref) -> ()
  %measOut = quake.mx %anc name "fired" : (!quake.ref) -> !quake.measure
  %2 = quake.discriminate %measOut : (!quake.measure) -> i1
  cc.if(%2) {
    %3 = quake.extract_ref %arg0[0] : (!quake.veq<?>) -> !quake.ref
    %4 = quake.extract_ref %arg0[1] : (!quake.veq<?>) -> !quake.ref
    quake.z [%3] %4 : (!quake.ref, !quake.ref) -> ()
    quake.x %anc : (!quake.ref) -> ()
  }
  quake.dealloc %anc : !quake.ref
  return
}

func.func @caller() {
  %c = quake.alloca !quake.ref
  %q = quake.alloca !quake.veq<2>
  %qv = quake.relax_size %q : (!quake.veq<2>) -> !quake.veq<?>
  quake.apply @mbu [%c] (%qv) : (!quake.ref, !quake.veq<?>) -> ()
  return
}

// CHECK-LABEL:   func.func private @mbu.ctrl(
// CHECK-SAME:      %[[CTRL:.*]]: !quake.veq<?>, %[[Q:.*]]: !quake.veq<?>) {
// CHECK:           %[[ANC:.*]] = quake.alloca !quake.ref
// CHECK:           quake.x {{\[}}%[[CTRL]], %{{.*}}, %{{.*}}] %[[ANC]] : (!quake.veq<?>, !quake.ref, !quake.ref, !quake.ref) -> ()
// CHECK:           quake.z {{\[}}%[[CTRL]]] %[[ANC]] : (!quake.veq<?>, !quake.ref) -> ()
// CHECK:           %[[M:.*]] = quake.mx %[[ANC]] name "fired" : (!quake.ref) -> !quake.measure
// CHECK:           %[[BIT:.*]] = quake.discriminate %[[M]] : (!quake.measure) -> i1
// CHECK:           cc.if(%[[BIT]]) {
// CHECK:             quake.z {{\[}}%[[CTRL]], %{{.*}}] %{{.*}} : (!quake.veq<?>, !quake.ref, !quake.ref) -> ()
// CHECK:             quake.x %[[ANC]] : (!quake.ref) -> ()
// CHECK:           }
// CHECK:           quake.dealloc %[[ANC]]
// CHECK:           return

// -----

// The same with a scratch qubit extracted from a locally allocated register
// and a Y-basis measurement.

func.func @mbu_y(%arg0: !quake.veq<?>) {
  %scratch = quake.alloca !quake.veq<1>
  %anc = quake.extract_ref %scratch[0] : (!quake.veq<1>) -> !quake.ref
  %0 = quake.extract_ref %arg0[0] : (!quake.veq<?>) -> !quake.ref
  %1 = quake.extract_ref %arg0[1] : (!quake.veq<?>) -> !quake.ref
  quake.x [%0, %1] %anc : (!quake.ref, !quake.ref, !quake.ref) -> ()
  %anc2 = quake.extract_ref %scratch[0] : (!quake.veq<1>) -> !quake.ref
  %measOut = quake.my %anc2 : (!quake.ref) -> !quake.measure
  %2 = quake.discriminate %measOut : (!quake.measure) -> i1
  cc.if(%2) {
    %3 = quake.extract_ref %arg0[0] : (!quake.veq<?>) -> !quake.ref
    %4 = quake.extract_ref %arg0[1] : (!quake.veq<?>) -> !quake.ref
    quake.z [%3] %4 : (!quake.ref, !quake.ref) -> ()
    %anc3 = quake.extract_ref %scratch[0] : (!quake.veq<1>) -> !quake.ref
    quake.x %anc3 : (!quake.ref) -> ()
  }
  quake.dealloc %scratch : !quake.veq<1>
  return
}

func.func @caller_y() {
  %c = quake.alloca !quake.ref
  %q = quake.alloca !quake.veq<2>
  %qv = quake.relax_size %q : (!quake.veq<2>) -> !quake.veq<?>
  quake.apply @mbu_y [%c] (%qv) : (!quake.ref, !quake.veq<?>) -> ()
  return
}

// CHECK-LABEL:   func.func private @mbu_y.ctrl(
// CHECK-SAME:      %[[CTRL:.*]]: !quake.veq<?>, %[[Q:.*]]: !quake.veq<?>) {
// CHECK:           %[[SCR:.*]] = quake.alloca !quake.veq<1>
// CHECK:           %[[ANC:.*]] = quake.extract_ref %[[SCR]][0] : (!quake.veq<1>) -> !quake.ref
// CHECK:           quake.x {{\[}}%[[CTRL]], %{{.*}}, %{{.*}}] %[[ANC]] : (!quake.veq<?>, !quake.ref, !quake.ref, !quake.ref) -> ()
// CHECK:           %[[M:.*]] = quake.my %[[ANC]] : (!quake.ref) -> !quake.measure
// CHECK:           %[[BIT:.*]] = quake.discriminate %[[M]] : (!quake.measure) -> i1
// CHECK:           cc.if(%[[BIT]]) {
// CHECK:             quake.z {{\[}}%[[CTRL]], %{{.*}}] %{{.*}} : (!quake.veq<?>, !quake.ref, !quake.ref) -> ()
// CHECK:             quake.x %[[ANC]] : (!quake.ref) -> ()
// CHECK:           }
// CHECK:           return
