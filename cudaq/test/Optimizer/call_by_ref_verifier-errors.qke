// RUN: cudaq-opt %s -split-input-file -verify-diagnostics

// The trailing results of a `call_by_ref` are one per quantum argument.

func.func private @external_wait_call(f64, !quake.ref)

func.func @tooFewResults() {
  %0 = arith.constant 1.000000e+00 : f64
  %1 = quake.null_wire
  // expected-error @+1 {{must return exactly one quantum value per quantum argument}}
  quake.call_by_ref @external_wait_call(%0, %1) : (f64, !quake.wire) -> ()
  return
}

// -----

func.func private @external_two_qubit_call(f64, !quake.ref, !quake.ref)

func.func @tooManyResults() {
  %0 = arith.constant 1.000000e+00 : f64
  %1 = quake.null_wire
  %2 = quake.null_wire
  // expected-error @+1 {{must return exactly one quantum value per quantum argument}}
  %3:3 = quake.call_by_ref @external_two_qubit_call(%0, %1, %2) : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire, !quake.wire)
  quake.sink %3#0 : !quake.wire
  quake.sink %3#1 : !quake.wire
  quake.sink %3#2 : !quake.wire
  return
}
