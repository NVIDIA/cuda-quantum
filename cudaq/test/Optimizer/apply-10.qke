// RUN: cudaq-opt --apply-op-specialization %s | FileCheck %s

// A quake.apply with no controls, whose actuals mix a wire (-> ref formal)
// and a cable<N> (-> veq<N> formal), autogenerates a value-semantics clone of
// the callee named with a type-encoding suffix ("wc2": wire, cable<2>)
// instead of folding the wire/cable<->ref/veq coercions into the call site.
// Inside the clone, each converted argument is adapted back to ref/veq at
// entry (wrap_new; split_cable+wrap_new+concat) and converted back to
// wire/cable just before each func.return (unwrap; extract_ref+unwrap+
// bundle_cable), threading from the same value used for the body's quantum
// ops (reference semantics: the callee mutates the handle in place).
// Autogenerated clones are inserted ahead of all other functions, so their
// CHECK-LABELs must precede the ones for the functions in source order.

// CHECK-LABEL:   func.func private @two_qubit_kernel.wc2(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.wire, %[[ARG1:.*]]: !quake.cable<2>) -> (!quake.wire, !quake.cable<2>) {
// CHECK:           %[[WRAP_NEW_0:.*]] = quake.wrap_new %[[ARG0]] : (!quake.wire) -> !quake.ref
// CHECK:           %[[SPLIT_CABLE_0:.*]]:2 = quake.split_cable %[[ARG1]] : (!quake.cable<2>) -> (!quake.wire, !quake.wire)
// CHECK:           %[[WRAP_NEW_1:.*]] = quake.wrap_new %[[SPLIT_CABLE_0]]#0 : (!quake.wire) -> !quake.ref
// CHECK:           %[[WRAP_NEW_2:.*]] = quake.wrap_new %[[SPLIT_CABLE_0]]#1 : (!quake.wire) -> !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[WRAP_NEW_1]], %[[WRAP_NEW_2]] : (!quake.ref, !quake.ref) -> !quake.veq<2>
// CHECK:           quake.h %[[WRAP_NEW_0]] : (!quake.ref) -> ()
// CHECK:           quake.x %[[CONCAT_0]] : (!quake.veq<2>) -> ()
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[WRAP_NEW_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[CONCAT_0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[EXTRACT_REF_1:.*]] = quake.extract_ref %[[CONCAT_0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK:           %[[UNWRAP_2:.*]] = quake.unwrap %[[EXTRACT_REF_1]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[BUNDLE_CABLE_0:.*]] = quake.bundle_cable %[[UNWRAP_1]], %[[UNWRAP_2]] : (!quake.wire, !quake.wire) -> !quake.cable<2>
// CHECK:           return %[[UNWRAP_0]], %[[BUNDLE_CABLE_0]] : !quake.wire, !quake.cable<2>
// CHECK:         }

// Two apply ops calling the same callee with the same coercion pattern (both
// wire actuals into the same ref-formal position) share one memoized clone -
// only a single @k.w is generated, not two.
// CHECK-LABEL:   func.func private @k.w(
// CHECK:           quake.h
// CHECK:           return
// CHECK:         }

// CHECK-NOT:     func.func private @k.w(

func.func @two_qubit_kernel(%a : !quake.ref, %b : !quake.veq<2>) {
  quake.h %a : (!quake.ref) -> ()
  quake.x %b : (!quake.veq<2>) -> ()
  return
}

func.func @do_apply(%w : !quake.wire, %c : !quake.cable<2>) -> (!quake.wire, !quake.cable<2>) {
  %w1, %c1 = quake.apply @two_qubit_kernel(%w, %c) : (!quake.wire, !quake.cable<2>) -> (!quake.wire, !quake.cable<2>)
  return %w1, %c1 : !quake.wire, !quake.cable<2>
}

// CHECK-LABEL:   func.func @do_apply(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.wire, %[[ARG1:.*]]: !quake.cable<2>) -> (!quake.wire, !quake.cable<2>) {
// CHECK:           %[[CALL_0:.*]]:2 = call @two_qubit_kernel.wc2(%[[ARG0]], %[[ARG1]]) : (!quake.wire, !quake.cable<2>) -> (!quake.wire, !quake.cable<2>)
// CHECK:           return %[[CALL_0]]#0, %[[CALL_0]]#1 : !quake.wire, !quake.cable<2>
// CHECK:         }

func.func @k(%a : !quake.ref) {
  quake.h %a : (!quake.ref) -> ()
  return
}

func.func @do_memo_apply(%w1 : !quake.wire, %w2 : !quake.wire) -> (!quake.wire, !quake.wire) {
  %r1 = quake.apply @k(%w1) : (!quake.wire) -> !quake.wire
  %r2 = quake.apply @k(%w2) : (!quake.wire) -> !quake.wire
  return %r1, %r2 : !quake.wire, !quake.wire
}

// CHECK-LABEL:   func.func @do_memo_apply(
// CHECK-SAME:      %[[ARG0:.*]]: !quake.wire, %[[ARG1:.*]]: !quake.wire) -> (!quake.wire, !quake.wire) {
// CHECK:           %[[CALL_0:.*]] = call @k.w(%[[ARG0]]) : (!quake.wire) -> !quake.wire
// CHECK:           %[[CALL_1:.*]] = call @k.w(%[[ARG1]]) : (!quake.wire) -> !quake.wire
// CHECK:           return %[[CALL_0]], %[[CALL_1]] : !quake.wire, !quake.wire
// CHECK:         }
