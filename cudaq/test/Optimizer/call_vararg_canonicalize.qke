// RUN: cudaq-opt --canonicalize %s | FileCheck %s

// A vararg call to a func.func has no variadic tail: it is an ordinary call.
func.func private @plain(i32, f64) -> i64

// CHECK-LABEL: func.func @to_call(
// CHECK:         %[[R:.*]] = call @plain(%{{.*}}, %{{.*}}) : (i32, f64) -> i64
// CHECK-NOT:     cc.call_vararg
func.func @to_call(%a: i32, %b: f64) -> i64 {
  %r = cc.call_vararg @plain(%a, %b) : (i32, f64) -> i64
  return %r : i64
}

// A call to a variadic llvm.func stays a vararg call, extra arguments included.
llvm.func @my_variadic(i32, ...)

// CHECK-LABEL: func.func @stays(
// CHECK:         cc.call_vararg @my_variadic(%{{.*}}, %{{.*}}) : (i32, i32) -> ()
func.func @stays(%a: i32, %b: i32) {
  cc.call_vararg @my_variadic(%a, %b) : (i32, i32) -> ()
  return
}
