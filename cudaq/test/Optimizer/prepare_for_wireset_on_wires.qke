// On a kernel that is already on wires, as a `quake-unmapped` stage with value
// semantics leaves it, `prepare-for-wireset{add-wireset=true}` produces the
// same IR as `add-wireset` and `assign-wire-indices` alone, including for a
// loop that carries wires and is longer than the unroll limit. The input is the
// output of the first stage of `compiler-bench-nisq` at level 1.

// RUN: cudaq-opt --pass-pipeline='builtin.module(prepare-for-wireset{add-wireset=true maximum-iterations=1024})' \
// RUN:   %s > %t.prepare
// RUN: cudaq-opt --pass-pipeline='builtin.module(add-wireset,func.func(assign-wire-indices))' \
// RUN:   %s > %t.direct
// RUN: diff %t.prepare %t.direct
// RUN: FileCheck %s < %t.direct

func.func @__nvqpp__mlirgen__loop() attributes {"cudaq-entrypoint", "cudaq-kernel", no_this} {
  %c2000 = arith.constant 2000 : i64
  %c1 = arith.constant 1 : i64
  %c0 = arith.constant 0 : i64
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2 = quake.null_wire
  %3 = quake.h %2 : (!quake.wire) -> !quake.wire
  %4:3 = cc.loop while ((%i = %c0, %a = %0, %b = %1) -> (i64, !quake.wire, !quake.wire)) {
    %5 = arith.cmpi slt, %i, %c2000 : i64
    cc.condition %5(%i, %a, %b : i64, !quake.wire, !quake.wire)
  } do {
  ^bb0(%i: i64, %a: !quake.wire, %b: !quake.wire):
    %5 = quake.h %a : (!quake.wire) -> !quake.wire
    %6 = quake.h %b : (!quake.wire) -> !quake.wire
    %7:2 = quake.z [%5] %6 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
    %8 = quake.h %7#1 : (!quake.wire) -> !quake.wire
    cc.continue %i, %7#0, %8 : i64, !quake.wire, !quake.wire
  } step {
  ^bb0(%i: i64, %a: !quake.wire, %b: !quake.wire):
    %5 = arith.addi %i, %c1 : i64
    cc.continue %5, %a, %b : i64, !quake.wire, !quake.wire
  }
  %m0, %w0 = quake.mz %4#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %m1, %w1 = quake.mz %4#2 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %m2, %w2 = quake.mz %3 : (!quake.wire) -> (!quake.measure, !quake.wire)
  quake.sink %w0 : !quake.wire
  quake.sink %w1 : !quake.wire
  quake.sink %w2 : !quake.wire
  return
}

// CHECK:   quake.wire_set @wires[2147483647]
// CHECK-LABEL: func.func @__nvqpp__mlirgen__loop()
// CHECK-COUNT-3: quake.borrow_wire @wires
// CHECK:   cc.loop while
// CHECK-COUNT-3: quake.return_wire
