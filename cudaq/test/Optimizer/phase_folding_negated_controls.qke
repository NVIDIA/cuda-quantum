// RUN: cudaq-opt --verify-each --phase-folding="min-length=0 min-rz-weight=0" %s | FileCheck %s

// Hand-written wire form of Rz(a); open-CX; Rz(b); closed-CX; Rz(c).
// The two CNOTs invert the target, so the outer rotations cannot add.
func.func @phase_open(%a: f64, %b: f64, %c: f64, %control: !quake.ref, %target: !quake.ref) {
  %q = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %t = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %r0 = quake.rz (%a) %t : (f64, !quake.wire) -> !quake.wire
  %cx0:2 = quake.x [%q neg [true]] %r0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1 = quake.rz (%b) %cx0#1 : (f64, !quake.wire) -> !quake.wire
  %cx1:2 = quake.x [%cx0#0] %r1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r2 = quake.rz (%c) %cx1#1 : (f64, !quake.wire) -> !quake.wire
  quake.wrap %cx1#0 to %control : !quake.wire, !quake.ref
  quake.wrap %r2 to %target : !quake.wire, !quake.ref
  return
}

func.func @phase_open_after_closed(%a: f64, %b: f64, %c: f64, %control: !quake.ref, %target: !quake.ref) {
  %q = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %t = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %r0 = quake.rz (%a) %t : (f64, !quake.wire) -> !quake.wire
  %cx0:2 = quake.x [%q] %r0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1 = quake.rz (%b) %cx0#1 : (f64, !quake.wire) -> !quake.wire
  %cx1:2 = quake.x [%cx0#0 neg [true]] %r1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r2 = quake.rz (%c) %cx1#1 : (f64, !quake.wire) -> !quake.wire
  quake.wrap %cx1#0 to %control : !quake.wire, !quake.ref
  quake.wrap %r2 to %target : !quake.wire, !quake.ref
  return
}

func.func @phase_closed(%a: f64, %b: f64, %c: f64, %control: !quake.ref, %target: !quake.ref) {
  %q = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %t = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %r0 = quake.rz (%a) %t : (f64, !quake.wire) -> !quake.wire
  %cx0:2 = quake.x [%q neg [false]] %r0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1 = quake.rz (%b) %cx0#1 : (f64, !quake.wire) -> !quake.wire
  %cx1:2 = quake.x [%cx0#0] %r1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r2 = quake.rz (%c) %cx1#1 : (f64, !quake.wire) -> !quake.wire
  quake.wrap %cx1#0 to %control : !quake.wire, !quake.ref
  quake.wrap %r2 to %target : !quake.wire, !quake.ref
  return
}

// Hand-written wire form of Rz(a); open-CX; Rz(b); open-CX; Rz(c).
// Two open CNOTs restore the target parity, so a and c must add.
func.func @phase_open_pair(%a: f64, %b: f64, %c: f64, %control: !quake.ref, %target: !quake.ref) {
  %q = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %t = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %r0 = quake.rz (%a) %t : (f64, !quake.wire) -> !quake.wire
  %cx0:2 = quake.x [%q neg [true]] %r0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1 = quake.rz (%b) %cx0#1 : (f64, !quake.wire) -> !quake.wire
  %cx1:2 = quake.x [%cx0#0 neg [true]] %r1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r2 = quake.rz (%c) %cx1#1 : (f64, !quake.wire) -> !quake.wire
  quake.wrap %cx1#0 to %control : !quake.wire, !quake.ref
  quake.wrap %r2 to %target : !quake.wire, !quake.ref
  return
}

// Hand-written wire form of Rz(a); open-CX; Rz(b), with both rotations
// on the control. Its parity is unchanged by the CNOT, so a and b must add.
func.func @phase_open_control(%a: f64, %b: f64, %control: !quake.ref, %target: !quake.ref) {
  %q = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %t = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %r0 = quake.rz (%a) %q : (f64, !quake.wire) -> !quake.wire
  %cx:2 = quake.x [%r0 neg [true]] %t : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1 = quake.rz (%b) %cx#0 : (f64, !quake.wire) -> !quake.wire
  quake.wrap %r1 to %control : !quake.wire, !quake.ref
  quake.wrap %cx#1 to %target : !quake.wire, !quake.ref
  return
}

// CHECK-LABEL:   func.func @phase_open(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref,
// CHECK-SAME:      %[[ARG4:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref) {
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ARG3]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[ARG4]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[RZ_0:.*]] = quake.rz (%[[ARG0]]) %[[UNWRAP_1]] : (f64, !quake.wire) -> !quake.wire
// CHECK:           %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_0]] neg [true]] %[[RZ_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[RZ_1:.*]] = quake.rz (%[[ARG1]]) %[[X_0]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           %[[X_1:.*]]:2 = quake.x {{\[}}%[[X_0]]#0] %[[RZ_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[RZ_2:.*]] = quake.rz (%[[ARG2]]) %[[X_1]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[X_1]]#0 to %[[ARG3]] : !quake.wire, !quake.ref
// CHECK:           quake.wrap %[[RZ_2]] to %[[ARG4]] : !quake.wire, !quake.ref
// CHECK:           return
// CHECK:         }

// CHECK-LABEL:   func.func @phase_open_after_closed(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref,
// CHECK-SAME:      %[[ARG4:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref) {
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ARG3]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[ARG4]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[RZ_0:.*]] = quake.rz (%[[ARG0]]) %[[UNWRAP_1]] : (f64, !quake.wire) -> !quake.wire
// CHECK:           %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_0]]] %[[RZ_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[RZ_1:.*]] = quake.rz (%[[ARG1]]) %[[X_0]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           %[[X_1:.*]]:2 = quake.x {{\[}}%[[X_0]]#0 neg [true]] %[[RZ_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[RZ_2:.*]] = quake.rz (%[[ARG2]]) %[[X_1]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[X_1]]#0 to %[[ARG3]] : !quake.wire, !quake.ref
// CHECK:           quake.wrap %[[RZ_2]] to %[[ARG4]] : !quake.wire, !quake.ref
// CHECK:           return
// CHECK:         }

// CHECK-LABEL:   func.func @phase_closed(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref,
// CHECK-SAME:      %[[ARG4:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref) {
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ARG3]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[ARG4]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_0]] neg [false]] %[[UNWRAP_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[RZ_0:.*]] = quake.rz (%[[ARG1]]) %[[X_0]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           %[[X_1:.*]]:2 = quake.x {{\[}}%[[X_0]]#0] %[[RZ_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[ADDF_0:.*]] = arith.addf %[[ARG0]], %[[ARG2]] : f64
// CHECK:           %[[RZ_1:.*]] = quake.rz (%[[ADDF_0]]) %[[X_1]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[X_1]]#0 to %[[ARG3]] : !quake.wire, !quake.ref
// CHECK:           quake.wrap %[[RZ_1]] to %[[ARG4]] : !quake.wire, !quake.ref
// CHECK:           return
// CHECK:         }

// CHECK-LABEL:   func.func @phase_open_pair(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref,
// CHECK-SAME:      %[[ARG4:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref) {
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ARG3]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[ARG4]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_0]] neg [true]] %[[UNWRAP_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[RZ_0:.*]] = quake.rz (%[[ARG1]]) %[[X_0]]#1 : (f64, !quake.wire) -> !quake.wire
// CHECK:           %[[X_1:.*]]:2 = quake.x {{\[}}%[[X_0]]#0 neg [true]] %[[RZ_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[ADDF_0:.*]] = arith.addf %[[ARG0]], %[[ARG2]] : f64
