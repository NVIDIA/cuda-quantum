// CHECK-LABEL:   func.func @phase_open_control(
// CHECK-SAME:      %[[ARG0:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG1:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: f64,
// CHECK-SAME:      %[[ARG2:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref,
// CHECK-SAME:      %[[ARG3:[0-9]+|[a-zA-Z$._-][a-zA-Z0-9$._-]*]]: !quake.ref) {
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ARG2]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[ARG3]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_0]] neg [true]] %[[UNWRAP_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[ADDF_0:.*]] = arith.addf %[[ARG0]], %[[ARG1]] : f64
// CHECK:           %[[RZ_0:.*]] = quake.rz (%[[ADDF_0]]) %[[X_0]]#0 : (f64, !quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[RZ_0]] to %[[ARG2]] : !quake.wire, !quake.ref
// CHECK:           quake.wrap %[[X_0]]#1 to %[[ARG3]] : !quake.wire, !quake.ref
// CHECK:           return
// CHECK:         }
