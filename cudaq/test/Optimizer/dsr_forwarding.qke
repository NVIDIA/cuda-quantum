// Store-to-load forwarding, redundant load removal and removal of overwritten
// stores within a block, including facts that are carried through a series of
// operations that cannot change them. Facts that cross a region or a branch are
// in dsr_forwarding_regions.qke and dsr_cfg_loops.qke.

// RUN: cudaq-opt --dead-store-removal %s | FileCheck %s

// Store followed by a load of the same location: forward the stored value.
func.func @forward(%p: !cc.ptr<i32>, %v: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @forward(
// CHECK-SAME:      %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32) -> i32 {
// CHECK:         cc.store %[[V]], %[[P]]
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]] : i32

// Two loads of the same location with no store between: reuse the first.
func.func @redundant_load(%p: !cc.ptr<i32>) -> i32 {
  %a = cc.load %p : !cc.ptr<i32>
  %b = cc.load %p : !cc.ptr<i32>
  %c = arith.addi %a, %b : i32
  return %c : i32
}

// CHECK-LABEL: func.func @redundant_load(
// CHECK:         %[[A:.*]] = cc.load
// CHECK-NOT:     cc.load
// CHECK:         arith.addi %[[A]], %[[A]]

// Back-to-back stores to the same location: the first is dead.
func.func @overwritten(%p: !cc.ptr<i32>, %v: i32, %w: i32) {
  cc.store %v, %p : !cc.ptr<i32>
  cc.store %w, %p : !cc.ptr<i32>
  return
}

// CHECK-LABEL: func.func @overwritten(
// CHECK-SAME:      %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) {
// CHECK-NOT:     cc.store %[[V]]
// CHECK:         cc.store %[[W]], %[[P]]
// CHECK-NEXT:    return

// A read of a pointer that may alias keeps the first store.
func.func @overwritten_but_read(%p: !cc.ptr<i32>, %q: !cc.ptr<i32>, %v: i32,
                                %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  %r = cc.load %q : !cc.ptr<i32>
  cc.store %w, %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @overwritten_but_read(
// CHECK-SAME:      %[[P:.*]]: !cc.ptr<i32>, %[[Q:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32)
// CHECK:         cc.store %[[V]], %[[P]]
// CHECK:         cc.load %[[Q]]
// CHECK:         cc.store %[[W]], %[[P]]

// A store through a pointer that may alias blocks forwarding.
func.func @may_alias_store(%p: !cc.ptr<i32>, %q: !cc.ptr<i32>, %v: i32,
                           %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cc.store %w, %q : !cc.ptr<i32>
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @may_alias_store(
// CHECK:         cc.store
// CHECK:         cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// Two compute_ptr ops with the same operands are the same address.
func.func @same_computed_address(%a: !cc.ptr<!cc.array<i32 x 4>>, %i: i64,
                                 %v: i32) -> i32 {
  %p1 = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x 4>>, i64) -> !cc.ptr<i32>
  cc.store %v, %p1 : !cc.ptr<i32>
  %p2 = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x 4>>, i64) -> !cc.ptr<i32>
  %r = cc.load %p2 : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @same_computed_address(
// CHECK-SAME:      %[[A:.*]]: !cc.ptr<!cc.array<i32 x 4>>, %[[I:.*]]: i64, %[[V:.*]]: i32)
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// Different dynamic indices may be equal: no forwarding past the other store.
func.func @dynamic_indices(%a: !cc.ptr<!cc.array<i32 x 4>>, %i: i64, %j: i64,
                           %v: i32, %w: i32) -> i32 {
  %pi = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x 4>>, i64) -> !cc.ptr<i32>
  %pj = cc.compute_ptr %a[%j] : (!cc.ptr<!cc.array<i32 x 4>>, i64) -> !cc.ptr<i32>
  cc.store %v, %pi : !cc.ptr<i32>
  cc.store %w, %pj : !cc.ptr<i32>
  %r = cc.load %pi : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @dynamic_indices(
// CHECK:         cc.store
// CHECK:         cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// Different constant indices off the same base are disjoint.
func.func @constant_indices(%a: !cc.ptr<!cc.array<i32 x 4>>, %v: i32,
                            %w: i32) -> i32 {
  %p0 = cc.compute_ptr %a[0] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  %p1 = cc.compute_ptr %a[1] : (!cc.ptr<!cc.array<i32 x 4>>) -> !cc.ptr<i32>
  cc.store %v, %p0 : !cc.ptr<i32>
  cc.store %w, %p1 : !cc.ptr<i32>
  %r = cc.load %p0 : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @constant_indices(
// CHECK-SAME:      %[[A:.*]]: !cc.ptr<!cc.array<i32 x 4>>, %[[V:.*]]: i32, %[[W:.*]]: i32)
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// A value of a different type at the same address is not forwarded.
func.func @different_type(%p: !cc.ptr<i32>, %v: i32) -> i64 {
  cc.store %v, %p : !cc.ptr<i32>
  %q = cc.cast %p : (!cc.ptr<i32>) -> !cc.ptr<i64>
  %r = cc.load %q : !cc.ptr<i64>
  return %r : i64
}

// CHECK-LABEL: func.func @different_type(
// CHECK:         cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// An operation that reads memory observes the store, whatever else it is. It
// must not be considered overwritten by the later store.
func.func @reader_observes_store(%v: i32, %w: i32, %n: i64)
    -> !cc.ptr<!quake.state> {
  %s = cc.alloca !cc.array<complex<f64> x 2>
  %p = cc.cast %s : (!cc.ptr<!cc.array<complex<f64> x 2>>) -> !cc.ptr<i32>
  cc.store %v, %p : !cc.ptr<i32>
  %st = quake.create_state %s, %n : (!cc.ptr<!cc.array<complex<f64> x 2>>, i64) -> !cc.ptr<!quake.state>
  cc.store %w, %p : !cc.ptr<i32>
  return %st : !cc.ptr<!quake.state>
}

// CHECK-LABEL: func.func @reader_observes_store(
// CHECK-SAME:      %[[V:.*]]: i32, %[[W:.*]]: i32, %{{.*}}: i64)
// CHECK:         cc.store %[[V]], %
// CHECK:         quake.create_state
// CHECK:         cc.store %[[W]], %

// A call may read or write memory that is not a private stack slot.
func.func private @opaque()

func.func @call_clobbers_pointer(%p: !cc.ptr<i32>, %v: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  call @opaque() : () -> ()
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @call_clobbers_pointer(
// CHECK:         cc.store
// CHECK:         call @opaque
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// ... but not a stack slot whose address never escapes.
func.func @call_spares_private_slot(%v: i32) -> i32 {
  %s = cc.alloca i32
  cc.store %v, %s : !cc.ptr<i32>
  call @opaque() : () -> ()
  %r = cc.load %s : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @call_spares_private_slot(
// CHECK-SAME:      %[[V:.*]]: i32) -> i32 {
// CHECK-NOT:     cc.load
// CHECK:         call @opaque
// CHECK:         return %[[V]]

// An escaped stack slot is clobbered by a call.
func.func private @take(!cc.ptr<i32>)

func.func @call_clobbers_escaped_slot(%v: i32) -> i32 {
  %s = cc.alloca i32
  cc.store %v, %s : !cc.ptr<i32>
  call @take(%s) : (!cc.ptr<i32>) -> ()
  %r = cc.load %s : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @call_clobbers_escaped_slot(
// CHECK:         cc.store
// CHECK:         call @take
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// Distinct stack slots never alias.
func.func @distinct_slots(%v: i32, %w: i32) -> i32 {
  %s = cc.alloca i32
  %t = cc.alloca i32
  cc.store %v, %s : !cc.ptr<i32>
  cc.store %w, %t : !cc.ptr<i32>
  %r = cc.load %s : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @distinct_slots(
// CHECK-SAME:      %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

//===----------------------------------------------------------------------===//
// Merge points. Block arguments are phi nodes: the same SSA name denotes a
// different value on each iteration, so nothing is carried across them.
//===----------------------------------------------------------------------===//

// Within one block of a loop body the induction variable is a single value, so
// the store to a[i] can be forwarded to the load of a[i].
func.func @loop_same_iteration(%a: !cc.ptr<!cc.array<i32 x ?>>, %n: i64,
                               %v: i32) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      %p = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
      cc.store %v, %p : !cc.ptr<i32>
      %r = cc.load %p : !cc.ptr<i32>
      func.call @use(%r) : (i32) -> ()
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  return
}

func.func private @use(i32)

// CHECK-LABEL: func.func @loop_same_iteration(
// CHECK-SAME:      %[[A:.*]]: !cc.ptr<!cc.array<i32 x ?>>, %[[N:.*]]: i64, %[[V:.*]]: i32) {
// CHECK:         cc.store %[[V]]
// CHECK-NOT:     cc.load
// CHECK:         call @use(%[[V]])

// A load in the loop body is not forwarded from a store before the loop, even
// though the address is loop invariant: no fact crosses a block boundary.
func.func @loop_load_not_forwarded(%p: !cc.ptr<i32>, %n: i64, %v: i32) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  cc.store %v, %p : !cc.ptr<i32>
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      %r = cc.load %p : !cc.ptr<i32>
      func.call @use(%r) : (i32) -> ()
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  return
}

// CHECK-LABEL: func.func @loop_load_not_forwarded(
// CHECK:         cc.store
// CHECK:         cc.loop
// CHECK:           %[[R:.*]] = cc.load
// CHECK:           call @use(%[[R]])

// A store in the loop body is not forwarded to a load after the loop, and the
// store before the loop is not removed as overwritten: the loop may run zero
// times, or the store at a[i] may be a different location on each iteration.
func.func @loop_store_not_forwarded(%a: !cc.ptr<!cc.array<i32 x ?>>, %n: i64,
                                    %v: i32, %w: i32) -> i32 {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %first = cc.compute_ptr %a[%c0] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
  cc.store %v, %first : !cc.ptr<i32>
  %res = cc.loop while ((%i = %c0) -> (i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond (%i : i64)
  } do {
    ^bb1(%i: i64):
      %p = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
      cc.store %w, %p : !cc.ptr<i32>
      cc.continue %i : i64
  } step {
    ^bb2(%i: i64):
      %next = arith.addi %i, %c1 : i64
      cc.continue %next : i64
  }
  %r = cc.load %first : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @loop_store_not_forwarded(
// CHECK-SAME:      %[[A:.*]]: !cc.ptr<!cc.array<i32 x ?>>, %[[N:.*]]: i64, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK:         cc.store %[[V]]
// CHECK:         cc.loop
// CHECK:           cc.store %[[W]]
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// A store in one branch of a cc.if is not seen after the merge.
func.func @if_branch_not_forwarded(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                   %w: i32) -> i32 {
  cc.store %v, %p : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %w, %p : !cc.ptr<i32>
  }
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_branch_not_forwarded(
// CHECK:         cc.store %{{.*}}, %{{.*}} : !cc.ptr<i32>
// CHECK:         cc.if
// CHECK:           cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// The same holds when each branch stores through its own local address.
func.func @if_local_addresses(%c: i1, %a: !cc.ptr<!cc.array<i32 x 4>>,
                              %i: i64, %j: i64, %v: i32) -> i32 {
  %pi = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x 4>>, i64) -> !cc.ptr<i32>
  cc.store %v, %pi : !cc.ptr<i32>
  cc.if(%c) {
    %pj = cc.compute_ptr %a[%j] : (!cc.ptr<!cc.array<i32 x 4>>, i64) -> !cc.ptr<i32>
    cc.store %v, %pj : !cc.ptr<i32>
  }
  %r = cc.load %pi : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_local_addresses(
// CHECK:         cc.store
// CHECK:         cc.if
// CHECK:           cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// A private stack slot that a region never touches survives the region.
func.func @if_spares_private_slot(%c: i1, %p: !cc.ptr<i32>, %v: i32,
                                  %w: i32) -> i32 {
  %s = cc.alloca i32
  cc.store %v, %s : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %w, %p : !cc.ptr<i32>
  }
  %r = cc.load %s : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_spares_private_slot(
// CHECK-SAME:      %[[C:.*]]: i1, %[[P:.*]]: !cc.ptr<i32>, %[[V:.*]]: i32, %[[W:.*]]: i32) -> i32 {
// CHECK:         cc.if
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// ... but a private slot that the region does touch is clobbered.
func.func @if_clobbers_touched_slot(%c: i1, %v: i32, %w: i32) -> i32 {
  %s = cc.alloca i32
  cc.store %v, %s : !cc.ptr<i32>
  cc.if(%c) {
    cc.store %w, %s : !cc.ptr<i32>
  }
  %r = cc.load %s : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @if_clobbers_touched_slot(
// CHECK:         cc.store
// CHECK:         cc.if
// CHECK:           cc.store
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

//===----------------------------------------------------------------------===//
// The same rules hold for CFG form (cf.br / cf.cond_br). A block argument of a
// block with several predecessors is a phi node: a merge of distinct values.
//===----------------------------------------------------------------------===//

// Within the merge block the argument is a single value, so forwarding is fine.
func.func @cfg_merge_same_block(%c: i1, %a: !cc.ptr<!cc.array<i32 x ?>>,
                                %i: i64, %j: i64, %v: i32) -> i32 {
  cf.cond_br %c, ^left, ^right
^left:
  cf.br ^merge(%i : i64)
^right:
  cf.br ^merge(%j : i64)
^merge(%k: i64):
  %p = cc.compute_ptr %a[%k] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
  cc.store %v, %p : !cc.ptr<i32>
  %r = cc.load %p : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @cfg_merge_same_block(
// CHECK-SAME:      %[[C:.*]]: i1, %[[A:.*]]: !cc.ptr<!cc.array<i32 x ?>>, %[[I:.*]]: i64, %[[J:.*]]: i64, %[[V:.*]]: i32) -> i32 {
// CHECK:         cc.compute_ptr %[[A]][%{{.*}}]
// CHECK:         cc.store %[[V]]
// CHECK-NOT:     cc.load
// CHECK:         return %[[V]]

// A store in a predecessor is not forwarded to a load in the merge block. The
// address is a different location depending on the path that was taken.
func.func @cfg_merge_not_forwarded(%c: i1, %a: !cc.ptr<!cc.array<i32 x ?>>,
                                   %i: i64, %j: i64, %v: i32) -> i32 {
  %pi = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
  cc.store %v, %pi : !cc.ptr<i32>
  cf.cond_br %c, ^left, ^right
^left:
  cf.br ^merge(%i : i64)
^right:
  cf.br ^merge(%j : i64)
^merge(%k: i64):
  %pk = cc.compute_ptr %a[%k] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
  %r = cc.load %pk : !cc.ptr<i32>
  return %r : i32
}

// CHECK-LABEL: func.func @cfg_merge_not_forwarded(
// CHECK:         cc.store
// CHECK:         cf.cond_br
// CHECK:         %[[R:.*]] = cc.load
// CHECK:         return %[[R]]

// A block that is its own successor. The load at the top reads what the store
// at the bottom wrote on the *previous* iteration, so it must not be forwarded,
// and the store must not be removed as being overwritten by the next one.
func.func @cfg_self_loop(%c: i1, %p: !cc.ptr<i32>, %v: i32) {
  cf.br ^loop(%v : i32)
^loop(%x: i32):
  %old = cc.load %p : !cc.ptr<i32>
  func.call @use(%old) : (i32) -> ()
  cc.store %x, %p : !cc.ptr<i32>
  cf.cond_br %c, ^loop(%x : i32), ^exit
^exit:
  return
}

// CHECK-LABEL: func.func @cfg_self_loop(
// CHECK:       ^bb1(%[[X:.*]]: i32):
// CHECK:         %[[OLD:.*]] = cc.load
// CHECK:         call @use(%[[OLD]])
// CHECK:         cc.store %[[X]]

// A store in a loop block whose address depends on the loop-carried argument
// is not seen as a dead store of the next iteration's store.
func.func @cfg_loop_carried_address(%c: i1, %a: !cc.ptr<!cc.array<i32 x ?>>,
                                    %v: i32) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  cf.br ^loop(%c0 : i64)
^loop(%i: i64):
  %p = cc.compute_ptr %a[%i] : (!cc.ptr<!cc.array<i32 x ?>>, i64) -> !cc.ptr<i32>
  cc.store %v, %p : !cc.ptr<i32>
  %next = arith.addi %i, %c1 : i64
  cf.cond_br %c, ^loop(%next : i64), ^exit
^exit:
  return
}

// CHECK-LABEL: func.func @cfg_loop_carried_address(
// CHECK:       ^bb1(%[[I:.*]]: i64):
// CHECK:         cc.compute_ptr
// CHECK:         cc.store

// An exp_pauli reads the Pauli word when it is given as an argument, so a store
// of the word is not overwritten before the exp_pauli. This is so whether the
// qubits are in reference or in value form.
func.func @exp_pauli_reads_word(%w0: i8, %w1: i8, %theta: f64) {
  %q = quake.alloca !quake.ref
  %word = cc.alloca !cc.array<i8 x 1>
  %p = cc.cast %word : (!cc.ptr<!cc.array<i8 x 1>>) -> !cc.ptr<i8>
  cc.store %w0, %p : !cc.ptr<i8>
  quake.exp_pauli (%theta) %q to %word : (f64, !quake.ref, !cc.ptr<!cc.array<i8 x 1>>) -> ()
  cc.store %w1, %p : !cc.ptr<i8>
  quake.exp_pauli (%theta) %q to %word : (f64, !quake.ref, !cc.ptr<!cc.array<i8 x 1>>) -> ()
  return
}

// CHECK-LABEL: func.func @exp_pauli_reads_word(
// CHECK-SAME:      %[[W0:.*]]: i8, %[[W1:.*]]: i8, %{{.*}}: f64) {
// CHECK:         cc.store %[[W0]], %
// CHECK:         quake.exp_pauli
// CHECK:         cc.store %[[W1]], %
// CHECK:         quake.exp_pauli

func.func @exp_pauli_wire_reads_word(%w0: i8, %w1: i8, %theta: f64) {
  %q = quake.null_wire
  %word = cc.alloca !cc.array<i8 x 1>
  %p = cc.cast %word : (!cc.ptr<!cc.array<i8 x 1>>) -> !cc.ptr<i8>
  cc.store %w0, %p : !cc.ptr<i8>
  %q1 = quake.exp_pauli (%theta) %q to %word : (f64, !quake.wire, !cc.ptr<!cc.array<i8 x 1>>) -> !quake.wire
  cc.store %w1, %p : !cc.ptr<i8>
  %q2 = quake.exp_pauli (%theta) %q1 to %word : (f64, !quake.wire, !cc.ptr<!cc.array<i8 x 1>>) -> !quake.wire
  quake.sink %q2 : !quake.wire
  return
}

