// RUN: cudaq-opt --canonicalize --memtoreg --canonicalize %s | FileCheck %s

// Regression for a bug where a wire threaded as a cc.loop-carried argument
// (%arg4, standing in for %1's state) crossed straight from the first
// quake.x to the second, completely skipping the invalidation that an
// intervening dynamic-index extract_ref of an *inner* loop (aliasing veq %7,
// which %1 is a concat member of) must impose. The wire must instead be
// wrapped back to %1 before the inner loop and the second quake.x must
// consume a *fresh* unwrap of %1, not the first quake.x's result directly.
func.func @nested_loop_wire_alias(%arg0: i64, %arg1: i64) {
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %0 = cc.undef i64
  %1 = quake.alloca !quake.ref
  %2 = quake.alloca !quake.ref
  %3 = quake.concat %1, %2 : (!quake.ref, !quake.ref) -> !quake.veq<2>
  %4:2 = cc.loop while ((%arg2 = %c0_i64, %arg3 = %0) -> (i64, i64)) {
    %5 = arith.cmpi slt, %arg2, %arg0 : i64
    cc.condition %5(%arg2, %arg3 : i64, i64)
  } do {
  ^bb0(%arg2: i64, %arg3: i64):
    quake.x %1 : (!quake.ref) -> ()
    %5 = cc.loop while ((%arg4 = %c0_i64) -> (i64)) {
      %9 = arith.cmpi slt, %arg4, %arg0 : i64
      cc.condition %9(%arg4 : i64)
    } do {
    ^bb0(%arg4: i64):
      %9 = quake.extract_ref %3[%arg1] : (!quake.veq<2>, i64) -> !quake.ref
      quake.h %9 : (!quake.ref) -> ()
      cc.continue %arg4 : i64
    } step {
    ^bb0(%arg4: i64):
      %9 = arith.addi %arg4, %c1_i64 : i64
      cc.continue %9 : i64
    } {normalized}
    %6 = arith.subi %5, %c1_i64 : i64
    %7 = arith.cmpi eq, %5, %c0_i64 : i64
    %8 = arith.select %7, %arg3, %6 : i64
    quake.x %1 : (!quake.ref) -> ()
    cc.continue %arg2, %8 : i64, i64
  } step {
  ^bb0(%arg2: i64, %arg3: i64):
    %5 = arith.addi %arg2, %c1_i64 : i64
    cc.continue %5, %arg3 : i64, i64
  } {normalized}
  quake.evince %3 : (!quake.veq<2>) -> () {compilerGenerated}
  quake.dealloc %1 : !quake.ref
  quake.dealloc %2 : !quake.ref
  return
}

// CHECK-LABEL:   func.func @nested_loop_wire_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64, %[[ARG1:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : i64
// CHECK:           %[[VAL_2:.*]] = cc.undef i64
// CHECK:           %[[VAL_3:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_4:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_5:.*]] = quake.concat %[[VAL_3]], %[[VAL_4]] : (!quake.ref, !quake.ref) -> !quake.veq<2>
// CHECK:           %[[VAL_6:.*]]:2 = cc.loop while ((%[[VAL_7:.*]] = %[[VAL_1]], %[[VAL_8:.*]] = %[[VAL_2]]) -> (i64, i64)) {
// CHECK:             %[[VAL_9:.*]] = arith.cmpi slt, %[[VAL_7]], %[[ARG0]] : i64
// CHECK:             cc.condition %[[VAL_9]](%[[VAL_7]], %[[VAL_8]] : i64, i64)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_7]]: i64, %[[VAL_8]]: i64):
// CHECK:             quake.x %[[VAL_3]] : (!quake.ref) -> ()
// CHECK:             %[[VAL_9]] = cc.loop while ((%[[VAL_10:.*]] = %[[VAL_1]]) -> (i64)) {
// CHECK:               %[[VAL_11:.*]] = arith.cmpi slt, %[[VAL_10]], %[[ARG0]] : i64
// CHECK:               cc.condition %[[VAL_11]](%[[VAL_10]] : i64)
// CHECK:             } do {
// CHECK:             ^bb0(%[[VAL_10]]: i64):
// CHECK:               %[[VAL_11]] = quake.extract_ref %[[VAL_5]][%[[ARG1]]] : (!quake.veq<2>, i64) -> !quake.ref
// CHECK:               quake.h %[[VAL_11]] : (!quake.ref) -> ()
// CHECK:               cc.continue %[[VAL_10]] : i64
// CHECK:             } step {
// CHECK:             ^bb0(%[[VAL_10]]: i64):
// CHECK:               %[[VAL_11]] = arith.addi %[[VAL_10]], %[[VAL_0]] : i64
// CHECK:               cc.continue %[[VAL_11]] : i64
// CHECK:             } {normalized}
// CHECK:             %[[VAL_12:.*]] = arith.subi %[[VAL_9]], %[[VAL_0]] : i64
// CHECK:             %[[VAL_13:.*]] = arith.cmpi eq, %[[VAL_9]], %[[VAL_1]] : i64
// CHECK:             %[[VAL_14:.*]] = arith.select %[[VAL_13]], %[[VAL_8]], %[[VAL_12]] : i64
// CHECK:             quake.x %[[VAL_3]] : (!quake.ref) -> ()
// CHECK:             cc.continue %[[VAL_7]], %[[VAL_14]] : i64, i64
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_7]]: i64, %[[VAL_8]]: i64):
// CHECK:             %[[VAL_9]] = arith.addi %[[VAL_7]], %[[VAL_0]] : i64
// CHECK:             cc.continue %[[VAL_9]], %[[VAL_8]] : i64, i64
// CHECK:           } {normalized}
// CHECK:           quake.evince %[[VAL_5]] : (!quake.veq<2>) -> () {compilerGenerated}
// CHECK:           quake.dealloc %[[VAL_3]] : !quake.ref
// CHECK:           quake.dealloc %[[VAL_4]] : !quake.ref
// CHECK:           return
// CHECK:         }

// %r is concat'd into %v, which is then indexed dynamically, so %r's qubit
// may be reached through an unknown element of %v. The location stays in
// memory form and each gate keeps its own unwrap/wrap, including across the
// cc.scope's internal CFG blocks -- no wire is threaded through the region.
func.func @scope_internal_alias(%idx: i64) {
  %c0 = arith.constant 0 : i64
  %r = quake.alloca !quake.ref
  %v = quake.concat %r : (!quake.ref) -> !quake.veq<1>
  quake.y %r : (!quake.ref) -> ()
  cc.scope atomic {
    %cond = arith.cmpi ugt, %idx, %c0 : i64
    cf.cond_br %cond, ^exit, ^body
  ^body:
    %q = quake.extract_ref %v[%idx] : (!quake.veq<1>, i64) -> !quake.ref
    quake.h %q : (!quake.ref) -> ()
    quake.x %r : (!quake.ref) -> ()
    cf.br ^exit
  ^exit:
    quake.z %r : (!quake.ref) -> ()
    cc.continue
  }
  quake.dealloc %r : !quake.ref
  return
}

// CHECK-LABEL:   func.func @scope_internal_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 0 : i64
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_2:.*]] = quake.concat %[[VAL_1]] : (!quake.ref) -> !quake.veq<1>
// CHECK:           quake.y %[[VAL_1]] : (!quake.ref) -> ()
// CHECK:           cc.scope atomic {
// CHECK:             %[[VAL_3:.*]] = arith.cmpi ugt, %[[ARG0]], %[[VAL_0]] : i64
// CHECK:             cf.cond_br %[[VAL_3]], ^bb2, ^bb1
// CHECK:           ^bb1:  // pred: ^bb0
// CHECK:             %[[VAL_4:.*]] = quake.extract_ref %[[VAL_2]][%[[ARG0]]] : (!quake.veq<1>, i64) -> !quake.ref
// CHECK:             quake.h %[[VAL_4]] : (!quake.ref) -> ()
// CHECK:             quake.x %[[VAL_1]] : (!quake.ref) -> ()
// CHECK:             cf.br ^bb2
// CHECK:           ^bb2:  // 2 preds: ^bb0, ^bb1
// CHECK:             quake.z %[[VAL_1]] : (!quake.ref) -> ()
// CHECK:             cc.continue
// CHECK:           }
// CHECK:           quake.dealloc %[[VAL_1]] : !quake.ref
// CHECK:           return
// CHECK:         }

// A non-escaping ref alloca (%3) used as a gate control inside a
// dynamically-aliased loop. %3 is its own root and no memory-form access
// reaches it, so it is still promoted to a null wire, while the refs coming
// out of the dynamically-indexed veq stay in memory form alongside it.
func.func @control_operand_alias(%arg0: i64) {
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %0 = quake.alloca !quake.ref
  %1 = quake.alloca !quake.ref
  %2 = quake.concat %0, %1 : (!quake.ref, !quake.ref) -> !quake.veq<2>
  %3 = quake.alloca !quake.ref
  %4 = cc.loop while ((%arg1 = %c0_i64) -> (i64)) {
    %5 = arith.cmpi slt, %arg1, %arg0 : i64
    cc.condition %5(%arg1 : i64)
  } do {
  ^bb0(%arg1: i64):
    %5 = quake.extract_ref %2[%arg1] : (!quake.veq<2>, i64) -> !quake.ref
    quake.x [%3] %5 : (!quake.ref, !quake.ref) -> ()
    cc.continue %arg1 : i64
  } step {
  ^bb0(%arg1: i64):
    %5 = arith.addi %arg1, %c1_i64 : i64
    cc.continue %5 : i64
  } {normalized}
  quake.evince %2 : (!quake.veq<2>) -> () {compilerGenerated}
  quake.evince %3 : (!quake.ref) -> () {compilerGenerated}
  quake.dealloc %3 : !quake.ref
  quake.dealloc %0 : !quake.ref
  quake.dealloc %1 : !quake.ref
  return
}

// CHECK-LABEL:   func.func @control_operand_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : i64
// CHECK:           %[[VAL_2:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_3:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_4:.*]] = quake.concat %[[VAL_2]], %[[VAL_3]] : (!quake.ref, !quake.ref) -> !quake.veq<2>
// CHECK:           %[[VAL_5:.*]] = quake.null_wire
// CHECK:           %[[VAL_6:.*]]:2 = cc.loop while ((%[[VAL_7:.*]] = %[[VAL_1]], %[[VAL_8:.*]] = %[[VAL_5]]) -> (i64, !quake.wire)) {
// CHECK:             %[[VAL_9:.*]] = arith.cmpi slt, %[[VAL_7]], %[[ARG0]] : i64
// CHECK:             cc.condition %[[VAL_9]](%[[VAL_7]], %[[VAL_8]] : i64, !quake.wire)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_7]]: i64, %[[VAL_8]]: !quake.wire):
// CHECK:             %[[VAL_9]] = quake.extract_ref %[[VAL_4]][%[[VAL_7]]] : (!quake.veq<2>, i64) -> !quake.ref
// CHECK:             %[[VAL_10:.*]] = quake.x [%[[VAL_8]]] %[[VAL_9]] : (!quake.wire, !quake.ref) -> !quake.wire
// CHECK:             cc.continue %[[VAL_7]], %[[VAL_10]] : i64, !quake.wire
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_7]]: i64, %[[VAL_8]]: !quake.wire):
// CHECK:             %[[VAL_9]] = arith.addi %[[VAL_7]], %[[VAL_0]] : i64
// CHECK:             cc.continue %[[VAL_9]], %[[VAL_8]] : i64, !quake.wire
// CHECK:           } {normalized}
// CHECK:           quake.evince %[[VAL_4]] : (!quake.veq<2>) -> () {compilerGenerated}
// CHECK:           %[[VAL_11:.*]] = quake.evince %[[VAL_6]]#1 : (!quake.wire) -> !quake.wire {compilerGenerated}
// CHECK:           quake.sink %[[VAL_11]] : !quake.wire
// CHECK:           quake.dealloc %[[VAL_2]] : !quake.ref
// CHECK:           quake.dealloc %[[VAL_3]] : !quake.ref
// CHECK:           return
// CHECK:         }
