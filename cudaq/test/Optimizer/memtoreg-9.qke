// RUN: cudaq-opt --canonicalize --memtoreg --canonicalize %s | FileCheck %s

// Regression for a bug where a wire threaded as a cc.loop-carried argument
// (%arg4, standing in for %1's state) crossed straight from the first
// quake.x to the second, completely skipping the invalidation that an
// intervening dynamic-index extract_ref of an *inner* loop (aliasing veq %7,
// which %1 is a concat member of) must impose. The wire must instead be
// wrapped back to %1 before the inner loop and the second quake.x must
// consume a *fresh* unwrap of %1, not the first quake.x's result directly.
func.func @nested_loop_wire_alias(%arg0: i64, %arg1: i64) {
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %0 = cc.undef i64
  %1 = quake.alloca !quake.ref
  %2 = quake.alloca !quake.ref
  %3 = quake.concat %1, %2 : (!quake.ref, !quake.ref) -> !quake.veq<2>
  %4:2 = cc.loop while ((%arg2 = %c0_i64, %arg3 = %0) -> (i64, i64)) {
    %5 = arith.cmpi slt, %arg2, %arg0 : i64
    cc.condition %5(%arg2, %arg3 : i64, i64)
  } do {
  ^bb0(%arg2: i64, %arg3: i64):
    quake.x %1 : (!quake.ref) -> ()
    %5 = cc.loop while ((%arg4 = %c0_i64) -> (i64)) {
      %9 = arith.cmpi slt, %arg4, %arg0 : i64
      cc.condition %9(%arg4 : i64)
    } do {
    ^bb0(%arg4: i64):
      %9 = quake.extract_ref %3[%arg1] : (!quake.veq<2>, i64) -> !quake.ref
      quake.h %9 : (!quake.ref) -> ()
      cc.continue %arg4 : i64
    } step {
    ^bb0(%arg4: i64):
      %9 = arith.addi %arg4, %c1_i64 : i64
      cc.continue %9 : i64
    } {normalized}
    %6 = arith.subi %5, %c1_i64 : i64
    %7 = arith.cmpi eq, %5, %c0_i64 : i64
    %8 = arith.select %7, %arg3, %6 : i64
    quake.x %1 : (!quake.ref) -> ()
    cc.continue %arg2, %8 : i64, i64
  } step {
  ^bb0(%arg2: i64, %arg3: i64):
    %5 = arith.addi %arg2, %c1_i64 : i64
    cc.continue %5, %arg3 : i64, i64
  } {normalized}
  quake.evince %3 : (!quake.veq<2>) -> () {compilerGenerated}
  quake.dealloc %1 : !quake.ref
  quake.dealloc %2 : !quake.ref
  return
}

// CHECK-LABEL:   func.func @nested_loop_wire_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64, %[[ARG1:.*]]: i64) {
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 1 : i64
// CHECK:           %[[CONSTANT_1:.*]] = arith.constant 0 : i64
// CHECK:           %[[UNDEF_0:.*]] = cc.undef i64
// CHECK:           %[[ALLOCA_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[ALLOCA_1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[ALLOCA_0]], %[[ALLOCA_1]] : (!quake.ref, !quake.ref) -> !quake.veq<2>
// CHECK:           %[[LOOP_0:.*]]:2 = cc.loop while ((%[[VAL_0:.*]] = %[[CONSTANT_1]], %[[VAL_1:.*]] = %[[UNDEF_0]]) -> (i64, i64)) {
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi slt, %[[VAL_0]], %[[ARG0]] : i64
// CHECK:             cc.condition %[[CMPI_0]](%[[VAL_0]], %[[VAL_1]] : i64, i64)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_2:.*]]: i64, %[[VAL_3:.*]]: i64):
// CHECK:             %[[UNWRAP_0:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[X_0:.*]] = quake.x %[[UNWRAP_0]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.wrap %[[X_0]] to %[[ALLOCA_0]] : !quake.wire, !quake.ref
// CHECK:             %[[LOOP_1:.*]] = cc.loop while ((%[[VAL_4:.*]] = %[[CONSTANT_1]]) -> (i64)) {
// CHECK:               %[[CMPI_1:.*]] = arith.cmpi slt, %[[VAL_4]], %[[ARG0]] : i64
// CHECK:               cc.condition %[[CMPI_1]](%[[VAL_4]] : i64)
// CHECK:             } do {
// CHECK:             ^bb0(%[[VAL_5:.*]]: i64):
// CHECK:               %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[CONCAT_0]]{{\[}}%[[ARG1]]] : (!quake.veq<2>, i64) -> !quake.ref
// CHECK:               %[[UNWRAP_1:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:               %[[H_0:.*]] = quake.h %[[UNWRAP_1]] : (!quake.wire) -> !quake.wire
// CHECK:               quake.wrap %[[H_0]] to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:               cc.continue %[[VAL_5]] : i64
// CHECK:             } step {
// CHECK:             ^bb0(%[[VAL_6:.*]]: i64):
// CHECK:               %[[ADDI_0:.*]] = arith.addi %[[VAL_6]], %[[CONSTANT_0]] : i64
// CHECK:               cc.continue %[[ADDI_0]] : i64
// CHECK:             } {normalized}
// CHECK:             %[[SUBI_0:.*]] = arith.subi %[[LOOP_1]], %[[CONSTANT_0]] : i64
// CHECK:             %[[CMPI_2:.*]] = arith.cmpi eq, %[[LOOP_1]], %[[CONSTANT_1]] : i64
// CHECK:             %[[SELECT_0:.*]] = arith.select %[[CMPI_2]], %[[VAL_3]], %[[SUBI_0]] : i64
// CHECK:             %[[UNWRAP_2:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[X_1:.*]] = quake.x %[[UNWRAP_2]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.wrap %[[X_1]] to %[[ALLOCA_0]] : !quake.wire, !quake.ref
// CHECK:             cc.continue %[[VAL_2]], %[[SELECT_0]] : i64, i64
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_7:.*]]: i64, %[[VAL_8:.*]]: i64):
// CHECK:             %[[ADDI_1:.*]] = arith.addi %[[VAL_7]], %[[CONSTANT_0]] : i64
// CHECK:             cc.continue %[[ADDI_1]], %[[VAL_8]] : i64, i64
// CHECK:           } {normalized}
// CHECK:           quake.evince %[[CONCAT_0]] : (!quake.veq<2>) -> () {compilerGenerated}
// CHECK:           %[[UNWRAP_3:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:           quake.sink %[[UNWRAP_3]] : !quake.wire
// CHECK:           %[[UNWRAP_4:.*]] = quake.unwrap %[[ALLOCA_1]] : (!quake.ref) -> !quake.wire
// CHECK:           quake.sink %[[UNWRAP_4]] : !quake.wire
// CHECK:           return
// CHECK:         }

// %r is concat'd into %v, which is then indexed dynamically, so %r's qubit
// may be reached through an unknown element of %v. The location stays in
// memory form and each gate keeps its own unwrap/wrap, including across the
// cc.scope's internal CFG blocks -- no wire is threaded through the region.
func.func @scope_internal_alias(%idx: i64) {
  %c0 = arith.constant 0 : i64
  %r = quake.alloca !quake.ref
  %v = quake.concat %r : (!quake.ref) -> !quake.veq<1>
  quake.y %r : (!quake.ref) -> ()
  cc.scope atomic {
    %cond = arith.cmpi ugt, %idx, %c0 : i64
    cf.cond_br %cond, ^exit, ^body
  ^body:
    %q = quake.extract_ref %v[%idx] : (!quake.veq<1>, i64) -> !quake.ref
    quake.h %q : (!quake.ref) -> ()
    quake.x %r : (!quake.ref) -> ()
    cf.br ^exit
  ^exit:
    quake.z %r : (!quake.ref) -> ()
    cc.continue
  }
  quake.dealloc %r : !quake.ref
  return
}

// CHECK-LABEL:   func.func @scope_internal_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 0 : i64
// CHECK:           %[[ALLOCA_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[ALLOCA_0]] : (!quake.ref) -> !quake.veq<1>
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[Y_0:.*]] = quake.y %[[UNWRAP_0]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[Y_0]] to %[[ALLOCA_0]] : !quake.wire, !quake.ref
// CHECK:           cc.scope atomic {
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi ugt, %[[ARG0]], %[[CONSTANT_0]] : i64
// CHECK:             cf.cond_br %[[CMPI_0]], ^bb2, ^bb1
// CHECK:           ^bb1:
// CHECK:             %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[CONCAT_0]]{{\[}}%[[ARG0]]] : (!quake.veq<1>, i64) -> !quake.ref
// CHECK:             %[[UNWRAP_1:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[H_0:.*]] = quake.h %[[UNWRAP_1]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.wrap %[[H_0]] to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:             %[[UNWRAP_2:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[X_0:.*]] = quake.x %[[UNWRAP_2]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.wrap %[[X_0]] to %[[ALLOCA_0]] : !quake.wire, !quake.ref
// CHECK:             cf.br ^bb2
// CHECK:           ^bb2:
// CHECK:             %[[UNWRAP_3:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[Z_0:.*]] = quake.z %[[UNWRAP_3]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.wrap %[[Z_0]] to %[[ALLOCA_0]] : !quake.wire, !quake.ref
// CHECK:             cc.continue
// CHECK:           }
// CHECK:           %[[UNWRAP_4:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:           quake.sink %[[UNWRAP_4]] : !quake.wire
// CHECK:           return
// CHECK:         }

// A non-escaping ref alloca (%3) used as a gate control inside a
// dynamically-aliased loop. %3 is its own root and no memory-form access
// reaches it, so it is still promoted to a null wire, while the refs coming
// out of the dynamically-indexed veq stay in memory form alongside it.
func.func @control_operand_alias(%arg0: i64) {
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %0 = quake.alloca !quake.ref
  %1 = quake.alloca !quake.ref
  %2 = quake.concat %0, %1 : (!quake.ref, !quake.ref) -> !quake.veq<2>
  %3 = quake.alloca !quake.ref
  %4 = cc.loop while ((%arg1 = %c0_i64) -> (i64)) {
    %5 = arith.cmpi slt, %arg1, %arg0 : i64
    cc.condition %5(%arg1 : i64)
  } do {
  ^bb0(%arg1: i64):
    %5 = quake.extract_ref %2[%arg1] : (!quake.veq<2>, i64) -> !quake.ref
    quake.x [%3] %5 : (!quake.ref, !quake.ref) -> ()
    cc.continue %arg1 : i64
  } step {
  ^bb0(%arg1: i64):
    %5 = arith.addi %arg1, %c1_i64 : i64
    cc.continue %5 : i64
  } {normalized}
  quake.evince %2 : (!quake.veq<2>) -> () {compilerGenerated}
  quake.evince %3 : (!quake.ref) -> () {compilerGenerated}
  quake.dealloc %3 : !quake.ref
  quake.dealloc %0 : !quake.ref
  quake.dealloc %1 : !quake.ref
  return
}

// CHECK-LABEL:   func.func @control_operand_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[ALLOCA_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[ALLOCA_1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[ALLOCA_0]], %[[ALLOCA_1]] : (!quake.ref, !quake.ref) -> !quake.veq<2>
// CHECK:           %[[NULL_0:.*]] = quake.null_wire
// CHECK:           %{{.*}}:2 = cc.loop while ((%[[CNT:.*]] = %{{.*}}, %[[CTRL:.*]] = %[[NULL_0]]) -> (i64, !quake.wire)) {
// CHECK:           } do {
// CHECK:           ^bb0(%[[CNTARG:.*]]: i64, %[[CTRLARG:.*]]: !quake.wire):
// CHECK:             %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[CONCAT_0]]{{\[}}%[[CNTARG]]] : (!quake.veq<2>, i64) -> !quake.ref
// CHECK:             %[[UNWRAP_0:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[X_0:.*]]:2 = quake.x [%[[CTRLARG]]] %[[UNWRAP_0]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:             quake.wrap %[[X_0]]#1 to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:             cc.continue %{{.*}}, %[[X_0]]#0 : i64, !quake.wire
// CHECK:           } step {
// CHECK:           }
// CHECK:           quake.evince %[[CONCAT_0]]
// CHECK:           quake.sink
// CHECK:           return
// CHECK:         }
