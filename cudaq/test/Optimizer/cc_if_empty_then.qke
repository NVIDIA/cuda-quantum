// RUN: cudaq-opt %s | cudaq-opt | FileCheck %s

// A cc.if with an empty then region prints as `{ }`. It must parse again (as a
// region that still has a block).

func.func @empty_then(%c: i1) -> i32 {
  %c2 = arith.constant 2 : i32
  cc.if(%c) {
  } else {
    cc.unwind_return %c2 : i32
  }
  %u = cc.undef i32
  return %u : i32
}

func.func @empty_both(%c: i1) {
  cc.if(%c) {
  } else {
  }
  return
}

// CHECK-LABEL: func.func @empty_then(
// CHECK:         cc.if(%{{.*}}) {
// CHECK:         } else {
// CHECK:           cc.unwind_return
// CHECK:         }
// CHECK-LABEL: func.func @empty_both(
