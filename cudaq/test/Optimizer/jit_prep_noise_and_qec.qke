// Both prep pipelines erase `quake.apply_noise` and the QEC operations by
// default, and keep each when its option turns the erasure off.

// RUN: cudaq-opt --pass-pipeline="builtin.module(hw-jit-prep-pipeline)" %s | \
// RUN:   FileCheck --check-prefix=ERASE %s
// RUN: cudaq-opt --pass-pipeline="builtin.module(emul-jit-prep-pipeline)" %s | \
// RUN:   FileCheck --check-prefix=ERASE %s
// RUN: cudaq-opt --pass-pipeline="builtin.module(hw-jit-prep-pipeline{erase-noise=false erase-qec=false})" %s | \
// RUN:   FileCheck --check-prefixes=NOISE,QEC %s
// RUN: cudaq-opt --pass-pipeline="builtin.module(emul-jit-prep-pipeline{erase-noise=false erase-qec=false})" %s | \
// RUN:   FileCheck --check-prefixes=NOISE,QEC %s

func.func @noisy_detector(%p: !cc.ptr<f64>, %h: !cc.measure_handle) {
  %q = quake.alloca !quake.ref
  quake.h %q : (!quake.ref) -> ()
  quake.apply_noise @channel(%p) %q : (!cc.ptr<f64>, !quake.ref) -> ()
  qec.detector %h : !cc.measure_handle
  return
}

func.func private @channel(!cc.ptr<f64>, !quake.ref)

// ERASE-LABEL: func.func @noisy_detector(
// ERASE-NOT:     quake.apply_noise
// ERASE-NOT:     qec.detector
// ERASE:         return

// NOISE-LABEL: func.func @noisy_detector(
// NOISE:         quake.apply_noise @channel
// QEC:           qec.detector
