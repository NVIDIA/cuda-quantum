// RUN: cudaq-opt --verify-each "--codegen-for-qir=convert-to=qir value-semantics=true" %s | FileCheck %s
// RUN: cudaq-opt --verify-each "--codegen-for-qir=convert-to=qir-adaptive value-semantics=true" %s | FileCheck %s

// One SWAP output stays live across the inner conditional. Bypassing its
// join before QIR conversion gives that wire a use on each incoming path.
func.func @nested_swap(%outer: i1, %inner: i1) attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %a = quake.alloca !quake.ref
  %b = quake.alloca !quake.ref
  cc.if(%outer) {
    quake.swap %a, %b : (!quake.ref, !quake.ref) -> ()
    cc.if(%inner) {
      quake.h %b : (!quake.ref) -> ()
    }
  }
  %ma = quake.mz %a : (!quake.ref) -> !cc.measure_handle
  %mb = quake.mz %b : (!quake.ref) -> !cc.measure_handle
  return
}

// CHECK-LABEL: llvm.func @nested_swap(
// CHECK: llvm.cond_br
// CHECK: llvm.call @__quantum__qis__swap
// CHECK: llvm.cond_br
// CHECK: llvm.call @__quantum__qis__h
// CHECK: llvm.return
