// RUN: cudaq-opt --verify-each --phase-folding="min-length=0 min-rz-weight=0" %s | FileCheck %s

// A `quake.x` with two controls leaves its target in a state that is not a
// parity of its inputs, so it ends the subcircuit. Its second control and its
// target hold different values, so phase folding must not merge the angles of
// the rotations on them.
func.func @control_and_target(%a: f64, %b: f64) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2 = quake.null_wire
  %3:2 = quake.x [%0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:3 = quake.x [%1, %3#0] %3#1 : (!quake.wire, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire, !quake.wire)
  %5 = quake.rz (%a) %4#1 : (f64, !quake.wire) -> !quake.wire
  %6 = quake.rz (%b) %4#2 : (f64, !quake.wire) -> !quake.wire
  quake.sink %4#0 : !quake.wire
  quake.sink %5 : !quake.wire
  quake.sink %6 : !quake.wire
  return
}

// CHECK-LABEL: func.func @control_and_target(
// CHECK-SAME:      %[[A:.*]]: f64, %[[B:.*]]: f64)
// CHECK-NOT:     arith.addf
// CHECK:         quake.rz (%[[A]])
// CHECK:         quake.rz (%[[B]])

// The two rotations before the doubly controlled `quake.x` belong to the
// subcircuit of the first singly controlled `quake.x`. The singly controlled
// `quake.x` after the doubly controlled one starts a second subcircuit, which
// must not reach back across the doubly controlled `quake.x` and fold the same
// rotations again.
func.func @rotations_before_toffoli(%a: f64, %b: f64) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2 = quake.null_wire
  %3 = quake.null_wire
  %4 = quake.null_wire
  %5:2 = quake.x [%0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %6 = quake.rz (%a) %5#0 : (f64, !quake.wire) -> !quake.wire
  %7 = quake.rz (%b) %6 : (f64, !quake.wire) -> !quake.wire
  %8:3 = quake.x [%1, %7] %3 : (!quake.wire, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire, !quake.wire)
  %9:2 = quake.x [%8#2] %4 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %5#1 : !quake.wire
  quake.sink %8#0 : !quake.wire
  quake.sink %8#1 : !quake.wire
  quake.sink %9#0 : !quake.wire
  quake.sink %9#1 : !quake.wire
  return
}

// CHECK-LABEL: func.func @rotations_before_toffoli(
// CHECK-SAME:      %[[A:.*]]: f64, %[[B:.*]]: f64)
// CHECK:         %[[SUM:.*]] = arith.addf %[[A]], %[[B]] : f64
// CHECK:         %[[ROT:.*]] = quake.rz (%[[SUM]])
// CHECK-NOT:     quake.rz
// CHECK:         quake.x [%{{.*}}, %[[ROT]]]
