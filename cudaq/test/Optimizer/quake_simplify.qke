// RUN: cudaq-opt --quake-simplify %s | FileCheck %s

func.func private @opaque_wire(!quake.wire) -> !quake.wire
func.func private @wire_source() -> !quake.wire

func.func @simp1() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.x [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %3#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp1() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]], %[[VAL_3:.*]] = quake.mz %[[VAL_0]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_4:.*]], %[[VAL_5:.*]] = quake.mz %[[VAL_1]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_6:.*]] = quake.discriminate %[[VAL_2]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_7:.*]] = quake.discriminate %[[VAL_4]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_3]] : !quake.wire
// CHECK:           quake.sink %[[VAL_5]] : !quake.wire
// CHECK:           return %[[VAL_6]], %[[VAL_7]] : i1, i1
// CHECK:         }

func.func @simp5() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.swap %0, %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.swap %2#1, %2#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %3#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// The second Swap names the two qubits in the opposite order, so its first
// result is the qubit that entered on %[[VAL_1]]. Each measurement must follow
// its own qubit back to the wire that qubit entered on.
// CHECK-LABEL:   func.func @simp5() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]], %[[VAL_3:.*]] = quake.mz %[[VAL_1]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_4:.*]], %[[VAL_5:.*]] = quake.mz %[[VAL_0]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_6:.*]] = quake.discriminate %[[VAL_2]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_7:.*]] = quake.discriminate %[[VAL_4]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_3]] : !quake.wire
// CHECK:           quake.sink %[[VAL_5]] : !quake.wire
// CHECK:           return %[[VAL_6]], %[[VAL_7]] : i1, i1
// CHECK:         }

func.func @simp4() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.y [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.y [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %5:2 = quake.y [%3#0] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %5#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %8:2 = quake.mz %5#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %8#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %8#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp4() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]]:2 = quake.y {{\[}}%[[VAL_0]]] %[[VAL_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_3:.*]], %[[VAL_4:.*]] = quake.mz %[[VAL_2]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_5:.*]], %[[VAL_6:.*]] = quake.mz %[[VAL_2]]#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_7:.*]] = quake.discriminate %[[VAL_3]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_8:.*]] = quake.discriminate %[[VAL_5]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_4]] : !quake.wire
// CHECK:           quake.sink %[[VAL_6]] : !quake.wire
// CHECK:           return %[[VAL_7]], %[[VAL_8]] : i1, i1
// CHECK:         }

func.func @simp2() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %p0 = arith.constant 1.0 : f64
  %p1 = arith.constant 10.0 : f64
  %2:2 = quake.rx (%p0) [%0] %1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.rx (%p1) [%2#0] %2#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %3#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp2() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1.100000e+01 : f64
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]] = quake.null_wire
// CHECK:           %[[VAL_3:.*]]:2 = quake.rx (%[[VAL_0]]) {{\[}}%[[VAL_1]]] %[[VAL_2]] : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_4:.*]], %[[VAL_5:.*]] = quake.mz %[[VAL_3]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_6:.*]], %[[VAL_7:.*]] = quake.mz %[[VAL_3]]#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_8:.*]] = quake.discriminate %[[VAL_4]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_9:.*]] = quake.discriminate %[[VAL_6]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_5]] : !quake.wire
// CHECK:           quake.sink %[[VAL_7]] : !quake.wire
// CHECK:           return %[[VAL_8]], %[[VAL_9]] : i1, i1
// CHECK:         }

func.func @simp3() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %p0 = arith.constant 1.0 : f64
  %p1 = arith.constant -10.0 : f64
  %p2 = arith.constant 2.0 : f64
  %p3 = arith.constant 20.0 : f64
  %p4 = arith.constant 3.0 : f64
  %p5 = arith.constant 30.0 : f64
  %2:2 = quake.u3 (%p0,%p2,%p4) [%0] %1 : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.u3<adj> (%p1,%p3,%p5) [%2#0] %2#1 : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %3#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp3() -> (i1, i1) {
// CHECK-DAG:       %[[VAL_0:.*]] = arith.constant 3.000000e+01 : f64
// CHECK-DAG:       %[[VAL_1:.*]] = arith.constant 3.000000e+00 : f64
// CHECK-DAG:       %[[VAL_2:.*]] = arith.constant 2.000000e+01 : f64
// CHECK-DAG:       %[[VAL_3:.*]] = arith.constant 2.000000e+00 : f64
// CHECK-DAG:       %[[VAL_4:.*]] = arith.constant -1.000000e+01 : f64
// CHECK-DAG:       %[[VAL_5:.*]] = arith.constant 1.000000e+00 : f64
// CHECK:           %[[VAL_6:.*]] = quake.null_wire
// CHECK:           %[[VAL_7:.*]] = quake.null_wire
// CHECK:           %[[VAL_8:.*]]:2 = quake.u3 (%[[VAL_5]], %[[VAL_3]], %[[VAL_1]]) {{\[}}%[[VAL_6]]] %[[VAL_7]] : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_9:.*]]:2 = quake.u3<adj> (%[[VAL_4]], %[[VAL_2]], %[[VAL_0]]) {{\[}}%[[VAL_8]]#0] %[[VAL_8]]#1 : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_10:.*]], %[[VAL_11:.*]] = quake.mz %[[VAL_9]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_12:.*]], %[[VAL_13:.*]] = quake.mz %[[VAL_9]]#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_14:.*]] = quake.discriminate %[[VAL_10]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_15:.*]] = quake.discriminate %[[VAL_12]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_11]] : !quake.wire
// CHECK:           quake.sink %[[VAL_13]] : !quake.wire
// CHECK:           return %[[VAL_14]], %[[VAL_15]] : i1, i1
// CHECK:         }

func.func @fail_to_simplify() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %8 = quake.null_wire
  %p0 = arith.constant 1.0 : f64
  %p1 = arith.constant -10.0 : f64
  %p2 = arith.constant 2.0 : f64
  %p3 = arith.constant 20.0 : f64
  %p4 = arith.constant 3.0 : f64
  %p5 = arith.constant 30.0 : f64
  %2:2 = quake.u3 (%p0,%p2,%p4) [%0] %1 : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.u3<adj> (%p1,%p3,%p5) [%8] %2#1 : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %9 = quake.x %3#0 : (!quake.wire) -> !quake.wire
  %11:2 = quake.x [%9] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %12 = quake.y %11#0 : (!quake.wire) -> !quake.wire
  %13:2 = quake.y [%11#1] %12 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %14 = quake.z %13#1 : (!quake.wire) -> !quake.wire
  %4:2 = quake.mz %13#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %14 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  quake.sink %2#0 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @fail_to_simplify() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 3.000000e+01 : f64
// CHECK:           %[[VAL_1:.*]] = arith.constant 3.000000e+00 : f64
// CHECK:           %[[VAL_2:.*]] = arith.constant 2.000000e+01 : f64
// CHECK:           %[[VAL_3:.*]] = arith.constant 2.000000e+00 : f64
// CHECK:           %[[VAL_4:.*]] = arith.constant -1.000000e+01 : f64
// CHECK:           %[[VAL_5:.*]] = arith.constant 1.000000e+00 : f64
// CHECK:           %[[VAL_6:.*]] = quake.null_wire
// CHECK:           %[[VAL_7:.*]] = quake.null_wire
// CHECK:           %[[VAL_8:.*]] = quake.null_wire
// CHECK:           %[[VAL_9:.*]]:2 = quake.u3 (%[[VAL_5]], %[[VAL_3]], %[[VAL_1]]) {{\[}}%[[VAL_6]]] %[[VAL_7]] : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_10:.*]]:2 = quake.u3<adj> (%[[VAL_4]], %[[VAL_2]], %[[VAL_0]]) {{\[}}%[[VAL_8]]] %[[VAL_9]]#1 : (f64, f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_11:.*]] = quake.x %[[VAL_10]]#0 : (!quake.wire) -> !quake.wire
// CHECK:           %[[VAL_12:.*]]:2 = quake.x {{\[}}%[[VAL_11]]] %[[VAL_10]]#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_13:.*]] = quake.y %[[VAL_12]]#0 : (!quake.wire) -> !quake.wire
// CHECK:           %[[VAL_14:.*]]:2 = quake.y {{\[}}%[[VAL_12]]#1] %[[VAL_13]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_15:.*]] = quake.z %[[VAL_14]]#1 : (!quake.wire) -> !quake.wire
// CHECK:           %[[VAL_16:.*]], %[[VAL_17:.*]] = quake.mz %[[VAL_14]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_18:.*]], %[[VAL_19:.*]] = quake.mz %[[VAL_15]] : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_20:.*]] = quake.discriminate %[[VAL_16]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_21:.*]] = quake.discriminate %[[VAL_18]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_17]] : !quake.wire
// CHECK:           quake.sink %[[VAL_19]] : !quake.wire
// CHECK:           quake.sink %[[VAL_9]]#0 : !quake.wire
// CHECK:           return %[[VAL_20]], %[[VAL_21]] : i1, i1
// CHECK:         }

// Z = SS
func.func @simp6() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.s [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %3#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp6() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]]:2 = quake.z {{\[}}%[[VAL_0]]] %[[VAL_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_3:.*]], %[[VAL_4:.*]] = quake.mz %[[VAL_2]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_5:.*]], %[[VAL_6:.*]] = quake.mz %[[VAL_2]]#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_7:.*]] = quake.discriminate %[[VAL_3]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_8:.*]] = quake.discriminate %[[VAL_5]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_4]] : !quake.wire
// CHECK:           quake.sink %[[VAL_6]] : !quake.wire
// CHECK:           return %[[VAL_7]], %[[VAL_8]] : i1, i1
// CHECK:         }

// S = TT
func.func @simp7() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.t [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.t [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %3#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %3#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp7() -> (i1, i1) {
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[VAL_2:.*]]:2 = quake.s {{\[}}%[[VAL_0]]] %[[VAL_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_3:.*]], %[[VAL_4:.*]] = quake.mz %[[VAL_2]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_5:.*]], %[[VAL_6:.*]] = quake.mz %[[VAL_2]]#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_7:.*]] = quake.discriminate %[[VAL_3]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_8:.*]] = quake.discriminate %[[VAL_5]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_4]] : !quake.wire
// CHECK:           quake.sink %[[VAL_6]] : !quake.wire
// CHECK:           return %[[VAL_7]], %[[VAL_8]] : i1, i1
// CHECK:         }

// Controlled YSX reduces to S plus a phase on the same predicate.
func.func @simp8() -> (i1, i1) {
  %0 = quake.null_wire
  %1 = quake.null_wire
  %2:2 = quake.y [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3:2 = quake.s [%2#0] %2#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %8:2 = quake.x [%3#0] %3#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4:2 = quake.mz %8#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %5:2 = quake.mz %8#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %6 = quake.discriminate %4#0 : (!quake.measure) -> i1
  %7 = quake.discriminate %5#0 : (!quake.measure) -> i1
  quake.sink %4#1 : !quake.wire
  quake.sink %5#1 : !quake.wire
  func.return %6, %7 : i1, i1
}

// CHECK-LABEL:   func.func @simp8() -> (i1, i1) {
// CHECK:           %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK:           %[[VAL_1:.*]] = quake.null_wire
// CHECK:           %[[S:.*]]:2 = quake.s {{\[}}%[[VAL_0]]] %[[VAL_1]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[PHASE:.*]]:2 = quake.phase (%[[PI]]) {{\[}}%[[S]]#0] %[[S]]#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           %[[VAL_5:.*]], %[[VAL_6:.*]] = quake.mz %[[PHASE]]#0 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_7:.*]], %[[VAL_8:.*]] = quake.mz %[[PHASE]]#1 : (!quake.wire) -> (!quake.measure, !quake.wire)
// CHECK:           %[[VAL_9:.*]] = quake.discriminate %[[VAL_5]] : (!quake.measure) -> i1
// CHECK:           %[[VAL_10:.*]] = quake.discriminate %[[VAL_7]] : (!quake.measure) -> i1
// CHECK:           quake.sink %[[VAL_6]] : !quake.wire
// CHECK:           quake.sink %[[VAL_8]] : !quake.wire
// CHECK:           return %[[VAL_9]], %[[VAL_10]] : i1, i1
// CHECK:         }

// Uncontrolled YSX is rewritten exactly as S followed by phase(pi).
func.func @simp9() {
  %0 = quake.null_wire
  %1 = quake.y %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s %1 : (!quake.wire) -> !quake.wire
  %3 = quake.x %2 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @simp9() {
// CHECK:           %[[PI:.*]] = arith.constant 3.1415926535897931 : f64
// CHECK:           %[[VAL_0:.*]] = quake.null_wire
// CHECK-NEXT:      %[[VAL_1:.*]] = quake.s %[[VAL_0]] : (!quake.wire) -> !quake.wire
// CHECK-NEXT:      %[[PHASE:.*]] = quake.phase (%[[PI]]) %[[VAL_1]] : (f64, !quake.wire) -> !quake.wire
// CHECK-NEXT:      quake.sink %[[PHASE]] : !quake.wire
// CHECK-NEXT:      return
// CHECK-NEXT:    }

func.func @simp10() {
  %0 = quake.null_wire
  %4 = quake.y %0 : (!quake.wire) -> !quake.wire
  %1 = quake.reset %4 : (!quake.wire) -> !quake.wire
  quake.sink %1 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @simp10() {
// CHECK:           %[[NULL_WIRE_0:.*]] = quake.null_wire
// CHECK:           %[[Y_0:.*]] = quake.y %[[NULL_WIRE_0]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.sink %[[Y_0]] : !quake.wire
// CHECK:           return
// CHECK:         }

func.func @simp11() {
  %0 = quake.null_wire
  %4 = quake.y %0 : (!quake.wire) -> !quake.wire
  %1 = quake.reset %4 : (!quake.wire) -> !quake.wire
  %2 = quake.reset %1 : (!quake.wire) -> !quake.wire
  %3 = quake.z %2 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @simp11() {
// CHECK:           %[[NULL_WIRE_0:.*]] = quake.null_wire
// CHECK:           %[[Y_0:.*]] = quake.y %[[NULL_WIRE_0]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[RESET_0:.*]] = quake.reset %[[Y_0]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[Z_0:.*]] = quake.z %[[RESET_0]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.sink %[[Z_0]] : !quake.wire
// CHECK:           return
// CHECK:         }

func.func @simp12() {
  %0 = quake.null_wire
  %1 = quake.reset %0 : (!quake.wire) -> !quake.wire
  %3 = quake.z %1 : (!quake.wire) -> !quake.wire
  quake.sink %3 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @simp12() {
// CHECK:           %[[NULL_WIRE_0:.*]] = quake.null_wire
// CHECK:           %[[Z_0:.*]] = quake.z %[[NULL_WIRE_0]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.sink %[[Z_0]] : !quake.wire
// CHECK:           return
// CHECK:         }

// Reference-form effects that may alias an active wire prevent reset
// elimination. The measured lane also keeps an otherwise unused wire path.
func.func @preserve_resets_across_aliases(%updated: !quake.ref, %measured: !quake.ref) -> i1 {
  %updated_wire = quake.unwrap %updated : (!quake.ref) -> !quake.wire
  %reset0 = quake.reset %updated_wire : (!quake.wire) -> !quake.wire
  quake.x %updated : (!quake.ref) -> ()
  %reset1 = quake.reset %reset0 : (!quake.wire) -> !quake.wire
  %bit, %updated_result = quake.mz %reset1
      : (!quake.wire) -> (!quake.measure, !quake.wire)
  quake.wrap %updated_result to %updated : !quake.wire, !quake.ref
  %measured_wire = quake.unwrap %measured : (!quake.ref) -> !quake.wire
  %reset2 = quake.reset %measured_wire : (!quake.wire) -> !quake.wire
  %measurement = quake.mz %measured : (!quake.ref) -> !cc.measure_handle
  %value = quake.discriminate %measurement : (!cc.measure_handle) -> i1
  quake.sink %reset2 : !quake.wire
  return %value : i1
}

// CHECK-LABEL:   func.func @preserve_resets_across_aliases(
// CHECK-SAME:      %[[UPDATED:.*]]: !quake.ref, %[[MEASURED:.*]]: !quake.ref) -> i1 {
// CHECK-NEXT:      %[[UPDATED_WIRE:.*]] = quake.unwrap %[[UPDATED]]
// CHECK-NEXT:      %[[RESET0:.*]] = quake.reset %[[UPDATED_WIRE]]
// CHECK-NEXT:      quake.x %[[UPDATED]]
// CHECK-NEXT:      %[[RESET1:.*]] = quake.reset %[[RESET0]]
// CHECK-NEXT:      %[[BIT:.*]], %[[UPDATED_RESULT:.*]] = quake.mz %[[RESET1]]
// CHECK-NEXT:      quake.wrap %[[UPDATED_RESULT]] to %[[UPDATED]]
// CHECK-NEXT:      %[[MEASURED_WIRE:.*]] = quake.unwrap %[[MEASURED]]
// CHECK-NEXT:      %[[RESET2:.*]] = quake.reset %[[MEASURED_WIRE]]
// CHECK-NEXT:      %[[MEASUREMENT:.*]] = quake.mz %[[MEASURED]]
// CHECK-NEXT:      %[[VALUE:.*]] = quake.discriminate %[[MEASUREMENT]]
// CHECK-NEXT:      quake.sink %[[RESET2]]
// CHECK-NEXT:      return %[[VALUE]] : i1
// CHECK-NEXT:    }

func.func @preserve_reset_sink_alias_measurements(
    %direct: !quake.ref, %duplicate: !quake.ref) -> (i1, i1) {
  %direct_wire = quake.unwrap %direct : (!quake.ref) -> !quake.wire
  %direct_reset = quake.reset %direct_wire : (!quake.wire) -> !quake.wire
  quake.sink %direct_reset : !quake.wire
  %direct_measurement = quake.mz %direct : (!quake.ref) -> !cc.measure_handle
  %direct_result = quake.discriminate %direct_measurement
      : (!cc.measure_handle) -> i1

  %duplicate_wire0 = quake.unwrap %duplicate : (!quake.ref) -> !quake.wire
  %duplicate_wire1 = quake.unwrap %duplicate : (!quake.ref) -> !quake.wire
  %duplicate_reset = quake.reset %duplicate_wire0
      : (!quake.wire) -> !quake.wire
  quake.sink %duplicate_reset : !quake.wire
  %duplicate_measurement, %duplicate_result_wire = quake.mz %duplicate_wire1
      : (!quake.wire) -> (!quake.measure, !quake.wire)
  %duplicate_result = quake.discriminate %duplicate_measurement
      : (!quake.measure) -> i1
  quake.sink %duplicate_result_wire : !quake.wire
  return %direct_result, %duplicate_result : i1, i1
}

// CHECK-LABEL: func.func @preserve_reset_sink_alias_measurements(
// CHECK:         %[[DIRECT_RESET:.*]] = quake.reset
// CHECK-NEXT:    quake.sink %[[DIRECT_RESET]]
// CHECK-NEXT:    %[[DIRECT_MZ:.*]] = quake.mz
// CHECK:         %[[DUP_RESET:.*]] = quake.reset
// CHECK-NEXT:    quake.sink %[[DUP_RESET]]
// CHECK-NEXT:    %[[DUP_MZ:.*]], %[[DUP_WIRE:.*]] = quake.mz
// CHECK:         %[[DUP_RESULT:.*]] = quake.discriminate %[[DUP_MZ]]
// CHECK-NEXT:    quake.sink %[[DUP_WIRE]]

func.func @preserve_reset_sink_with_branched_input() -> i1 {
  %wire = quake.null_wire
  %prepared = quake.x %wire : (!quake.wire) -> !quake.wire
  %reset = quake.reset %prepared : (!quake.wire) -> !quake.wire
  quake.sink %reset : !quake.wire
  cf.br ^measure
^measure:
  %measurement, %result_wire = quake.mz %prepared
      : (!quake.wire) -> (!quake.measure, !quake.wire)
  %result = quake.discriminate %measurement : (!quake.measure) -> i1
  quake.sink %result_wire : !quake.wire
  return %result : i1
}

// CHECK-LABEL: func.func @preserve_reset_sink_with_branched_input() -> i1 {
// CHECK:         %[[WIRE:.*]] = quake.null_wire
// CHECK-NEXT:    %[[PREPARED:.*]] = quake.x %[[WIRE]]
// CHECK-NEXT:    %[[RESET:.*]] = quake.reset %[[PREPARED]]
// CHECK-NEXT:    quake.sink %[[RESET]]
// CHECK-NEXT:    cf.br ^bb1
// CHECK:       ^bb1:
// CHECK-NEXT:    %[[MEASUREMENT:.*]], %[[RESULT_WIRE:.*]] = quake.mz %[[PREPARED]]
// CHECK:         %[[RESULT:.*]] = quake.discriminate %[[MEASUREMENT]]
// CHECK-NEXT:    quake.sink %[[RESULT_WIRE]]
// CHECK-NEXT:    return %[[RESULT]] : i1

// Non-unitary operations and opaque control flow require observable pass
// coverage because they are outside CircuitCheck's unitary contract.
func.func @commutation_boundaries(%condition: i1,
    %word: !cc.charspan) -> i1 {
  %angle = arith.constant 2.500000e-01 : f64

  %measured_positive = quake.null_wire
  %mz_z0 = quake.z %measured_positive : (!quake.wire) -> !quake.wire
  %mz_bit, %mz_wire = quake.mz %mz_z0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %mz_result = quake.discriminate %mz_bit : (!quake.measure) -> i1
  %mz_z1 = quake.z %mz_wire : (!quake.wire) -> !quake.wire
  %measured_negative = quake.null_wire
  %mz_h0 = quake.h %measured_negative : (!quake.wire) -> !quake.wire
  %negative_bit, %negative_wire = quake.mz %mz_h0 : (!quake.wire) -> (!quake.measure, !quake.wire)
  %mz_h1 = quake.h %negative_wire : (!quake.wire) -> !quake.wire

  %reset_positive = quake.null_wire
  %reset_z0 = quake.z %reset_positive : (!quake.wire) -> !quake.wire
  %reset_z = quake.reset %reset_z0 : (!quake.wire) -> !quake.wire
  %reset_z1 = quake.z %reset_z : (!quake.wire) -> !quake.wire
  %reset_negative = quake.null_wire
  %reset_x0 = quake.x %reset_negative : (!quake.wire) -> !quake.wire
  %reset_x = quake.reset %reset_x0 : (!quake.wire) -> !quake.wire
  %reset_x1 = quake.x %reset_x : (!quake.wire) -> !quake.wire

  %multi0 = quake.null_wire
  %multi1 = quake.null_wire
  %multi_h0 = quake.h %multi0 : (!quake.wire) -> !quake.wire
  %multi_bit, %multi_wire:2 = quake.mz %multi_h0, %multi1 : (!quake.wire, !quake.wire) -> (!cc.sequence<!cc.measure_handle>, !quake.wire, !quake.wire)
  %multi_h1 = quake.h %multi_wire#0 : (!quake.wire) -> !quake.wire

  %call_input = quake.null_wire
  %call_h0 = quake.h %call_input : (!quake.wire) -> !quake.wire
  %called = func.call @opaque_wire(%call_h0) : (!quake.wire) -> !quake.wire
  %call_h1 = quake.h %called : (!quake.wire) -> !quake.wire
  %unknown_control = quake.null_wire
  %unknown_target = func.call @wire_source() : () -> !quake.wire
  %unknown_z0 = quake.z %unknown_control : (!quake.wire) -> !quake.wire
  %unknown_x:2 = quake.x [%unknown_z0] %unknown_target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %unknown_z1 = quake.z %unknown_x#0 : (!quake.wire) -> !quake.wire

  %region_input = quake.null_wire
  %region_h0 = quake.h %region_input : (!quake.wire) -> !quake.wire
  %region:1 = cc.if (%condition) ((%arg = %region_h0)) -> (!quake.wire) {
    cc.continue %arg : !quake.wire
  } else {
    cc.continue %arg : !quake.wire
  }
  %region_h1 = quake.h %region#0 : (!quake.wire) -> !quake.wire

  %frontier_control = quake.null_wire
  %frontier_target = quake.null_wire
  %frontier_x0:2 = quake.x [%frontier_control] %frontier_target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %frontier_h = quake.h %frontier_x0#0 : (!quake.wire) -> !quake.wire
  %frontier_x1:2 = quake.x [%frontier_h] %frontier_x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)

  %dynamic = quake.null_wire
  %dynamic_z0 = quake.z %dynamic : (!quake.wire) -> !quake.wire
  %dynamic_pauli = quake.exp_pauli (%angle) %dynamic_z0 to %word : (f64, !quake.wire, !cc.charspan) -> !quake.wire
  %dynamic_z1 = quake.z %dynamic_pauli : (!quake.wire) -> !quake.wire

  %reusable_source = quake.null_wire
  %reusable = quake.to_ctrl %reusable_source : (!quake.wire) -> !quake.control
  %reusable_target = quake.null_wire
  %reusable_other = quake.null_wire
  %reusable_h0 = quake.h %reusable_target : (!quake.wire) -> !quake.wire
  %reusable_x = quake.x [%reusable] %reusable_other
      : (!quake.control, !quake.wire) -> !quake.wire
  %reusable_h1 = quake.h %reusable_h0 : (!quake.wire) -> !quake.wire
  %reusable_returned = quake.from_ctrl %reusable
      : (!quake.control) -> !quake.wire

  %wrapped_control = quake.null_wire
  %control_ref = quake.wrap_new %wrapped_control : (!quake.wire) -> !quake.ref
  %control_wire = quake.unwrap %control_ref : (!quake.ref) -> !quake.wire
  %wrapped_target = quake.null_wire
  %target_ref = quake.wrap_new %wrapped_target : (!quake.wire) -> !quake.ref
  %target_wire = quake.unwrap %target_ref : (!quake.ref) -> !quake.wire
  %wrapped_x0:2 = quake.x [%control_wire] %target_wire : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %wrapped_rx:2 = quake.rx (%angle) [%wrapped_x0#0] %wrapped_x0#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %wrapped_x1:2 = quake.x [%wrapped_rx#0] %wrapped_rx#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)

  quake.sink %mz_z1 : !quake.wire
  quake.sink %mz_h1 : !quake.wire
  quake.sink %reset_z1 : !quake.wire
  quake.sink %reset_x1 : !quake.wire
  quake.sink %multi_h1 : !quake.wire
  quake.sink %multi_wire#1 : !quake.wire
  quake.sink %call_h1 : !quake.wire
  quake.sink %unknown_z1 : !quake.wire
  quake.sink %unknown_x#1 : !quake.wire
  quake.sink %region_h1 : !quake.wire
  quake.sink %frontier_x1#0 : !quake.wire
  quake.sink %frontier_x1#1 : !quake.wire
  quake.sink %dynamic_z1 : !quake.wire
  quake.sink %reusable_returned : !quake.wire
  quake.sink %reusable_x : !quake.wire
  quake.sink %reusable_h1 : !quake.wire
  quake.wrap %wrapped_x1#0 to %control_ref : !quake.wire, !quake.ref
  quake.wrap %wrapped_x1#1 to %target_ref : !quake.wire, !quake.ref
  return %mz_result : i1
}

// CHECK-LABEL: func.func @commutation_boundaries
// CHECK:         %[[MZ_Q:.*]] = quake.null_wire
// CHECK-NOT:     quake.z
// CHECK:         quake.mz %[[MZ_Q]]
// CHECK:         %[[MZ_RESULT:.*]] = quake.discriminate
// CHECK-NOT:     quake.z
// CHECK:         %[[MZ_H0:.*]] = quake.h
// CHECK:         %[[MZ_BIT:.*]], %[[MZ_WIRE:.*]] = quake.mz %[[MZ_H0]]
// CHECK:         quake.h %[[MZ_WIRE]]
// CHECK:         %[[RESET_Z_Q:.*]] = quake.null_wire
// CHECK-NOT:     quake.z
// CHECK-NOT:     quake.reset
// CHECK:         %[[RESET_X_Q:.*]] = quake.null_wire
// CHECK:         %[[RESET_X0:.*]] = quake.x
// CHECK:         %[[RESET_X:.*]] = quake.reset %[[RESET_X0]]
// CHECK:         quake.x %[[RESET_X]]
// CHECK:         %[[MULTI_H0:.*]] = quake.h
// CHECK:         %[[MULTI_BIT:.*]], %[[MULTI_WIRE:.*]]:2 = quake.mz %[[MULTI_H0]],
// CHECK:         quake.h %[[MULTI_WIRE]]#0
// CHECK:         %[[CALL_H0:.*]] = quake.h
// CHECK:         %[[CALLED:.*]] = call @opaque_wire(%[[CALL_H0]])
// CHECK:         quake.h %[[CALLED]]
// CHECK:         %[[UNKNOWN_TARGET:.*]] = call @wire_source()
// CHECK:         %[[UNKNOWN_Z0:.*]] = quake.z
// CHECK:         %[[UNKNOWN_X:.*]]:2 = quake.x {{\[}}%[[UNKNOWN_Z0]]] %[[UNKNOWN_TARGET]]
// CHECK:         quake.z %[[UNKNOWN_X]]#0
// CHECK:         %[[REGION_H0:.*]] = quake.h
// CHECK:         %[[REGION:.*]] = cc.if{{.*}}%[[REGION_H0]]
// CHECK:         quake.h %[[REGION]]
// CHECK:         %[[FRONTIER_X0:.*]]:2 = quake.x
// CHECK-NEXT:    %[[FRONTIER_H:.*]] = quake.h %[[FRONTIER_X0]]#0
// CHECK-NEXT:    %[[FRONTIER_X1:.*]]:2 = quake.x {{\[}}%[[FRONTIER_H]]] %[[FRONTIER_X0]]#1
// CHECK:         %[[DYNAMIC_Z0:.*]] = quake.z
// CHECK:         %[[DYNAMIC_PAULI:.*]] = quake.exp_pauli {{.*}} %[[DYNAMIC_Z0]] to
// CHECK:         quake.z %[[DYNAMIC_PAULI]]
// CHECK:         %[[REUSABLE_SOURCE:.*]] = quake.null_wire
// CHECK-NEXT:    %[[REUSABLE:.*]] = quake.to_ctrl %[[REUSABLE_SOURCE]]
// CHECK-NEXT:    %[[REUSABLE_TARGET:.*]] = quake.null_wire
// CHECK-NEXT:    %[[REUSABLE_OTHER:.*]] = quake.null_wire
// CHECK-NEXT:    %[[REUSABLE_H0:.*]] = quake.h %[[REUSABLE_TARGET]]
// CHECK-NEXT:    %[[REUSABLE_X:.*]] = quake.x {{\[}}%[[REUSABLE]]] %[[REUSABLE_OTHER]]
// CHECK-NEXT:    %[[REUSABLE_H1:.*]] = quake.h %[[REUSABLE_H0]]
// CHECK-NEXT:    %[[REUSABLE_RETURNED:.*]] = quake.from_ctrl %[[REUSABLE]]
// CHECK-COUNT-2: quake.wrap_new
// CHECK-NOT:     quake.x
// CHECK:         quake.rx
// CHECK-NOT:     quake.x
// CHECK:         quake.wrap
// CHECK:         return %[[MZ_RESULT]] : i1

func.func @successor_alias_roles(%condition: i1) {
  %wire = quake.null_wire
  cf.cond_br %condition, ^left(%wire, %wire : !quake.wire, !quake.wire), ^right
^left(%control: !quake.wire, %target: !quake.wire):
  %x0:2 = quake.x [%control] %target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1:2 = quake.x [%x0#0] %x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  return
^right:
  return
}

// CHECK-LABEL: func.func @successor_alias_roles
// CHECK:       ^bb1(%[[CONTROL:.*]]: !quake.wire, %[[TARGET:.*]]: !quake.wire):
// CHECK:         quake.x {{\[}}%[[CONTROL]]] %[[TARGET]]
// CHECK:         quake.x
