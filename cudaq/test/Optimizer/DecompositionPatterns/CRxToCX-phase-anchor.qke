// CRxToCX must retain an aggregate target when it cannot anchor its scalar
// residue exactly. This test is FileCheck-only because CircuitCheck does not
// support aggregate quantum targets.
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=CRxToCX})' %s | FileCheck %s

// A vector control would normally be extracted by CRxToCX. Rejection must
// happen first when the target has no legal phase anchor.
func.func @aggregate_target(%control: !quake.veq<1>, %targets: !quake.veq<2>) {
  %theta = arith.constant 2.500000e-01 : f64
  quake.rx (%theta) [%control] %targets
      : (f64, !quake.veq<1>, !quake.veq<2>) -> ()
  return
}

// CHECK-LABEL: func.func @aggregate_target
// CHECK-NOT: quake.extract_ref
// CHECK: quake.rx {{.*}} : (f64, !quake.veq<1>, !quake.veq<2>) -> ()
// CHECK-NOT: quake.phase
// CHECK: return

func.func @unsized_aggregate_target(%control: !quake.ref,
                                    %targets: !quake.veq<?>) {
  %theta = arith.constant 2.500000e-01 : f64
  quake.rx (%theta) [%control] %targets
      : (f64, !quake.ref, !quake.veq<?>) -> ()
  return
}

// CHECK-LABEL: func.func @unsized_aggregate_target
// CHECK: quake.rx {{.*}} : (f64, !quake.ref, !quake.veq<?>) -> ()
// CHECK-NOT: quake.phase
// CHECK: return
