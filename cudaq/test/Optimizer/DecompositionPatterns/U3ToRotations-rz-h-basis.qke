// RUN: cudaq-opt '--decomposition=basis=rz,h' %s | FileCheck %s --implicit-check-not=quake.u3 --implicit-check-not=quake.rx

// A u3 decomposes to Rz+H as three rotations and two Hadamards (plus a phase correction).

// CHECK-LABEL: func.func @u3(
// CHECK:         quake.rz
// CHECK-NEXT:    quake.h
// CHECK-NEXT:    quake.rz
// CHECK-NEXT:    quake.h
// CHECK-NEXT:    quake.rz
// CHECK-NEXT:    quake.phase
// CHECK-NEXT:    return
func.func @u3(%q: !quake.ref) {
  %theta = arith.constant 7.850000e-01 : f64
  %phi = arith.constant 1.230000e-01 : f64
  %lambda = arith.constant 4.560000e-01 : f64
  quake.u3 (%theta, %phi, %lambda) %q : (f64, f64, f64, !quake.ref) -> ()
  return
}
