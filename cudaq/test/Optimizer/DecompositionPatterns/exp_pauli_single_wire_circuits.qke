// Compare SSA wires with the existing reference-form decomposition, without
// relaxing CircuitCheck's default phase or numerical comparison settings.
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=ExpPauliDecomposition})' %s > %t.actual
// RUN: FileCheck %s --implicit-check-not=quake.exp_pauli < %t.actual
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{enable-patterns=ExpPauliDecomposition})' %S/Inputs/exp_pauli_single_wire_reference.qke > %t.reference
// RUN: CircuitCheck --input=%t.actual %t.reference

quake.wire_set @single_wire[1]

func.func @wire_x_f32_forward_positive() attributes {"cudaq-entrypoint"} {
  %qubit = quake.borrow_wire @single_wire[0] : !quake.wire
  %theta = arith.constant 0.125 : f32
  %result = quake.exp_pauli (%theta) %qubit to "X" : (f32, !quake.wire) -> !quake.wire
  quake.return_wire %result : !quake.wire
  return
}

// CHECK-LABEL: func.func @wire_x_f32_forward_positive()
// CHECK: return

func.func @wire_y_f64_adjoint_negative() attributes {"cudaq-entrypoint"} {
  %qubit = quake.borrow_wire @single_wire[0] : !quake.wire
  %theta = arith.constant -0.25 : f64
  %result = quake.exp_pauli<adj> (%theta) %qubit to "Y" : (f64, !quake.wire) -> !quake.wire
  quake.return_wire %result : !quake.wire
  return
}

// CHECK-LABEL: func.func @wire_y_f64_adjoint_negative()
// CHECK: return

func.func @wire_z_f64_forward_negative() attributes {"cudaq-entrypoint"} {
  %qubit = quake.borrow_wire @single_wire[0] : !quake.wire
  %theta = arith.constant -0.25 : f64
  %result = quake.exp_pauli (%theta) %qubit to "Z" : (f64, !quake.wire) -> !quake.wire
  quake.return_wire %result : !quake.wire
  return
}

// CHECK-LABEL: func.func @wire_z_f64_forward_negative()
// CHECK: return
