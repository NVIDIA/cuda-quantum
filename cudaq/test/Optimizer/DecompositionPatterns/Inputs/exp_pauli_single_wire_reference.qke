func.func @wire_x_f32_forward_positive() attributes {"cudaq-entrypoint"} {
  %qubit = quake.alloca !quake.ref
  %theta = arith.constant 0.125 : f32
  quake.exp_pauli (%theta) %qubit to "X" : (f32, !quake.ref) -> ()
  quake.dealloc %qubit : !quake.ref
  return
}

func.func @wire_y_f64_adjoint_negative() attributes {"cudaq-entrypoint"} {
  %qubit = quake.alloca !quake.ref
  %theta = arith.constant -0.25 : f64
  quake.exp_pauli<adj> (%theta) %qubit to "Y" : (f64, !quake.ref) -> ()
  quake.dealloc %qubit : !quake.ref
  return
}

func.func @wire_z_f64_forward_negative() attributes {"cudaq-entrypoint"} {
  %qubit = quake.alloca !quake.ref
  %theta = arith.constant -0.25 : f64
  quake.exp_pauli (%theta) %qubit to "Z" : (f64, !quake.ref) -> ()
  quake.dealloc %qubit : !quake.ref
  return
}
