// Both passes must retain the exact R1 phase while a controlled call exists.
// Specialization and phase lowering are covered by staged-input tests.
// RUN: cudaq-opt -pass-pipeline='builtin.module(decomposition{basis=rz})' %s | FileCheck %s --check-prefix=DECOMP --implicit-check-not=quake.r1
// RUN: cudaq-opt -pass-pipeline='builtin.module(basis-conversion{basis=rz})' %s | FileCheck %s --check-prefix=BASIS --implicit-check-not=quake.r1

func.func private @phase_producer(%theta: f64, %target: !quake.ref) {
  quake.r1 (%theta) %target : (f64, !quake.ref) -> ()
  return
}

func.func @controlled_caller(%control: !quake.ref, %target: !quake.ref) {
  %theta = arith.constant 3.700000e-01 : f64
  quake.apply @phase_producer [%control] (%theta, %target)
      : (!quake.ref, f64, !quake.ref) -> ()
  return
}

// DECOMP-LABEL: func.func private @phase_producer(
// DECOMP-SAME: %[[THETA:.*]]: f64, %[[TARGET:.*]]: !quake.ref
// DECOMP-DAG: %[[TWO:.*]] = arith.constant 2.000000e+00 : f64
// DECOMP-DAG: quake.rz (%[[THETA]]) %[[TARGET]]
// DECOMP: %[[HALF:.*]] = arith.divf %[[THETA]], %[[TWO]] : f64
// DECOMP: quake.phase (%[[HALF]]) %[[TARGET]] : (f64, !quake.ref) -> ()
// DECOMP: return

// BASIS-LABEL: func.func private @phase_producer(
// BASIS-SAME: %[[BASIS_THETA:.*]]: f64, %[[BASIS_TARGET:.*]]: !quake.ref
// BASIS-DAG: %[[BASIS_TWO:.*]] = arith.constant 2.000000e+00 : f64
// BASIS-DAG: quake.rz (%[[BASIS_THETA]]) %[[BASIS_TARGET]]
// BASIS: %[[BASIS_HALF:.*]] = arith.divf %[[BASIS_THETA]], %[[BASIS_TWO]] : f64
// BASIS: quake.phase (%[[BASIS_HALF]]) %[[BASIS_TARGET]] : (f64, !quake.ref) -> ()
// BASIS: return
