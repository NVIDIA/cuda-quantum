// Stage 3: start with the post-specialization IR from the preceding test.
// LowerPhase moves a phase with one control onto that control, and a phase
// with two controls onto the final control under the preceding predicate.
// RUN: split-file %s %t
// RUN: cudaq-opt --lower-phase --canonicalize %t/specialized.qke > %t.lowered
// RUN: FileCheck %s --check-prefix=LOWERED \
// RUN:   --implicit-check-not=quake.phase < %t.lowered
// RUN: CircuitCheck --input=%t.lowered %t/reference.qke

// LOWERED-LABEL: func.func @controlled_caller(
// LOWERED-SAME: %[[OUTER:.*]]: !quake.ref, %[[INNER:.*]]: !quake.ref,
// LOWERED-SAME: %[[TARGET:.*]]: !quake.ref)
// LOWERED-DAG: %[[THETA:.*]] = arith.constant 2.900000e-01 : f64
// LOWERED-DAG: %[[AXIS:.*]] = arith.constant 1.230000e-01 : f64
// LOWERED: quake.phased_rx {{.*}} {{\[}}%[[OUTER]]{{\]}} %[[TARGET]]
// LOWERED: quake.rz {{.*}} {{\[}}%[[OUTER]], %[[INNER]]{{\]}} %[[TARGET]]
// LOWERED: quake.r1 (%[[AXIS]]) %[[OUTER]]
// LOWERED: quake.r1 (%[[THETA]]) {{\[}}%[[OUTER]]{{\]}} %[[INNER]]
// LOWERED: return

//--- specialized.qke

func.func @controlled_caller(%outer: !quake.ref, %inner: !quake.ref,
                             %target: !quake.ref) {
  %theta = arith.constant 2.900000e-01 : f64
  %axis = arith.constant 1.230000e-01 : f64
  %pi_2 = arith.constant 1.5707963267948966 : f64
  quake.rx (%pi_2) %outer : (f64, !quake.ref) -> ()
  quake.phased_rx (%theta, %axis) [%outer] %target
      : (f64, f64, !quake.ref, !quake.ref) -> ()
  quake.rz (%theta) [%outer, %inner] %target
      : (f64, !quake.ref, !quake.ref, !quake.ref) -> ()
  quake.phase (%axis) [%outer] %target
      : (f64, !quake.ref, !quake.ref) -> ()
  quake.phase (%theta) [%outer, %inner] %target
      : (f64, !quake.ref, !quake.ref, !quake.ref) -> ()
  quake.rx<adj> (%pi_2) %outer : (f64, !quake.ref) -> ()
  return
}

//--- reference.qke

func.func @controlled_caller(%outer: !quake.ref, %inner: !quake.ref,
                             %target: !quake.ref) {
  %theta = arith.constant 2.900000e-01 : f64
  %axis = arith.constant 1.230000e-01 : f64
  %pi_2 = arith.constant 1.5707963267948966 : f64
  quake.rx (%pi_2) %outer : (f64, !quake.ref) -> ()
  quake.phased_rx (%theta, %axis) [%outer] %target
      : (f64, f64, !quake.ref, !quake.ref) -> ()
  quake.rz (%theta) [%outer, %inner] %target
      : (f64, !quake.ref, !quake.ref, !quake.ref) -> ()
  quake.r1 (%axis) %outer : (f64, !quake.ref) -> ()
  quake.r1 (%theta) [%outer] %inner
      : (f64, !quake.ref, !quake.ref) -> ()
  quake.rx<adj> (%pi_2) %outer : (f64, !quake.ref) -> ()
  return
}
