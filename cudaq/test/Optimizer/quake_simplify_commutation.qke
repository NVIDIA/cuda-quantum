// CHECK-NOT:     quake.x
// CHECK:         quake.rx
// CHECK-NOT:     quake.x
// CHECK:         return

func.func @combine_r1_across_z() {
  %angle = arith.constant 2.500000e-01 : f64
  %q = quake.null_wire
  %r0 = quake.r1 (%angle) %q : (f64, !quake.wire) -> !quake.wire
  %z = quake.z %r0 : (!quake.wire) -> !quake.wire
  %r1 = quake.r1 (%angle) %z : (f64, !quake.wire) -> !quake.wire
  quake.sink %r1 : !quake.wire
  return
}

