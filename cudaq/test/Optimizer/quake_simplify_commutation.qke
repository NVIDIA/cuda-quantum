func.func @preserve_inner_scope_alias() {
  %reference = quake.alloca !quake.ref
  %wire = quake.unwrap %reference : (!quake.ref) -> !quake.wire
  %h0 = quake.h %wire : (!quake.wire) -> !quake.wire
  %scope = cc.scope -> (!quake.wire) {
    quake.x %reference : (!quake.ref) -> ()
    %h1 = quake.h %h0 : (!quake.wire) -> !quake.wire
    cc.continue %h1 : !quake.wire
  }
  quake.wrap %scope to %reference : !quake.wire, !quake.ref
  return
}

