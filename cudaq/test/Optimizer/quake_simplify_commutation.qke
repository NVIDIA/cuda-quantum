// Cancelling the controlled-X pair exposes the Rz pair to the same greedy
// fixed point.
func.func @fold_after_cancellation() {
  %quarter = arith.constant 2.500000e-01 : f64
  %half = arith.constant 5.000000e-01 : f64
  %control = quake.null_wire
  %target = quake.null_wire
  %other = quake.null_wire
  %r0 = quake.rz (%quarter) %target : (f64, !quake.wire) -> !quake.wire
  %x0:2 = quake.x [%control] %r0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %z:2 = quake.z [%x0#0] %other : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1:2 = quake.x [%z#0] %x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1 = quake.rz (%half) %x1#1 : (f64, !quake.wire) -> !quake.wire
  quake.sink %x1#0 : !quake.wire
  quake.sink %r1 : !quake.wire
  quake.sink %z#1 : !quake.wire
  return
}

// CHECK-LABEL: func.func @fold_after_cancellation() {
// CHECK:         %[[SUM:.*]] = arith.constant 7.500000e-01 : f64
// CHECK-NOT:     quake.x
// CHECK:         quake.z
// CHECK:         quake.rz (%[[SUM]])
// CHECK-NOT:     quake.x
// CHECK:         return

