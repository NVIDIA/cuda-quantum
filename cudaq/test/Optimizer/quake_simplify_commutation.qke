func.func @cancel_mutually_exclusive_controls() {
  %control = quake.null_wire
  %target = quake.null_wire
  %other = quake.null_wire
  %x0:2 = quake.x [%control] %target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %y:2 = quake.y [%x0#0 neg [true]] %other : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1:2 = quake.x [%y#0] %x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  quake.sink %y#1 : !quake.wire
  return
}

