// CHECK-NOT:     quake.x
// CHECK:         quake.exp_pauli
// CHECK-NOT:     quake.x
// CHECK:         return
// CHECK-LABEL: func.func private @odd_pauli_parity() {
// CHECK:         quake.z
// CHECK:         quake.exp_pauli
// CHECK:         quake.z
