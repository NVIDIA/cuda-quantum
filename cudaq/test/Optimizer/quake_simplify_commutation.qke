// `CircuitCheck` cannot materialize ExpPauli matrices, so these remain focused
// FileCheck owners. Even parity removes both X endpoints; odd parity retains Z.
func.func private @even_pauli_parity() {
  %angle = arith.constant 2.500000e-01 : f64
  %q0 = quake.null_wire
  %q1 = quake.null_wire
  %x0 = quake.x %q0 : (!quake.wire) -> !quake.wire
  %xx:2 = quake.exp_pauli (%angle) %x0, %q1 to "XX" : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1 = quake.x %xx#0 : (!quake.wire) -> !quake.wire
  quake.sink %x1 : !quake.wire
  quake.sink %xx#1 : !quake.wire
  return
}

func.func private @odd_pauli_parity() {
  %angle = arith.constant 2.500000e-01 : f64
  %q = quake.null_wire
  %z0 = quake.z %q : (!quake.wire) -> !quake.wire
  %x = quake.exp_pauli (%angle) %z0 to "X" : (f64, !quake.wire) -> !quake.wire
  %z1 = quake.z %x : (!quake.wire) -> !quake.wire
  quake.sink %z1 : !quake.wire
  return
}

