quake.wire_set @duplicate_roles[1]

// These functions are verifier-valid but intentionally excluded from strict
// circuit comparison because they use the same physical qubit in two roles.
func.func private @preserve_repeated_ssa_roles() {
  %q = quake.null_wire
  %x0:2 = quake.x [%q] %q : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1:2 = quake.x [%x0#0] %x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  return
}

func.func private @preserve_borrowed_roles() {
  %control = quake.borrow_wire @duplicate_roles[0] : !quake.wire
  %target = quake.borrow_wire @duplicate_roles[0] : !quake.wire
  %x0:2 = quake.x [%control] %target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1:2 = quake.x [%x0#0] %x0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  return
}

// The endpoints act on the same physical qubits in the same roles, but only
// the control lane reaches the earlier operation.
func.func private @preserve_incomplete_frontier() {
  %control = quake.alloca !quake.ref
  %target = quake.alloca !quake.ref
  %controlWire = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %targetWire0 = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %targetWire1 = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %x0:2 = quake.x [%controlWire] %targetWire0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %x1:2 = quake.x [%x0#0] %targetWire1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %x0#1 : !quake.wire
  quake.sink %x1#0 : !quake.wire
  quake.sink %x1#1 : !quake.wire
  return
}

// The earlier result branches, so the pair does not form a linear wire path.
func.func private @preserve_branched_producer_result(%condition: i1) {
  %q = quake.null_wire
  %h0 = quake.h %q : (!quake.wire) -> !quake.wire
  %h1 = quake.h %h0 : (!quake.wire) -> !quake.wire
  cf.cond_br %condition, ^left(%h1 : !quake.wire),
      ^right(%h1 : !quake.wire)
^left(%left: !quake.wire):
  quake.sink %h0 : !quake.wire
  quake.sink %left : !quake.wire
  return
^right(%right: !quake.wire):
  quake.sink %right : !quake.wire
  return
}

