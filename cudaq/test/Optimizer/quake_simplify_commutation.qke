func.func @cancel_controlled_inverse_rx() {
  %angle = arith.constant 2.500000e-01 : f64
  %control = quake.null_wire
  %target = quake.null_wire
  %r0:2 = quake.rx (%angle) [%control] %target : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1:2 = quake.rx<adj> (%angle) [%r0#0 neg [false]] %r0#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %r1#0 : !quake.wire
  quake.sink %r1#1 : !quake.wire
  return
}

