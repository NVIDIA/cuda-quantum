func.func @combine_phased_rx() {
  %one = arith.constant 1.000000e+00 : f64
  %quarter = arith.constant 2.500000e-01 : f64
  %axis = arith.constant 5.000000e-01 : f64
  %control = quake.null_wire
  %target = quake.null_wire
  %other = quake.null_wire
  %r0:2 = quake.phased_rx (%one, %axis) [%control neg [true]] %target : (f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %z:2 = quake.z [%r0#0] %other : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %r1:2 = quake.phased_rx<adj> (%quarter, %axis) [%z#0 neg [true]] %r0#1 : (f64, f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %r1#0 : !quake.wire
  quake.sink %r1#1 : !quake.wire
  quake.sink %z#1 : !quake.wire
  return
}

// CHECK-LABEL: func.func @combine_phased_rx() {
// CHECK:         %[[SUM:.*]] = arith.constant 7.500000e-01 : f64
// CHECK:         %[[Z:.*]]:2 = quake.z
// CHECK-NEXT:    quake.phased_rx (%[[SUM]], {{.*}}) {{\[}}%[[Z]]#0 neg [true]
// CHECK-NEXT:    quake.sink

func.func @fold_discrete_phases() {
  %angle = arith.constant 2.500000e-01 : f64
  %control = quake.null_wire
  %s_target = quake.null_wire
  %t_target = quake.null_wire
  %s0:2 = quake.s [%control neg [true]] %s_target : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %z = quake.z %s0#0 : (!quake.wire) -> !quake.wire
  %s1:2 = quake.s [%z neg [true]] %s0#1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %t0 = quake.t<adj> %t_target : (!quake.wire) -> !quake.wire
  %rz = quake.rz (%angle) %t0 : (f64, !quake.wire) -> !quake.wire
  %t1 = quake.t<adj> %rz : (!quake.wire) -> !quake.wire
  quake.sink %s1#0 : !quake.wire
  quake.sink %s1#1 : !quake.wire
  quake.sink %t1 : !quake.wire
  return
}

