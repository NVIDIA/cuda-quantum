func.func @cancel_transposed_swap() {
  %left = quake.null_wire
  %right = quake.null_wire
  %s0:2 = quake.swap %left, %right : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %s1:2 = quake.swap %s0#1, %s0#0 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %s1#0 : !quake.wire
  quake.sink %s1#1 : !quake.wire
  return
}

