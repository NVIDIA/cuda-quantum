func.func @cancel_x_across_rx() {
  %angle = arith.constant 2.500000e-01 : f64
  %q = quake.null_wire
  %x0 = quake.x %q : (!quake.wire) -> !quake.wire
  %rx = quake.rx (%angle) %x0 : (f64, !quake.wire) -> !quake.wire
  %x1 = quake.x %rx : (!quake.wire) -> !quake.wire
  quake.sink %x1 : !quake.wire
  return
}

