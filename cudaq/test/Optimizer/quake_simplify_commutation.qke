func.func @combine_controlled_ry() {
  %quarter = arith.constant 2.500000e-01 : f64
  %half = arith.constant 5.000000e-01 : f64
  %control = quake.null_wire
  %target = quake.null_wire
  %r0:2 = quake.ry (%quarter) [%control neg [true]] %target : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %z = quake.z %r0#0 : (!quake.wire) -> !quake.wire
  %r1:2 = quake.ry (%half) [%z neg [true]] %r0#1 : (f64, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.sink %r1#0 : !quake.wire
  quake.sink %r1#1 : !quake.wire
  return
}

