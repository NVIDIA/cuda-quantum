// Example:
//
//   for (int b = 0; b < 4; b++)
//     for (int c = b + 1; c < 4; c++)
//       x<cudaq::ctrl>(q[b], q[c]);
//
// The dynamic extract_ref raises the quantum aliasing barrier for the block,
// but a veq access cannot alias a stack slot, so both induction variables must
// still be promoted.

func.func @nested_loop_dynamic_extract() {
  %c1_i32 = arith.constant 1 : i32
  %c0_i32 = arith.constant 0 : i32
  %c4_i32 = arith.constant 4 : i32
  %0 = quake.alloca !quake.veq<4>
  cc.scope {
    %1 = cc.alloca i32
    cc.store %c0_i32, %1 : !cc.ptr<i32>
    cc.loop while {
      %2 = cc.load %1 : !cc.ptr<i32>
      %3 = arith.cmpi slt, %2, %c4_i32 : i32
      cc.condition %3
    } do {
      cc.scope {
        %2 = cc.load %1 : !cc.ptr<i32>
        %3 = arith.addi %2, %c1_i32 : i32
        %4 = cc.alloca i32
        cc.store %3, %4 : !cc.ptr<i32>
        cc.loop while {
          %5 = cc.load %4 : !cc.ptr<i32>
          %6 = arith.cmpi slt, %5, %c4_i32 : i32
          cc.condition %6
        } do {
          %5 = cc.load %1 : !cc.ptr<i32>
          %6 = cc.cast signed %5 : (i32) -> i64
          %7 = quake.extract_ref %0[%6] : (!quake.veq<4>, i64) -> !quake.ref
          %8 = cc.load %4 : !cc.ptr<i32>
          %9 = cc.cast signed %8 : (i32) -> i64
          %10 = quake.extract_ref %0[%9] : (!quake.veq<4>, i64) -> !quake.ref
          quake.x [%7] %10 : (!quake.ref, !quake.ref) -> ()
          cc.continue
        } step {
          %5 = cc.load %4 : !cc.ptr<i32>
          %6 = arith.addi %5, %c1_i32 : i32
          cc.store %6, %4 : !cc.ptr<i32>
        }
      }
      cc.continue
    } step {
      %2 = cc.load %1 : !cc.ptr<i32>
      %3 = arith.addi %2, %c1_i32 : i32
      cc.store %3, %1 : !cc.ptr<i32>
    }
  }
  return
}

// CHECK-LABEL:   func.func @nested_loop_dynamic_extract() {
// CHECK-NOT:       cc.alloca i32
// CHECK-NOT:       cc.load
// CHECK:           %[[VEQ:.*]] = quake.alloca !quake.veq<4>
// CHECK:           cc.loop while ((%{{.*}} = %{{.*}}) -> (i32)) {
// CHECK:           } do {
// CHECK:           ^bb0(%[[OUTERARG:.*]]: i32):
// CHECK:             %[[INIT:.*]] = arith.addi %[[OUTERARG]], %{{.*}} : i32
// CHECK:             cc.loop while ((%{{.*}} = %[[INIT]]) -> (i32)) {
// CHECK:             } do {
// CHECK:             ^bb0(%[[INNERARG:.*]]: i32):
// CHECK:               %[[CO:.*]] = cc.cast signed %[[OUTERARG]] : (i32) -> i64
// CHECK:               %[[RO:.*]] = quake.extract_ref %[[VEQ]][%[[CO]]]
// CHECK:               %[[CI:.*]] = cc.cast signed %[[INNERARG]] : (i32) -> i64
// CHECK:               %[[RI:.*]] = quake.extract_ref %[[VEQ]][%[[CI]]]
// CHECK:               quake.x
// CHECK:               cc.continue %[[INNERARG]] : i32
// CHECK:             }
// CHECK:             cc.continue %[[OUTERARG]] : i32
// CHECK:           }
// CHECK:           return
// CHECK:         }

// A dynamic extract is an aliasing barrier. The following fixed use imports
// the outer ref into the physical entry block of a cc.scope. Since cc.scope has
// NoRegionArguments, MemToReg must capture the promoted wire directly rather
// than create an entry block argument.
func.func @scope_entry_alias(%idx: i64) {
  %r = quake.alloca !quake.ref
  %v = quake.concat %r : (!quake.ref) -> !quake.veq<1>
  quake.y %r : (!quake.ref) -> ()
  cc.scope atomic {
    %q = quake.extract_ref %v[%idx] : (!quake.veq<1>, i64) -> !quake.ref
    quake.h %q : (!quake.ref) -> ()
    quake.x %r : (!quake.ref) -> ()
    cc.continue
  }
  quake.dealloc %r : !quake.ref
  return
}

// CHECK-LABEL:   func.func @scope_entry_alias(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[ALLOCA_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[WRAP_NEW_0:.*]] = quake.wrap_new %[[UNWRAP_0]] : (!quake.wire) -> !quake.ref
// CHECK:           %[[CONCAT_0:.*]] = quake.concat %[[WRAP_NEW_0]] : (!quake.ref) -> !quake.veq<1>
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[WRAP_NEW_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[Y_0:.*]] = quake.y %[[UNWRAP_1]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[Y_0]] to %[[ALLOCA_0]] : !quake.wire, !quake.ref
// CHECK:           %[[SCOPE_0:.*]] = cc.scope -> (!quake.wire) atomic {
// CHECK:             %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[CONCAT_0]]{{\[}}%[[ARG0]]] : (!quake.veq<1>, i64) -> !quake.ref
// CHECK:             %[[UNWRAP_2:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[H_0:.*]] = quake.h %[[UNWRAP_2]] : (!quake.wire) -> !quake.wire
// CHECK:             quake.wrap %[[H_0]] to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:             %[[UNWRAP_3:.*]] = quake.unwrap %[[ALLOCA_0]] : (!quake.ref) -> !quake.wire
// CHECK:             %[[X_0:.*]] = quake.x %[[UNWRAP_3]] : (!quake.wire) -> !quake.wire
// CHECK:             cc.continue %[[X_0]] : !quake.wire
// CHECK:           }
// CHECK:           quake.sink %[[SCOPE_0]] : !quake.wire
// CHECK:           return
// CHECK:         }

func.func @__nvqpp__mlirgen__function_f76(%arg0: i32, %arg1: i32, %arg2: i32) -> i32 {
  %c1_i32 = arith.constant 1 : i32
  %c0_i32 = arith.constant 0 : i32
  %0 = cc.alloca i32
  cc.store %arg0, %0 : !cc.ptr<i32>
  %1 = cc.alloca i32
  cc.store %arg1, %1 : !cc.ptr<i32>
  %2 = cc.alloca i32
  cc.store %arg2, %2 : !cc.ptr<i32>
  cc.store %c0_i32, %0 : !cc.ptr<i32>
  cc.loop while {
    %4 = cc.load %0 : !cc.ptr<i32>
    %5 = cc.load %2 : !cc.ptr<i32>
    %6 = arith.cmpi slt, %4, %5 : i32
    cc.condition %6
  } do {
    %4 = cc.load %0 : !cc.ptr<i32>
    cc.store %4, %1 : !cc.ptr<i32>
    cc.continue
  } step {
    %4 = cc.load %0 : !cc.ptr<i32>
    %5 = arith.addi %4, %c1_i32 : i32
    cc.store %5, %0 : !cc.ptr<i32>
  }
  %3 = cc.load %1 : !cc.ptr<i32>
  return %3 : i32
}

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__function_f76(
// CHECK-SAME:      %[[ARG0:.*]]: i32, %[[ARG1:.*]]: i32, %[[ARG2:.*]]: i32) -> i32 {
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 1 : i32
// CHECK:           %[[CONSTANT_1:.*]] = arith.constant 0 : i32
// CHECK:           %[[UNDEF_0:.*]] = cc.undef i32
// CHECK:           %[[UNDEF_1:.*]] = cc.undef i32
// CHECK:           %[[UNDEF_2:.*]] = cc.undef i32
// CHECK:           %[[LOOP_0:.*]]:2 = cc.loop while ((%[[VAL_0:.*]] = %[[CONSTANT_1]], %[[VAL_1:.*]] = %[[ARG1]]) -> (i32, i32)) {
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi slt, %[[VAL_0]], %[[ARG2]] : i32
// CHECK:             cc.condition %[[CMPI_0]](%[[VAL_0]], %[[VAL_1]] : i32, i32)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: i32):
// CHECK:             cc.continue %[[VAL_2]], %[[VAL_2]] : i32, i32
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_4:.*]]: i32, %[[VAL_5:.*]]: i32):
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[VAL_4]], %[[CONSTANT_0]] : i32
// CHECK:             cc.continue %[[ADDI_0]], %[[VAL_5]] : i32, i32
// CHECK:           }
// CHECK:           return %[[VAL_6:.*]]#1 : i32
// CHECK:         }

func.func @bug_5286() {
  %c1_i64 = arith.constant 1 : i64
  %c0_i64 = arith.constant 0 : i64
  %c100_i64 = arith.constant 100 : i64
  %0 = quake.alloca !quake.ref
  quake.h %0 : (!quake.ref) -> ()
  %1 = cc.loop while ((%arg0 = %c0_i64) -> (i64)) {
    %2 = arith.cmpi ult, %arg0, %c100_i64 : i64
    cc.condition %2(%arg0 : i64)
  } do {
  ^bb0(%arg0: i64):
    quake.x %0 : (!quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.ref) -> !cc.measure_handle
    %2 = quake.discriminate %measOut : (!cc.measure_handle) -> i1
    cf.cond_br %2, ^bb1, ^bb2
  ^bb1:
    cc.break %arg0 : i64
  ^bb2:
    cc.continue %arg0 : i64
  } step {
  ^bb0(%arg0: i64):
    %2 = arith.addi %arg0, %c1_i64 : i64
    cc.continue %2 : i64
  }
  quake.evince %0 : (!quake.ref) -> () {compilerGenerated}
  quake.dealloc %0 : !quake.ref
  return
}

