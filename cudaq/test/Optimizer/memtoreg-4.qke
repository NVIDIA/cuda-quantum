// CHECK:           %[[H_0:.*]] = quake.h %[[NULL_WIRE_0]] : (!quake.wire) -> !quake.wire
// CHECK:           %[[LOOP_0:.*]]:2 = cc.loop while ((%[[VAL_0:.*]] = %[[CONSTANT_1]], %[[VAL_1:.*]] = %[[H_0]]) -> (i64, !quake.wire)) {
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi ult, %[[VAL_0]], %[[CONSTANT_2]] : i64
// CHECK:             cc.condition %[[CMPI_0]](%[[VAL_0]], %[[VAL_1]] : i64, !quake.wire)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_2:.*]]: i64, %[[VAL_3:.*]]: !quake.wire):
// CHECK:             %[[X_0:.*]] = quake.x %[[VAL_3]] : (!quake.wire) -> !quake.wire
// CHECK:             %[[MZ_0:.*]], %[[MZ_1:.*]] = quake.mz %[[X_0]] : (!quake.wire) -> (!cc.measure_handle, !quake.wire)
// CHECK:             %[[DISCRIMINATE_0:.*]] = quake.discriminate %[[MZ_0]] : (!cc.measure_handle) -> i1
// CHECK:             cf.cond_br %[[DISCRIMINATE_0]], ^bb1(%[[MZ_1]] : !quake.wire), ^bb2(%[[MZ_1]] : !quake.wire)
// CHECK:           ^bb1(%[[VAL_4:.*]]: !quake.wire):
// CHECK:             cc.break %[[VAL_2]], %[[VAL_4]] : i64, !quake.wire
// CHECK:           ^bb2(%[[VAL_5:.*]]: !quake.wire):
// CHECK:             cc.continue %[[VAL_2]], %[[VAL_5]] : i64, !quake.wire
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_6:.*]]: i64, %[[VAL_7:.*]]: !quake.wire):
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[VAL_6]], %[[CONSTANT_0]] : i64
// CHECK:             cc.continue %[[ADDI_0]], %[[VAL_7]] : i64, !quake.wire
// CHECK:           }
// CHECK:           %[[EVINCE_0:.*]] = quake.evince %[[LOOP_0]]#1 : (!quake.wire) -> !quake.wire {compilerGenerated}
// CHECK:           quake.sink %[[EVINCE_0]] : !quake.wire
// CHECK:           return
// CHECK:         }
