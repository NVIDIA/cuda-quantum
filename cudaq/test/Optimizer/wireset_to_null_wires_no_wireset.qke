// RUN: cudaq-opt --wireset-to-null-wires %s | FileCheck %s

// A `return_wire` of an unwrapped reference remains after `symbol-dce` erases
// the wire set that no `borrow_wire` references. It still becomes a sink.

func.func @__nvqpp__mlirgen__kernel() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %0 = quake.alloca !quake.ref
  %1 = quake.unwrap %0 : (!quake.ref) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  quake.return_wire %2 : !quake.wire
  return
}

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__kernel()
// CHECK:           %[[VAL_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_1:.*]] = quake.unwrap %[[VAL_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[VAL_2:.*]] = quake.x %[[VAL_1]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.sink %[[VAL_2]] : !quake.wire
// CHECK-NOT:       quake.return_wire
// CHECK:           return
