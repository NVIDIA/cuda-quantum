func.func @test_5() {
  %0 = cc.alloca i32
  %1 = cc.alloca i32
  %2 = arith.constant 42 : i32
  %c = arith.constant true
  %3 = cc.if (%c) -> i32 {
    %10 = arith.constant 8 : i32
    cc.store %10, %0 : !cc.ptr<i32>
    cc.store %10, %1 : !cc.ptr<i32>
    cc.continue %2 : i32
  } else {
    %10 = arith.constant 23 : i32
    %11 = arith.constant 78234 : i32
    cc.store %10, %0 : !cc.ptr<i32>
    cc.store %11, %1 : !cc.ptr<i32>
    cc.continue %2 : i32
  }
  %4 = cc.load %0 : !cc.ptr<i32>
  %5 = cc.load %1 : !cc.ptr<i32>
  call @live(%3, %4, %5) : (i32, i32, i32) -> ()
  return
}

// CHECK-LABEL:   func.func @test_5() {
// CHECK:           %[[UNDEF_0:.*]] = cc.undef i32
// CHECK:           %[[UNDEF_1:.*]] = cc.undef i32
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 42 : i32
// CHECK:           %[[CONSTANT_1:.*]] = arith.constant true
// CHECK:           %[[IF_0:.*]]:3 = cc.if(%[[CONSTANT_1]]) -> (i32, i32, i32) {
// CHECK:             %[[CONSTANT_2:.*]] = arith.constant 8 : i32
// CHECK:             cc.continue %[[CONSTANT_0]], %[[CONSTANT_2]], %[[CONSTANT_2]] : i32, i32, i32
// CHECK:           } else {
// CHECK:             %[[CONSTANT_3:.*]] = arith.constant 23 : i32
// CHECK:             %[[CONSTANT_4:.*]] = arith.constant 78234 : i32
// CHECK:             cc.continue %[[CONSTANT_0]], %[[CONSTANT_3]], %[[CONSTANT_4]] : i32, i32, i32
// CHECK:           }
// CHECK:           call @live(%[[VAL_0:.*]]#0, %[[VAL_0]]#1, %[[VAL_0]]#2) : (i32, i32, i32) -> ()
// CHECK:           return
// CHECK:         }

// Both refs come from dynamic-index extracts of %0, so neither location is
// knowable and the whole veq stays in memory form: the cc.loop carries no
// wire and the cc.if has no results. Compare @insert_sigma_cfg below, which
// is the same kernel written as a raw CFG.
func.func @insert_sigma(%arg: i64) {
  %0 = quake.alloca !quake.veq<3>
  %1 = quake.extract_ref %0[%arg] : (!quake.veq<3>, i64) -> !quake.ref
  %2 = cc.alloca i64
  %zero = arith.constant 0 : i64
  cc.store %zero, %2 : !cc.ptr<i64>
  quake.h %1 : (!quake.ref) -> ()
  cc.loop while {
    %i = cc.load %2 : !cc.ptr<i64>
    %three = arith.constant 3 : i64
    %cond = arith.cmpi ult, %i, %three : i64
    cc.condition %cond
  } do {
    %i2 = cc.load %2 : !cc.ptr<i64>
    %cond2 = arith.cmpi ne, %i2, %arg : i64
    cc.if (%cond2) {
      %3 = quake.extract_ref %0[%i2] : (!quake.veq<3>, i64) -> !quake.ref
      quake.x [%1] %3 : (!quake.ref, !quake.ref) -> ()
    }
    cc.continue
  } step {
    %i3 = cc.load %2 : !cc.ptr<i64>
    %one = arith.constant 1 : i64
    %inc_i = arith.addi %i3, %one : i64
    cc.store %inc_i, %2 : !cc.ptr<i64>
  }
  quake.dealloc %0 : !quake.veq<3>
  return
}

// CHECK-LABEL:   func.func @insert_sigma(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[ALLOCA_0:.*]] = quake.alloca !quake.veq<3>
// CHECK:           %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[ALLOCA_0]]{{\[}}%[[ARG0]]] : (!quake.veq<3>, i64) -> !quake.ref
// CHECK:           %[[UNDEF_0:.*]] = cc.undef i64
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 0 : i64
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[H_0:.*]] = quake.h %[[UNWRAP_0]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[H_0]] to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:           %[[LOOP_0:.*]] = cc.loop while ((%[[VAL_0:.*]] = %[[CONSTANT_0]]) -> (i64)) {
// CHECK:             %[[CONSTANT_1:.*]] = arith.constant 3 : i64
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi ult, %[[VAL_0]], %[[CONSTANT_1]] : i64
// CHECK:             cc.condition %[[CMPI_0]](%[[VAL_0]] : i64)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_1:.*]]: i64):
// CHECK:             %[[CMPI_1:.*]] = arith.cmpi ne, %[[VAL_1]], %[[ARG0]] : i64
// CHECK:             cc.if(%[[CMPI_1]]) {
// CHECK:               %[[EXTRACT_REF_1:.*]] = quake.extract_ref %[[ALLOCA_0]]{{\[}}%[[VAL_1]]] : (!quake.veq<3>, i64) -> !quake.ref
// CHECK:               %[[UNWRAP_1:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:               %[[UNWRAP_2:.*]] = quake.unwrap %[[EXTRACT_REF_1]] : (!quake.ref) -> !quake.wire
// CHECK:               %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_1]]] %[[UNWRAP_2]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:               quake.wrap %[[X_0]]#0 to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:               quake.wrap %[[X_0]]#1 to %[[EXTRACT_REF_1]] : !quake.wire, !quake.ref
// CHECK:             } else {
// CHECK:             }
// CHECK:             cc.continue %[[VAL_1]] : i64
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_2:.*]]: i64):
// CHECK:             %[[CONSTANT_2:.*]] = arith.constant 1 : i64
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[VAL_2]], %[[CONSTANT_2]] : i64
// CHECK:             cc.continue %[[ADDI_0]] : i64
// CHECK:           }
// CHECK:           quake.dealloc %[[ALLOCA_0]] : !quake.veq<3>
// CHECK:           return
// CHECK:         }

func.func @insert_sigma_cfg(%arg0: i64) {
  %0 = quake.alloca !quake.veq<3>
  %1 = quake.extract_ref %0[%arg0] : (!quake.veq<3>, i64) -> !quake.ref
  %2 = cc.alloca i64
  %c0_i64 = arith.constant 0 : i64
  cc.store %c0_i64, %2 : !cc.ptr<i64>
  quake.h %1 : (!quake.ref) -> ()
  cf.br ^bb1
^bb1:  // 2 preds: ^bb0, ^bb5
  %3 = cc.load %2 : !cc.ptr<i64>
  %c3_i64 = arith.constant 3 : i64
  %4 = arith.cmpi ult, %3, %c3_i64 : i64
  cf.cond_br %4, ^bb2, ^bb6
^bb2:  // pred: ^bb1
  %5 = cc.load %2 : !cc.ptr<i64>
  %6 = arith.cmpi ne, %5, %arg0 : i64
  cf.cond_br %6, ^bb3, ^bb4
^bb3:  // pred: ^bb2
  %7 = quake.extract_ref %0[%5] : (!quake.veq<3>, i64) -> !quake.ref
  quake.x [%1] %7 : (!quake.ref, !quake.ref) -> ()
  cf.br ^bb4
^bb4:  // 2 preds: ^bb2, ^bb3
  cf.br ^bb5
^bb5:  // pred: ^bb4
  %8 = cc.load %2 : !cc.ptr<i64>
  %c1_i64 = arith.constant 1 : i64
  %9 = arith.addi %8, %c1_i64 : i64
  cc.store %9, %2 : !cc.ptr<i64>
  cf.br ^bb1
^bb6:  // pred: ^bb1
  quake.dealloc %0 : !quake.veq<3>
  return
}

// CHECK-LABEL:   func.func @insert_sigma_cfg(
// CHECK-SAME:      %[[ARG0:.*]]: i64) {
// CHECK:           %[[ALLOCA_0:.*]] = quake.alloca !quake.veq<3>
// CHECK:           %[[EXTRACT_REF_0:.*]] = quake.extract_ref %[[ALLOCA_0]]{{\[}}%[[ARG0]]] : (!quake.veq<3>, i64) -> !quake.ref
// CHECK:           %[[UNDEF_0:.*]] = cc.undef i64
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 0 : i64
// CHECK:           %[[UNWRAP_0:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[H_0:.*]] = quake.h %[[UNWRAP_0]] : (!quake.wire) -> !quake.wire
// CHECK:           quake.wrap %[[H_0]] to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:           cf.br ^bb1(%[[CONSTANT_0]] : i64)
// CHECK:         ^bb1(%[[VAL_0:.*]]: i64):
// CHECK:           %[[CONSTANT_1:.*]] = arith.constant 3 : i64
// CHECK:           %[[CMPI_0:.*]] = arith.cmpi ult, %[[VAL_0]], %[[CONSTANT_1]] : i64
// CHECK:           cf.cond_br %[[CMPI_0]], ^bb2(%[[VAL_0]] : i64), ^bb6
// CHECK:         ^bb2(%[[VAL_1:.*]]: i64):
// CHECK:           %[[CMPI_1:.*]] = arith.cmpi ne, %[[VAL_1]], %[[ARG0]] : i64
// CHECK:           cf.cond_br %[[CMPI_1]], ^bb3(%[[VAL_1]] : i64), ^bb4(%[[VAL_1]] : i64)
// CHECK:         ^bb3(%[[VAL_2:.*]]: i64):
// CHECK:           %[[EXTRACT_REF_1:.*]] = quake.extract_ref %[[ALLOCA_0]]{{\[}}%[[VAL_1]]] : (!quake.veq<3>, i64) -> !quake.ref
// CHECK:           %[[UNWRAP_1:.*]] = quake.unwrap %[[EXTRACT_REF_0]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[UNWRAP_2:.*]] = quake.unwrap %[[EXTRACT_REF_1]] : (!quake.ref) -> !quake.wire
// CHECK:           %[[X_0:.*]]:2 = quake.x {{\[}}%[[UNWRAP_1]]] %[[UNWRAP_2]] : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
// CHECK:           quake.wrap %[[X_0]]#0 to %[[EXTRACT_REF_0]] : !quake.wire, !quake.ref
// CHECK:           quake.wrap %[[X_0]]#1 to %[[EXTRACT_REF_1]] : !quake.wire, !quake.ref
// CHECK:           cf.br ^bb4(%[[VAL_2]] : i64)
// CHECK:         ^bb4(%[[VAL_3:.*]]: i64):
// CHECK:           cf.br ^bb5(%[[VAL_3]] : i64)
// CHECK:         ^bb5(%[[VAL_4:.*]]: i64):
// CHECK:           %[[CONSTANT_2:.*]] = arith.constant 1 : i64
// CHECK:           %[[ADDI_0:.*]] = arith.addi %[[VAL_4]], %[[CONSTANT_2]] : i64
// CHECK:           cf.br ^bb1(%[[ADDI_0]] : i64)
// CHECK:         ^bb6:
// CHECK:           quake.dealloc %[[ALLOCA_0]] : !quake.veq<3>
// CHECK:           return
// CHECK:         }

