// RUN: not cudaq-opt --lower-phase %s -split-input-file 2>&1 | FileCheck %s

// The exact fallback requires an anchor outside the control predicate.
func.func @anchor_aliases_vector_control(%theta: f64,
                                         %controls: !quake.veq<?>) {
  %anchor = quake.extract_ref %controls[0]
      : (!quake.veq<?>) -> !quake.ref
  quake.phase (%theta) [%controls] %anchor
      : (f64, !quake.veq<?>, !quake.ref) -> ()
  return
}

// -----

func.func @concat_control_contains_anchor(%theta: f64,
                                          %anchor: !quake.ref) {
  %controls = quake.concat %anchor
      : (!quake.ref) -> !quake.veq<?>
  quake.phase (%theta) [%controls] %anchor
      : (f64, !quake.veq<?>, !quake.ref) -> ()
  return
}

// -----

// Aggregate views must retain the provenance of their source vector.
func.func @subveq_control_contains_anchor(%theta: f64,
                                          %controls: !quake.veq<?>) {
  %sub = quake.subveq %controls, 0, 0
      : (!quake.veq<?>) -> !quake.veq<1>
  %anchor = quake.extract_ref %sub[0] : (!quake.veq<1>) -> !quake.ref
  quake.phase (%theta) [%controls] %anchor
      : (f64, !quake.veq<?>, !quake.ref) -> ()
  return
}

// -----

// A wire target threaded through a gate retains the identity of the reference
// it was unwrapped from.
func.func @anchor_aliases_vector_control_through_wire(
    %theta: f64, %controls: !quake.veq<?>) {
  %anchor_ref = quake.extract_ref %controls[0]
      : (!quake.veq<?>) -> !quake.ref
  %anchor_wire = quake.unwrap %anchor_ref : (!quake.ref) -> !quake.wire
  %threaded_anchor = quake.x %anchor_wire : (!quake.wire) -> !quake.wire
  %result = quake.phase (%theta) [%controls] %threaded_anchor
      : (f64, !quake.veq<?>, !quake.wire) -> !quake.wire
  quake.sink %result : !quake.wire
  return
}

// -----

// Rebinding a local reference to a control-derived wire destroys its fresh
// anchor provenance.
func.func @anchor_aliases_vector_control_through_wrap(
    %theta: f64, %controls: !quake.veq<?>) {
  %anchor = quake.alloca !quake.ref
  %control = quake.extract_ref %controls[0] : (!quake.veq<?>) -> !quake.ref
  %wire = quake.unwrap %control : (!quake.ref) -> !quake.wire
  %changed = quake.x %wire : (!quake.wire) -> !quake.wire
  quake.wrap %changed to %anchor : !quake.wire, !quake.ref
  quake.phase (%theta) [%controls] %anchor
      : (f64, !quake.veq<?>, !quake.ref) -> ()
  return
}

// -----

// Wrapping a control-derived wire in a new reference does not make it a
// distinct anchor.
func.func @anchor_aliases_vector_control_through_wrap_new(
    %theta: f64, %controls: !quake.veq<?>) {
  %extracted = quake.extract_ref %controls[0]
      : (!quake.veq<?>) -> !quake.ref
  %wire = quake.unwrap %extracted : (!quake.ref) -> !quake.wire
  %anchor = quake.wrap_new %wire : (!quake.wire) -> !quake.ref
  quake.phase (%theta) [%controls] %anchor
      : (f64, !quake.veq<?>, !quake.ref) -> ()
  %reclaimed = quake.unwrap %anchor : (!quake.ref) -> !quake.wire
  quake.sink %reclaimed : !quake.wire
  return
}

// -----

// The same conservative rule applies to CFG block arguments.
func.func @opaque_block_arguments_may_alias(%theta: f64,
                                            %controls: !quake.veq<?>,
                                            %anchor: !quake.ref) {
  cf.br ^alias(%controls, %anchor : !quake.veq<?>, !quake.ref)
^alias(%block_controls: !quake.veq<?>, %block_anchor: !quake.ref):
  quake.phase (%theta) [%block_controls] %block_anchor
      : (f64, !quake.veq<?>, !quake.ref) -> ()
  return
}
// -----

// Structured loop arguments must not hide a control-derived wire root.
func.func @structured_loop_wire_anchor_aliases_control(
    %theta: f64, %controls: !quake.veq<?>) {
  %anchor_ref = quake.extract_ref %controls[0]
      : (!quake.veq<?>) -> !quake.ref
  %anchor = quake.unwrap %anchor_ref : (!quake.ref) -> !quake.wire
  %c0 = arith.constant 0 : i64
  %c4 = arith.constant 4 : i64
  %c1 = arith.constant 1 : i64
  %loop:2 = cc.loop while ((%i = %c0, %wire = %anchor)
                            -> (i64, !quake.wire)) {
    %condition = arith.cmpi slt, %i, %c4 : i64
    cc.condition %condition (%i, %wire : i64, !quake.wire)
  } do {
  ^bb0(%i: i64, %wire: !quake.wire):
    %next_wire = quake.phase (%theta) [%controls] %wire
        : (f64, !quake.veq<?>, !quake.wire) -> !quake.wire
    cc.continue %i, %next_wire : i64, !quake.wire
  } step {
  ^bb0(%i: i64, %wire: !quake.wire):
    %next = arith.addi %i, %c1 : i64
    cc.continue %next, %wire : i64, !quake.wire
  }
  quake.sink %loop#1 : !quake.wire
  return
}
// CHECK-COUNT-8: error: 'quake.phase' op cannot lower with an anchor that aliases a control operand
