// RUN: cudaq-opt --verify-each --quake-to-qir-api-prep=api=full %s | FileCheck %s --check-prefix=PREP
// RUN: cudaq-opt --verify-each --convert-to-qir-api=api=full %s | FileCheck %s --check-prefix=QIR

// The first exp_pauli result stays live across the inner branch. Bypassing
// the inner join would give that wire a use in each predecessor.
func.func @nested_exp_pauli(%outer: i1, %inner: i1, %theta: f64) attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %a = quake.null_wire
  %b = quake.null_wire
  cf.cond_br %outer, ^apply(%a, %b : !quake.wire, !quake.wire), ^done(%a, %b : !quake.wire, !quake.wire)
^apply(%x: !quake.wire, %y: !quake.wire):
  %word = cc.string_literal "XY" : !cc.ptr<!cc.array<i8 x 3>>
  %p:2 = quake.exp_pauli (%theta) %x, %y to %word : (f64, !quake.wire, !quake.wire, !cc.ptr<!cc.array<i8 x 3>>) -> (!quake.wire, !quake.wire)
  cf.cond_br %inner, ^rotate(%p#1 : !quake.wire), ^join(%p#1 : !quake.wire)
^rotate(%q: !quake.wire):
  %h = quake.h %q : (!quake.wire) -> !quake.wire
  cf.br ^join(%h : !quake.wire)
^join(%z: !quake.wire):
  cf.br ^done(%p#0, %z : !quake.wire, !quake.wire)
^done(%first: !quake.wire, %second: !quake.wire):
  quake.sink %first : !quake.wire
  quake.sink %second : !quake.wire
  return
}

// PREP-LABEL: func.func @nested_exp_pauli(
// PREP-SAME: %[[OUTER:[^:]+]]: i1, %[[INNER:[^:]+]]: i1, %[[THETA:[^:]+]]: f64)
// PREP: %[[A:[^ ]+]] = quake.null_wire
// PREP: %[[B:[^ ]+]] = quake.null_wire
// PREP: cf.cond_br %[[OUTER]], ^[[APPLY:bb[0-9]+]](%[[A]], %[[B]] : !quake.wire, !quake.wire), ^[[DONE:bb[0-9]+]](%[[A]], %[[B]] : !quake.wire, !quake.wire)
// PREP: ^[[APPLY]](%[[X:[^:]+]]: !quake.wire, %[[Y:[^:]+]]: !quake.wire):
// PREP: %[[WORD:[^ ]+]] = cc.string_literal "XY"
// PREP: %[[P:[^:]+]]:2 = quake.exp_pauli (%[[THETA]]) %[[X]], %[[Y]] to %[[WORD]] : (f64, !quake.wire, !quake.wire, !cc.ptr<!cc.array<i8 x 3>>) -> (!quake.wire, !quake.wire)
// PREP: cf.cond_br %[[INNER]], ^[[ROTATE:bb[0-9]+]](%[[P]]#1 : !quake.wire), ^[[JOIN:bb[0-9]+]](%[[P]]#1 : !quake.wire)
// PREP: ^[[ROTATE]](%[[Q:[^:]+]]: !quake.wire):
// PREP: %[[H:[^ ]+]] = quake.h %[[Q]] : (!quake.wire) -> !quake.wire
// PREP: cf.br ^[[JOIN]](%[[H]] : !quake.wire)
// PREP: ^[[JOIN]](%[[Z:[^:]+]]: !quake.wire):
// PREP: cf.br ^[[DONE]](%[[P]]#0, %[[Z]] : !quake.wire, !quake.wire)
// PREP: ^[[DONE]](%[[FIRST:[^:]+]]: !quake.wire, %[[SECOND:[^:]+]]: !quake.wire):
// PREP-DAG: quake.sink %[[FIRST]] : !quake.wire
// PREP-DAG: quake.sink %[[SECOND]] : !quake.wire

// QIR-LABEL: func.func @nested_exp_pauli(
// QIR-SAME: %[[OUTER:[^:]+]]: i1, %[[INNER:[^:]+]]: i1, %[[THETA:[^:]+]]: f64)
// QIR-DAG: %[[LEN:[^ ]+]] = arith.constant 2 : i64
// QIR-DAG: %[[WORD:[^ ]+]] = cc.alloca !cc.array<!cc.struct<{!cc.ptr<i8>, i64}> x 1>
// QIR: %[[A:[^ ]+]] = call @__quantum__rt__qubit_allocate()
// QIR: %[[B:[^ ]+]] = call @__quantum__rt__qubit_allocate()
// QIR: cf.cond_br %[[OUTER]], ^[[APPLY:bb[0-9]+]], ^[[DONE:bb[0-9]+]]
// QIR: ^[[APPLY]]:
// QIR: %[[LITERAL:[^ ]+]] = cc.string_literal "XY"
// QIR: %[[XS:[^ ]+]] = call @__quantum__rt__array_create_1d(
// QIR: %[[X:[^ ]+]] = call @__quantum__rt__array_get_element_ptr_1d(%[[XS]],
// QIR: cc.store %[[A]], %[[X]] :
// QIR: %[[YS:[^ ]+]] = call @__quantum__rt__array_create_1d(
// QIR: %[[Y:[^ ]+]] = call @__quantum__rt__array_get_element_ptr_1d(%[[YS]],
// QIR: cc.store %[[B]], %[[Y]] :
// QIR: %[[TARGETS:[^ ]+]] = call @__quantum__rt__array_concatenate(%[[XS]], %[[YS]])
// QIR: %[[DATA:[^ ]+]] = cc.cast %[[LITERAL]] :
// QIR: %[[DATA_SLOT:[^ ]+]] = cc.cast %[[WORD]] :
// QIR: cc.store %[[DATA]], %[[DATA_SLOT]] :
// QIR: %[[LEN_SLOT:[^ ]+]] = cc.compute_ptr %[[WORD]][0, 1]
// QIR: cc.store %[[LEN]], %[[LEN_SLOT]] :
// QIR: %[[WORD_ARG:[^ ]+]] = cc.cast %[[WORD]] :
// QIR: call @__quantum__qis__exp_pauli(%[[THETA]], %[[TARGETS]], %[[WORD_ARG]])
// QIR: cf.cond_br %[[INNER]], ^[[ROTATE:bb[0-9]+]], ^[[DONE]]
// QIR: ^[[ROTATE]]:
// QIR: call @__quantum__qis__h(%[[B]])
// QIR: cf.br ^[[DONE]]
// QIR: ^[[DONE]]:
// QIR-DAG: call @__quantum__rt__qubit_release(%[[A]])
// QIR-DAG: call @__quantum__rt__qubit_release(%[[B]])
// QIR: return
