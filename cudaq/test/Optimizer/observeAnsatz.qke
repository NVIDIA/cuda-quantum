// clang-format off
// Observing for SpinOp = "x(0)*y(1)*z(2)"
// RUN: cudaq-opt --observe-ansatz="term-bsf=1,1,0,0,1,1" --canonicalize %s | FileCheck %s
// clang-format on

  func.func @__nvqpp__mlirgen__ansatz(%arg0: f64) attributes {"cudaq-entrypoint"} {
    %0 = cc.alloca f64
    cc.store %arg0, %0 : !cc.ptr<f64>
    %1 = quake.alloca !quake.veq<3>
    %2 = quake.extract_ref %1[0] : (!quake.veq<3>) -> !quake.ref
    quake.x %2 : (!quake.ref) -> ()
    %3 = cc.load %0 : !cc.ptr<f64>
    %4 = quake.extract_ref %1[1] : (!quake.veq<3>) -> !quake.ref
    quake.ry (%3) %4 : (f64, !quake.ref) -> ()
    %5 = quake.extract_ref %1[2] : (!quake.veq<3>) -> !quake.ref
    quake.x [%2] %5 : (!quake.ref, !quake.ref) -> ()
    quake.evince %2, %4, %5 : (!quake.ref, !quake.ref, !quake.ref) -> () {userRecord}
    return
  }


// The term is x(0)*y(1)*z(2): qubit 0 rotates into the X basis, qubit 1 into
// the Y basis, and qubit 2 is already in Z. All three are in the term's
// support, so all three are measured, in record order, and the record is
// consumed.

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__ansatz(
// CHECK:           quake.h %[[A0:.*]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[A0]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.rx (%{{.*}}) %[[A1:.*]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[A1]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[A2:.*]] : (!quake.ref) -> !quake.measure
// CHECK-NOT:       quake.evince
// CHECK:           return

  func.func @test_veq_no_extract_refs() attributes {"cudaq-entrypoint"} {
    %0 = quake.alloca !quake.veq<3>
    %1 = quake.extract_ref %0[0] : (!quake.veq<3>) -> !quake.ref
    %2 = quake.extract_ref %0[1] : (!quake.veq<3>) -> !quake.ref
    %3 = quake.extract_ref %0[2] : (!quake.veq<3>) -> !quake.ref
    quake.evince %1, %2, %3 : (!quake.ref, !quake.ref, !quake.ref) -> () {userRecord}
    return
  }

// A record over a whole register names each of its qubits.

// CHECK-LABEL:   func.func @test_veq_no_extract_refs()
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.veq<3>
// CHECK:           quake.h %[[B0:.*]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[B0]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.rx (%{{.*}}) %[[B1:.*]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[B1]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[B2:.*]] : (!quake.ref) -> !quake.measure
// CHECK-NOT:       quake.evince
// CHECK:           return
// CHECK:         }

  func.func @test_veq_no_extract_refs2() attributes {"cudaq-entrypoint"} {
    %0 = quake.alloca !quake.ref
    %1 = quake.alloca !quake.ref
    %2 = quake.alloca !quake.ref
    quake.evince %0, %1, %2 : (!quake.ref, !quake.ref, !quake.ref) -> () {userRecord}
    return
  }

// Separately allocated qubits: the qubit index is the position in the record.

// CHECK-LABEL:   func.func @test_veq_no_extract_refs2()
// CHECK:           %[[C0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[C1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[C2:.*]] = quake.alloca !quake.ref
// CHECK:           quake.h %[[C0]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[C0]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.rx (%{{.*}}) %[[C1]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[C1]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[C2]] : (!quake.ref) -> !quake.measure
// CHECK-NOT:       quake.evince
// CHECK:           return
// CHECK:         }

  func.func @test_veq_no_extract_refs3() attributes {"cudaq-entrypoint"} {
    %0 = quake.alloca !quake.veq<1>
    %1 = quake.alloca !quake.veq<2>
    %2 = quake.extract_ref %0[0] : (!quake.veq<1>) -> !quake.ref
    %3 = quake.extract_ref %1[0] : (!quake.veq<2>) -> !quake.ref
    %4 = quake.extract_ref %1[1] : (!quake.veq<2>) -> !quake.ref
    quake.evince %2, %3, %4 : (!quake.ref, !quake.ref, !quake.ref) -> () {userRecord}
    return
  }

// Two veqs of different sizes: the qubit index runs across both, in order.

// CHECK-LABEL:   func.func @test_veq_no_extract_refs3()
// CHECK:           %[[D_VEQ1:.*]] = quake.alloca !quake.veq<1>
// CHECK:           %[[D_VEQ2:.*]] = quake.alloca !quake.veq<2>
// CHECK:           %[[D0:.*]] = quake.extract_ref %[[D_VEQ1]][0] : (!quake.veq<1>) -> !quake.ref
// CHECK:           %[[D1:.*]] = quake.extract_ref %[[D_VEQ2]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK:           %[[D2:.*]] = quake.extract_ref %[[D_VEQ2]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK:           quake.h %[[D0]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[D0]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.rx (%{{.*}}) %[[D1]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[D1]] : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[D2]] : (!quake.ref) -> !quake.measure
// CHECK-NOT:       quake.evince
// CHECK:           return
// CHECK:         }
