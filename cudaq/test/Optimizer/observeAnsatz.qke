// clang-format off
// Observing for SpinOp = "x(0)*y(1)*z(2)"
// RUN: cudaq-opt --canonicalize --cse --inject-implicit-output --expand-veq-uses --observe-ansatz="term-bsf=1,1,0,0,1,1" --canonicalize %s | FileCheck %s
// clang-format on

  func.func @__nvqpp__mlirgen__ansatz(%arg0: f64) attributes {"cudaq-entrypoint"} {
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c2_i64 = arith.constant 2 : i64
    %0 = cc.alloca f64
    cc.store %arg0, %0 : !cc.ptr<f64>
    %1 = quake.alloca  !quake.veq<3>
    %2 = quake.extract_ref %1[%c0_i64] : (!quake.veq<3>,i64) -> !quake.ref
    quake.x %2 : (!quake.ref) -> ()
    %3 = cc.load %0 : !cc.ptr<f64>
    %4 = quake.extract_ref %1[%c1_i64] : (!quake.veq<3>,i64) -> !quake.ref
    quake.ry (%3) %4 : (f64, !quake.ref) -> ()
    %5 = quake.extract_ref %1[%c0_i64] : (!quake.veq<3>,i64) -> !quake.ref
    %6 = quake.extract_ref %1[%c2_i64] : (!quake.veq<3>,i64) -> !quake.ref
    quake.x [%5] %6 : (!quake.ref,!quake.ref) -> ()
    return
  }

// The term is x(0)*y(1)*z(2): qubit 0 rotates into the X basis, qubit 1 into
// the Y basis, and qubit 2 is already in Z. All three are in the term's
// support, so all three are measured, in front of the evince.

// CHECK-LABEL:   func.func @__nvqpp__mlirgen__ansatz(
// CHECK:           quake.h %[[A0:.*]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[A0]] name "r00000" : (!quake.ref) -> !quake.measure
// CHECK:           quake.rx (%{{.*}}) %[[A1:.*]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[A1]] name "r00001" : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[A2:.*]] name "r00002" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[A0]], %[[A1]], %[[A2]] : (!quake.ref, !quake.ref, !quake.ref) -> ()
// CHECK:           return

  func.func @test_veq_no_extract_refs() attributes {"cudaq-entrypoint"} {
    %0 = quake.alloca !quake.veq<3>
    return
  }

// A single veq evince is split into one operand per qubit by expand-veq-uses.

// CHECK-LABEL:   func.func @test_veq_no_extract_refs()
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.veq<3>
// CHECK:           quake.h %[[B0:.*]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[B0]] name "r00000" : (!quake.ref) -> !quake.measure
// CHECK:           quake.rx (%{{.*}}) %[[B1:.*]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[B1]] name "r00001" : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[B2:.*]] name "r00002" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[B0]], %[[B1]], %[[B2]] : (!quake.ref, !quake.ref, !quake.ref) -> ()
// CHECK:           return
// CHECK:         }

  func.func @test_veq_no_extract_refs2() attributes {"cudaq-entrypoint"} {
    %0 = quake.alloca !quake.ref
    %1 = quake.alloca !quake.ref
    %2 = quake.alloca !quake.ref
    return
  }

// Separately allocated qubits get one evince each; the qubit index is the
// position across the evince ops taken in order.

// CHECK-LABEL:   func.func @test_veq_no_extract_refs2()
// CHECK:           %[[C0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[C1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[C2:.*]] = quake.alloca !quake.ref
// CHECK:           quake.h %[[C0]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[C0]] name "r00000" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[C0]] : (!quake.ref) -> ()
// CHECK:           quake.rx (%{{.*}}) %[[C1]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[C1]] name "r00001" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[C1]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[C2]] name "r00002" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[C2]] : (!quake.ref) -> ()
// CHECK:           return
// CHECK:         }

  func.func @test_veq_no_extract_refs3() attributes {"cudaq-entrypoint"} {
    %0 = quake.alloca !quake.veq<1>
    %1 = quake.alloca !quake.veq<2>
    return
  }

// Two veqs of different sizes: the qubit index runs across both, in order.

// CHECK-LABEL:   func.func @test_veq_no_extract_refs3()
// CHECK:           %[[D_VEQ1:.*]] = quake.alloca !quake.veq<1>
// CHECK:           %[[D_VEQ2:.*]] = quake.alloca !quake.veq<2>
// CHECK:           %[[D0:.*]] = quake.extract_ref %[[D_VEQ1]][0] : (!quake.veq<1>) -> !quake.ref
// CHECK:           quake.h %[[D0]] : (!quake.ref) -> ()
// CHECK:           quake.mz %[[D0]] name "r00000" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[D0]] : (!quake.ref) -> ()
// CHECK:           %[[D1:.*]] = quake.extract_ref %[[D_VEQ2]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK:           %[[D2:.*]] = quake.extract_ref %[[D_VEQ2]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK:           quake.rx (%{{.*}}) %[[D1]] : (f64, !quake.ref) -> ()
// CHECK:           quake.mz %[[D1]] name "r00001" : (!quake.ref) -> !quake.measure
// CHECK:           quake.mz %[[D2]] name "r00002" : (!quake.ref) -> !quake.measure
// CHECK:           quake.evince %[[D1]], %[[D2]] : (!quake.ref, !quake.ref) -> ()
// CHECK:           return
// CHECK:         }
