// Loop induction fusion can be a NOP, if the pipeline is wrong.

// RUN: cudaq-opt --cc-loop-induction-fusion --canonicalize %s | FileCheck %s

// ---------------------------------------------------------------------------
// Positive fall-through: loop already in invariant form (starts at 0,
// steps by 1) but never passed through cc-loop-normalize, so there is no
// {normalized} attribute.  The pass must still fuse the secondary induction.
//
//   for (i = 0, j = 0; i < N; ++i, j += 3)   ← already invariant, no attr
// ---------------------------------------------------------------------------

func.func private @two_args(i64, i64) -> ()

func.func @test_already_invariant(%n: i64) -> (i64, i64) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %c3 = arith.constant 3 : i64
  // Starts at 0, steps by 1 — isaInvariantLoop returns true without the attr.
  %r:2 = cc.loop while ((%i = %c0, %j = %c0) -> (i64, i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond(%i, %j : i64, i64)
  } do {
  ^bb0(%i : i64, %j : i64):
    func.call @two_args(%i, %j) : (i64, i64) -> ()
    cc.continue %i, %j : i64, i64
  } step {
  ^bb0(%i : i64, %j : i64):
    %i1 = arith.addi %i, %c1 : i64
    %j1 = arith.addi %j, %c3 : i64
    cc.continue %i1, %j1 : i64, i64
  }
  return %r#0, %r#1 : i64, i64
}

// CHECK-LABEL:   func.func @test_already_invariant(
// CHECK-SAME:      %[[ARG0:.*]]: i64) -> (i64, i64) {
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 0 : i64
// CHECK:           %[[CONSTANT_1:.*]] = arith.constant 1 : i64
// CHECK:           %[[CONSTANT_2:.*]] = arith.constant 3 : i64
// CHECK:           %[[LOOP_0:.*]] = cc.loop while ((%[[VAL_0:.*]] = %[[CONSTANT_0]]) -> (i64)) {
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi ult, %[[VAL_0]], %[[ARG0]] : i64
// CHECK:             cc.condition %[[CMPI_0]](%[[VAL_0]] : i64)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_1:.*]]: i64):
// CHECK:             %[[MULI_0:.*]] = arith.muli %[[VAL_1]], %[[CONSTANT_2]] : i64
// CHECK:             func.call @two_args(%[[VAL_1]], %[[MULI_0]]) : (i64, i64) -> ()
// CHECK:             cc.continue %[[VAL_1]] : i64
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_2:.*]]: i64):
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[VAL_2]], %[[CONSTANT_1]] : i64
// CHECK:             cc.continue %[[ADDI_0]] : i64
// CHECK:           } {normalized}
// CHECK:           %[[MULI_1:.*]] = arith.muli %[[LOOP_0]], %[[CONSTANT_2]] : i64
// CHECK:           return %[[LOOP_0]], %[[MULI_1]] : i64, i64
// CHECK:         }

// ---------------------------------------------------------------------------
// Negative test: loop has secondary inductions but the loop control variable
// does NOT start at 0.  isaInvariantLoop returns false so the fusion pass is a
// NOP.
//
//   for (i = 5, j = 0; i < N; ++i, j += 3)   ← non-invariant, no normalize
// ---------------------------------------------------------------------------

func.func @test_not_invariant(%n: i64) -> (i64, i64) {
  %c0 = arith.constant 0 : i64
  %c1 = arith.constant 1 : i64
  %c3 = arith.constant 3 : i64
  %c5 = arith.constant 5 : i64
  // i starts at 5 — not a normalized loop
  %r:2 = cc.loop while ((%i = %c5, %j = %c0) -> (i64, i64)) {
    %cond = arith.cmpi ult, %i, %n : i64
    cc.condition %cond(%i, %j : i64, i64)
  } do {
  ^bb0(%i : i64, %j : i64):
    func.call @two_args(%i, %j) : (i64, i64) -> ()
    cc.continue %i, %j : i64, i64
  } step {
  ^bb0(%i : i64, %j : i64):
    %i1 = arith.addi %i, %c1 : i64
    %j1 = arith.addi %j, %c3 : i64
    cc.continue %i1, %j1 : i64, i64
  }
  return %r#0, %r#1 : i64, i64
}

// CHECK-LABEL:   func.func @test_not_invariant(
// CHECK-SAME:      %[[ARG0:.*]]: i64) -> (i64, i64) {
// CHECK:           %[[CONSTANT_0:.*]] = arith.constant 0 : i64
// CHECK:           %[[CONSTANT_1:.*]] = arith.constant 1 : i64
// CHECK:           %[[CONSTANT_2:.*]] = arith.constant 3 : i64
// CHECK:           %[[CONSTANT_3:.*]] = arith.constant 5 : i64
// CHECK:           %[[LOOP_0:.*]]:2 = cc.loop while ((%[[VAL_0:.*]] = %[[CONSTANT_3]], %[[VAL_1:.*]] = %[[CONSTANT_0]]) -> (i64, i64)) {
// CHECK:             %[[CMPI_0:.*]] = arith.cmpi ult, %[[VAL_0]], %[[ARG0]] : i64
// CHECK:             cc.condition %[[CMPI_0]](%[[VAL_0]], %[[VAL_1]] : i64, i64)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_2:.*]]: i64, %[[VAL_3:.*]]: i64):
// CHECK:             func.call @two_args(%[[VAL_2]], %[[VAL_3]]) : (i64, i64) -> ()
// CHECK:             cc.continue %[[VAL_2]], %[[VAL_3]] : i64, i64
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_4:.*]]: i64, %[[VAL_5:.*]]: i64):
// CHECK:             %[[ADDI_0:.*]] = arith.addi %[[VAL_4]], %[[CONSTANT_1]] : i64
// CHECK:             %[[ADDI_1:.*]] = arith.addi %[[VAL_5]], %[[CONSTANT_2]] : i64
// CHECK:             cc.continue %[[ADDI_0]], %[[ADDI_1]] : i64, i64
// CHECK:           }
// CHECK:           return %[[VAL_6:.*]]#0, %[[VAL_6]]#1 : i64, i64
// CHECK:         }

