// Under value semantics, the quake-unmapped profile accepts an entry point on
// wires and rejects one that takes or creates a reference. Each diagnostic
// names the cause.

// RUN: cudaq-opt --verify-quake-unmapped-profile='wires-only=true' \
// RUN:   --split-input-file --verify-diagnostics %s

func.func @wires() attributes {"cudaq-entrypoint"} {
  %0 = quake.null_wire
  %1 = quake.h %0 : (!quake.wire) -> !quake.wire
  %m, %2 = quake.mz %1 : (!quake.wire) -> (!cc.measure_handle, !quake.wire)
  quake.sink %2 : !quake.wire
  return
}

// Only entry points are checked, so a callee that takes a reference passes.
func.func @callee(%q: !quake.ref) {
  quake.h %q : (!quake.ref) -> ()
  return
}

// -----

// A qubit picked by an index known only at run time stays a reference. The
// index is reported as the cause, and the register it indexes is not.
func.func @runtime_index() attributes {"cudaq-entrypoint"} {
  %q = quake.alloca !quake.veq<2>
  %w = quake.null_wire
  %m, %w1 = quake.mz %w : (!quake.wire) -> (!cc.measure_handle, !quake.wire)
  %b = quake.discriminate %m : (!cc.measure_handle) -> i1
  %i = cc.cast unsigned %b : (i1) -> i64
  // expected-error@+1 {{requires every qubit to be a wire, but the index is not a compile-time constant}}
  %r = quake.extract_ref %q[%i] : (!quake.veq<2>, i64) -> !quake.ref
  quake.h %r : (!quake.ref) -> ()
  quake.sink %w1 : !quake.wire
  return
}

// -----

// expected-error@+1 {{requires every qubit to be a wire, but the entry point takes a reference}}
func.func @qubit_argument(%q: !quake.ref) attributes {"cudaq-entrypoint"} {
  quake.h %q : (!quake.ref) -> ()
  return
}

// -----

// Noise applies only to references, so a kernel that keeps it cannot convert
// to wires.
func.func @noise(%p: !cc.ptr<f64>) attributes {"cudaq-entrypoint"} {
  %q = quake.alloca !quake.ref
  // expected-error@+1 {{requires every qubit to be a wire, but noise applies only to references}}
  quake.apply_noise @channel(%p) %q : (!cc.ptr<f64>, !quake.ref) -> ()
  return
}

func.func private @channel(!cc.ptr<f64>, !quake.ref)

// -----

// Without a known cause, only the first reference is reported.
func.func @references() attributes {"cudaq-entrypoint"} {
  // expected-error@+1 {{requires every qubit to be a wire, but this operation yields a reference}}
  %q = quake.alloca !quake.ref
  %r = quake.alloca !quake.ref
  quake.x [%q] %r : (!quake.ref, !quake.ref) -> ()
  return
}
