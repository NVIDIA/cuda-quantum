//--- gates.qke

func.func @spread_x(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  // The dependency-analysis node ID on this X still permits cancellation.
  %2 = quake.x %0 : (!quake.wire) -> !quake.wire {dnodeid = 1 : ui32}
  %3:2 = quake.x [%2] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4 = quake.x %3#0 : (!quake.wire) -> !quake.wire
  %5 = quake.x %3#1 : (!quake.wire) -> !quake.wire
  quake.wrap %4 to %c : !quake.wire, !quake.ref
  quake.wrap %5 to %t : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @spread_x
// CHECK-NOT: quake.x %
// CHECK: quake.x [
// CHECK-NOT: quake.x
// CHECK: return

func.func @spread_z(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2 = quake.z %1 : (!quake.wire) -> !quake.wire
  %3:2 = quake.x [%0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4 = quake.z %3#0 : (!quake.wire) -> !quake.wire
  %5 = quake.z %3#1 : (!quake.wire) -> !quake.wire
  quake.wrap %4 to %c : !quake.wire, !quake.ref
  quake.wrap %5 to %t : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @spread_z
// CHECK-NOT: quake.z
// CHECK: quake.x [
// CHECK-NOT: quake.z
// CHECK: return

// Moving Y on both wires through CX leaves -X on the control times Z on the
// target. The final X and Z cancel those Paulis, leaving the scalar -1.
func.func @cx_sign(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2 = quake.y %0 : (!quake.wire) -> !quake.wire
  %3 = quake.y %1 : (!quake.wire) -> !quake.wire
  %4:2 = quake.x [%2] %3 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %5 = quake.x %4#0 : (!quake.wire) -> !quake.wire
  %6 = quake.z %4#1 : (!quake.wire) -> !quake.wire
  quake.wrap %5 to %c : !quake.wire, !quake.ref
  quake.wrap %6 to %t : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @cx_sign
// CHECK: %[[PI:.*]] = arith.constant 3.1415926535897931
// CHECK-NOT: quake.{{[xyz]}}
// CHECK: quake.x [
// CHECK-NEXT: quake.phase (%[[PI]])
// CHECK-NOT: quake.{{[xyz]}}
// CHECK: return

// Only propagation from the output end reduces this sequence.
func.func @reverse_only(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3 = quake.x %2#0 : (!quake.wire) -> !quake.wire
  %4 = quake.x %2#1 : (!quake.wire) -> !quake.wire
  quake.wrap %3 to %c : !quake.wire, !quake.ref
  quake.wrap %4 to %t : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @reverse_only
// CHECK: quake.x %
// CHECK-NEXT: {{.*}}quake.x [
// CHECK-NOT: quake.x
// CHECK: return

func.func @hyh(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.h %0 : (!quake.wire) -> !quake.wire
  %2 = quake.y %1 : (!quake.wire) -> !quake.wire
  %3 = quake.h %2 : (!quake.wire) -> !quake.wire
  quake.wrap %3 to %q : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @hyh
// CHECK: %[[PI:.*]] = arith.constant 3.1415926535897931
// CHECK-NOT: quake.h
// CHECK: %[[Y:.*]] = quake.y
// CHECK-NEXT: quake.phase (%[[PI]]) %[[Y]]
// CHECK-NOT: quake.h
// CHECK: return

// Each rotation ends the run, so the Paulis on either side cannot cancel.
func.func @rotation_boundaries(%q: !quake.ref) {
  %angle = arith.constant 0.25 : f64
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.x %0 : (!quake.wire) -> !quake.wire
  %2 = quake.rz (%angle) %1 : (f64, !quake.wire) -> !quake.wire
  %3 = quake.x %2 : (!quake.wire) -> !quake.wire
  %4 = quake.ry (%angle) %3 : (f64, !quake.wire) -> !quake.wire
  %5 = quake.z %4 : (!quake.wire) -> !quake.wire
  %6 = quake.rx (%angle) %5 : (f64, !quake.wire) -> !quake.wire
  %7 = quake.z %6 : (!quake.wire) -> !quake.wire
  quake.wrap %7 to %q : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @rotation_boundaries
// CHECK: %[[ANGLE:.*]] = arith.constant 2.500000e-01
// CHECK: quake.x
// CHECK-NEXT: {{.*}}quake.rz (%[[ANGLE]])
// CHECK-NEXT: {{.*}}quake.x
// CHECK-NEXT: {{.*}}quake.ry (%[[ANGLE]])
// CHECK-NEXT: {{.*}}quake.z
// CHECK-NEXT: {{.*}}quake.rx (%[[ANGLE]])
// CHECK-NEXT: {{.*}}quake.z

func.func @conjugate_s(%q: !quake.ref) {
  %a = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %b = quake.x %a : (!quake.wire) -> !quake.wire
  %c = quake.s %b : (!quake.wire) -> !quake.wire
  %d = quake.x %c : (!quake.wire) -> !quake.wire
  quake.wrap %d to %q : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @conjugate_s
// CHECK: %[[ANGLE:.*]] = arith.constant 1.5707963267948966
// CHECK-NOT: quake.x
// CHECK: %[[S:.*]] = quake.s<adj>
// CHECK-NEXT: quake.phase (%[[ANGLE]]) %[[S]]
// CHECK-NOT: quake.x
// CHECK: return

// X followed by Z is iY. One Y gate suffices, with a global phase of pi/2.
func.func @xz_to_y(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.x %0 : (!quake.wire) -> !quake.wire
  %2 = quake.z %1 : (!quake.wire) -> !quake.wire
  quake.wrap %2 to %q : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @xz_to_y
// CHECK: %[[HALF_PI:.*]] = arith.constant 1.5707963267948966
// CHECK-NOT: quake.{{[xz]}} %
// CHECK: %[[Y:.*]] = quake.y
// CHECK-NEXT: quake.phase (%[[HALF_PI]]) %[[Y]]
// CHECK-NOT: quake.{{[xz]}} %
// CHECK: return

// The matrix product Z Y X is -i I.
func.func @pauli_product(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.x %0 : (!quake.wire) -> !quake.wire
  %2 = quake.y %1 : (!quake.wire) -> !quake.wire
  %3 = quake.z %2 : (!quake.wire) -> !quake.wire
  quake.wrap %3 to %q : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @pauli_product
// CHECK: %[[PHASE:.*]] = arith.constant 4.7123889803846897
// CHECK-NOT: quake.{{[xyz]}} %
// CHECK: quake.phase (%[[PHASE]])
// CHECK-NOT: quake.{{[xyz]}} %
// CHECK: return

func.func @growth(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2 = quake.x %0 : (!quake.wire) -> !quake.wire
  %3:2 = quake.x [%2] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  quake.wrap %3#0 to %c : !quake.wire, !quake.ref
  quake.wrap %3#1 to %t : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @growth
// CHECK: quake.x %
// CHECK-NEXT: {{.*}}quake.x [

// T X T-adjoint X normalizes to S with phase -pi/4. A target without S
// must keep the four original gates, all of which are in its basis.
func.func @needs_s(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.t %0 : (!quake.wire) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  %3 = quake.t<adj> %2 : (!quake.wire) -> !quake.wire
  %4 = quake.x %3 : (!quake.wire) -> !quake.wire
  quake.wrap %4 to %q : !quake.wire, !quake.ref
  return
}
// CHECK-LABEL: func.func @needs_s
// CHECK-NOT: quake.{{[tx]}}
// CHECK: quake.s %
// CHECK-NOT: quake.{{[tx]}}
// CHECK: return
// NO-S-LABEL: func.func @needs_s
// NO-S: %[[IN:.*]] = quake.unwrap
// NO-S-NEXT: %[[T:.*]] = quake.t %[[IN]]
// NO-S-NEXT: %[[X:.*]] = quake.x %[[T]]
// NO-S-NEXT: %[[TDG:.*]] = quake.t<adj> %[[X]]
// NO-S-NEXT: %[[OUT:.*]] = quake.x %[[TDG]]
// NO-S-NEXT: quake.wrap %[[OUT]]

//--- boundary.qke

func.func @measure(%q: !quake.wire) -> (!quake.measure, !quake.wire) {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %m, %b = quake.mz %a : (!quake.wire) -> (!quake.measure, !quake.wire)
  %c = quake.x %b : (!quake.wire) -> !quake.wire
  return %m, %c : !quake.measure, !quake.wire
}
// BOUNDARY-LABEL: func.func @measure
// BOUNDARY: quake.x
// BOUNDARY-NEXT: {{.*}}quake.mz
// BOUNDARY-NEXT: {{.*}}quake.x

func.func @reset(%q: !quake.wire) -> !quake.wire {
  %a = quake.z %q : (!quake.wire) -> !quake.wire
  %b = quake.reset %a : (!quake.wire) -> !quake.wire
  %c = quake.z %b : (!quake.wire) -> !quake.wire
  return %c : !quake.wire
}
// BOUNDARY-LABEL: func.func @reset
// BOUNDARY: quake.z
// BOUNDARY-NEXT: {{.*}}quake.reset
// BOUNDARY-NEXT: {{.*}}quake.z

func.func @branch(%condition: i1, %q: !quake.wire) -> !quake.wire {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %b = cc.if (%condition) ((%arg = %a)) -> (!quake.wire) {
    cc.continue %arg : !quake.wire
  } else {
    cc.continue %arg : !quake.wire
  }
  %c = quake.x %b : (!quake.wire) -> !quake.wire
  return %c : !quake.wire
}
// BOUNDARY-LABEL: func.func @branch
// BOUNDARY: quake.x
// BOUNDARY-NEXT: {{.*}}cc.if
// BOUNDARY: quake.x

func.func @reference_gate(%ref: !quake.ref, %q: !quake.wire) -> !quake.wire {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  quake.x %ref : (!quake.ref) -> ()
  %b = quake.x %a : (!quake.wire) -> !quake.wire
  return %b : !quake.wire
}
// BOUNDARY-LABEL: func.func @reference_gate
// BOUNDARY: quake.x %{{.*}} : (!quake.wire) -> !quake.wire
// BOUNDARY-NEXT: quake.x %{{.*}} : (!quake.ref) -> ()
// BOUNDARY-NEXT: {{.*}}quake.x %{{.*}} : (!quake.wire) -> !quake.wire

func.func @reference_control(%ref: !quake.ref, %q: !quake.wire) -> !quake.wire {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %b = quake.x [%ref] %a : (!quake.ref, !quake.wire) -> !quake.wire
  %c = quake.x %b : (!quake.wire) -> !quake.wire
  return %c : !quake.wire
}
// BOUNDARY-LABEL: func.func @reference_control
// BOUNDARY: quake.x %
// BOUNDARY-NEXT: {{.*}}quake.x [
// BOUNDARY-NEXT: {{.*}}quake.x %

func.func @controlled_h(%c: !quake.wire, %q: !quake.wire) -> (!quake.wire, !quake.wire) {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %b:2 = quake.h [%c] %a : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %d = quake.x %b#1 : (!quake.wire) -> !quake.wire
  return %b#0, %d : !quake.wire, !quake.wire
}
// BOUNDARY-LABEL: func.func @controlled_h
// BOUNDARY: quake.x %
// BOUNDARY-NEXT: {{.*}}quake.h [
// BOUNDARY-NEXT: {{.*}}quake.x %

func.func @two_controls(%c0: !quake.wire, %c1: !quake.wire, %q: !quake.wire)
    -> (!quake.wire, !quake.wire, !quake.wire) {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %b:3 = quake.x [%c0, %c1] %a : (!quake.wire, !quake.wire, !quake.wire) -> (!quake.wire, !quake.wire, !quake.wire)
  %d = quake.x %b#2 : (!quake.wire) -> !quake.wire
  return %b#0, %b#1, %d : !quake.wire, !quake.wire, !quake.wire
}
// BOUNDARY-LABEL: func.func @two_controls
// BOUNDARY: quake.x %
// BOUNDARY-NEXT: {{.*}}quake.x [%{{.*}}, %{{.*}}]
// BOUNDARY-NEXT: {{.*}}quake.x %

func.func @negated_control(%c: !quake.wire, %q: !quake.wire) -> (!quake.wire, !quake.wire) {
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %b:2 = quake.x [%c neg [true]] %a : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %d = quake.x %b#1 : (!quake.wire) -> !quake.wire
  return %b#0, %d : !quake.wire, !quake.wire
}
// BOUNDARY-LABEL: func.func @negated_control
// BOUNDARY: quake.x %
// BOUNDARY-NEXT: {{.*}}quake.x [%{{.*}} neg [true]]
// BOUNDARY-NEXT: {{.*}}quake.x %

func.func @two_targets(%a: !quake.wire, %b: !quake.wire) -> (!quake.wire, !quake.wire) {
  %x = quake.x %a : (!quake.wire) -> !quake.wire
  %s:2 = quake.swap %x, %b : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %y = quake.x %s#1 : (!quake.wire) -> !quake.wire
  return %s#0, %y : !quake.wire, !quake.wire
}
// BOUNDARY-LABEL: func.func @two_targets
// BOUNDARY: quake.x %
// BOUNDARY-NEXT: {{.*}}quake.swap
// BOUNDARY-NEXT: {{.*}}quake.x %

// An unsupported rotation on a distinct wire ends the run between the X gates.
func.func @disjoint_rotation_boundary() {
  %angle = arith.constant 0.25 : f64
  %a = quake.null_wire
  %b = quake.null_wire
  %x = quake.x %b : (!quake.wire) -> !quake.wire
  %r = quake.rz (%angle) %a : (f64, !quake.wire) -> !quake.wire
  %y = quake.x %x : (!quake.wire) -> !quake.wire
  quake.sink %r : !quake.wire
  quake.sink %y : !quake.wire
  return
}
// BOUNDARY-LABEL: func.func @disjoint_rotation_boundary
// BOUNDARY: %[[A:.*]] = quake.null_wire
// BOUNDARY-NEXT: %[[B:.*]] = quake.null_wire
// BOUNDARY-NEXT: %[[X:.*]] = quake.x %[[B]]
// BOUNDARY-NEXT: %[[R:.*]] = quake.rz (%{{.*}}) %[[A]]
// BOUNDARY-NEXT: %[[Y:.*]] = quake.x %[[X]]
// BOUNDARY-NEXT: quake.sink %[[R]]
// BOUNDARY-NEXT: quake.sink %[[Y]]

//--- controlled.qke

func.func private @helper(%target: !quake.ref) {
  %q = quake.unwrap %target : (!quake.ref) -> !quake.wire
  %a = quake.x %q : (!quake.wire) -> !quake.wire
  %b = quake.t<adj> %a : (!quake.wire) -> !quake.wire
  %c = quake.x %b : (!quake.wire) -> !quake.wire
  quake.wrap %c to %target : !quake.wire, !quake.ref
  return
}
func.func @controlled(%control: !quake.ref, %target: !quake.ref) {
  quake.apply @helper [%control] (%target) : (!quake.ref, !quake.ref) -> ()
  return
}

// ADJOINT-LABEL: func.func private @helper
// ADJOINT-NOT: quake.x
// ADJOINT: quake.t %
// ADJOINT: quake.phase
// ADJOINT-NOT: quake.x
// ADJOINT: return

//--- reference.qke

func.func @controlled(%control: !quake.ref, %target: !quake.ref) {
  quake.x [%control] %target : (!quake.ref, !quake.ref) -> ()
  quake.t<adj> [%control] %target : (!quake.ref, !quake.ref) -> ()
  quake.x [%control] %target : (!quake.ref, !quake.ref) -> ()
  return
}

//--- pipeline.qke

// Up to global phase, the circuit reduces to CX followed by T-adjoint.
func.func @kernel(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2 = quake.x %0 : (!quake.wire) -> !quake.wire
  %3:2 = quake.x [%2] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4 = quake.x %3#1 : (!quake.wire) -> !quake.wire
  %5 = quake.t %3#0 : (!quake.wire) -> !quake.wire
  %6 = quake.x %5 : (!quake.wire) -> !quake.wire
  quake.wrap %6 to %c : !quake.wire, !quake.ref
  quake.wrap %4 to %t : !quake.wire, !quake.ref
  return
}

// PIPELINE-LABEL: func.func @kernel
// PIPELINE: quake.x [
// PIPELINE: quake.t<adj>
// PIPELINE: return

//--- split-x.qke

// In execution order, ZYYY reduces to the native pair YZ with a minus sign.
func.func @split_x(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.z %0 : (!quake.wire) -> !quake.wire
  %2 = quake.y %1 : (!quake.wire) -> !quake.wire
  %3 = quake.y %2 : (!quake.wire) -> !quake.wire
  %4 = quake.y %3 : (!quake.wire) -> !quake.wire
  quake.wrap %4 to %q : !quake.wire, !quake.ref
  return
}
// SPLIT-X-LABEL: func.func @split_x
// SPLIT-X-NOT: quake.{{[xyz]}} %
// SPLIT-X: %[[FIRST:.*]] = quake.y %
// SPLIT-X-NEXT: {{.*}}quake.z %[[FIRST]]
// SPLIT-X-NOT: quake.{{[xyz]}} %
// SPLIT-X: return

//--- split-y.qke

// In execution order, XZZZ reduces to the native pair ZX with a minus sign.
func.func @split_y(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.x %0 : (!quake.wire) -> !quake.wire
  %2 = quake.z %1 : (!quake.wire) -> !quake.wire
  %3 = quake.z %2 : (!quake.wire) -> !quake.wire
  %4 = quake.z %3 : (!quake.wire) -> !quake.wire
  quake.wrap %4 to %q : !quake.wire, !quake.ref
  return
}
// SPLIT-Y-LABEL: func.func @split_y
// SPLIT-Y-NOT: quake.{{[xyz]}} %
// SPLIT-Y: %[[FIRST:.*]] = quake.z %
// SPLIT-Y-NEXT: {{.*}}quake.x %[[FIRST]]
// SPLIT-Y-NOT: quake.{{[xyz]}} %
// SPLIT-Y: return

// Each wire contributes a Y to the same candidate. Splitting both Ys
// contributes a total phase correction of pi.
func.func @two_splits(%a: !quake.ref, %b: !quake.ref) {
  %a0 = quake.unwrap %a : (!quake.ref) -> !quake.wire
  %b0 = quake.unwrap %b : (!quake.ref) -> !quake.wire
  %a1 = quake.x %a0 : (!quake.wire) -> !quake.wire
  %a2 = quake.z %a1 : (!quake.wire) -> !quake.wire
  %a3 = quake.z %a2 : (!quake.wire) -> !quake.wire
  %a4 = quake.z %a3 : (!quake.wire) -> !quake.wire
  %b1 = quake.x %b0 : (!quake.wire) -> !quake.wire
  %b2 = quake.z %b1 : (!quake.wire) -> !quake.wire
  %b3 = quake.z %b2 : (!quake.wire) -> !quake.wire
  %b4 = quake.z %b3 : (!quake.wire) -> !quake.wire
  quake.wrap %a4 to %a : !quake.wire, !quake.ref
  quake.wrap %b4 to %b : !quake.wire, !quake.ref
  return
}
// SPLIT-Y-LABEL: func.func @two_splits
// SPLIT-Y: %[[A:.*]] = quake.unwrap
// SPLIT-Y-NEXT: %[[B:.*]] = quake.unwrap
// SPLIT-Y-NEXT: %[[ZA:.*]] = quake.z %[[A]]
// SPLIT-Y-NEXT: {{.*}}quake.x %[[ZA]]
// SPLIT-Y-NEXT: %[[ZB:.*]] = quake.z %[[B]]
// SPLIT-Y-NEXT: {{.*}}quake.x %[[ZB]]
// SPLIT-Y-NOT: quake.{{[xz]}} %
// SPLIT-Y: return

//--- split-z.qke

// In execution order, YXXX reduces to the native pair XY with a minus sign.
func.func @split_z(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.y %0 : (!quake.wire) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  %3 = quake.x %2 : (!quake.wire) -> !quake.wire
  %4 = quake.x %3 : (!quake.wire) -> !quake.wire
  quake.wrap %4 to %q : !quake.wire, !quake.ref
  return
}
// SPLIT-Z-LABEL: func.func @split_z
// SPLIT-Z-NOT: quake.{{[xyz]}} %
// SPLIT-Z: %[[FIRST:.*]] = quake.x %
// SPLIT-Z-NEXT: {{.*}}quake.y %[[FIRST]]
// SPLIT-Z-NOT: quake.{{[xyz]}} %
// SPLIT-Z: return

//--- normalized-x.qke

// The two Y gates cancel during propagation. Single-qubit normalization then
// turns H S S H into X, which also needs decomposition in this basis.
func.func @normalized_x(%q: !quake.ref) {
  %0 = quake.unwrap %q : (!quake.ref) -> !quake.wire
  %1 = quake.h %0 : (!quake.wire) -> !quake.wire
  %2 = quake.s %1 : (!quake.wire) -> !quake.wire
  %3 = quake.s %2 : (!quake.wire) -> !quake.wire
  %4 = quake.h %3 : (!quake.wire) -> !quake.wire
  %5 = quake.y %4 : (!quake.wire) -> !quake.wire
  %6 = quake.y %5 : (!quake.wire) -> !quake.wire
  quake.wrap %6 to %q : !quake.wire, !quake.ref
  return
}
// NORMALIZED-X-LABEL: func.func @normalized_x
// NORMALIZED-X-NOT: quake.{{[hsyz]}} %
// NORMALIZED-X: %[[Y:.*]] = quake.y %
// NORMALIZED-X-NEXT: {{.*}}quake.z %[[Y]]
// NORMALIZED-X-NOT: quake.{{[hsyz]}} %
// NORMALIZED-X: return

//--- unavailable.qke

// H X H would reduce to Z, which the target cannot emit.
func.func @unavailable_z(%q: !quake.wire) -> !quake.wire {
  %a = quake.h %q : (!quake.wire) -> !quake.wire
  %b = quake.x %a : (!quake.wire) -> !quake.wire
  %c = quake.h %b : (!quake.wire) -> !quake.wire
  return %c : !quake.wire
}
// UNAVAILABLE-LABEL: func.func @unavailable_z
// UNAVAILABLE: quake.h %
// UNAVAILABLE-NEXT: {{.*}}quake.x %
// UNAVAILABLE-NEXT: {{.*}}quake.h %

//--- no-y-pipeline.qke

// A native Y reduces the gate count. With only X and Z available for the
// Pauli factor, the candidate ties the input and the original gates remain.
func.func @y_free(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2 = quake.x %1 : (!quake.wire) -> !quake.wire
  %3:2 = quake.x [%0] %2 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %4 = quake.z %3#1 : (!quake.wire) -> !quake.wire
  quake.wrap %3#0 to %c : !quake.wire, !quake.ref
  quake.wrap %4 to %t : !quake.wire, !quake.ref
  return
}
// WITH-Y-LABEL: func.func @y_free
// WITH-Y: quake.x [
// WITH-Y: quake.y %
// NO-Y-LABEL: func.func @y_free
// NO-Y: %[[X:.*]] = quake.x %
// NO-Y-NEXT: %[[CX:.*]]:2 = quake.x {{\[}}%{{.*}}] %[[X]]
// NO-Y-NEXT: {{.*}}quake.z %[[CX]]#1

// With only X and Z available, the forward sweep ties the five input gates.
// The reverse sweep emits Y on the control before CX and flips T to T-adjoint,
// with phase -pi/4. Splitting Y into Z then X adds pi/2, giving +pi/4 overall.
func.func @reverse_t(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3 = quake.t %2#0 : (!quake.wire) -> !quake.wire
  %4 = quake.z %3 : (!quake.wire) -> !quake.wire
  %5 = quake.x %2#1 : (!quake.wire) -> !quake.wire
  %6 = quake.x %4 : (!quake.wire) -> !quake.wire
  quake.wrap %6 to %c : !quake.wire, !quake.ref
  quake.wrap %5 to %t : !quake.wire, !quake.ref
  return
}
// REVERSE-Y-LABEL: func.func @reverse_t(
// REVERSE-Y: %[[Y:.*]] = quake.y %
// REVERSE-Y-NEXT: %[[CX:.*]]:2 = quake.x {{\[}}%[[Y]]]
// REVERSE-Y-NEXT: {{.*}}quake.t<adj> %[[CX]]#0

// REVERSE-XZ-LABEL: func.func @reverse_t(
// REVERSE-XZ: %[[Z:.*]] = quake.z %
// REVERSE-XZ-NEXT: %[[X:.*]] = quake.x %[[Z]]
// REVERSE-XZ-NEXT: %[[CX:.*]]:2 = quake.x {{\[}}%[[X]]]
// REVERSE-XZ-NEXT: {{.*}}quake.t<adj> %[[CX]]#0

// With T-adjoint in the source, the reverse sweep emits T. Its phase is
// 5pi/4 with native Y, or 7pi/4 after splitting Y into Z then X.
func.func @reverse_tdg(%c: !quake.ref, %t: !quake.ref) {
  %0 = quake.unwrap %c : (!quake.ref) -> !quake.wire
  %1 = quake.unwrap %t : (!quake.ref) -> !quake.wire
  %2:2 = quake.x [%0] %1 : (!quake.wire, !quake.wire) -> (!quake.wire, !quake.wire)
  %3 = quake.t<adj> %2#0 : (!quake.wire) -> !quake.wire
  %4 = quake.z %3 : (!quake.wire) -> !quake.wire
  %5 = quake.x %2#1 : (!quake.wire) -> !quake.wire
  %6 = quake.x %4 : (!quake.wire) -> !quake.wire
  quake.wrap %6 to %c : !quake.wire, !quake.ref
  quake.wrap %5 to %t : !quake.wire, !quake.ref
  return
}
// REVERSE-Y-LABEL: func.func @reverse_tdg
// REVERSE-Y: %[[Y:.*]] = quake.y %
// REVERSE-Y-NEXT: %[[CX:.*]]:2 = quake.x {{\[}}%[[Y]]]
// REVERSE-Y-NEXT: {{.*}}quake.t %[[CX]]#0

// REVERSE-XZ-LABEL: func.func @reverse_tdg
// REVERSE-XZ: %[[Z:.*]] = quake.z %
// REVERSE-XZ-NEXT: %[[X:.*]] = quake.x %[[Z]]
// REVERSE-XZ-NEXT: %[[CX:.*]]:2 = quake.x {{\[}}%[[X]]]
// REVERSE-XZ-NEXT: {{.*}}quake.t %[[CX]]#0
