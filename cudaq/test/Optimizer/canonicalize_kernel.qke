// RUN: cudaq-opt --pass-pipeline='builtin.module(func.func(canonicalize-kernel,cse,canonicalize-kernel))' %s | FileCheck %s

// RUN: cudaq-opt --pass-pipeline='builtin.module(inline,classical-optimization-pipeline)' %s | FileCheck %s --check-prefix=MEASURE

// Fold and erase dead operations in a single SSA block.
func.func @flat(%arg: i32) -> i32 {
  %zero = arith.constant 0 : i32
  %sum = arith.addi %arg, %zero : i32
  return %sum : i32
}
// CHECK-LABEL: func.func @flat(
// CHECK-SAME: %[[ARG:.*]]: i32)
// CHECK-NEXT: return %[[ARG]] : i32

// CSE can expose folds to the following canonicalizer.
func.func @after_cse(%a: i32, %b: i32) -> i1 {
  %lhs = arith.addi %a, %b : i32
  %rhs = arith.addi %a, %b : i32
  %equal = arith.cmpi eq, %lhs, %rhs : i32
  return %equal : i1
}
// CHECK-LABEL: func.func @after_cse
// CHECK-NEXT: %[[TRUE:.*]] = arith.constant true
// CHECK-NEXT: return %[[TRUE]] : i1

// Keep region simplification for a function with unreachable code.
func.func @unreachable(%q: !quake.ref) {
  return
^dead:
  quake.h %q : (!quake.ref) -> ()
  return
}
// CHECK-LABEL: func.func @unreachable
// CHECK-NEXT: return
// CHECK-NEXT: }

// Inlining can duplicate measurement register names in a canonical gate list.
func.func private @measure(%q: !quake.ref) {
  %m = quake.mz %q name "out" : (!quake.ref) -> !quake.measure
  return
}

func.func @measure_twice(%q: !quake.ref) {
  func.call @measure(%q) : (!quake.ref) -> ()
  quake.h %q : (!quake.ref) -> ()
  func.call @measure(%q) : (!quake.ref) -> ()
  return
}
// MEASURE-LABEL: func.func @measure_twice
// MEASURE: quake.mz {{.*}} name "out%0"
// MEASURE: quake.h
// MEASURE: quake.mz {{.*}} name "out%1"
