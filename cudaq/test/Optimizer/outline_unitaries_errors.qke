// RUN: cudaq-opt --outline-unitaries --split-input-file --verify-diagnostics %s

// Negative tests for the unitary outlining pass.

// Reference-semantics groups are rejected rather than silently skipped.
func.func @reference_semantics(%q: !quake.ref) {
  // expected-error@+1 {{failed to outline unitary group: selected operation must be memory-effect-free and have supported wire semantics}}
  quake.h %q : (!quake.ref) -> ()
  return
}

// -----

// A wire result used in a nested block is outside the outliner's supported
// external-consumer model, even though the input IR is valid.
func.func @nested_consumer(%q: !quake.wire) {
  // expected-error@+1 {{failed to outline unitary group: external result consumers must belong to the same block}}
  %h = quake.h %q : (!quake.wire) -> !quake.wire
  cc.scope {
    quake.sink %h : !quake.wire
    cc.continue
  }
  return
}
