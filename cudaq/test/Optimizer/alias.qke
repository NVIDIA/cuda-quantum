// RUN: cudaq-opt --factor-quantum-alloc --canonicalize --memtoreg \
// RUN:   --canonicalize %s | FileCheck %s

func.func @test0(%arg0: i32) {
  %0 = cc.alloca i32
  cc.store %arg0, %0 : !cc.ptr<i32>
  %1 = quake.alloca !quake.veq<5>
  %2 = quake.extract_ref %1[0] : (!quake.veq<5>) -> !quake.ref
  quake.x %2 : (!quake.ref) -> ()
  %3 = cc.load %0 : !cc.ptr<i32>
  %4 = cc.cast signed %3 : (i32) -> i64
  %5 = quake.extract_ref %1[%4] : (!quake.veq<5>, i64) -> !quake.ref
  quake.h %5 : (!quake.ref) -> ()
  %6 = quake.extract_ref %1[0] : (!quake.veq<5>) -> !quake.ref
  quake.x %6 : (!quake.ref) -> ()
  %measOut = quake.mz %1 : (!quake.veq<5>) -> !cc.sequence<!cc.measure_handle>
  return
}

// CHECK-LABEL:   func.func @test0(
// CHECK-SAME:      %[[ARG0:.*]]: i32) {
// CHECK:           %[[VAL_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_2:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_3:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_4:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_5:.*]] = quake.concat %[[VAL_0]], %[[VAL_1]], %[[VAL_2]], %[[VAL_3]], %[[VAL_4]] : (!quake.ref, !quake.ref, !quake.ref, !quake.ref, !quake.ref) -> !quake.veq<5>
// CHECK:           quake.x %[[VAL_0]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_6:.*]] = cc.cast signed %[[ARG0]] : (i32) -> i64
// CHECK:           %[[VAL_7:.*]] = quake.extract_ref %[[VAL_5]][%[[VAL_6]]] : (!quake.veq<5>, i64) -> !quake.ref
// CHECK:           quake.h %[[VAL_7]] : (!quake.ref) -> ()
// CHECK:           quake.x %[[VAL_0]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_8:.*]] = quake.mz %[[VAL_5]] : (!quake.veq<5>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           return
// CHECK:         }

func.func @test1(%arg0: i32) {
  %c1_i32 = arith.constant 1 : i32
  %c0_i32 = arith.constant 0 : i32
  %c5_i32 = arith.constant 5 : i32
  %0 = cc.alloca i32
  cc.store %arg0, %0 : !cc.ptr<i32>
  %1 = quake.alloca !quake.veq<5>
  %2 = quake.extract_ref %1[0] : (!quake.veq<5>) -> !quake.ref
  quake.x %2 : (!quake.ref) -> ()
  cc.scope {
    %4 = cc.alloca i32
    cc.store %c0_i32, %4 : !cc.ptr<i32>
    cc.loop while {
      %5 = cc.load %4 : !cc.ptr<i32>
      %6 = arith.cmpi ult, %5, %c5_i32 : i32
      cc.condition %6
    } do {
      %5 = cc.load %4 : !cc.ptr<i32>
      %6 = cc.cast unsigned %5 : (i32) -> i64
      %7 = quake.extract_ref %1[%6] : (!quake.veq<5>, i64) -> !quake.ref
      quake.h %7 : (!quake.ref) -> ()
      cc.continue
    } step {
      %5 = cc.load %4 : !cc.ptr<i32>
      %6 = arith.addi %5, %c1_i32 : i32
      cc.store %6, %4 : !cc.ptr<i32>
    }
  }
  %3 = quake.extract_ref %1[0] : (!quake.veq<5>) -> !quake.ref
  quake.x %3 : (!quake.ref) -> ()
  %measOut = quake.mz %1 : (!quake.veq<5>) -> !cc.sequence<!cc.measure_handle>
  return
}

// CHECK-LABEL:   func.func @test1(
// CHECK-SAME:      %[[ARG0:.*]]: i32) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1 : i32
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_2:.*]] = arith.constant 5 : i32
// CHECK:           %[[VAL_3:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_4:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_5:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_6:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_7:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_8:.*]] = quake.concat %[[VAL_3]], %[[VAL_4]], %[[VAL_5]], %[[VAL_6]], %[[VAL_7]] : (!quake.ref, !quake.ref, !quake.ref, !quake.ref, !quake.ref) -> !quake.veq<5>
// CHECK:           quake.x %[[VAL_3]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_9:.*]] = cc.loop while ((%[[VAL_10:.*]] = %[[VAL_1]]) -> (i32)) {
// CHECK:             %[[VAL_11:.*]] = arith.cmpi ult, %[[VAL_10]], %[[VAL_2]] : i32
// CHECK:             cc.condition %[[VAL_11]](%[[VAL_10]] : i32)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_10]]: i32):
// CHECK:             %[[VAL_11]] = cc.cast unsigned %[[VAL_10]] : (i32) -> i64
// CHECK:             %[[VAL_12:.*]] = quake.extract_ref %[[VAL_8]][%[[VAL_11]]] : (!quake.veq<5>, i64) -> !quake.ref
// CHECK:             quake.h %[[VAL_12]] : (!quake.ref) -> ()
// CHECK:             cc.continue %[[VAL_10]] : i32
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_10]]: i32):
// CHECK:             %[[VAL_11]] = arith.addi %[[VAL_10]], %[[VAL_0]] : i32
// CHECK:             cc.continue %[[VAL_11]] : i32
// CHECK:           }
// CHECK:           quake.x %[[VAL_3]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_13:.*]] = quake.mz %[[VAL_8]] : (!quake.veq<5>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           return
// CHECK:         }

func.func @test2(%arg0: i32) {
  %0 = cc.alloca i32
  cc.store %arg0, %0 : !cc.ptr<i32>
  %1 = quake.alloca !quake.veq<5>
  %2 = quake.extract_ref %1[0] : (!quake.veq<5>) -> !quake.ref
  quake.x %2 : (!quake.ref) -> ()
  %3 = cc.load %0 : !cc.ptr<i32>
  %4 = cc.cast signed %3 : (i32) -> i64
  %5 = quake.extract_ref %1[%4] : (!quake.veq<5>, i64) -> !quake.ref
  quake.h %5 : (!quake.ref) -> ()
  quake.x %2 : (!quake.ref) -> ()
  quake.y %2 : (!quake.ref) -> ()
  %measOut = quake.mz %1 : (!quake.veq<5>) -> !cc.sequence<!cc.measure_handle>
  return
}

// CHECK-LABEL:   func.func @test2(
// CHECK-SAME:      %[[ARG0:.*]]: i32) {
// CHECK:           %[[VAL_0:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_2:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_3:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_4:.*]] = quake.alloca !quake.ref
// CHECK:           %[[VAL_5:.*]] = quake.concat %[[VAL_0]], %[[VAL_1]], %[[VAL_2]], %[[VAL_3]], %[[VAL_4]] : (!quake.ref, !quake.ref, !quake.ref, !quake.ref, !quake.ref) -> !quake.veq<5>
// CHECK:           quake.x %[[VAL_0]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_6:.*]] = cc.cast signed %[[ARG0]] : (i32) -> i64
// CHECK:           %[[VAL_7:.*]] = quake.extract_ref %[[VAL_5]][%[[VAL_6]]] : (!quake.veq<5>, i64) -> !quake.ref
// CHECK:           quake.h %[[VAL_7]] : (!quake.ref) -> ()
// CHECK:           quake.x %[[VAL_0]] : (!quake.ref) -> ()
// CHECK:           quake.y %[[VAL_0]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_8:.*]] = quake.mz %[[VAL_5]] : (!quake.veq<5>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           return
// CHECK:         }

// A dynamically-sized veq that factor-quantum-alloc cannot decompose into
// individual ref allocas "survives into the circuit": refs are extracted
// directly from it rather than glued together via quake.concat. The
// dynamic-index extract_ref nested in the cc.if reaches an unknown element,
// so every location in %0 is left in memory form -- including the ref bound
// before the cc.if, which therefore keeps its unwrap/wrap pair.
func.func @test3(%arg0: i32, %arg1: i1, %n: i64) {
  %0 = quake.alloca !quake.veq<?>[%n : i64]
  %1 = quake.extract_ref %0[0] : (!quake.veq<?>) -> !quake.ref
  quake.x %1 : (!quake.ref) -> ()
  cc.if(%arg1) {
    %2 = cc.cast unsigned %arg0 : (i32) -> i64
    %3 = quake.extract_ref %0[%2] : (!quake.veq<?>, i64) -> !quake.ref
    quake.h %3 : (!quake.ref) -> ()
    cc.continue
  }
  quake.x %1 : (!quake.ref) -> ()
  %measOut = quake.mz %0 : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
  return
}

// CHECK-LABEL:   func.func @test3(
// CHECK-SAME:      %[[ARG0:.*]]: i32, %[[ARG1:.*]]: i1, %[[ARG2:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = quake.alloca !quake.veq<?>[%[[ARG2]] : i64]
// CHECK:           %[[VAL_1:.*]] = quake.extract_ref %[[VAL_0]][0] : (!quake.veq<?>) -> !quake.ref
// CHECK:           quake.x %[[VAL_1]] : (!quake.ref) -> ()
// CHECK:           cc.if(%[[ARG1]]) {
// CHECK:             %[[VAL_2:.*]] = cc.cast unsigned %[[ARG0]] : (i32) -> i64
// CHECK:             %[[VAL_3:.*]] = quake.extract_ref %[[VAL_0]][%[[VAL_2]]] : (!quake.veq<?>, i64) -> !quake.ref
// CHECK:             quake.h %[[VAL_3]] : (!quake.ref) -> ()
// CHECK:           } else {
// CHECK:           }
// CHECK:           quake.x %[[VAL_1]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_4:.*]] = quake.mz %[[VAL_0]] : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           return
// CHECK:         }

// Same bug as test3, but the aliasing extract_ref is nested two levels deep
// (inside a cc.if that is itself inside a cc.loop's body), which exercises
// the childMap/parentMap summary propagating the veq access up through both
// levels before it is finally resolved and cancelled at the enclosing
// function scope, dominating the second use of the ref.
func.func @test4(%arg0: i32, %arg1: i1, %n: i64) {
  %c1_i32 = arith.constant 1 : i32
  %c0_i32 = arith.constant 0 : i32
  %c5_i32 = arith.constant 5 : i32
  %0 = quake.alloca !quake.veq<?>[%n : i64]
  %1 = quake.extract_ref %0[0] : (!quake.veq<?>) -> !quake.ref
  quake.x %1 : (!quake.ref) -> ()
  cc.scope {
    %i = cc.alloca i32
    cc.store %c0_i32, %i : !cc.ptr<i32>
    cc.loop while {
      %iv = cc.load %i : !cc.ptr<i32>
      %cond = arith.cmpi ult, %iv, %c5_i32 : i32
      cc.condition %cond
    } do {
      cc.if(%arg1) {
        %iv = cc.load %i : !cc.ptr<i32>
        %2 = cc.cast unsigned %iv : (i32) -> i64
        %3 = quake.extract_ref %0[%2] : (!quake.veq<?>, i64) -> !quake.ref
        quake.h %3 : (!quake.ref) -> ()
        cc.continue
      }
      cc.continue
    } step {
      %iv = cc.load %i : !cc.ptr<i32>
      %inc = arith.addi %iv, %c1_i32 : i32
      cc.store %inc, %i : !cc.ptr<i32>
    }
  }
  quake.x %1 : (!quake.ref) -> ()
  %measOut = quake.mz %0 : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
  return
}

// CHECK-LABEL:   func.func @test4(
// CHECK-SAME:      %[[ARG0:.*]]: i32, %[[ARG1:.*]]: i1, %[[ARG2:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1 : i32
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_2:.*]] = arith.constant 5 : i32
// CHECK:           %[[VAL_3:.*]] = quake.alloca !quake.veq<?>[%[[ARG2]] : i64]
// CHECK:           %[[VAL_4:.*]] = quake.extract_ref %[[VAL_3]][0] : (!quake.veq<?>) -> !quake.ref
// CHECK:           quake.x %[[VAL_4]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_5:.*]] = cc.loop while ((%[[VAL_6:.*]] = %[[VAL_1]]) -> (i32)) {
// CHECK:             %[[VAL_7:.*]] = arith.cmpi ult, %[[VAL_6]], %[[VAL_2]] : i32
// CHECK:             cc.condition %[[VAL_7]](%[[VAL_6]] : i32)
// CHECK:           } do {
// CHECK:           ^bb0(%[[VAL_6]]: i32):
// CHECK:             cc.if(%[[ARG1]]) {
// CHECK:               %[[VAL_7]] = cc.cast unsigned %[[VAL_6]] : (i32) -> i64
// CHECK:               %[[VAL_8:.*]] = quake.extract_ref %[[VAL_3]][%[[VAL_7]]] : (!quake.veq<?>, i64) -> !quake.ref
// CHECK:               quake.h %[[VAL_8]] : (!quake.ref) -> ()
// CHECK:             } else {
// CHECK:             }
// CHECK:             cc.continue %[[VAL_6]] : i32
// CHECK:           } step {
// CHECK:           ^bb0(%[[VAL_6]]: i32):
// CHECK:             %[[VAL_7]] = arith.addi %[[VAL_6]], %[[VAL_0]] : i32
// CHECK:             cc.continue %[[VAL_7]] : i32
// CHECK:           }
// CHECK:           quake.x %[[VAL_4]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_9:.*]] = quake.mz %[[VAL_3]] : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           return
// CHECK:         }

// Precision check: the aliasing extract_ref inside the cc.if reads from a
// *different*, independently allocated dynamically-sized veq (%s) than the
// one the ref before/after the cc.if belongs to (%r). Because the two veqs
// are provably disjoint (see definitelyNotDerivedFrom), the ref's wire must
// thread straight through the cc.if with no rewrap/unwrap forced around it —
// unlike test3, where the same veq is involved and a fresh unwrap is
// required.
func.func @test5(%arg0: i32, %arg1: i1, %n1: i64, %n2: i64) {
  %r = quake.alloca !quake.veq<?>[%n1 : i64]
  %s = quake.alloca !quake.veq<?>[%n2 : i64]
  %1 = quake.extract_ref %r[0] : (!quake.veq<?>) -> !quake.ref
  quake.x %1 : (!quake.ref) -> ()
  cc.if(%arg1) {
    %2 = cc.cast unsigned %arg0 : (i32) -> i64
    %3 = quake.extract_ref %s[%2] : (!quake.veq<?>, i64) -> !quake.ref
    quake.h %3 : (!quake.ref) -> ()
    cc.continue
  }
  quake.y %1 : (!quake.ref) -> ()
  %measOutR = quake.mz %r : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
  %measOutS = quake.mz %s : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
  return
}

// CHECK-LABEL:   func.func @test5(
// CHECK-SAME:      %[[ARG0:.*]]: i32, %[[ARG1:.*]]: i1, %[[ARG2:.*]]: i64, %[[ARG3:.*]]: i64) {
// CHECK:           %[[VAL_0:.*]] = quake.alloca !quake.veq<?>[%[[ARG2]] : i64]
// CHECK:           %[[VAL_1:.*]] = quake.alloca !quake.veq<?>[%[[ARG3]] : i64]
// CHECK:           %[[VAL_2:.*]] = quake.extract_ref %[[VAL_0]][0] : (!quake.veq<?>) -> !quake.ref
// CHECK:           quake.x %[[VAL_2]] : (!quake.ref) -> ()
// CHECK:           cc.if(%[[ARG1]]) {
// CHECK:             %[[VAL_3:.*]] = cc.cast unsigned %[[ARG0]] : (i32) -> i64
// CHECK:             %[[VAL_4:.*]] = quake.extract_ref %[[VAL_1]][%[[VAL_3]]] : (!quake.veq<?>, i64) -> !quake.ref
// CHECK:             quake.h %[[VAL_4]] : (!quake.ref) -> ()
// CHECK:           } else {
// CHECK:           }
// CHECK:           quake.y %[[VAL_2]] : (!quake.ref) -> ()
// CHECK:           %[[VAL_5:.*]] = quake.mz %[[VAL_0]] : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           %[[VAL_6:.*]] = quake.mz %[[VAL_1]] : (!quake.veq<?>) -> !cc.sequence<!cc.measure_handle>
// CHECK:           return
// CHECK:         }

