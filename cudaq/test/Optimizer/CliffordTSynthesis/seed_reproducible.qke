// RUN: cudaq-opt --clifford-t-synthesis='epsilon=1e-3 skip-below=0 seed=42' %s -o %t.1
// RUN: cudaq-opt --clifford-t-synthesis='epsilon=1e-3 skip-below=0 seed=42' %s -o %t.2
// RUN: cudaq-opt --clifford-t-synthesis='epsilon=1e-3 skip-below=0 seed=42' %s -o %t.3
// RUN: cudaq-opt --clifford-t-synthesis='epsilon=1e-3 skip-below=0 seed=1' %s -o %t.4
// RUN: diff %t.1 %t.2
// RUN: diff %t.1 %t.3
// RUN: not diff %t.1 %t.4
// RUN: FileCheck --input-file=%t.1 %s

// pi/8 at epsilon=1e-3 varies run to run when unseeded. The diffs catch a seed
// that never reaches gridsynth, the `not diff` a seed that is ignored for a
// fixed stream.

func.func @seeded() {
  %theta = arith.constant 0.39269908169872414 : f64
  %q = quake.null_wire
  %0 = quake.rz (%theta) %q : (f64, !quake.wire) -> !quake.wire
  quake.sink %0 : !quake.wire
  return
}

// The rotation becomes a call to the per-angle helper outlined ahead of it.
// CHECK-LABEL: func.func private @__cliffordt_rz_wire_
// CHECK-LABEL: func.func @seeded()
// CHECK-NOT:     quake.rz
// CHECK:         call @__cliffordt_rz_wire_
