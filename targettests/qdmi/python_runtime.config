# REQUIRES: qdmi
# RUN: env CUDAQ_LOG_LEVEL=info PYTHONPATH=../../python python3 -c 'import cudaq; cudaq.set_target("qdmi", device="mqt.ddsim.default", program_format="qasm2"); kernel = cudaq.make_kernel(); qubit = kernel.qalloc(); kernel.x(qubit); kernel.mz(qubit); result = cudaq.sample(kernel, shots_count=32); print("ones=", result.count("1"), sep="")' 2>&1 | FileCheck %s

# CHECK: through 'qasm2' transport.
# CHECK: ones=32
