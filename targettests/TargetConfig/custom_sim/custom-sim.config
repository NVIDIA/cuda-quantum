# Validate the custom simulator target config generation and resolution

# RUN: bash %s %t.root %cudaq_target_dir %cudaq_lib_dir %cudaq_plugin_ext | FileCheck %s

set -euo pipefail

test_root=$1
target_dir=$2
lib_dir=$3
lib_ext=$4

# Set up a valid plugin directory structure
rm -rf "${test_root}"
mkdir -p "${test_root}/targets" "${test_root}/lib"
cp "${target_dir}/MyCustomSimulator.yml" "${test_root}/targets/"
touch "${test_root}/lib/libnvqir-MyCustomSimulator${lib_ext}"

cudaq-target-resolve \
  --enable-yaml-parsing \
  --plugin-root="${test_root}" \
  --lib-dir="${test_root}/lib" \
  --gpu-count=1 \
  MyCustomSimulator \
  -o "${test_root}/custom.out"
cat "${test_root}/custom.out"

# CHECK: NVQIR_SIMULATION_BACKEND="MyCustomSimulator"
# CHECK: TARGET_CONFIG_PATH=
# CHECK-SAME: .root/targets/MyCustomSimulator.yml
# CHECK: TARGET_PLUGIN_LIB_DIR=
# CHECK-SAME: .root/lib
