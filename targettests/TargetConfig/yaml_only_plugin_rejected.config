# nvq++ rejects a plugin root that has only YAML (no compiled target library).

# RUN: bash %s %t | FileCheck %s

set -euo pipefail

source "$(dirname "$0")/Inputs/yaml_only_plugin.sh"
setup_yaml_only_plugin "$1"

if env XDG_DATA_HOME="${test_root}/xdg" \
    nvq++ --target yaml-only-runtime "${test_root}/main.cpp" -o "${exe}" \
    >"${test_root}/nvqpp.log" 2>&1; then
  echo "error: nvq++ unexpectedly succeeded with a YAML-only plugin" >&2
  cat "${test_root}/nvqpp.log" >&2
  exit 1
fi
cat "${test_root}/nvqpp.log"

# CHECK: Invalid Target: (yaml-only-runtime)
