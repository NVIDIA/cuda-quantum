# Compiling the YAML into a target plugin library makes nvq++ and the
# resulting executable succeed.

# RUN: bash %s %t %cudaq_plugin_ext %cudaq_src_dir | FileCheck %s

set -euo pipefail

source "$(dirname "$0")/Inputs/yaml_only_plugin.sh"
setup_yaml_only_plugin "$1" "$2" "$3"
compile_yaml_only_plugin_lib

env XDG_DATA_HOME="${test_root}/xdg" \
  nvq++ --target yaml-only-runtime "${test_root}/main.cpp" -o "${exe}"
env XDG_DATA_HOME="${test_root}/xdg" "${exe}"
echo "EXEC-OK"

# CHECK: EXEC-OK
