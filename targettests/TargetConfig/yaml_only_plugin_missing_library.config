# After nvq++ links against a compiled target plugin library, deleting that
# library makes the already-built executable fail at runtime even if the YAML
# is still present.

# RUN: bash %s %t %cudaq_plugin_ext %cudaq_src_dir %cudaq_plugin_cxx "%cudaq_plugin_cxx_flags" | FileCheck %s

set -euo pipefail

source "$(dirname "$0")/Inputs/yaml_only_plugin.sh"
setup_yaml_only_plugin "$1" "$2" "$3" "$4" "$5"
compile_yaml_only_plugin_lib

env XDG_DATA_HOME="${test_root}/xdg" \
  nvq++ --target yaml-only-runtime "${test_root}/main.cpp" -o "${exe}"
rm -f "${lib}"
env XDG_DATA_HOME="${test_root}/xdg" not --crash "${exe}" 2>&1

# CHECK: Invalid Target: (yaml-only-runtime)
