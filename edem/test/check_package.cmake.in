function(run)
  execute_process(COMMAND ${ARGV}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${errors}")
  endif()
endfunction()

set(config "${EDEM_TEST_CONFIG}")
if(NOT config)
  set(config Release)
endif()
set(configure_args
  -G "@CMAKE_GENERATOR@"
  "-DCMAKE_C_COMPILER:FILEPATH=@CMAKE_C_COMPILER@"
  "-DCMAKE_CXX_COMPILER:FILEPATH=@CMAKE_CXX_COMPILER@"
  "-DCMAKE_C_FLAGS:STRING=@CMAKE_C_FLAGS@"
  "-DCMAKE_CXX_FLAGS:STRING=@CMAKE_CXX_FLAGS@"
  "-DCMAKE_BUILD_TYPE:STRING=${config}"
  -DCMAKE_COMPILE_WARNING_AS_ERROR=ON)
if(NOT "@CMAKE_MAKE_PROGRAM@" STREQUAL "")
  list(APPEND configure_args "-DCMAKE_MAKE_PROGRAM:FILEPATH=@CMAKE_MAKE_PROGRAM@")
endif()
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
  list(APPEND configure_args -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
  list(APPEND configure_args -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
if(NOT "@CMAKE_TOOLCHAIN_FILE@" STREQUAL "")
  list(APPEND configure_args "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=@CMAKE_TOOLCHAIN_FILE@")
endif()

set(mode standalone)
if(EDEM_TEST_PARENT)
  set(mode parent)
elseif(EDEM_TEST_CUSTOM_INSTALL_DIRS)
  set(mode custom-install-dirs)
endif()
set(work "@CMAKE_CURRENT_BINARY_DIR@/${mode}-package-check")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")

set(install_build "@CMAKE_CURRENT_BINARY_DIR@/..")
set(components "@CUDAQ_EDEM_LIBRARY_COMPONENT@;@CUDAQ_EDEM_DEVELOPMENT_COMPONENT@")
set(package_install_dir "@CUDAQ_EDEM_CMAKE_INSTALL_DIR@")
if("@CUDAQ_EDEM_BUILD_PYTHON@" AND mode STREQUAL "standalone")
  list(APPEND components EDEMPython)
endif()
if(EDEM_TEST_PARENT)
  run("@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/parent"
    -B "${work}/build" ${configure_args}
    "-DCUDAQ_EDEM_TEST_SOURCE:PATH=@CUDAQ_EDEM_SOURCE_DIR@"
    "-DBUILD_SHARED_LIBS:BOOL=@BUILD_SHARED_LIBS@")
  run("@CMAKE_COMMAND@" --build "${work}/build" --config "${config}")
  run("@CMAKE_CTEST_COMMAND@" --test-dir "${work}/build"
    -C "${config}" --output-on-failure)
  set(install_build "${work}/build/edem")
  set(components Core)
  set(package_install_dir lib/cmake/cudaq-edem)
elseif(EDEM_TEST_CUSTOM_INSTALL_DIRS)
  run("@CMAKE_COMMAND@" -S "@CUDAQ_EDEM_SOURCE_DIR@"
    -B "${work}/build" ${configure_args}
    "-DBUILD_SHARED_LIBS:BOOL=@BUILD_SHARED_LIBS@"
    -DCUDAQ_EDEM_BUILD_TESTS=OFF
    -DCMAKE_INSTALL_LIBDIR=lib64
    -DCMAKE_INSTALL_INCLUDEDIR=include/cudaq-edem)
  run("@CMAKE_COMMAND@" --build "${work}/build" --config "${config}")
  set(install_build "${work}/build")
  set(package_install_dir lib64/cmake/cudaq-edem)
endif()

set(prefix "${work}/prefix")
list(REMOVE_DUPLICATES components)
foreach(component IN LISTS components)
  run("@CMAKE_COMMAND@" --install "${install_build}" --config "${config}"
    --prefix "${prefix}" --component "${component}")
endforeach()
set(relocated "${work}/relocated")
file(RENAME "${prefix}" "${relocated}")

if("@CUDAQ_EDEM_BUILD_PYTHON@" AND mode STREQUAL "standalone")
  get_filename_component(python_prefix
    "${relocated}/@CUDAQ_EDEM_PYTHON_INSTALL_DIR@" DIRECTORY)
  run("@CMAKE_COMMAND@" -E env "PYTHONPATH=${python_prefix}"
    "@CUDAQ_EDEM_PYTHON_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/test_values.py")
endif()

# A relocatable package must not retain checkout, build, or old-prefix paths.
get_filename_component(checkout "@CUDAQ_EDEM_SOURCE_DIR@/.." ABSOLUTE)
file(GLOB_RECURSE package_files "${relocated}/*.cmake")
foreach(path IN LISTS package_files)
  file(READ "${path}" contents)
  foreach(forbidden IN ITEMS "${checkout}" "@CMAKE_BINARY_DIR@" "${prefix}")
    string(FIND "${contents}" "${forbidden}" position)
    if(NOT position EQUAL -1)
      message(FATAL_ERROR "Package metadata retains ${forbidden}: ${path}")
    endif()
  endforeach()
endforeach()
if(NOT package_files)
  message(FATAL_ERROR "The installation did not include the CMake package")
endif()

run("@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/consumer"
  -B "${work}/consumer" ${configure_args}
  "-DCUDAQ_EDEM_TEST_PREFIX:PATH=${relocated}"
  "-Dcudaq-edem_DIR:PATH=${relocated}/${package_install_dir}"
  "-DCUDAQ_EDEM_TEST_VERSION:STRING=@CUDAQ_EDEM_VERSION@")
run("@CMAKE_COMMAND@" --build "${work}/consumer" --config "${config}")
run("@CMAKE_CTEST_COMMAND@" --test-dir "${work}/consumer"
  -C "${config}" --output-on-failure)

# The implementation's C++ standard and runtime must not leak into a C build.
set(c_configure_args ${configure_args})
list(FILTER c_configure_args EXCLUDE REGEX "^-DCMAKE_CXX_")
run("@CMAKE_COMMAND@" -S "@CMAKE_CURRENT_SOURCE_DIR@/consumer"
  -B "${work}/c-only-consumer" ${c_configure_args}
  -DCUDAQ_EDEM_TEST_C_ONLY=ON
  "-DCUDAQ_EDEM_TEST_PREFIX:PATH=${relocated}"
  "-Dcudaq-edem_DIR:PATH=${relocated}/${package_install_dir}"
  "-DCUDAQ_EDEM_TEST_VERSION:STRING=@CUDAQ_EDEM_VERSION@")
run("@CMAKE_COMMAND@" --build "${work}/c-only-consumer" --config "${config}")
run("@CMAKE_CTEST_COMMAND@" --test-dir "${work}/c-only-consumer"
  -C "${config}" --output-on-failure)
