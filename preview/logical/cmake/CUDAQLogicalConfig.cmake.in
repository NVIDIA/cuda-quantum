#
# CUDAQLogicalConfig.cmake — build-tree package config for CUDA-Q Logical
# dialect extensions.
#
# Usage:
#   cmake -DCUDAQLogical_DIR=<build>/lib/cmake/CUDAQLogical -S . -B build
#
# After find_package(CUDAQLogical REQUIRED), downstream CMakeLists files have:
#   - CUDAQLogical::MLIRCUDAQLogicalInterfaces,
#     CUDAQLogical::MLIRQLXDialect, CUDAQLogical::MLIRLVMDialect,
#     CUDAQLogical::MLIRFabricDialect, CUDAQLogical::MLIRPhysDialect,
#     CUDAQLogical::MLIRCflowDialect, CUDAQLogical::MLIREventDialect
#   - CUDAQ_LOGICAL_INCLUDE_DIRS — public headers (source + generated)
#   - cudaq::MLIR plus the MLIR and CUDA-Q cmake helpers
# ============================================================================ #

include(CMakeFindDependencyMacro)

# CUDA-Q Logical was built against this CUDA-Q installation and the LLVM/MLIR pair that
# ships with it — consumers must resolve MLIR from the same libcudaqMLIR image.
list(PREPEND CMAKE_PREFIX_PATH "@CUDAQ_LOGICAL_CUDAQ_PREFIX@")
set(CUDAQ_ENABLE_LANGUAGE OFF)
find_dependency(CUDAQ CONFIG)
find_dependency(MLIR CONFIG)

# Re-surface LLVM/MLIR cmake module paths so consumers can call
# add_mlir_dialect_library, mlir_tablegen, etc. without re-finding MLIR.
list(APPEND CMAKE_MODULE_PATH "@MLIR_CMAKE_DIR@" "@LLVM_CMAKE_DIR@")
include(TableGen)
include(AddLLVM)
include(AddMLIR)
include(HandleLLVMOptions)
include(AddCUDAQ)

# Exported CUDA-Q Logical targets. QLX is one dialect target in this package;
# it is not the namespace or owner of the other dialects and interfaces.
include("@CMAKE_BINARY_DIR@/lib/cmake/CUDAQLogical/CUDAQLogicalTargets.cmake")

# CUDA-Q Logical public header directories: source tree + build tree (tablegen outputs).
set(CUDAQ_LOGICAL_INCLUDE_DIRS
  "@CMAKE_SOURCE_DIR@/ir/include"
  "@CMAKE_BINARY_DIR@/ir/include"
)

# Path to the CUDA-Q Logical Python C API library. Downstream plugins using the
# Python bindings should share this runtime entry point.
set(CUDAQ_LOGICAL_PYTHON_CAPI_LIB
  "@CMAKE_BINARY_DIR@/python/cudaq/mlir/_mlir_libs/libQLXPythonCAPI.so"
)

set(CUDAQLogical_FOUND TRUE)
