{
    "retryOn429": true,
    "retryCount": 5,
    "fallbackRetryDelay": "30s",
    "aliveStatusCodes": [200, 206],
    "httpHeaders": [
      {
        "urls": ["https://github.com/", "https://guides.github.com/", "https://help.github.com/", "https://docs.github.com/"],
        "headers": {
          "Accept-Encoding": "zstd, br, gzip, deflate"
        }
      },
      {
        "urls": ["https://www.mpich.org/"],
        "headers": {
          "User-Agent": "curl/8.0"
        }
      }
    ],
    "ignorePatterns": [
      {
        "pattern": "^https://www.gnu.org/"
      },
      {
        "pattern": "^https://gcc.gnu.org/"
      },
      {
        "_comment": "Cloudflare blocks programmatic clients (TLS fingerprint, not UA); no header workaround possible. Verified with curl + lychee + markdown-link-check across multiple UAs.",
        "pattern": "^https://en\\.cppreference\\.com/"
      },
      {
        "_comment": "Cloudflare returns 403 to programmatic clients regardless of User-Agent.",
        "pattern": "^https://www\\.quantum-machines\\.co/"
      },
      {
        "pattern": "^https://epubs.siam.org/doi/10.1137/S0097539796300921"
      },
      {
        "pattern": "^https://epubs.siam.org/doi/10.1137/090774999"
      },
      {
        "pattern": "^https://epubs.siam.org/doi/10.1137/090771806"
      },
      {
        "pattern": "^https://vscode.dev/"
      },
      {
        "_comment": "Requires an NGC login. Returns 401 to unauthenticated clients even though the page is live.",
        "pattern": "^https://ngc\\.nvidia\\.com/setup/api-key"
      },
      {
        "pattern": "microsoft.com/"
      },
      {
        "pattern": "visualstudio.com/"
      },
      {
        "pattern": "openapi.html"
      }
    ]
}
