@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CUDAToolkit is only a dependency when the installed build had CUDA; a
# CUDA-less build exports only the CPU-only targets (e.g. the UDP transport).
if(@CUDA_FOUND@)
  find_dependency(CUDAToolkit REQUIRED)
endif()
find_dependency(Threads REQUIRED)
if(@CUDAQ_REALTIME_HAS_CPU_ROCE@)
  find_dependency(HololinkRoce 2.7 CONFIG REQUIRED COMPONENTS transport)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cudaq-realtime-targets.cmake")

set(CUDAQ_REALTIME_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(CUDAQ_REALTIME_INCLUDE_DIRS "${CUDAQ_REALTIME_INCLUDE_DIR}")

# cudaq_realtime_add_dispatch_kernel: an application's own dispatch kernel,
# built for the architecture libcudaq-realtime's kernel targets.
if(@CUDA_FOUND@)
  set(CUDAQ_REALTIME_DEVICE_CODE_MIN_ARCH @CUDAQ_REALTIME_DEVICE_CODE_MIN_ARCH@)
  include("${CMAKE_CURRENT_LIST_DIR}/CudaqRealtimeDispatchKernel.cmake")
endif()
