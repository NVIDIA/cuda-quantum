# Check if iqm-client is installed, otherwise mark the test as skipped
@Python_EXECUTABLE@ -c "import iqm.iqm_client" 2> /dev/null
if [ $? -ne 0 ]; then
    echo "iqm-client is not installed. It is required for testing IQM integration. Please install it using pip install iqm-client. Skipping IQM tests."
    exit 77
fi

checkServerConnection() {
  PYTHONPATH=@CMAKE_BINARY_DIR@/python @Python_EXECUTABLE@ - << EOF
import socket
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect(("localhost", 62443))
    s.close()
except Exception:
    exit(1)
EOF
}

if [ a${IQM_SERVER_URL} != a ]; then

  # Special case: split-topology tests only work on mock server
  if [ "$1" = "test_iqm_split" ]; then
      echo "Skipping split-topology tests. Split-topology tests work only with the mock server."
      exit 77
  fi

  # Run the tests against IQM_SERVER_URL
  ./$1
  exit $?
fi

# Run the tests against a locally started mock server

# Launch the fake server
PYTHONPATH=@CMAKE_BINARY_DIR@/python @Python_EXECUTABLE@ @CMAKE_BINARY_DIR@/python/tests/utils/start_mock_qpu.py iqm &
# we'll need the process id to kill it
pid=$(echo "$!")
n=0
while ! checkServerConnection; do
  sleep 1
  n=$((n+1))
  if [ "$n" -eq "60" ]; then
    kill -INT $pid
    exit 99
  fi
done
# Run the tests
IQM_TOKEN="good_access_token" ./$1
testsPassed=$?
# kill the server
kill -INT $pid
# wait for the server to die
sleep 1
# return success / failure
exit $testsPassed
