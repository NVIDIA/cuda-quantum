@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The pulse GPU runtime target (cudaq::cudm_runtime) links cuDensityMat and the
# CUDA runtime, so a consumer of the installed package needs both available.
# This dependency is only recorded when the installed build actually produced
# the GPU runtime (see the @CUDAQ_PULSE_HAS_CUDM@ substitution).
if(@CUDAQ_PULSE_HAS_CUDM@)
  find_dependency(CUDAToolkit REQUIRED)
  find_dependency(cuDensityMat REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cudaq-pulse-targets.cmake")

set(CUDAQ_PULSE_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(CUDAQ_PULSE_INCLUDE_DIRS "${CUDAQ_PULSE_INCLUDE_DIR}")
